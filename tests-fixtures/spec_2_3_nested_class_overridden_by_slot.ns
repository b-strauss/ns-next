Newspeak3
'Test'
class Spec23NestedClassOverriddenBySlot usingPlatform: p = Object new (| t = p transcript. |) (
    (* newspeak-spec.pdf 2.3, verbatim apart from the module around it: "Here
       is a class with a single nested class", then "Because all references
       to nested classes are message sends, nested classes can be
       overridden." ... "Here we have overridden a nested class declaration
       with a slot." *)
    class Outer = () (
       public class Inner = ()()
    )
    class ChildOfOuter = Outer () (
           public foo = (^Inner new) (* Note that the caret acts like return *)
    )
    class GrandChildOfOuter = ChildOfOuter( | public Inner = String. |) (
    )
    public main: platform args: args = (
        (* GrandChildOfOuter new foo. -- returns a String, not an Inner *)
        t show: (GrandChildOfOuter new foo class == String) printString; newLine.
    )
) : ()
