(* Programs reach the exception classes, `Message` and the classes a
   program may name through `platform kernel`, as the corpus does
   (`private Exception = platform kernel Exception.`) and as Primordial
   Soup's `Kernel wrapping:` facet provides them; `Object` declares no
   accessor for them. *)
class TheKernelNamespace = Object new (
    
) (
    public main: platform args: arguments = (
        | transcript = platform transcript. kernel = platform kernel. |
        transcript show: kernel Exception printString; newLine.
        transcript show: kernel Error printString; newLine.
        transcript show: kernel MessageNotUnderstood printString; newLine.
        transcript show: kernel Halt printString; newLine.
        transcript show: kernel Message printString; newLine.
        transcript show: kernel ArgumentError printString; newLine.
        transcript show: kernel CannotReturn printString; newLine.
        transcript show: kernel CannotInstantiate printString; newLine.
        transcript show: (kernel = platform kernel) printString; newLine.
    )
) : ()
