/// `reachedDefaultHandler` answers whether a `signal` of the exception has
/// found no handler and run `defaultAction`, and once it has, it stays
/// true: a later `signal` that a handler catches does not clear it, as
/// Squeak's flag of that name, which Newspeak's kernel reads, is never
/// cleared. `Quiet`'s default action answers a value instead of ending the
/// run, so the same exception can be signalled again.
class ReachedDefaultHandlerStaysTrueOnceReached = Object new () (
  public class Quiet = Exception new () (
    public defaultAction = (
      ^42.
    )
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      quiet
    |
    quiet:: Quiet new.
    transcript
        show: quiet reachedDefaultHandler printString;
        newLine.
    transcript
        show: ([quiet signal] on: Quiet do: [:e | e return: 7]) printString;
        newLine.
    transcript
        show: quiet reachedDefaultHandler printString;
        newLine.
    transcript
        show: quiet signal printString;
        newLine.
    transcript
        show: quiet reachedDefaultHandler printString;
        newLine.
    transcript
        show: ([quiet signal] on: Quiet do: [:e | e return: 7]) printString;
        newLine.
    transcript
        show: quiet reachedDefaultHandler printString;
        newLine.
  )
)
