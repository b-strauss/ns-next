/// An unhandled exception ends the run whatever its text is: a Symbol's is
/// reported as its text, and nothing after the signal runs.
class AnUnhandledErrorWithASymbolTextEndsTheRun = Object new () (
  public main: platform args: arguments = (
    |
      transcript = platform transcript.
    |
    transcript
        show: 'before';
        newLine.
    Error signal: #sym.
    transcript
        show: 'not reached';
        newLine.
  )
)
