/// An error nothing handles ends the run through `defaultAction`, which
/// terminates it: every pending `ensure:` block runs, innermost first, on
/// the way to the bottom of the stack, and the host then reports the error
/// as it always has.
class AnUncaughtErrorRunsPendingEnsures = Object new () (
  public main: platform args: arguments = (
    |
      transcript = platform transcript.
    |
    transcript
        show: 'before';
        newLine.
    [
      [Error signal: 'boom'] ensure: [
        transcript
            show: 'cleanup';
            newLine.
      ].
    ] ensure: [
      transcript
          show: 'outer cleanup';
          newLine.
    ].
    transcript
        show: 'not reached';
        newLine.
  )
)
