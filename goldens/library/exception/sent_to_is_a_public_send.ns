(* `Message>>sentTo:` sends the message as an ordinary public send (§5.5),
   as Primordial Soup's `sendTo:` does: a program can build a message, so a
   send through one reaches a public method and never a private or a
   protected one, which end in `doesNotUnderstand:`. A message built without
   `arguments:` is sent with none; one whose selector is no Symbol cannot be
   sent, and `sentTo:` raises an `Error` rather than answering nil. *)
class SentToIsAPublicSend = Object new (
    
) (
    class Holder = Object new () (
        private secret = ( ^'the private one' )
        protected guarded = ( ^'the protected one' )
        public open = ( ^'the public one' )
    )
    public main: platform args: arguments = (
        | transcript = platform transcript. Error = platform kernel Error. Message = platform kernel Message. holder |
        holder:: Holder new.
        transcript show: ((Message new selector: #open; arguments: {}) sentTo: holder); newLine.
        transcript show: ([(Message new selector: #secret; arguments: {}) sentTo: holder] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([(Message new selector: #guarded; arguments: {}) sentTo: holder] on: Error do: [:e | e messageText]); newLine.
        transcript show: ((Message new selector: #at:; arguments: {2}) sentTo: {7. 8}) printString; newLine.
        transcript show: ((Message new selector: #open) sentTo: holder); newLine.
        transcript show: ([(Message new selector: 'open'; arguments: {}) sentTo: holder] on: Error do: [:e | e messageText]); newLine.
    )
) : ()
