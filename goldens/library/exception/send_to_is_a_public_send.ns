/// `Message>>sendTo:` sends the message as an ordinary public send (§5.5):
/// a program can build a message, so a send through one reaches a public
/// method and never a private or a protected one, which end in
/// `doesNotUnderstand:`. A message built without `arguments:` is sent with
/// none; one whose selector is no Symbol cannot be sent, and `sendTo:`
/// raises an `Error` rather than answering nil.
class SendToIsAPublicSend = Object new () (
  class Holder = Object new () (
    private secret = (
      ^'the private one'.
    )

    protected guarded = (
      ^'the protected one'.
    )

    public open = (
      ^'the public one'.
    )
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      Message = platform kernel Message.
      holder
    |
    holder:: Holder new.
    transcript
        show: ((Message new
            selector: #open;
            arguments: {}) sendTo: holder);
        newLine.
    transcript
        show: ([
          (Message new
              selector: #secret;
              arguments: {}) sendTo: holder.
        ] on: Error do: [:e | e messageText]);
        newLine.
    transcript
        show: ([
          (Message new
              selector: #guarded;
              arguments: {}) sendTo: holder.
        ] on: Error do: [:e | e messageText]);
        newLine.
    transcript
        show: ((Message new
            selector: #at:;
            arguments: {2}) sendTo: {7. 8}) printString;
        newLine.
    transcript
        show: ((Message new selector: #open) sendTo: holder);
        newLine.
    transcript
        show: ([
          (Message new
              selector: 'open';
              arguments: {}) sendTo: holder.
        ] on: Error do: [:e | e messageText]);
        newLine.
  )
)
