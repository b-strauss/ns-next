/// §7's `cannotReturn` is a VM error, and so a signalled `Error`: a `^`
/// from a block whose home has returned, run inside `on: Error do:`, is
/// caught, its text the one an uncaught one ends the run with, and the
/// program carries on after the handler.
class ACannotReturnIsCaught = Object new (
  |
    stored ::= nil.
  |
) (
  stash = (
    stored:: [^'too late'].
    ^'stashed'.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
    |
    transcript
        show: self stash;
        newLine.
    transcript
        show: ([stored value] on: Error do: [:e | e messageText]);
        newLine.
    transcript
        show: 'after';
        newLine.
  )
)
