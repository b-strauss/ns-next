(* A Symbol is a String (§5.1.6, as in every reference kernel), which
   `String handles:` reads as inheritance: it answers
   `size`, `at:`, `copyFrom:to:` and `,` as a String of its text does, and
   those two answer a String. `=` stays class-tight, since a Symbol is one
   object per text, and `Transcript show:` writes its text. *)
class ASymbolIsAString = Object new () (
    public main: platform args: arguments = (
        | transcript = platform transcript. |
        transcript print: (String handles: #abc); newLine.
        transcript print: #abc size; newLine.
        transcript print: (#abc at: 2); newLine.
        transcript show: (#abc copyFrom: 1 to: 2) printString; newLine.
        transcript show: (#abc copyFrom: 1 to: 2) class name; newLine.
        transcript show: ('a' , #b) printString; newLine.
        transcript show: (#a , 'b') printString; newLine.
        transcript show: (#a , 'b') class name; newLine.
        transcript print: #a = 'a'; newLine.
        transcript print: 'a' = #a; newLine.
        transcript print: #abc asSymbol == #abc; newLine.
        transcript show: #abc; newLine
    )
) : ()
