(* asString converts to a string, so a string answers itself: the very
   object, not a copy. *)
class StringAsString = Object new () (
    public main: p args: a = (
        | text |
        text:: 'abc'.
        p transcript show: text asString; newLine.
        p transcript show: (text asString == text) printString; newLine
    )
) : ()
