/// A class mirror reads a class's structure: its name, whether it is a
/// metaclass, its superclass chain up to `Top`, whose superclass is nil,
/// and its slots, methods and nested classes, the inherited ones included,
/// superclass first, a level's methods in the order of the source, not of
/// their selectors. A method mirror covers only the methods a declaration
/// writes, never a slot's accessors or a nested class's. A nested class's
/// enclosing object is the object it is nested in, a module's class has
/// none, and anything that is no class or metaclass is refused with an
/// ArgumentError.
class AClassMirrorWalksTheSuperclassChain = Object new () (
  class Shape = Object new (
    |
      public sides = 0.
    |
  ) (
    class Outline = Object new () ()

    public label = (
      ^'shape'.
    )

    public area = (
      ^0.
    )
  )

  class Square = Shape new (
    |
      public length ::= 1.
    |
  ) (
    class Corner = Object new () ()

    class Edge = Object new () ()

    public perimeter = (
      ^4 * length.
    )

    public area = (
      ^length * length.
    )
  )

  names: group on: transcript = (
    (group collect: [:each | each name]) do: [:name |
      transcript show: name.
    ] separatedBy: [
      transcript show: ' '.
    ].
    transcript newLine.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      ObjectMirror = platform mirrors ObjectMirror.
      ArgumentError = platform kernel ArgumentError.
      square = ClassMirror reflecting: Square.
      metaclass = (ObjectMirror reflecting: Square) getClass.
      objectMethods = (ClassMirror reflecting: Object) methods.
      level ::= square.
    |
    transcript
        show: square name;
        show: ' ';
        print: square isMeta;
        show: ' ';
        show: metaclass name;
        show: ' ';
        print: metaclass isMeta;
        newLine.
    [level isNil] whileFalse: [
      transcript
          show: level name;
          show: ' '.
      level:: level superclass.
    ].
    transcript
        print: level;
        newLine.
    names: square slots on: transcript.
    names: (square methods asArray reject: [:method |
      objectMethods includesMirrorNamed: method name.
    ])
        on: transcript.
    names: square nestedClasses on: transcript.
    transcript
        print: square enclosingObject reflectee == self;
        show: ' ';
        print: (ClassMirror reflecting: self class) enclosingObject reflectee;
        newLine.
    transcript
        show: ([ClassMirror reflecting: 3] on: ArgumentError do: [:error | error messageText]);
        show: ' ';
        print: ([ClassMirror reflecting: 3] on: ArgumentError do: [:error | error argument]);
        newLine.
  )
)
