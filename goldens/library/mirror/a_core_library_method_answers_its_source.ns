/// A method mirror on a core-library method answers its text, which the
/// binary carries whether the program runs from source or from an image;
/// only that it is a non-empty String is printed, since the text is the
/// library's to lay out. A program's own method and class declaration
/// answer their text only when the program's source is at hand, nil from
/// an image built without it, so a host test holds those
/// (`crates/ns-runtime/tests/platform.rs`).
class ACoreLibraryMethodAnswersItsSource = Object new () (
  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      listMixin = (ClassMirror reflecting: platform collections List) mixin.
      listSource = (listMixin methods findMirrorNamed: #add:) source.
    |
    transcript
        print: listSource isKindOfString;
        show: ' ';
        print: listSource isEmpty not;
        newLine.
  )
)
