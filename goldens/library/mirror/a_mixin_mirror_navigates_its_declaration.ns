/// A mixin mirror navigates the declarations around it: a nested class's
/// mixin is enclosed by its enclosing class's, a module's by none; a
/// mixin's class side leads back to it; and its declaration is a mirror
/// of its own, whose instance side is the mixin, whose class side is the
/// mixin's class side and whose enclosing class is the enclosing class's
/// declaration, the module's having none. A declaration is never equal to
/// either of its sides, but is equal to the declaration reached from its
/// class side or from its enclosing class's nested classes, which come in
/// declaration order, each with its access, an unmarked one's protected.
class AMixinMirrorNavigatesItsDeclaration = Object new () (
  class Holder = Object new () (
    public class First = Object new () ()

    private class Second = Object new () ()

    class Third = Object new () ()
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      module = (ClassMirror reflecting: self class) mixin.
      holder = (ClassMirror reflecting: Holder) mixin.
      first = (ClassMirror reflecting: Holder new First) mixin.
      declaration = first declaration.
    |
    transcript
        show: first enclosingMixin name;
        show: ' ';
        print: first enclosingMixin = holder;
        show: ' ';
        print: holder enclosingMixin = module;
        show: ' ';
        print: module enclosingMixin;
        newLine.
    transcript
        show: first classMixin name;
        show: ' ';
        print: first classMixin instanceMixin = first;
        show: ' ';
        print: first instanceMixin = first;
        show: ' ';
        print: first classMixin = first;
        newLine.
    transcript
        show: declaration name;
        show: ' ';
        print: declaration instanceSide = first;
        show: ' ';
        print: declaration classSide = first classMixin;
        show: ' ';
        show: declaration classSide name;
        show: ' ';
        show: declaration enclosingClass name;
        show: ' ';
        show: holder declaration enclosingClass name;
        show: ' ';
        print: module declaration enclosingClass;
        newLine.
    transcript
        print: declaration = first;
        show: ' ';
        print: first = declaration;
        show: ' ';
        print: declaration = declaration classSide;
        show: ' ';
        print: declaration = first classMixin declaration;
        show: ' ';
        print: declaration hash = first classMixin declaration hash;
        show: ' ';
        print: declaration = (holder nestedClasses findMirrorNamed: #First);
        newLine.
    holder nestedClasses do: [:each |
      transcript
          show: each name;
          show: ' ';
          print: each accessModifier;
          newLine.
    ].
  )
)
