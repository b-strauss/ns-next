/// `LargeInteger`'s arithmetic and ordering, with a `LargeInteger` on either
/// side and an `Integer` on the other. `big` is built by arithmetic; `small`,
/// `9223372036854775807`, lies beyond 61 bits and so is itself a
/// `LargeInteger` literal (large literals have their own golden). That a
/// result that fits again is answered as an `Integer` only the
/// representation shows, so `crates/ns-runtime/tests/representation.rs`
/// checks it.
class LargeArithmetic = Object new () (
  public main: p args: a = (
    |
      two
      big
      other
      small
      back
      count
    |
    two:: 2.
    small:: 9223372036854775807.
    count:: 0.
    big:: 1.
    [count < 200] whileTrue: [
      big:: big * two.
      count:: count + 1.
    ].
    p transcript
        show: big printString;
        newLine.
    other:: 0 - (big // (small * small)).
    p transcript
        show: other printString;
        newLine.
    p transcript
        show: (big + other) printString;
        newLine.
    p transcript
        show: (big - other) printString;
        newLine.
    p transcript
        show: (big * other) printString;
        newLine.
    p transcript
        show: (big // -7) printString;
        newLine.
    p transcript
        show: (other // 7) printString;
        newLine.
    p transcript
        show: (big // other) printString;
        newLine.
    p transcript
        show: (other // big) printString;
        newLine.
    p transcript
        show: (big < other) printString;
        newLine.
    p transcript
        show: (big > other) printString;
        newLine.
    p transcript
        show: (big <= big) printString;
        newLine.
    p transcript
        show: (other >= big) printString;
        newLine.
    p transcript
        show: (5 < big) printString;
        newLine.
    p transcript
        show: (5 > other) printString;
        newLine.
    p transcript
        show: (5 + big) printString;
        newLine.
    p transcript
        show: (5 - big) printString;
        newLine.
    p transcript
        show: (5 // big) printString;
        newLine.
    p transcript
        show: (-5 // big) printString;
        newLine.
    back:: (small + 1) - 1.
    p transcript
        show: (back = small) printString;
        newLine.
    p transcript
        show: other negated printString;
        newLine.
    p transcript
        show: other abs printString;
        newLine.
  )
)
