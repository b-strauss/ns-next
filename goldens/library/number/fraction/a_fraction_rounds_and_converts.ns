/// A Fraction rounds to an Integer -- `floor` and `ceiling` outward,
/// `truncated` and `asInteger` toward zero, `rounded` to the nearest with
/// a half away from zero -- and converts to the nearest Float in one
/// rounding, so a fraction whose parts are both beyond the largest Float
/// still converts, and one beyond it or below the smallest converts to an
/// infinity or zero. It answers the mathematical functions through that
/// Float, and `negated` and `abs` exactly.
class AFractionRoundsAndConverts = () (
  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      half = 1 / 2.
      third = 1 / 3.
      huge = 10 raisedTo: 400.
    |
    transcript
        print: (7 / 2) floor;
        show: ' ';
        print: (7 / 2) ceiling;
        show: ' ';
        print: (7 / 2) rounded;
        show: ' ';
        print: (7 / 2) truncated;
        show: ' ';
        print: (7 / 2) asInteger;
        newLine.
    transcript
        print: (-7 / 2) floor;
        show: ' ';
        print: (-7 / 2) ceiling;
        show: ' ';
        print: (-7 / 2) rounded;
        show: ' ';
        print: (-7 / 2) truncated;
        show: ' ';
        print: (5 / 3) rounded;
        show: ' ';
        print: (-5 / 3) rounded;
        newLine.
    transcript
        print: half asFloat;
        show: ' ';
        print: third asFloat;
        show: ' ';
        print: (huge / 3) asFloat;
        show: ' ';
        print: (1 / huge) asFloat;
        show: ' ';
        print: (huge + 1 / (huge * 3)) asFloat;
        newLine.
    transcript
        print: half negated;
        show: ' ';
        print: (-1 / 2) abs;
        show: ' ';
        print: half abs;
        show: ' ';
        print: (1 / 4) sqrt;
        show: ' ';
        print: half isNaN;
        show: ' ';
        print: half isFinite;
        newLine.
  )
)
