/// A `Float`'s arithmetic converts a `LargeInteger` argument to the
/// nearest `double`, as it converts an `Integer` one; `<` and `=` compare
/// exact values. `big` is 2^64, and `1.5 + 2^64` rounds to 2^64.
class FloatMeetsLarge = Object new () (
  public main: p args: a = (
    |
      big
    |
    big:: 9223372036854775807 + 1 * 2.
    p transcript
        show: (1.5 + big) printString;
        newLine.
    p transcript
        show: (1.5 < big) printString;
        newLine.
    p transcript
        show: (1.5 = big) printString;
        newLine.
  )
)
