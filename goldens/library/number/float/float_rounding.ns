/// `Float`'s `floor`, `ceiling`, `rounded`, `truncated` and `asInteger` of
/// every kind of receiver -- `SmallFloat64`s, the boxed `1.0e300` and
/// `1.0e-300`, the infinity, NaN, the subnormal `4.9e-324` -- and of the
/// halves `rounded` takes away from zero, the largest double below 2^52
/// with a half, `0.49999999999999994` just below a half, and doubles past
/// the `SmallInteger` range, whose `asInteger` is a `LargeInteger`. The
/// four roundings answer a `Float`; `asInteger` truncates and refuses a
/// NaN and an infinity. Each operation is a block run on every receiver,
/// so that machine code runs it once the block is compiled; a line is the
/// receiver and each result, or the error it signals, apart by ` | `.
class FloatRounding = () (
  /// The text of `operation` on `receiver`: its result printed, or the
  /// message of the error it signals.
  textOf: operation on: receiver = (
    ^[(operation value: receiver) printString] on: Error do: [:error | error messageText].
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      receivers = {
        1.5.
        -2.25.
        0.1.
        1.0e300.
        1.0e-300.
        Float infinity.
        Float negativeInfinity.
        Float nan.
        4.9e-324.
        0.5.
        -0.5.
        2.5.
        -2.5.
        3.5.
        -1.5.
        0.49999999999999994.
        -0.49999999999999994.
        4503599627370495.5.
        -4503599627370495.5.
        1.0e20.
        -1.0e20.
        (2 raisedTo: 62) asFloat.
        (2 raisedTo: 60) asFloat negated.
        1152921504606846976.0.
        -1152921504606846976.0.
        1152921504606846848.0.
        -1152921504606846848.0.
      }.
      operations = {
        [:receiver | receiver floor].
        [:receiver | receiver ceiling].
        [:receiver | receiver rounded].
        [:receiver | receiver truncated].
        [:receiver | receiver asInteger].
      }.
    |
    transcript show: 'receiver | floor | ceiling | rounded | truncated | asInteger'.
    transcript newLine.
    receivers do: [:receiver |
      transcript show: receiver printString.
      operations do: [:operation |
        transcript
            show: ' | ';
            show: (textOf: operation on: receiver).
      ].
      transcript newLine.
    ].
  )
)
