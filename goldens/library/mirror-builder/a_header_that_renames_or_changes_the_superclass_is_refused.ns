/// `header source:` refuses a header that renames the class or changes
/// its superclass, with an Error naming the class, and stages nothing: the
/// header still answers the declaration's own, and installing changes
/// neither the class's name nor its superclass. A header that keeps both
/// and changes a slot's value is staged.
class AHeaderThatRenamesOrChangesTheSuperclassIsRefused = Object new () (
  class Base = Object new () ()

  class Subject = Object new (
    |
      public kept = 1.
    |
  ) ()

  outcome: action = (
    ^[
      action value.
      'staged'.
    ] on: Error do: [:error | error messageText].
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      builder = (ClassMirror reflecting: Subject) mixin declaration asBuilder.
      original = builder header source.
    |
    transcript
        show: (outcome: [
          builder header source: 'class Renamed = Object new (| public kept = 1. |)'.
        ]);
        newLine.
    transcript
        show: (outcome: [builder header source: 'class Subject = Base new (| public kept = 1. |)']);
        newLine.
    transcript
        print: builder header source = original;
        newLine.
    transcript
        show: (outcome: [
          builder header source: 'class Subject = Object new (| public kept = 2. |)'.
        ]);
        newLine.
    builder install.
    transcript
        show: (ClassMirror reflecting: Subject) name;
        show: ' ';
        show: (ClassMirror reflecting: Subject) superclass name;
        show: ' ';
        print: Subject new kept;
        newLine.
  )
)
