/// A header edit that changes only a slot's initializer leaves an
/// instance made before the install with the values its initializers
/// gave it, the changed slot included; an instance made after the
/// install runs the new initializer and the unchanged ones.
class AChangedSlotInitializerReachesOnlyNewInstances = Object new () (
  class Subject = Object new (
    |
      public x ::= 117.
      public y = 0.
      public z.
    |
  ) ()

  show: instance on: transcript = (
    transcript
        print: instance x;
        show: ' ';
        print: instance y;
        show: ' ';
        print: instance z;
        newLine.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      instance = Subject new.
      builder = (ClassMirror reflecting: Subject) mixin declaration asBuilder.
    |
    builder
        header source: 'class Subject = Object new (| public x ::= 120. public y = 0. public z |)'.
    show: instance on: transcript.
    builder install.
    show: instance on: transcript.
    show: Subject new on: transcript.
  )
)
