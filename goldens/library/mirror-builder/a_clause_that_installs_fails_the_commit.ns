/// A superclass clause runs as program code between the preparation and
/// the commit, so it may install: the install it runs in then refuses its
/// commit with the epoch's diagnostic, and neither of that install's
/// builders' changes is visible, while the install the clause made stays.
/// An empty install in a clause installs nothing and leaves the commit
/// free.
class AClauseThatInstallsFailsTheCommit = Object new (
  |
    /// The mirrors, for the clauses.
    public mirrors ::= nil.
  |
) (
  class Holder = Object new () (
    public class Base = Object new () ()

    public class Other = Object new () ()

    public class Inner = Base new () ()

    public class Sibling = Object new () ()

    public installAnother = (
      |
        another = (ClassMirror reflecting: Other) mixin declaration asBuilder.
      |
      another instanceSide methods addFromSource: 'public added = ( ^#added )'.
      another install.
      ^Other.
    )

    public installNothing = (
      mirrors installAtomically: {}.
      ^Other.
    )
  )

  outcome: action = (
    ^[
      action value.
      'installed'.
    ] on: Error do: [:error | error messageText].
  )

  public ClassMirror = (
    ^mirrors ClassMirror.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      holder
      inner
      sibling
      empty
    |
    mirrors:: platform mirrors.
    holder:: Holder new.
    inner:: (ClassMirror reflecting: holder Inner) mixin declaration asBuilder.
    sibling:: (ClassMirror reflecting: holder Sibling) mixin declaration asBuilder.
    inner header source: 'public class Inner = installAnother new ()'.
    sibling instanceSide methods addFromSource: 'public staged = ( ^#staged )'.
    transcript
        show: (outcome: [mirrors installAtomically: {inner. sibling}]);
        newLine.
    transcript
        print: (ClassMirror reflecting: holder Inner) superclass reflectee == holder Base;
        show: ' ';
        show: (outcome: [holder Sibling new staged]);
        show: ' ';
        print: holder Other new added;
        newLine.
    empty:: (ClassMirror reflecting: holder Inner) mixin declaration asBuilder.
    empty header source: 'public class Inner = installNothing new ()'.
    transcript
        show: (outcome: [empty install]);
        show: ' ';
        print: (ClassMirror reflecting: holder Inner) superclass reflectee == holder Other;
        newLine.
  )
)
