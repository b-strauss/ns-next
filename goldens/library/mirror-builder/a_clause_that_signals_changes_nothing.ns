/// A new superclass clause is evaluated as program code before anything
/// is installed, and one that signals propagates its error out of
/// `install`: nothing is installed, so the class keeps its superclass and
/// an instance made before keeps answering its methods.
class AClauseThatSignalsChangesNothing = Object new () (
  class Holder = Object new () (
    public class Base = Object new () (
      public kind = (
        ^#base.
      )
    )

    public class Inner = Base new () ()

    failing = (
      ^Error signal: 'no superclass yet'.
    )
  )

  outcome: action = (
    ^[
      action value.
      'installed'.
    ] on: Error do: [:error | error messageText].
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      holder = Holder new.
      old = holder Inner new.
      builder = (ClassMirror reflecting: holder Inner) mixin declaration asBuilder.
    |
    builder header source: 'public class Inner = failing new ()'.
    transcript
        show: (outcome: [builder install]);
        newLine.
    transcript
        print: old kind;
        show: ' ';
        print: (ClassMirror reflecting: holder Inner) superclass reflectee == holder Base;
        newLine.
  )
)
