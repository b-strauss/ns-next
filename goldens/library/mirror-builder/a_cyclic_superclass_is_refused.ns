/// A new superclass clause that answers a class inheriting from the class
/// itself -- here its own subclass -- is refused before anything changes:
/// both classes keep their superclasses.
class ACyclicSuperclassIsRefused = Object new () (
  class Holder = Object new () (
    public class Base = Object new () (
      public kind = (
        ^#base.
      )
    )

    public class Inner = Base new () ()
  )

  outcome: action = (
    ^[
      action value.
      'installed'.
    ] on: Error do: [:error | error messageText].
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      holder = Holder new.
      old = holder Inner new.
      builder = (ClassMirror reflecting: holder Base) mixin declaration asBuilder.
    |
    builder header source: 'public class Base = Inner new ()'.
    transcript
        show: (outcome: [builder install]);
        newLine.
    transcript
        print: old kind;
        show: ' ';
        print: (ClassMirror reflecting: holder Inner) superclass reflectee == holder Base;
        show: ' ';
        show: (ClassMirror reflecting: holder Base) superclass name;
        newLine.
  )
)
