/// A new superclass clause that answers something other than a class is
/// refused, naming what it answered, and nothing is installed: so is a
/// `<:` clause whose receiver answers no class.
class AClauseAnsweringNoClassIsRefused = Object new () (
  class Holder = Object new () (
    public class Base = Object new () (
      public kind = (
        ^#base.
      )
    )

    public class Inner = Base new () ()

    three = (
      ^3.
    )
  )

  outcome: action = (
    ^[
      action value.
      'installed'.
    ] on: Error do: [:error | error messageText].
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      holder = Holder new.
      old = holder Inner new.
      first = (ClassMirror reflecting: holder Inner) mixin declaration asBuilder.
      second = (ClassMirror reflecting: holder Inner) mixin declaration asBuilder.
    |
    first header source: 'public class Inner = three new ()'.
    transcript
        show: (outcome: [first install]);
        newLine.
    second header source: 'public class Inner = Base new <: three ()'.
    transcript
        show: (outcome: [second install]);
        newLine.
    transcript
        print: old kind;
        show: ' ';
        print: (ClassMirror reflecting: holder Inner) superclass reflectee == holder Base;
        newLine.
  )
)
