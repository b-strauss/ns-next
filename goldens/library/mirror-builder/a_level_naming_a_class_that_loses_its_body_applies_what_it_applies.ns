/// A `<:` level applies the mixin of the class its clause named, so when
/// that class loses its body and becomes a mixin application of its own,
/// every level naming it applies what the class now applies, as a fresh
/// evaluation of the clause would: an instance made before the install
/// answers the applied mixin's methods, and its own slots, like a fresh
/// instance's, are kept.
class ALevelNamingAClassThatLosesItsBodyAppliesWhatItApplies = Object new () (
  class Holder = Object new () (
    public class Trait = Object new (
      |
        public mark ::= #initialized.
      |
    ) (
      public trait = (
        ^#trait.
      )
    )

    public class Inner = Object new () (
      public inner = (
        ^#inner.
      )
    )

    public class User = Object new <: Inner (
      |
        public own ::= 3.
      |
    ) ()
  )

  outcome: action = (
    ^[action value printString] on: Error do: [:error | error messageText].
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      ClassMirror = platform mirrors ClassMirror.
      holder = Holder new.
      old = holder User new.
      builder = (ClassMirror reflecting: Holder) mixin declaration asBuilder.
    |
    old own: 4.
    builder instanceSide nestedClasses addFromSource: 'public class Inner = Object new <: Trait.'.
    builder install.
    transcript
        show: (outcome: [old trait]);
        show: ' ';
        show: (outcome: [old inner]);
        show: ' ';
        show: (outcome: [old mark]);
        show: ' ';
        print: old own;
        newLine.
    transcript
        show: (outcome: [holder User new trait]);
        show: ' ';
        show: (outcome: [holder User new inner]);
        show: ' ';
        show: (outcome: [holder User new mark]);
        newLine.
    transcript
        show: (outcome: [Holder new User new trait]);
        show: ' ';
        show: (outcome: [Holder new User new inner]);
        show: ' ';
        show: (outcome: [Holder new User new mark]);
        newLine.
  )
)
