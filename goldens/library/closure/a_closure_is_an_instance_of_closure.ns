/// §5.1.8: a closure literal denotes a newly created instance of class
/// `Closure`, and a closure that is no number is described as one in an
/// error's text.
class AClosureIsAnInstanceOfClosure = Object new () (
  public main: platform args: arguments = (
    |
      transcript = platform transcript.
    |
    transcript
        show: [] isKindOfClosure printString;
        newLine.
    transcript
        show: [:each | each] isKindOfClosure printString;
        newLine.
    transcript
        show: ([3 + []] on: Error do: [:error | error messageText]);
        newLine.
  )
)
