/// newspeak-spec.pdf 3.1.1: an object is a value object if "its class
/// inherits from class Value", and a value is "globally unique, in the
/// sense that no other object is equal to it" -- so a user class below
/// `Value` gets its equality from its state, not from its identity: two
/// separately created points with equal coordinates are equal, are `==`,
/// and hash alike, which is what lets a value be copied across an actor
/// boundary and still stand for its original.
///
/// Each line prints `=`, then `==`, then whether the two hash alike. The
/// first two columns must always agree (3.1.1's condition on an identity
/// method), and the third must be true wherever the first is.
///
/// `other class` is the class check: `Pair` lays out the same two slots as
/// `Point` and holds the same numbers, so it hashes alike -- and is still
/// not equal, because equality of state is equality *within* one class.
/// The hash column there is informational; the contract says nothing about
/// how two unequal values hash.
///
/// The module is a value (`Object <: Value`) because §3.1.1 asks a value
/// class's enclosing object to be one; the transcript lives in `Script`,
/// which is no value.
class UserValueClass = Object <: Value () (
    public class Point x: anX y: aY = Value new (
        | public x = anX. public y = aY. |
    ) ()
    public class Pair x: anX y: aY = Value new (
        | public x = anX. public y = aY. |
    ) ()
    class Script on: aTranscript = Object new (
        | transcript = aTranscript. |
    ) (
        report: label for: first and: second = (
            transcript show: label; show: ' '; show: (first = second) printString;
                show: ' '; show: (first == second) printString;
                show: ' '; show: (first hash = second hash) printString; newLine
        )
        public run = (
            report: 'equal' for: (Point x: 1 y: 2) and: (Point x: 1 y: 2).
            report: 'different' for: (Point x: 1 y: 2) and: (Point x: 1 y: 3).
            report: 'other class' for: (Point x: 1 y: 2) and: (Pair x: 1 y: 2).
            report: 'nested' for: (Point x: (Point x: 1 y: 2) y: 'a')
                and: (Point x: (Point x: 1 y: 2) y: 'a').
        )
    )
    public main: platform args: arguments = (
        (Script on: platform transcript) run
    )
) : ()
