(* A future handed to `Future computing:` is forced at the call, not when
   the new future is: the row declines for it, since it is no closure, and
   its failure path sees through the future it was handed, forcing it and
   running the send again. Its value here is a block, so the new future is
   a future of that block. *)
class AFutureHandedToFutureComputingIsForcedAtTheCall = Object new (
    | ran ::= false. |
) (
    public main: platform args: arguments = (
        | transcript = platform transcript. Future = platform kernel Future. handed made |
        handed:: Future computing: [ran:: true. [6 * 7]].
        transcript show: ran printString; newLine.
        made:: Future computing: handed.
        transcript show: ran printString; newLine.
        transcript show: (made + 0) printString; newLine.
        transcript show: ran printString; newLine.
    )
) : ()
