/// `Future computing:` answers a future of its block: the block runs on the
/// future's first message, once, and the future then behaves as its value,
/// `==` both ways included. A computation that is no block is sent `value`.
/// A future forced while it is being computed is an error.
class FutureComputingDefersItsBlock = Object new (
  |
    count ::= 0.
    looping ::= nil.
  |
) (
  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      Future = platform kernel Future.
      future
    |
    future:: Future computing: [
      count:: count + 1.
      6 * 7.
    ].
    transcript
        show: count printString;
        newLine.
    transcript
        show: (future + 0) printString;
        newLine.
    transcript
        show: count printString;
        newLine.
    transcript
        show: (future == 42) printString;
        newLine.
    transcript
        show: (42 == future) printString;
        newLine.
    transcript
        show: (future identityHash = 42 identityHash) printString;
        newLine.
    transcript
        show: future isKindOfInteger printString;
        newLine.
    transcript
        show: count printString;
        newLine.
    transcript
        show: ((Future computing: [3]) + (Future computing: [4])) printString;
        newLine.
    transcript
        show: ([(Future computing: 5) + 1] on: Error do: [:error | error messageText]);
        newLine.
    looping:: Future computing: [looping + 1].
    transcript
        show: ([looping + 1] on: Error do: [:error | error messageText]);
        newLine.
  )
)
