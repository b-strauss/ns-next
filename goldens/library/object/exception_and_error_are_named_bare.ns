/// `Exception` and `Error` are accessors of `Object`, so any method names
/// them bare and gets the classes `platform kernel` answers. A nearer
/// declaration of the name still wins.
class ExceptionAndErrorAreNamedBare = () (
  class Shadowing = () (
    public Error = (
      ^'a nearer Error'.
    )

    public report = (
      ^Error.
    )
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      kernel = platform kernel.
    |
    transcript
        print: Error == kernel Error;
        show: ' ';
        print: Exception == kernel Exception;
        newLine.
    transcript
        show: ([Error signal: 'failed'] on: Exception do: [:error | error messageText]);
        newLine.
    transcript
        show: ([nil zork] on: kernel MessageNotUnderstood do: [:error | 'MessageNotUnderstood']);
        newLine.
    transcript
        show: Shadowing new report;
        newLine.
  )
)
