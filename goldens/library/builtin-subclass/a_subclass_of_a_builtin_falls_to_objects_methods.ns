/// A user subclass of a builtin inherits its kernel methods but none of its
/// payload, so each leaf those methods forward to declines, and the failure
/// block's `super` send reaches Object's method: `=` is identity and
/// `printString` the generic default, family by family. `size` is the
/// exception: Array's superclass is Collection, whose `size` counts through
/// `do:`, whose leaf declines in turn and whose failure block reaches
/// Collection's abstract `do:`.
///
/// The module is a value (`Object <: Value`) because §3.1.1 asks a value
/// class's enclosing object to be one; the transcript lives in `Script`,
/// which is no value. `MyArray` and `MyClosure` stay here, at module level,
/// and are no values themselves -- only a value class is asked about its
/// enclosing object.
class FallThrough = Object <: Value () (
    class MyBoolean = Boolean new () ()
    class MyInteger = Integer new () ()
    class MyFloat = Float new () ()
    class MySymbol = Symbol new () ()
    class MyArray = Array new () ()
    class MyClosure = Closure new () ()
    class Script on: aTranscript = Object new (
        | transcript = aTranscript. |
    ) (
        report: instance = (
            transcript show: (instance = instance) printString; show: ' '; show: instance printString; newLine
        )
        public run = (
            report: MyBoolean new.
            report: MyInteger new.
            report: MyFloat new.
            report: MySymbol new.
            report: MyArray new.
            report: MyClosure new.
            transcript show: MyArray new size printString; newLine
        )
    )
    public main: platform args: arguments = (
        (Script on: platform transcript) run
    )
) : ()
