(* The transcript's `show:` writes a string only; anything else is an
   ordinary Newspeak error, catchable like any other, where it used to be
   written as nothing at all (decided with the user on 2026-09-27). `print:`
   is the message that writes any object. *)
class ShowOfANumber = Object new () (
    public main: platform args: arguments = (
        | t |
        t:: platform transcript.
        t show: 'before'; newLine.
        t show: ([t show: 42. 'not reached'] on: Error do: [:error | error return: 'caught']); newLine.
        t show: 42
    )
) : ()
