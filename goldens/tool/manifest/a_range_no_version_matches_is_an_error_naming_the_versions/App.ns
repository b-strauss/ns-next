/// A range none of an id's versions lies in signals an Error naming the
/// versions there are, in ascending order, raised while the root is
/// instantiated, so main:args: never runs.
class App packageUsing: manifest = Object new (
  |
    private Util = manifest at: 'com.acme.util.Util' version: '3'.
  |
) (
  public main: platform args: arguments = (
    platform transcript
        show: 'unreachable';
        newLine.
  )
)
