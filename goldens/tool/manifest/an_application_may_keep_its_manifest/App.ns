/// The manifest is an ordinary object, so an application may keep it in a
/// slot and reach its modules later, from main:args:.
class App packageUsing: manifest = Object new (
  |
    private modules = manifest.
  |
) (
  public main: platform args: arguments = (
    platform transcript
        show: (modules at: 'Counter') new count printString;
        newLine.
  )
)
