/// Recursion through a method the optimizing compiler inlines, to the depth
/// limit: `down:` sends `step:`, small enough to be inlined into it, which
/// sends `down:` again. First a shallow recursion runs many times, so that
/// both bodies are optimized, each with the other inlined; then an
/// unbounded one, five times over, each overflow caught and the depth it
/// reached printed -- every inlined scope is an activation the depth limit
/// counts, so that the overflow is raised at the activation the
/// interpreter raises it at -- and once more uncaught, which ends the run
/// with the interpreter's error.
class InlinedRecursionOverflowsWhereTheInterpreterDoes = Object new (
  |
    limit ::= 10.
    deepest ::= 0.
  |
) (
  down: depth = (
    depth = limit ifTrue: [^0].
    deepest:: depth.
    ^1 + (self step: depth + 1).
  )

  step: depth = (
    ^self down: depth.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      total ::= 0.
    |
    1 to: 2000 do: [:index | total:: total + (self down: 0)].
    transcript
        show: total printString;
        newLine.
    limit:: -1.
    1 to: 5 do: [:index |
      deepest:: 0.
      [self down: 0] on: Error do: [:error | 0].
      transcript
          show: deepest printString;
          newLine.
    ].
    self down: 0.
    transcript
        show: 'unreachable';
        newLine.
  )
)
