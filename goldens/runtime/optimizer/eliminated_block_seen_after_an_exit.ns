/// Blocks an optimized copy eliminates, live where the copy's
/// speculation fails, made by the exit there and evaluated after.
///
/// `scale:by:` makes `[:each | each * factor]` and hands it to
/// `apply:to:`, which sums `values` before it evaluates the block twice;
/// `scale:by:` evaluates it once more itself. `sumScaled:by:times:` sends
/// `scale:by:` from the block it hands `to:do:`, and that block's copy
/// inlines `scale:by:`, `apply:to:` and `sumOf:`, whose `to:do:` and block
/// it inlines too, so that both blocks are eliminated. For 30000 turns
/// `values` holds SmallIntegers, whose addition the copy takes for
/// granted, then Floats: the first Float fails that speculation inside
/// `sumOf:`'s inlined block, where the scaling block lies in
/// `scale:by:`'s local and in `apply:to:`'s parameter, so that the exit
/// makes it, one closure over `scale:by:`'s activation, and the
/// interpreter evaluates it from there. `{1. 2. 3}` scaled by 2 answers 6
/// * 2 + 1 * 2 + 0, so 14, and 30000 times 420000; `{1.5. 2.5. 3.0}` by
/// 2, 16.0; `{1. 2. 3}` by 3, 21.
///
/// `countOf:` hands `values do:` a block that counts, which the copy
/// eliminates where it inlines `Triple`'s `do:` for the 30000 Triples it
/// is handed: then a `Quadruple`, which no arm of the type-case takes, so
/// that the send is run again by the interpreter with the block, made by
/// the exit, as its argument. 30000 Triples count 90000, and the
/// Quadruple 4.
class EliminatedBlockSeenAfterAnExit = Object new () (
  class Triple = Object new () (
    public do: action = (
      action value: 1.
      action value: 2.
      action value: 3.
    )
  )

  class Quadruple = Object new () (
    public do: action = (
      action value: 1.
      action value: 2.
      action value: 3.
      action value: 4.
    )
  )

  sumOf: values = (
    |
      total ::= 0.
    |
    1 to: values size do: [:index | total:: total + (values at: index)].
    ^total.
  )

  apply: action to: values = (
    |
      sum = self sumOf: values.
    |
    ^(action value: sum) + (action value: 1).
  )

  scale: values by: factor = (
    |
      block = [:each | each * factor].
    |
    ^(self apply: block to: values) + (block value: 0).
  )

  sumScaled: values by: factor times: count = (
    |
      total ::= 0.
    |
    1 to: count do: [:index | total:: total + (self scale: values by: factor)].
    ^total.
  )

  countOf: values = (
    |
      count ::= 0.
    |
    values do: [:each | count:: count + 1].
    ^count.
  )

  countOf: values times: count = (
    |
      counted ::= 0.
    |
    1 to: count do: [:index | counted:: counted + (self countOf: values)].
    ^counted.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      small = {1. 2. 3}.
      floats = {1.5. 2.5. 3.0}.
    |
    transcript
        show: (self sumScaled: small by: 2 times: 30000) printString;
        newLine.
    transcript
        show: (self sumScaled: floats by: 2 times: 1) printString;
        newLine.
    transcript
        show: (self sumScaled: small by: 3 times: 1) printString;
        newLine.
    transcript
        show: (self countOf: Triple new times: 30000) printString;
        newLine.
    transcript
        show: (self countOf: Quadruple new times: 1) printString;
        newLine.
  )
)
