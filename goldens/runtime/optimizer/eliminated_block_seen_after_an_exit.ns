/// Blocks the optimized copies eliminate, made by an exit that finds them
/// live -- the deopt stress mode's, at any interrupt point -- and
/// evaluated after, and blocks the copies create.
///
/// `scale:by:` makes `[:each | each * factor]` and hands it to
/// `apply:to:`, which sums `values` before it evaluates the block twice;
/// `scale:by:` evaluates it once more itself, so that a copy inlining
/// both eliminates it. For 30000 sends `values` holds SmallIntegers, whose
/// addition the optimized code takes for granted, then Floats, which fail
/// that speculation in `sumOf:`. No copy inlines `sumOf:`: the block it
/// hands an Array's `do:` escapes through `do:`'s way for a receiver
/// whose size the mirror cannot read, so that its scope would create it
/// and leave the copy at every send. `{1. 2. 3}` scaled by 2 answers 6 *
/// 2 + 1 * 2 + 0, so 14, and 30000 times 420000; `{1.5. 2.5. 3.0}` by 2,
/// 16.0; `{1. 2. 3}` by 3, 21.
///
/// `countOf:` hands `values do:` a block that counts, for the Arrays
/// 30000 sends hand it, then a List, which no arm of an inlined `do:`
/// takes, so that the send is run with the block as its argument. 30000
/// Arrays of 3 count 90000, and the List of 4, 4.
class EliminatedBlockSeenAfterAnExit = Object new () (
  sumOf: values = (
    |
      total ::= 0.
    |
    values do: [:each | total:: total + each].
    ^total.
  )

  apply: action to: values = (
    |
      sum = self sumOf: values.
    |
    ^(action value: sum) + (action value: 1).
  )

  scale: values by: factor = (
    |
      block = [:each | each * factor].
    |
    ^(self apply: block to: values) + (block value: 0).
  )

  countOf: values = (
    |
      count ::= 0.
    |
    values do: [:each | count:: count + 1].
    ^count.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      small = {1. 2. 3}.
      floats = {1.5. 2.5. 3.0}.
      total ::= 0.
      counted ::= 0.
    |
    1 to: 30000 do: [:index | total:: total + (self scale: small by: 2)].
    transcript
        show: total printString;
        newLine.
    transcript
        show: (self scale: floats by: 2) printString;
        newLine.
    transcript
        show: (self scale: small by: 3) printString;
        newLine.
    1 to: 30000 do: [:index | counted:: counted + (self countOf: small)].
    transcript
        show: counted printString;
        newLine.
    transcript
        show: (self countOf: (platform collections List withAll: {1. 2. 3. 4})) printString;
        newLine.
  )
)
