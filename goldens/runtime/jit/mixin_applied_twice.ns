/// A mixin applied twice in one chain, its method's `super` send and
/// `outer` send run from compiled code at both of its levels, through
/// their sites' cells (`docs/design/execution.md`, "Sends in machine
/// code"). Every method loops once before it does anything else, so that
/// its body is compiled at its second entry.
///
/// Twice is Base new <: Marker <: Middle <: Marker: newspeak-spec.pdf 6.2
/// makes each application a class with its mixin and the class to its
/// left as superclass, so the upper Marker level's superclass is the
/// Middle level and the lower one's is Base. One compiled body of
/// Marker's step: runs at both, and 5.10 starts its `super step:` at the
/// superclass of the activation's current class: from the upper level
/// it reaches Middle's step:, from the lower one Base's -- one site, two
/// superclasses. Its `bonus` is an implicit receiver send at depth 1,
/// which 5.9 sends to Marker's enclosing object, the module, at both
/// levels, since 6.2 makes the enclosing object of each application
/// Marker's. So Base answers value + 1, the lower Marker twice that plus
/// 3, Middle that plus 1000, and the upper Marker twice that plus 3:
/// 4 value + 2013, over the values 0 to 999 the sum 4011000. The lower
/// level's step: alone, through Middle's `super`, answers
/// 2 value + 5, over the same values 1004000.
class MixinAppliedTwice = Object new () (
  class Base = Object new () (
    public step: value = (
      |
        index ::= 0.
      |
      [index < 1] whileTrue: [index:: index + 1].
      ^value + 1.
    )
  )

  class Marker = Object new () (
    public step: value = (
      |
        index ::= 0.
      |
      [index < 1] whileTrue: [index:: index + 1].
      ^(super step: value) * 2 + bonus.
    )
  )

  class Middle = Object new () (
    public step: value = (
      |
        index ::= 0.
      |
      [index < 1] whileTrue: [index:: index + 1].
      ^(super step: value) + 1000.
    )

    public below: value = (
      |
        index ::= 0.
      |
      [index < 1] whileTrue: [index:: index + 1].
      ^super step: value.
    )
  )

  class Twice = Base new <: Marker <: Middle <: Marker () ()

  bonus = (
    |
      index ::= 0.
    |
    [index < 1] whileTrue: [index:: index + 1].
    ^3.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      twice = Twice new.
    |
    1 to: 2 do: [:round |
      |
        sum ::= 0.
        lower ::= 0.
      |
      0 to: 999 do: [:value |
        sum:: sum + (twice step: value).
        lower:: lower + (twice below: value).
      ].
      transcript
          show: sum printString;
          newLine.
      transcript
          show: lower printString;
          newLine.
    ].
  )
)
