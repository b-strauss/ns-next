/// Closures activated by compiled sends: `round:` runs once a round, so
/// that its body and its blocks are compiled at their second entry, and
/// the later rounds call each block through the closure stubs, as a
/// method is called (`docs/design/execution.md`, "Stage 4: closures,
/// non-local return, allocation and the barrier"): `value` to
/// `value:value:value:`, whose arity the stub checks;
/// `value:value:value:value:`, which no closure understands; `cull:`,
/// `ifNotNil:` and its two relatives of two arguments, which hand a block
/// of no parameter nothing and one of one parameter the receiver;
/// `ifTrue:`, `ifFalse:`, `ifTrue:ifFalse:`, `and:` and `or:` sent blocks
/// held in locals, which no lowering inlines and a closure stub shifts
/// past the slots they take no argument from; `ifTrue:` sent a value
/// that is no block, which the method sends `value`; a block of the wrong
/// arity, whose error the interpreter raises; and blocks reading copied
/// values.
class ClosureCalls = Object new () (
  /// Answers `action`'s value, or the message text of the Error it
  /// signals.
  guarded: action = (
    ^action on: Error do: [:error | error messageText].
  )

  /// Answers one line of what the blocks of round `index` answer.
  round: index = (
    |
      base = index * 10.
      none = [base].
      one = [:first | first + base].
      two = [:first :second | first + second + base].
      three = [:first :second :third | first + second + third + base].
      copies = [base + index + 1].
      even = index \\ 2 = 0.
      truth = [index > 1].
    |
    ^{
      none value.
      one value: 1.
      two value: 1 value: 2.
      three value: 1 value: 2 value: 3.
      self guarded: [three value: 1 value: 2 value: 3 value: 4].
      self guarded: [one value].
      self guarded: [two value: 1].
      one cull: 5.
      none cull: 5.
      index ifNotNil: one.
      index ifNotNil: none.
      even ifTrue: none.
      even ifTrue: copies ifFalse: none.
      self guarded: [even ifTrue: 7].
      copies value.
      even ifFalse: copies.
      even and: truth.
      even or: truth.
      index ifNil: none ifNotNil: one.
      index ifNotNil: none ifNil: one.
      index ifNil: one ifNotNil: none.
    }.
  )

  public main: platform args: arguments = (
    |
      transcript = platform transcript.
      index ::= 0.
    |
    [index < 4] whileTrue: [
      transcript show: 'round ' , index printString , ':'.
      (self round: index) do: [:each |
        transcript
            show: ' ';
            show: each printString.
      ].
      transcript newLine.
      index:: index + 1.
    ].
  )
)
