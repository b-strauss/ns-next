(* A handler for the depth limit runs in the reserve above it; one that
   recurses itself overruns the reserve too, and that ends the run
   unsignalled: the outer `on: Error do:` never runs, while the pending
   `ensure:` block does, as for any run that ends. *)
class AHandlerOverrunningTheReserveEndsTheRun = Object new (
    
) (
    recurse = ( ^self recurse )
    public main: platform args: arguments = (
        | transcript = platform transcript. |
        transcript show: 'start'; newLine.
        [[[self recurse]
            on: Error do: [:e | transcript show: e messageText; newLine. self recurse]]
                on: Error do: [:e | transcript show: 'caught outside'; newLine]]
                    ensure: [transcript show: 'ensured'; newLine].
        transcript show: 'not reached'; newLine.
    )
) : ()
