Newspeak3
'Test'
(* An error raised just below the depth limit, or at it, is signalled as
   itself: its `signal` needs activations of its own, which the reserve
   above the limit gives it, so it is not mistaken for the limit.
   `descend:to:` reaches the depth `probe:` measured, level for level, and
   fails there, three levels below the last, one below it and at it. *)
class AnErrorJustBelowTheDepthLimitIsCaught = Object new (
    |
      deepest ::= 0. |
) (
    probe: n = ( deepest:: n. ^self probe: n + 1 )
    descend: n to: bottom = (
        n = bottom ifTrue: [^{1} at: 5].
        ^self descend: n + 1 to: bottom
    )
    public main: platform args: arguments = (
        | transcript = platform transcript. Error = platform kernel Error. |
        transcript show: ([self probe: 1] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self descend: 1 to: deepest - 3] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self descend: 1 to: deepest - 1] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self descend: 1 to: deepest] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self descend: 1 to: deepest + 1] on: Error do: [:e | e messageText]); newLine.
    )
) : ()
