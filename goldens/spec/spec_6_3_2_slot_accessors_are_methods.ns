Newspeak3
'Test'
(* newspeak-spec.pdf 6.3.2: "Access to the value of a mutable slot is via a
   getter method ... a mutable slot may be set exclusively by a invoking a
   setter method ... The setter method is implicitly defined by the slot
   declaration. It sets the value of the slot to be the incoming argument.
   It returns the receiver of the message." And: "The initialization
   itself is not accomplished by the setter method. Consequently,
   overriding a setter will not impact such an initialization". 2.3:
   "Methods are always virtual (i.e., subject to override)".

   So Child's x and x: override the accessors Base's slot defines: Base's
   readX and writeX: reach them, while creating a Child initializes x
   without running Child's x:. *)
class Spec632SlotAccessorsAreMethods = Object new () (
    class Base = Object new (| public x ::= 1. |) (
        public readX = ( ^x )
        public writeX: value = ( ^x: value )
    )
    class Child = Base new (| public log ::= 'no setter ran'. |) (
        public x = ( ^42 )
        public x: value = ( log:: 'the overriding setter ran'. ^self )
    )
    public main: platform args: args = (
        | t = platform transcript. base child |
        child:: Child new.
        t show: child log; newLine.
        t show: child readX printString; newLine.
        t show: ((child writeX: 5) == child) printString; newLine.
        t show: child log; newLine.
        base:: Base new.
        t show: ((base writeX: 5) == base) printString; newLine.
        t show: base readX printString; newLine.
    )
) : ()
