Newspeak3
'Test'
(* newspeak-spec.pdf 6.2: "The result of a mixin application expression is
   a class I with mixin M and superclass S", where S is the class the
   superclass clause denotes and M is the mixin of the class the
   inheritance clause after <: specifies. So Combined answers Trait's own
   method and inherits Base's.

   The parser does not accept <: in a superclass clause
   (docs/design/frontend.md, "Deviation: mixin application is not
   implemented"), so this does not parse today. Skipped until it does; it
   fails loudly rather than answering wrongly, which is why the deviation
   is the least dangerous of the recorded ones. *)
class Spec62MixinApplication usingPlatform: p = Object new (| t = p transcript. |) (
    class Base = Object new () (
        public inherited = ( ^'from the superclass' )
    ) : ()
    class Trait = Object new () (
        public own = ( ^'from the mixin' )
    ) : ()
    class Combined = Base new <: Trait new.
    public main: platform args: arguments = (
        t show: Combined new own; newLine.
        t show: Combined new inherited; newLine
    )
) : ()
