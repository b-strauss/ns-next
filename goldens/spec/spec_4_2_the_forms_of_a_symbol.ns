Newspeak3
'Test'
(* newspeak-spec.pdf 4.2: symbol is pound sym, and sym is str | kws | binSel
   | id -- a quoted string, keywords each ending in their colon, a binary
   selector, or an identifier. *)
class Spec42TheFormsOfASymbol usingPlatform: p = Object new (| t = p transcript. |) (
    public main: platform args: arguments = (
        t show: #name printString; newLine.
        t show: #at:put: printString; newLine.
        t show: #-> printString; newLine.
        t show: #'two words' printString; newLine.
        t show: (#at:put: == #at:put:) printString; newLine
    )
) : ()
