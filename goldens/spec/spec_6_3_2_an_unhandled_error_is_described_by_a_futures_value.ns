Newspeak3
'Test'
(* An unhandled error's description reaches the leaf that ends the run,
   which renders it: here it is `text`'s future, since `Error`'s
   `description` answers its message text, and the run must report the
   text it stands for (docs/design/object-model.md, "Where Rust sees a
   future"). *)
class Spec632AnUnhandledErrorDescribedByAFuture usingPlatform: p = Object new (| private Error = p kernel Error. |) (
    class Probe = Object new (|| public failed = Error signal: text. public text = 'boom'. ||) () : ()
    public main: platform args: arguments = (
        Probe new
    )
) : ()
