Newspeak3
'Test'
(* newspeak-spec.pdf 4.1 reserves self, super, outer, true, false and nil and
   nothing else, so class, public, protected, private and lazy are ordinary
   identifiers. 6.3.2's slotDef, [accessModifier] slotDecl, is a PEG (4.2):
   an access modifier's word standing first is taken as the modifier, so it
   names a slot only behind a modifier, while class and lazy need none. Each
   slot answers its getter and its setter, sent to self and to an explicit
   receiver, like any other; the one named class answers #class in place of
   the inherited method. *)
class Spec41TheUnreservedWordsNameSlots usingPlatform: p = Object new (| t = p transcript. |) (
    class Holder = Object new (|
        public public ::= 'a'.
        public protected ::= 'b'.
        public private ::= 'c'.
        public lazy ::= 'd'.
        public class ::= 'e'.
    |) (
        public all = ( ^public, protected, private, lazy, class )
        public renameAll = (
            public:: 'A'.
            protected:: 'B'.
            private:: 'C'.
            lazy:: 'D'.
            class:: 'E'
        )
    ) : ()
    public main: platform args: arguments = (
        | holder |
        holder:: Holder new.
        t show: holder all; newLine.
        t show: holder public, holder protected, holder private, holder lazy, holder class; newLine.
        holder renameAll.
        t show: holder all; newLine.
        holder public: '1'; protected: '2'; private: '3'; lazy: '4'.
        t show: holder all; newLine
    )
) : ()
