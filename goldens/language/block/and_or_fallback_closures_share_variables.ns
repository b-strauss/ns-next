/// fallback_closures_share_variables.ns for and: and or:. The compiler
/// inlines both, and both keep a run-time guard whose failure path sends
/// the real message with a real closure; that closure keeps the
/// by-reference model (docs/design/execution.md, "Fallback blocks").
///
/// andWritesAfterCapture: a real block captured x before the and:, and an
/// inlinable branch assigns it, so rule 4 puts x in the method's vector
/// however early the write stands. The receiver is not a Boolean, so the
/// closure is kept rather than run; runKept then writes the vector slot,
/// and the reader -- which shares that vector -- answers 2.
/// orReadsLater: nothing captures x by a real block, so x stays in a
/// register and the kept closure reads that register. The method writes 5
/// after making the closure, so running it answers 5.
class AndOrFallbackClosuresShareVariables = Object new (
    
) (
    class Keeper = Object new (
        | kept ::= nil. |
    ) (
        public and: block = ( kept:: block. ^nil )
        public or: block = ( kept:: block. ^nil )
        public runKept = ( ^kept value )
    ) : ()
    andWritesAfterCapture: keeper = (
        | x ::= 1. reader ::= nil. |
        reader:: [x].
        keeper and: [x:: 2].
        keeper runKept.
        ^reader value
    )
    orReadsLater: keeper = (
        | x ::= 1. |
        keeper or: [x].
        x:: 5.
        ^keeper runKept
    )
    public main: platform args: arguments = (
        | transcript = platform transcript. |
        transcript show: (self andWritesAfterCapture: Keeper new) printString; newLine.
        transcript show: (self orReadsLater: Keeper new) printString; newLine
    )
) : ()
