/// newspeak-spec.pdf 5.4.4: a cascade "has the form e m0; ... mn where mi,
/// i in 0..n are message clauses and e is an expression. It is equivalent
/// to `[:p | p m0. ... p mn] value:(e)`." A message clause (5.4.2) is one
/// unary, binary or keyword clause, so e absorbs everything up to the last
/// clause ahead of the first semicolon -- here `self inner`, not the
/// primary `self`.
///
/// Read against 5.4.4's own grammar the sentence is ambiguous:
/// `cascadedMessageExpression = primary [msgCascade]` with
/// `msgCascade = nonEmptyMessages cascadeMsg*`, where `nonEmptyMessages`
/// may itself be a whole keyword clause, so e would be the primary. The
/// prose reading is the one canonical Newspeak implements:
/// corpus/modules/NewspeakASTs.ns's CascadedSendAST>>receiver
/// is `^self previousSend receiver`, the receiver of the immediately
/// preceding send. It is also the reading every cascade in this repository
/// depends on -- under the other one `transcript show: 'x'; newLine` would
/// send newLine to the platform.
///
/// The enclosing class declares its own mark:, so the other reading gives
/// [receiver once][inner one][outer two][outer three] rather than an error.
/// The trace also shows e evaluated exactly once, which the equivalence
/// requires: value: takes one argument.
class Spec544CascadeReceiver = Object new (| trace ::= ''. |) (
    class Inner on: owner = Object new (| owner = owner. |) (
        public mark: label = ( owner note: 'inner ', label )
    ) : ()
    public note: label = ( trace:: trace, '[', label, ']' )
    inner = ( note: 'receiver once'. ^Inner on: self )
    public mark: label = ( note: 'outer ', label )
    public main: platform args: arguments = (
        | t = platform transcript. |
        self inner mark: 'one'; mark: 'two'; mark: 'three'.
        t show: trace; newLine.
    )
) : ()
