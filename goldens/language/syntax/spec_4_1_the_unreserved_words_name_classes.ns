(* newspeak-spec.pdf 4.1 reserves only self, super, outer, true, false and
   nil, so class, public, protected, private and lazy name a nested class
   (6's classDeclaration takes an identifier after the class token) and are
   sent as a superclass clause's receiver like any other name (6.1's
   inheritanceClause); outer public names the enclosing class public (6.1's
   outerReceiver, an outer token and an identifier). public class = ( ... )
   stays a method named class, since no identifier follows the class
   token. *)
class Spec41TheUnreservedWordsNameClasses = Object new () (
    class Names = Object new () (
        class public = Object new () (
            public class Inner = Object new () (
                public outerName = ( ^outer public name )
            ) : ()
            public name = ( ^'public' )
        ) : ()
        class protected = public new () ( public name = ( ^super name, ' protected' ) ) : ()
        class private = protected new () ( public name = ( ^super name, ' private' ) ) : ()
        class lazy = private new () ( public name = ( ^super name, ' lazy' ) ) : ()
        public class class = lazy new () ( public name = ( ^super name, ' class' ) ) : ()
        public all = ( ^public new name, ', ', class new name, ', ', public new Inner new outerName )
    ) : ()
    class Holder = Object new () (
        public class = ( ^'a method named class' )
    ) : ()
    public main: platform args: arguments = (
        | t = platform transcript. |
        t show: Names new all; newLine.
        t show: Holder new class; newLine
    )
) : ()
