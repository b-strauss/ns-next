/// newspeak-spec.pdf 5.4.4: cascadeMsg is semicolon (keywordMsg | binaryMsg |
/// unarySelector), and binaryMsg takes any binarySelector -- "=", "<" and
/// ">", which have tokens of their own for the declaration syntax, among
/// them. Each part goes to the last message's receiver, and the cascade
/// answers what its last part answers.
class Spec544ACascadeTakesEveryBinarySelector = Object new () (
  public main: platform args: arguments = (
    |
      t = platform transcript.
    |
    t
        show: (3
            printString;
            = 3)
            printString;
        newLine.
    t
        show: (3
            + 1;
            < 4)
            printString;
        newLine.
    t
        show: (3
            + 1;
            > 4)
            printString;
        newLine.
    t
        show: ({7. 8}
            size;
            at: 2)
            printString;
        newLine.
  )
)
