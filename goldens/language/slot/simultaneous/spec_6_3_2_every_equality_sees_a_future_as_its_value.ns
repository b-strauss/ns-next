/// newspeak-spec.pdf 6.3.2's futures are indistinguishable from their
/// values (5.5's proxy; docs/design/object-model.md, "Where Rust sees a
/// future"), so every equality leaf that answers false to an operand of
/// another kind answers for the value a future stands for: Float's `=`,
/// a value object's `=`, and the handler class `on:do:` tests an error
/// against, each met while the sibling is still its future.
class Spec632EveryEqualitySeesAFuture = Object <: Value (
) (
    class Pair first: a second: b = Value new (| public first = a. public second = b. |) () : ()
    class Probe = Object new (||
        public checks = {1.5 = float. (Pair first: 1 second: 2) = pair. caught}.
        public caught = [Error signal: 'boom'. 'not caught'] on: errorClass do: [:error | 'caught'].
        public float = 1.5.
        public pair = Pair first: 1 second: 2.
        public errorClass = Error. ||) () : ()
    public main: platform args: arguments = (
        | t = platform transcript. |
        Probe new checks do: [:each | t show: each printString; newLine]
    )
) : ()
