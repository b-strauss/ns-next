/// newspeak-spec.pdf 5.8: "A self send consists of the reserved word self
/// (5.2), enclosed in zero or more pairs of parentheses, followed by a
/// message clause" -- and "the solution is to recognize the parenthesized
/// form as a self send as well". A self send is outer C m, so (self)
/// secret reaches Holder's protected secret.
class Spec58ParenthesizedSelfIsASelfSend = Object new () (
  class Holder = Object new () (
    protected secret = (
      ^5.
    )

    public viaParenthesizedSelf = (
      ^(self) secret.
    )
  )

  public main: platform args: args = (
    |
      t = platform transcript.
    |
    t
        show: Holder new viaParenthesizedSelf printString;
        newLine.
  )
)
