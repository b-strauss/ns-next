Newspeak3
'Test'
class WhileLoop usingPlatform: platform = Object new (
	| n ::= 0. sum ::= 0. |
) (
	public main: p args: a = (
		[n < 5] whileTrue: [sum := sum + n. n := n + 1].
		[n = 0] whileFalse: [n := n - 1].
		p transcript show: sum printString; show: ' '; show: n printString; newLine
	)
) : ()
