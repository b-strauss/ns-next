(* The VM mirror is a capability that reaches the core library alone, so
   `Object` provides no accessor for its class among its "accessors for
   predefined classes" (newspeak-spec.pdf 3.2). A bare `VmMirror` is, by
   5.7, `self VmMirror`, which finds nothing on the receiver's inheritance
   chain (2.3.1) and is an ordinary `doesNotUnderstand:`. *)
class MirrorsClassIsNotAName = Object new () (
    public main: platform args: arguments = (
        platform transcript show: VmMirror printString; newLine
    )
) : ()
