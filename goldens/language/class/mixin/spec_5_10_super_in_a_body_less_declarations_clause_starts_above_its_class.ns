/// newspeak-spec.pdf 5.10: a super send starts at "the superclass of C",
/// C the current class of the activation, which 3.6 makes the class
/// defining the running code. A declaration without a body "is a class I
/// with mixin M and superclass S" (6.2), and its clause messages and
/// arguments are evaluated by I's own initializer: their current class is
/// I, the declaration's class object, so their super starts at I's
/// superclass, Base, and passes over M1. A body version's class is a
/// level of its own below the one its clause added, so its super finds
/// M1.
///
/// Each line runs three times, so a cached send answers as the first did:
///
/// 1. `tag: super foo`: Base's foo.
/// 2. `tag: [super foo] value`: the same from a block.
/// 3. `tag: super a printString`: Base has no `a` and M1's slot accessor
///    is passed over, so the send is not understood: Base's
///    doesNotUnderstand: signals, and the instantiation fails.
/// 4. M1's own `^super foo` on the same instances: Base's foo.
/// 5. The body version of line 1: M1's foo.
class Spec510SuperInABodyLessDeclarationsClauseStartsAboveItsClass = Object new () (
  class Base = Object new () (
    public foo = (
      ^'Base foo'.
    )
  )

  class M1 tag: t = Object new (
    |
      public a = t.
    |
  ) (
    public foo = (
      ^'M1 foo'.
    )

    public superFoo = (
      ^super foo.
    )
  )

  class Direct = Base new <: M1 tag: super foo.

  class InBlock = Base new <: M1 tag: [super foo] value.

  class Slot = Base new <: M1 tag: super a printString.

  class WithBody = Base new <: M1 tag: super foo () ()

  public main: platform args: arguments = (
    |
      t = platform transcript.
    |
    1 to: 3 do: [:each |
      t
          show: Direct new a;
          show: ', ';
          show: InBlock new a;
          show: ', ';
          show: ([Slot new a] on: Error do: [:error | error messageText]);
          show: ', ';
          show: Direct new superFoo;
          show: ', ';
          show: InBlock new superFoo;
          show: ', ';
          show: WithBody new a;
          newLine.
    ].
  )
)
