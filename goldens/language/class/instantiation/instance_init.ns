class InstanceInit = Object new (
  |
    greeting ::= 'hi'.
    count ::= 0.
    initialized ::= false.
  |
  count:: greeting size.
  initialized:: true.
) (
  public main: p args: a = (
    |
      out = p transcript.
    |
    initialized ifTrue: [
      out
          show: 'init ran';
          newLine.
    ].
    out
        show: greeting;
        show: ' ';
        show: count printString;
        newLine.
  )
)
