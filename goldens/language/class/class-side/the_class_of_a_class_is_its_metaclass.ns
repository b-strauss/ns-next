/// newspeak-spec.pdf 3.2: "Each class is an instance of a unique metaclass".
/// So a class's class is its metaclass, one per class and none of them the
/// class itself.
class TheClassOfAClass = Object new () (
  class Foo = Object new () () : (
    /// Answers Foo's metaclass, which only Foo's class side can ask for.
    public metaclass = (
      ^self class.
    )
  )

  class Bar = Object new () () : (
    /// Answers Bar's metaclass, which only Bar's class side can ask for.
    public metaclass = (
      ^self class.
    )
  )

  public main: platform args: args = (
    |
      transcript = platform transcript.
    |
    transcript
        show: (Foo metaclass == Foo metaclass) printString;
        newLine.
    transcript
        show: (Foo metaclass == Bar metaclass) printString;
        newLine.
    transcript
        show: (Foo metaclass == Foo) printString;
        newLine.
  )
)
