/// newspeak-spec.pdf §5.5: "the #doesNotUnderstand: method defined for
/// (3.5) the class of o is invoked" -- a class object's class is its
/// metaclass (§3.2), so a class side that declares `doesNotUnderstand:`
/// answers every unhandled send its class object gets, explicit-receiver,
/// implicit-receiver and keyword alike, while `new` still finds the
/// inherited factory and instantiates normally.
class AClassSideDoesNotUnderstandHandlesItsClassObjectsSends = Object new () (
    class Foo = Object new () (
    ) : (
        protected doesNotUnderstand: message = ( ^'caught ', message selector printString )
        public tryImplicit = ( ^zap )
    )
    public main: platform args: args = (
        | transcript = platform transcript. |
        transcript show: Foo bar; newLine.
        transcript show: Foo tryImplicit; newLine.
        transcript show: (Foo zork: 1 with: 2); newLine.
        transcript show: Foo new printString; newLine.
    )
) : ()
