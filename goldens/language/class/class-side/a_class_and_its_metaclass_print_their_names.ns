/// A class prints as its name and a metaclass as its class's name followed
/// by ` class`, as Primordial Soup's `Class>>printString` and
/// `Metaclass>>printString` do.
class AClassAndItsMetaclassPrint = Object new () (
  class Foo = Object new () () : (
    /// Answers Foo's metaclass, which only Foo's class side can ask for.
    public metaclass = (
      ^self class.
    )
  )

  public main: platform args: args = (
    |
      transcript = platform transcript.
    |
    transcript
        show: Foo printString;
        newLine.
    transcript
        show: Foo metaclass printString;
        newLine.
    transcript
        show: Foo new printString;
        newLine.
  )
)
