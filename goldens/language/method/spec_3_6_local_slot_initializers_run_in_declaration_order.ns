(* newspeak-spec.pdf 3.6: an activation has "zero or more local slots, one
   for each slot declaration in the body of p. Local slots are defined by
   their corresponding declarations (6.3.2). They are initialized in the
   context of a, according to their declarations." So each initializer runs
   when its activation starts, in declaration order, and sees the slots
   declared before it; a slot with no initializer stays nil (6.3.2), checked
   here by identity (third == nil) rather than printString, since nil's own
   printString is unrelated to this rule; a block's local slots are
   initialized per block activation, from its parameters; and a block whose
   body declares slots but has no statement still answers nil, checked the
   same way. The class-level counterpart, a slot initializer, is what the
   instance initializer already does. *)
class Spec36LocalSlotInitializersRunInDeclarationOrder = Object new () (
    public main: platform args: arguments = (
        | t = platform transcript. first = 3. second ::= first + 4. third |
        t show: first printString; newLine.
        t show: second printString; newLine.
        t show: (third == nil) printString; newLine.
        [:argument | | doubled = argument * 2. | t show: doubled printString; newLine] value: 5.
        t show: ([| only = 1. |] value == nil) printString; newLine.
    )
) : ()
