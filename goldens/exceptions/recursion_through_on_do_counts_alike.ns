Newspeak3
'Test'
(* `on:do:` is an ordinary kernel method, so a recursion through it counts
   its activations as any other (docs/design/compiler.md, "How the limit
   counts"): each level of `down:` is three counted activations -- the
   method, `on:do:` and its protected block -- as each level of `a:` is
   three methods. Both start from the same depth, so both reach the limit at
   the same level, under either lowering, and the innermost `on:do:` catches
   the limit it reached. Their difference, not the level itself, is
   printed, so that the limit's value is in no recorded answer. *)
class RecursionThroughOnDoCountsAlike usingPlatform: thePlatform = Object new (
    | transcript = thePlatform transcript.
      private Error = thePlatform kernel Error.
      plainLevel ::= 0.
      handlerLevel ::= 0. |
) (
    a: n = ( plainLevel:: n. ^self b: n )
    b: n = ( ^self c: n )
    c: n = ( ^self a: n + 1 )
    down: n = (
        handlerLevel:: n.
        ^[self down: n + 1] on: Error do: [:e | e messageText]
    )
    public main: platform args: arguments = (
        transcript show: ([self a: 1] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self down: 1] on: Error do: [:e | 'not the innermost']); newLine.
        transcript show: (plainLevel - handlerLevel) printString; newLine.
        transcript show: (plainLevel > 1000) printString; newLine.
    )
) : ()
