Newspeak3
'Test'
(* `halt` signals a `Halt`, which is resumable: handled with `resume:`, the
   value answers from `halt` and execution carries on after it. Unhandled,
   its `defaultAction` -- the hook the debugger will replace -- ends the
   run, reporting the class name, since it has no text. *)
class HaltResumesWhenHandledAndEndsTheRunWhenNot usingPlatform: thePlatform = Object new (
    | transcript = thePlatform transcript.
      private Halt = thePlatform kernel Halt. |
) (
    public main: platform args: arguments = (
        transcript show: ([self halt. 3] on: Halt do: [:e | e resume: 7]) printString; newLine.
        transcript show: ([self halt] on: Halt do: [:e | e resume: 7]) printString; newLine.
        self halt.
        transcript show: 'not reached'; newLine.
    )
) : ()
