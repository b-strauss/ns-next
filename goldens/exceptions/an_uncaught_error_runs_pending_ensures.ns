Newspeak3
'Test'
(* An error nothing handles ends the run through `defaultAction`, which
   terminates it: every pending `ensure:` block runs, innermost first, on
   the way to the bottom of the stack, and the host then reports the error
   as it always has. *)
class AnUncaughtErrorRunsPendingEnsures usingPlatform: thePlatform = Object new (
    | transcript = thePlatform transcript.
      private Error = thePlatform kernel Error. |
) (
    public main: platform args: arguments = (
        transcript show: 'before'; newLine.
        [[Error signal: 'boom'] ensure: [transcript show: 'cleanup'; newLine]]
            ensure: [transcript show: 'outer cleanup'; newLine].
        transcript show: 'not reached'; newLine.
    )
) : ()
