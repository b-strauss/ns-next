Newspeak3
'Test'
(* A subclass may answer anything from `description` and from the
   selector it reports: an unhandled one still ends the run, its
   description rendered as a value is in an error message, and nothing
   after the signal runs. *)
class AnUnhandledExceptionWhoseDescriptionIsNoStringEndsTheRun usingPlatform: thePlatform = Object new (
    | transcript = thePlatform transcript.
      private Error = thePlatform kernel Error. |
) (
    public class Odd = Error new () (
        public description = ( ^42 )
        protected hostSelector = ( ^'no symbol' )
    )
    public main: platform args: arguments = (
        transcript show: 'before'; newLine.
        Odd new signal.
        transcript show: 'not reached'; newLine.
    )
) : ()
