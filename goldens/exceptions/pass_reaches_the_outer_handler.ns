Newspeak3
'Test'
(* `pass` hands the exception on to the next enclosing handler, whose value
   is then the value of that handler's `on:do:`; a handler for a class the
   exception is no instance of is passed by without running. *)
class PassReachesTheOuterHandler usingPlatform: thePlatform = Object new (
    | transcript = thePlatform transcript.
      private Error = thePlatform kernel Error.
      private Halt = thePlatform kernel Halt. |
) (
    public main: platform args: arguments = (
        transcript show: ([[Error signal] on: Error do: [:e | e pass]] on: Error do: [:e | 'outer']); newLine.
        transcript show: ([[Error signal] on: Error do: [:e | transcript show: 'inner '. e pass. 'not reached']]
                              on: Error do: [:e | 'outer']); newLine.
        transcript show: ([[Error signal] on: Halt do: [:e | 'wrong']] on: Error do: [:e | 'right']); newLine.
    )
) : ()
