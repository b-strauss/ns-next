Newspeak3
'Test'
(* Every VM error is a signalled `Error` (docs/design/core-library.md,
   "Exceptions"): an index out of range in `Array>>at:` is caught
   by `on: Error do:`, its `messageText` the text an uncaught one ends the
   run with, and the program carries on after the handler. *)
class AnArrayIndexErrorIsCaught usingPlatform: thePlatform = Object new (
    | transcript = thePlatform transcript.
      private Error = thePlatform kernel Error. |
) (
    public main: platform args: arguments = (
        transcript show: ([#(1 2) at: 5] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([#(1 2) at: 5] on: Error do: [:e | e class name]); newLine.
        transcript show: ([#(1 2) at: 2] on: Error do: [:e | 0]) printString; newLine.
    )
) : ()
