Newspeak3
'Test'
(* §5.5 makes a message nothing understood the VM's error, so a
   `doesNotUnderstand:` raised just below the depth limit, or at it, takes
   the reserve above the limit as any VM error does and is caught as
   itself, three levels below the last, one below it and at it; one level
   further it is the limit. A program's own `signal` takes no reserve: its
   search meets the limit, which is what is caught. *)
class AMessageNotUnderstoodJustBelowTheDepthLimitIsCaught usingPlatform: thePlatform = Object new (
    | transcript = thePlatform transcript.
      private Error = thePlatform kernel Error.
      deepest ::= 0. |
) (
    probe: n = ( deepest:: n. ^self probe: n + 1 )
    descend: n to: bottom = (
        n = bottom ifTrue: [^nil foo].
        ^self descend: n + 1 to: bottom
    )
    signalOwn: n to: bottom = (
        n = bottom ifTrue: [^Error new signal: 'own'].
        ^self signalOwn: n + 1 to: bottom
    )
    public main: platform args: arguments = (
        transcript show: ([self probe: 1] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self descend: 1 to: deepest - 3] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self descend: 1 to: deepest - 1] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self descend: 1 to: deepest] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self descend: 1 to: deepest + 1] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self signalOwn: 1 to: deepest - 3] on: Error do: [:e | e messageText]); newLine.
        transcript show: ([self signalOwn: 1 to: 10] on: Error do: [:e | e messageText]); newLine.
    )
) : ()
