Newspeak3
'Test'
(* `ensure:` and `ifCurtailed:` send `value` to their argument, as Squeak's
   and Primordial Soup's do, so any object that answers `value` will do --
   on the normal path, where `ensure:` sends it itself, and on an unwind,
   where the unwinder runs it. *)
class AnUnwindSendsValue usingPlatform: thePlatform = Object new (
    | private transcript = thePlatform transcript. |
) (
    class Noisy named: text = (
        | private name = text. |
    ) (
        public value = (
            transcript show: name; newLine.
            ^99
        )
    )
    endsNormally = (
        ^[1] ensure: (Noisy named: 'ensured')
    )
    isUnwound = (
        [^2] ensure: (Noisy named: 'ensured').
        ^0
    )
    isCurtailed = (
        [^3] ifCurtailed: (Noisy named: 'curtailed').
        ^0
    )
    public main: platform args: arguments = (
        transcript show: self endsNormally printString; newLine.
        transcript show: self isUnwound printString; newLine.
        transcript show: self isCurtailed printString; newLine.
    )
) : ()
