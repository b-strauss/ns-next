Newspeak3
'Test'
(* A nested class's superclass clause (newspeak-spec.pdf 6.1) is evaluated
   once per enclosing instance, and `GrandChildOfOuter` overrides what its
   `Inner` clause reads with a slot rather than a nested-class declaration.
   `Nested`'s cached class is per receiver (6): once `g Nested` has resolved
   `Inner` for `g`, changing `g`'s `Inner` slot afterwards must not change
   the class `g Nested` already answers.

   The slot starts at `OrderedCollection`, not `Array`: `setInner:` supplies
   `Array` later, to show the cached class does not change, so the starting
   value has to differ from it. `OrderedCollection` is no value class --
   this golden instantiates `Nested` (`n1 new` below), and a value class
   whose enclosing object is mutable, as `g` is here, is refused where an
   instance is made (newspeak-spec.pdf 3.1.1), which would be `n1 new`
   itself rather than the line above it. *)
class NestedOverride usingPlatform: p = Object new (| t ::= p transcript. |) (
    class Outer = Object new () (
        class Inner = Object new () (
            public printString = ( ^'Inner instance' )
        )
    )
    class ChildOfOuter = Outer () (
        public class Nested = Inner () ()
    )
    class GrandChildOfOuter = ChildOfOuter (| public Inner ::= OrderedCollection. |) (
        public setInner: v = ( Inner:: v )
    )
    public main: platform args: args = (
        | g n1 n2 |
        g:: GrandChildOfOuter new.
        n1:: g Nested.
        t show: n1 new printString; newLine.
        g setInner: Array.
        n2:: g Nested.
        t show: (n1 == n2) printString; newLine.
    )
)
