Newspeak3
'Test'
class NestedRedeclared usingPlatform: p = Object new (| t ::= p transcript. |) (
    class Base = Object new () (
        public class Inner = Object new () (
            public label = ( ^'base-inner' )
        )
    )
    class Derived = Base new () (
        public class Inner = Object new () (
            public label = ( ^'derived-inner' )
        )
        public superFirst = (
            | inherited own |
            inherited := (super Inner) new label.
            own := Inner new label.
            ^inherited, '/', own
        )
        public ownFirst = (
            | inherited own |
            own := Inner new label.
            inherited := (super Inner) new label.
            ^inherited, '/', own
        )
    )
    public main: platform args: args = (
        t show: Derived new superFirst; newLine.
        t show: Derived new ownFirst; newLine.
    )
)
