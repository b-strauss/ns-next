Newspeak3
'Test'
class ClassSideOuter usingPlatform: p = Object new (| t ::= p transcript. |) (
    label = ( ^'top' )
    public class Widget = Object new () (
        label = ( ^'widget' )
        public class Part = Object new () (
        ) : (
            public whichOuter = ( ^outer ClassSideOuter label )
        )
    ) : (
        public whichOuter = ( ^outer ClassSideOuter label )
    )
    public main: platform args: args = (
        t show: 'class side: ', Widget whichOuter; newLine.
        t show: 'nested class side: ', Widget new Part whichOuter; newLine.
    )
)
