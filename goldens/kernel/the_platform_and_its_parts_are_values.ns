Newspeak3
'Kernel'
(* The platform, its transcript and its collections namespace are values
   (§3.1.1): stateless but for what the host handed the platform, so any two
   of a kind are equal and, a value having no identity, identical. Each is
   an instance of its own class, so none answers another's protocol. The
   platform itself is not compared with a fresh one: its factory is
   `usingVmMirror:kernel:`, which a program has nothing to pass to, so the
   collections namespace, whose class answers `new`, stands in for it. *)
class PlatformValues usingPlatform: platformAtCreation = Object new () (
    public main: platform args: arguments = (
        | t c |
        t:: platform transcript.
        c:: platform collections.
        t show: (t == platform transcript) printString; newLine.
        t show: (t = t class new) printString; newLine.
        t show: (c = c class new) printString; newLine.
        t show: (c hash = c class new hash) printString; newLine.
        t show: (t class == platform class) printString; show: ' ';
            show: (c class == platform class) printString; newLine.
        t show: (c List == OrderedCollection) printString; newLine
    )
) : ()
