Newspeak3
'T'
(* Raised where it is *evaluated*, not when the method is compiled:
   everything before it still runs. *)
class DeferredSuper usingPlatform: platform = Object new (
) (
    unreached = ( ^super )
    public main: p args: a = (
        p transcript show: 'before'; newLine.
        ^self unreached
    )
) : ()
