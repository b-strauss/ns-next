Newspeak3
'Arithmetic'
(* Both operands are literal small integers, so `IntegerBinary`'s guard
   passes and the fast path runs `checked_add` itself -- which declines an
   overflowing result and falls back to the ordinary `+` send, whose
   primitive (`builtins/numbers.rs`) raises the overflow. Inlining must not
   take this error away from the primitive. *)
class IntegerOverflow usingPlatform: platform = Object new (
) (
  public main: p args: a = (
    p transcript show: (9223372036854775807 + 1) printString; newLine
  )
) : ()
