Newspeak3
'Arithmetic'
(* A zero divisor is the other case `checked_div_euclid` declines: the fast
   path's guard passes on two literal integers, then the fallback's ordinary
   `//` send raises the primitive's own "division by zero" -- not a message
   the fast path invents. *)
class IntegerDivisionByZero usingPlatform: platform = Object new (
) (
  public main: p args: a = (
    p transcript show: (7 // 0) printString; newLine
  )
) : ()
