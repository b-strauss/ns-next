Newspeak3
'T'
class WhileVarMbb usingPlatform: platform = Object new (
    | n ::= 0. |
) (
    public main: p args: a = (
        | cond body |
        cond := [n < 2 ifTrue: [true] ifFalse: [n]].
        body := [n := n + 1. p transcript show: n printString; newLine].
        cond whileTrue: body
    )
) : ()
