/// The platform's module: answers, to `build`, the platform the
/// host hands every program, whose members are the program's standard
/// output, the collections, the kernel classes a program may name, a
/// stopwatch and the typed arrays. The host instantiates it once, at boot.
///
/// mirror: the VM mirror, which the host alone holds.
/// kernel: the kernel module's instance, whose classes `KernelNamespace`
///     hands out.
///
/// The module behind the platform a module is handed (§8.3): a shipped
/// core-library module, booted by the host with the VM mirror and the
/// kernel instance (`docs/design/core-library.md`, "The module table and
/// the boot").
///
/// The factory pattern: this root holds what is privileged -- the mirror,
/// and the kernel's classes `KernelNamespace` hands out, never the kernel
/// instance -- and the host never hands its instance to anyone. It
/// instantiates the root once, sends it `build`, its one public member, and
/// hands every program that platform, an instance of the nested class
/// `Platform`, whose factory is a harmless `new`. What a program receives
/// are instances of the nested classes, the facets, through the platform's
/// members; each reaches the mirror and the kernel's classes lexically, as
/// a member of this root, never through a slot of its own, so every one of
/// them writes through the one mirror. The nested classes are private, so
/// even a holder of this root's instance could send it nothing but `build`:
/// a second line of defence behind the instance being unreachable. The
/// transcript, the clock, the collections and the typed arrays are each a
/// module of their own, another such root (`platform/TranscriptFactory.ns`,
/// `platform/TimeFactory.ns`, `platform/CollectionsFactory.ns`,
/// `platform/TypedArraysFactory.ns`), whose one instance this root builds
/// through the mirror on its first use and keeps in a private lazy slot
/// here; the platform hands out only the facets their `build` answers.
/// Nothing a program can name answers this root's instance or its class,
/// so no program can build a second one over something that is not the
/// mirror. Keep it so: no code whose receiver is
/// this root's instance may send it anything it does not understand, since
/// a `MessageNotUnderstood` hands its receiver to whoever catches it
/// (`docs/design/core-library.md`, "No program reaches a shipped module's
/// root").
///
/// The factory's parameters are copied into slots because neither a lazy
/// slot nor a method may name them (§6); of the kernel only the classes
/// `KernelNamespace` hands out are kept, not the kernel instance itself. A
/// send to `vmMirror` here is a mirror send, as in `Kernel.ns`: this module
/// is resolved with `resolve_kernel`, which only shipped source is.
///
/// Everything here is a value (§3.1.1): stateless but for what the host
/// hands the root and the modules built on first use, which the root
/// reaches through the mirror.
class PlatformFactory usingVmMirror: mirror kernel: kernel = Value (
  |
    /// The VM mirror the factory was given: the one object through which
    /// a member here reaches a native operation. Never handed out.
    private vmMirror = mirror.
    /// The kernel's `Exception`, which `KernelNamespace` hands out.
    private Exception = kernel Exception.
    /// The kernel's `Error`, which `KernelNamespace` hands out.
    private Error = kernel Error.
    /// The kernel's `MessageNotUnderstood`, which `KernelNamespace` hands out.
    private MessageNotUnderstood = kernel MessageNotUnderstood.
    /// The kernel's `Halt`, which `KernelNamespace` hands out.
    private Halt = kernel Halt.
    /// The kernel's `Message`, which `KernelNamespace` hands out.
    private Message = kernel Message.
    /// The kernel's `ArgumentError`, which `KernelNamespace` hands out.
    private ArgumentError = kernel ArgumentError.
    /// The kernel's `CannotReturn`, which `KernelNamespace` hands out.
    private CannotReturn = kernel CannotReturn.
    /// The kernel's `CannotInstantiate`, which `KernelNamespace` hands out.
    private CannotInstantiate = kernel CannotInstantiate.
    /// The kernel's `Closure`, which `KernelNamespace` hands out.
    private Closure = kernel Closure.
    /// The kernel's `Future`, which `KernelNamespace` hands out.
    private Future = kernel Future.
    /// The kernel's `Proxy`, which `KernelNamespace` hands out.
    private Proxy = kernel Proxy.
    /// The kernel's `Collection`, which `KernelNamespace` hands out.
    private Collection = kernel Collection.
    /// The kernel's `StringBuilder`, which `KernelNamespace` hands out.
    private StringBuilder = kernel StringBuilder.
    /// The kernel's `DataView`, which `KernelNamespace` hands out.
    private DataView = kernel DataView.
  |
) (
  /// The one collections module, built over the kernel on first use and
  /// the same object on every use after it.
  ///
  /// The mirror answers a module's one instance once it is recorded, so
  /// every platform's facet comes from one factory and hands out one
  /// `List` class. Until then the mirror answers the module's root class,
  /// which is sent its factory, and records what the factory answered as
  /// that one instance. A demand an unwind interrupts -- the depth limit
  /// reached inside the factory -- records nothing, so the next demand
  /// builds the module again from the same class. The kernel's instance
  /// is asked of the mirror too, so this root keeps none. The module's
  /// instance is as private as this one: only the facets its `build`
  /// answers leave this module.
  lazy private collectionsModule = vmMirror moduleInstanceNamed: #CollectionsFactory ifFail: [
    vmMirror recordShippedModule: ((vmMirror shippedModuleClassNamed: #CollectionsFactory ifFail: [
      nil.
    ]) usingKernel: (vmMirror moduleInstanceNamed: #Kernel ifFail: [nil]))
        ifFail: [nil].
  ].

  /// The one transcript module, built over the mirror on first use and
  /// the same object on every use after it, as `collectionsModule` is: a
  /// demand an unwind interrupts records nothing, and the next one builds
  /// the module again. Only the transcripts its `build` answers leave
  /// this module.
  lazy private transcriptModule = vmMirror moduleInstanceNamed: #TranscriptFactory ifFail: [
    vmMirror recordShippedModule: ((vmMirror shippedModuleClassNamed: #TranscriptFactory ifFail: [
      nil.
    ]) usingVmMirror: vmMirror)
        ifFail: [nil].
  ].

  /// The one clock module, built over the mirror on first use and the
  /// same object on every use after it, as `collectionsModule` is: a
  /// demand an unwind interrupts records nothing, and the next one builds
  /// the module again. Only the `Time` namespaces its `build` answers
  /// leave this module.
  lazy private timeModule = vmMirror moduleInstanceNamed: #TimeFactory ifFail: [
    vmMirror recordShippedModule: ((vmMirror shippedModuleClassNamed: #TimeFactory ifFail: [
      nil.
    ]) usingVmMirror: vmMirror)
        ifFail: [nil].
  ].

  /// The one typed arrays module, built over the mirror and the kernel on
  /// first use and the same object on every use after it, as
  /// `collectionsModule` is: a demand an unwind interrupts records
  /// nothing, and the next one builds the module again. Only the
  /// `TypedArrays` namespaces its `build` answers leave this module.
  lazy private typedArraysModule = vmMirror moduleInstanceNamed: #TypedArraysFactory ifFail: [
    vmMirror recordShippedModule: ((vmMirror shippedModuleClassNamed: #TypedArraysFactory ifFail: [
      nil.
    ]) usingVmMirror: vmMirror kernel: (vmMirror moduleInstanceNamed: #Kernel ifFail: [nil]))
        ifFail: [nil].
  ].

  /// The platform a program is handed: the namespace of what it may use
  /// beyond the kernel, each member built on first use.
  ///
  /// §8.3 describes the platform as an object that "provides accessors to
  /// various modules"; each is a lazy slot (§6.3.3), built on first use,
  /// so a program pays only for what it asks for. It hands out none of
  /// this module's classes: a program holds the instances its members
  /// answer, and since `class` is protected it reaches no class of
  /// theirs, so it can make no second platform or transcript. `Time`
  /// hands out `Stopwatch`, which a program instantiates itself, the
  /// collections facet the collections module's classes, and the typed
  /// arrays facet the typed arrays module's classes.
  private class Platform = Value () (
    /// The program's standard output, a `Transcript`, written as UTF-8.
    /// Built on first use; every later send answers the same one.
    lazy public transcript = transcriptModule build.

    /// The namespace of the collections module's classes -- `List`,
    /// `Map`, `IdentityMap`, `Set` and the Errors `NotFound` and
    /// `ConcurrentModification` -- and of the kernel's `Collection`.
    /// Built on first use; every later send answers the same one.
    lazy public collections = collectionsModule build.

    /// The namespace of the kernel classes a program may name, a
    /// `KernelNamespace`. Built on first use; every later send answers
    /// the same one.
    lazy public kernel = KernelNamespace new.

    /// The namespace of `Stopwatch`, a `Time`. Built on first use;
    /// every later send answers the same one.
    lazy public time = timeModule build.

    /// The namespace of the typed arrays module's classes -- `TypedArray`
    /// and the ten typed arrays, `Int8Array` to `Float64Array` -- a
    /// `TypedArrays`. Built on first use; every later send answers the
    /// same one.
    ///
    /// Exempt from the rule that an accessor here exists only because a
    /// program needs it, as `kernel` is: it hands out a whole module of
    /// the core library's classes, not a piece of the platform's services.
    lazy public typedArrays = typedArraysModule build.
  )

  /// `platform kernel`: the kernel classes a program may name that
  /// `Object`'s class accessors do not answer, and `Closure`, which they
  /// answer too.
  ///
  /// The facet over the kernel module that Primordial Soup's `Kernel
  /// wrapping:` answers.
  private class KernelNamespace = Value () (
    /// Answers the kernel's class `Exception`.
    public Exception = (
      ^outer PlatformFactory Exception.
    )

    /// Answers the kernel's class `Error`.
    public Error = (
      ^outer PlatformFactory Error.
    )

    /// Answers the kernel's class `MessageNotUnderstood`.
    public MessageNotUnderstood = (
      ^outer PlatformFactory MessageNotUnderstood.
    )

    /// Answers the kernel's class `Halt`.
    public Halt = (
      ^outer PlatformFactory Halt.
    )

    /// Answers the kernel's class `Message`.
    public Message = (
      ^outer PlatformFactory Message.
    )

    /// Answers the kernel's class `ArgumentError`.
    public ArgumentError = (
      ^outer PlatformFactory ArgumentError.
    )

    /// Answers the kernel's class `CannotReturn`.
    public CannotReturn = (
      ^outer PlatformFactory CannotReturn.
    )

    /// Answers the kernel's class `CannotInstantiate`.
    public CannotInstantiate = (
      ^outer PlatformFactory CannotInstantiate.
    )

    /// Answers the kernel's class `Closure`.
    public Closure = (
      ^outer PlatformFactory Closure.
    )

    /// Answers the kernel's class `Future`.
    public Future = (
      ^outer PlatformFactory Future.
    )

    /// Answers the kernel's class `Proxy`.
    public Proxy = (
      ^outer PlatformFactory Proxy.
    )

    /// Answers the kernel's `Collection` class, the abstract superclass
    /// of `Array`, `List`, `Map` and `Set`, for a program to subclass.
    public Collection = (
      ^outer PlatformFactory Collection.
    )

    /// Answers the kernel's class `StringBuilder`, which a program
    /// instantiates with `new` or `new:` to build a String from pieces.
    public StringBuilder = (
      ^outer PlatformFactory StringBuilder.
    )

    /// Answers the kernel's class `DataView`, which a program instantiates
    /// with `on:byteOrder:` a ByteArray or `new:byteOrder:`.
    public DataView = (
      ^outer PlatformFactory DataView.
    )
  )

  /// Answers a new `Platform`: what the host hands every program. The
  /// one public member of the module, named `build` like every shipped
  /// factory's.
  public build = (
    ^Platform new.
  )
)
