/// What a project's root receives as `packageUsing:`'s argument: every
/// module the project file names, asked for by its id, and by a range of
/// its versions where several modules share the id
/// (docs/design/modules.md, decisions 3 and 4). Not privileged: it holds
/// no mirror and is compiled into the program like any module, so an
/// application may keep it.
///
/// @factory makes the manifest over the four arrays, keeping them as they
/// are, neither copied nor checked; the host makes one per assembled
/// application. The arrays are of one length, and their elements at one
/// index describe one module.
/// @param moduleIds an Array of Strings, each module's id, in module order.
/// @param moduleVersions an Array of each module's version, a String in
/// semver's canonical text, or nil for a module without one.
/// @param moduleRanks an Array of Integers, each module's place, counted
/// from 0, among the modules of its id ordered by semver's precedence; a
/// module alone with its id has 0.
/// @param moduleDefinitions an Array of the modules' definitions, the
/// class objects (§6.4), not instances.
(* :module: newspeak.core.Manifest *)
class Manifest
    ids: moduleIds
    versions: moduleVersions
    ranks: moduleRanks
    definitions: moduleDefinitions
    = (
  |
    /// The modules' ids, the Array the factory was given: searched from
    /// the first to the last, never written.
    private ids = moduleIds.
    /// The modules' versions, the Array the factory was given, never
    /// written.
    private versions = moduleVersions.
    /// The modules' ranks among those of their ids, the Array the factory
    /// was given, never written.
    private ranks = moduleRanks.
    /// The modules' definitions, the Array the factory was given: the one
    /// at an index belongs to the id at the same index, never written.
    private definitions = moduleDefinitions.
    /// One text for each `at:version:` that matched several versions, in
    /// the order asked. Each new one replaces the Array with a longer
    /// copy, so an Array once answered never changes; the host reads it
    /// to warn.
    private ambiguitiesFound ::= {}.
  |
) (
  /// Answers the definition of the one module whose id is `id`.
  ///
  /// @param id a String, a module's id, compared with each id by `=`.
  /// @answers the module definition, a class object.
  /// @signals Error 'no module `<id>`' when no module has the id, and
  /// '`<id>` names <count> modules; ask with at:version:' when several
  /// have it, versions of one module.
  /// @see `at:version:`.
  public at: id = (
    |
      count ::= 0.
      match ::= 0.
    |
    1 to: ids size do: [:index |
      (ids at: index) = id ifTrue: [
        count:: count + 1.
        match:: index.
      ].
    ].
    count = 0 ifTrue: [^Error signal: 'no module `' , id , '`'].
    count > 1 ifTrue: [
      ^Error signal: '`' , id , '` names ' , count printString , ' modules; ask with at:version:'.
    ].
    ^definitions at: match.
  )

  /// Answers the definition of the module whose id is `id` of the highest
  /// version `range` matches. A version matches when it equals `range`, or
  /// begins with `range` followed by `.` and has no pre-release, so that
  /// `'2'` matches 2.3.1 but neither 20.0.0 nor 2.1.0-beta.1, and only a
  /// range that names a pre-release whole matches it. When several
  /// versions match, the one taken and those matched are recorded in
  /// `ambiguities`.
  ///
  /// @param id a String, a module's id, compared with each id by `=`.
  /// @param range a String: a major version, a major and a minor version,
  /// or a whole version, each number without a leading zero and below
  /// 2^64, a pre-release only in a whole version, and no build metadata.
  /// @answers the module definition, a class object.
  /// @signals Error '`<range>` is no version: <reason>' for a `range` of
  /// no such form, whatever the manifest holds, the reason the loader's
  /// own check of a range gives; 'no module `<id>`' when no module has the
  /// id, and 'no module `<id>` of version <range>; there are <candidates>'
  /// when none of its versions matches, the versions in ascending order,
  /// then 'and a module without a version' for one, or 'no versions' when
  /// there is only such a module.
  /// @see `at:` and `ambiguities`.
  public at: id version: range = (
    |
      defect = self rangeDefect: range.
      rank ::= 0.
      index ::= self indexOf: id rank: 0.
      candidates ::= ''.
      unversioned ::= false.
      matches ::= ''.
      matchCount ::= 0.
      taken ::= 0.
    |
    defect isNil ifFalse: [^Error signal: '`' , range , '` is no version: ' , defect].
    index = 0 ifTrue: [^Error signal: 'no module `' , id , '`'].
    [index > 0] whileTrue: [
      (versions at: index) isNil ifTrue: [
        unversioned:: true.
      ] ifFalse: [
        candidates:: self join: candidates and: (versions at: index).
      ].
      (self version: (versions at: index) matches: range) ifTrue: [
        matches:: self join: matches and: (versions at: index).
        matchCount:: matchCount + 1.
        taken:: index.
      ].
      rank:: rank + 1.
      index:: self indexOf: id rank: rank.
    ].
    taken = 0 ifTrue: [
      ^Error signal: 'no module `'
          , id
          , '` of version '
          , range
          , '; there are '
          , (self describeCandidates: candidates unversioned: unversioned).
    ].
    matchCount > 1 ifTrue: [
      ambiguitiesFound:: ambiguitiesFound copyWith: '`'
          , id
          , '` version '
          , range
          , ' matched '
          , matches
          , '; took '
          , (versions at: taken).
    ].
    ^definitions at: taken.
  )

  /// Answers what `at:version:` met that matched several versions: one
  /// String for each such request, in the order asked, naming the id, the
  /// range, the versions matched and the version taken.
  ///
  /// @answers an Array of Strings, which the manifest never changes; a
  /// later request answers a new Array.
  /// @see `at:version:`.
  public ambiguities = (
    ^ambiguitiesFound.
  )

  /// Finds the module of the id `id` and the rank `rank`.
  ///
  /// @param id a String, a module's id.
  /// @param rank an Integer, a place among the modules of `id`.
  /// @answers the module's index, or 0 when there is none.
  private indexOf: id rank: rank = (
    1 to: ids size do: [:index |
      ((ids at: index) = id and: [(ranks at: index) = rank]) ifTrue: [^index].
    ].
    ^0.
  )

  /// Tells whether `version` lies in `range`, by their texts: equal, or
  /// `version` beginning with `range` and a `.` and having no `-`, which
  /// begins a pre-release.
  ///
  /// @param version a String, a version's canonical text, or nil.
  /// @param range a String, the range asked for.
  /// @answers whether the version matches, false for nil.
  private version: version matches: range = (
    version isNil ifTrue: [^false].
    version = range ifTrue: [^true].
    (version startsWith: range , '.') ifFalse: [^false].
    ^(version indexOf: '-') = 0.
  )

  /// Tells why `range` is no range: a major version, a major and a minor
  /// version, or a whole version (`versionDefect:`), a pre-release or
  /// build metadata only in a whole version. The rules and reasons are
  /// those the loader holds a range to, so that a request reads alike
  /// wherever it is refused.
  ///
  /// @param range a String, the range asked for.
  /// @answers a String, the reason, or nil for a range.
  private rangeDefect: range = (
    |
      parts = self split: range at: '.'.
      majorDefect ::= nil.
    |
    parts size >= 3 ifTrue: [^self versionDefect: range].
    ((range indexOf: '-') > 0 or: [(range indexOf: '+') > 0]) ifTrue: [
      ^'a range with a pre-release names all three numbers'.
    ].
    majorDefect:: self number: (parts at: 1) defect: 'major'.
    (majorDefect isNil and: [parts size = 2]) ifTrue: [^self number: (parts at: 2) defect: 'minor'].
    ^majorDefect.
  )

  /// Tells why `text` is no version: `MAJOR.MINOR.PATCH`, then optionally
  /// `-` and a pre-release of dot-separated parts, and no build metadata,
  /// which orders nothing.
  ///
  /// @param text a String, a range of three numbers or more.
  /// @answers a String, the reason, or nil for a version.
  private versionDefect: text = (
    |
      dash = text indexOf: '-'.
      core = dash = 0 ifTrue: [text] ifFalse: [text copyFrom: 1 to: dash - 1].
      parts = self split: core at: '.'.
      defect ::= nil.
    |
    (text indexOf: '+') > 0 ifTrue: [^'build metadata orders nothing and is refused'].
    parts size = 3 ifFalse: [^'it needs MAJOR.MINOR.PATCH'].
    defect:: self number: (parts at: 1) defect: 'major'.
    defect isNil ifTrue: [defect:: self number: (parts at: 2) defect: 'minor'].
    defect isNil ifTrue: [defect:: self number: (parts at: 3) defect: 'patch'].
    (defect isNil and: [dash > 0]) ifTrue: [
      (self split: (text copyFrom: dash + 1 to: text size) at: '.') do: [:part |
        defect isNil ifTrue: [defect:: self preReleasePartDefect: part].
      ].
    ].
    ^defect.
  )

  /// Tells why `part` is no part of a pre-release: letters, digits and
  /// `-`, at least one, and a number when all digits.
  ///
  /// @param part a String, one dot-separated part of a pre-release.
  /// @answers a String, the reason, or nil for a part.
  private preReleasePartDefect: part = (
    |
      digits ::= true.
    |
    part isEmpty ifTrue: [^'a pre-release part is empty'].
    1 to: part size do: [:index |
      |
        code = part at: index.
      |
      (self isDigit: code) ifFalse: [
        digits:: false.
        ((code between: 65 and: 90) or: [(code between: 97 and: 122) or: [code = 45]]) ifFalse: [
          ^'pre-release part `' , part , '` holds a character other than letters, digits and `-`'.
        ].
      ].
    ].
    digits ifTrue: [^self number: part defect: 'pre-release part'].
    ^nil.
  )

  /// Tells why `text` is no number of a version: ASCII digits, at least
  /// one, no leading zero, and below 2^64, the widest a version holds.
  ///
  /// @param text a String, the number's text.
  /// @param what a String, the number's name in the reason: 'major',
  /// 'minor', 'patch' or 'pre-release part'.
  /// @answers a String, the reason, or nil for a number.
  private number: text defect: what = (
    |
      value ::= 0.
    |
    text isEmpty ifTrue: [^what , ' `' , text , '` is not a number'].
    1 to: text size do: [:index |
      (self isDigit: (text at: index)) ifFalse: [^what , ' `' , text , '` is not a number'].
      value:: value * 10 + ((text at: index) - 48).
    ].
    (text size > 1 and: [(text at: 1) = 48]) ifTrue: [^what , ' `' , text , '` has a leading zero'].
    value > 18446744073709551615 ifTrue: [^what , ' `' , text , '` is too large'].
    ^nil.
  )

  /// Tells whether `code` is an ASCII digit's code point.
  ///
  /// @param code an Integer, a code point.
  /// @answers whether it lies from 48, `0`, to 57, `9`.
  private isDigit: code = (
    ^code between: 48 and: 57.
  )

  /// Splits `text` at every occurrence of `separator`, so that `n`
  /// separators give `n + 1` parts, empty ones included.
  ///
  /// @param text a String.
  /// @param separator a String of one character.
  /// @answers a new Array of the parts, Strings, in order.
  private split: text at: separator = (
    |
      parts ::= {}.
      start ::= 1.
      found ::= text indexOf: separator.
    |
    [found > 0] whileTrue: [
      parts:: parts copyWith: (text copyFrom: start to: found - 1).
      start:: found + 1.
      found:: text indexOf: separator startingAt: start.
    ].
    ^parts copyWith: (text copyFrom: start to: text size).
  )

  /// Describes the modules of an id for the message that follows 'there
  /// are', so that it reads as a sentence whichever modules there are.
  ///
  /// @param versionTexts a String, the versions there are, joined by
  /// `join:and:`, empty for none.
  /// @param unversioned a Boolean, whether a module without a version is
  /// among them.
  /// @answers `versionTexts`, followed by ' and a module without a
  /// version' when there is one, or 'no versions' when it is alone.
  private describeCandidates: versionTexts unversioned: unversioned = (
    unversioned ifFalse: [^versionTexts].
    versionTexts isEmpty ifTrue: [^'no versions'].
    ^versionTexts , ' and a module without a version'.
  )

  /// Joins two parts of a list for a message.
  ///
  /// @param text a String, the list so far, empty for none.
  /// @param addition a String, the next part.
  /// @answers `addition` after `text` and a comma, or `addition` alone.
  private join: text and: addition = (
    text isEmpty ifTrue: [^addition].
    ^text , ', ' , addition.
  )
)
