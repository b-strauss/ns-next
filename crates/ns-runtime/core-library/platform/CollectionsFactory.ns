/// The collections module: the growable Collections a program computes
/// with -- `List`, `Map`, `IdentityMap` and `Set` -- and the Errors they
/// signal, `NotFound` and `ConcurrentModification`, reached through
/// `platform collections`. Built on its first demand, or by the loader
/// when an image names it, over the kernel,
/// from which it takes `Collection`, `ArgumentError`, `WeakArray` and
/// `WeakMap`; `Error` and `Array` it names bare, through `Object`'s
/// accessors.
///
/// The factory pattern `PlatformFactory.ns` is written in. This root keeps
/// of the kernel only the four classes it needs, never the kernel instance,
/// and nothing hands its instance to a program: the platform's root builds
/// it through the mirror on its first use -- again after an unwind
/// interrupted that use, which records nothing -- and keeps it in a
/// private lazy slot, and each platform's `collections` getter sends it
/// `build`, its one public member. What a program gets is the
/// `Collections` facet `build` answers, which hands out this module's
/// classes by class accessors, each exactly `^outer CollectionsFactory
/// <Name>` -- a lexical send, which reaches the root's private classes
/// (§5.9), and which lets an image name the class by its declaration
/// (`docs/design/image-format.md`, "Shipped names"). Nothing a program
/// can name answers this root's instance or its class, so no
/// program can build one over something that is not the kernel. Keep it
/// so: no code whose receiver is this root's instance may send it anything
/// it does not understand, since a `MessageNotUnderstood` hands its
/// receiver to whoever catches it.
///
/// A value (§3.1.1), so that every platform shares the one module and its
/// classes -- `platform collections List` is one class however many
/// platforms a program makes -- and so that the platform, a value, may hold
/// the facet in a slot.
///
/// @factory makes the collections module over `kernel`, copying its
/// `ArgumentError`, `Collection`, `WeakArray` and `WeakMap` into slots of
/// its own and keeping nothing else of it. The platform's root sends it
/// to the class the mirror answers on the module's first demand, and again
/// on the next demand after an unwind interrupted one, which records
/// nothing; the loader sends it instead when an image names the module.
/// @param kernel the kernel module instance; its `Collection` is the
/// superclass of `List`, `Map` and `Set`, its `ArgumentError` what they
/// signal for an index or a capacity out of range, and its `WeakArray` and
/// `WeakMap` what the facet hands out beside them.
class CollectionsFactory usingKernel: kernel = Value (
  |
    /// The kernel's `ArgumentError`, which the classes here signal for an
    /// index or a capacity out of range.
    private ArgumentError = kernel ArgumentError.
    /// The kernel's `Collection`, the superclass of `List`, `Map` and
    /// `Set`.
    private Collection = kernel Collection.
    /// The kernel's `WeakArray`, which the `Collections` facet hands out.
    /// It is the very class `platform kernel WeakArray` answers.
    private WeakArray = kernel WeakArray.
    /// The kernel's `WeakMap`, which the `Collections` facet hands out:
    /// a map whose entries last only while their keys do.
    private WeakMap = kernel WeakMap.
  |
) (
  /// The namespace `platform collections` answers: it hands out the
  /// module's classes, one accessor each, and the kernel's `Collection`,
  /// `WeakArray` and `WeakMap`; nothing else. Its own class is not among
  /// them, so a program makes no second namespace.
  private class Collections = Value () (
    /// Hands out the module's ordered, growable sequence: `List new`,
    /// `List new: capacity` or `List withAll: collection`.
    ///
    /// Signals nothing itself; `List new:` signals what `Array new:`
    /// signals for a capacity that is no Integer or is negative.
    ///
    /// @answers the `List` class.
    public List = (
      ^outer CollectionsFactory List.
    )

    /// Hands out the Error a collection signals for what it does not
    /// hold.
    ///
    /// @answers the `NotFound` class: an Error carrying the element or
    /// key a collection was asked for and does not hold.
    public NotFound = (
      ^outer CollectionsFactory NotFound.
    )

    /// Hands out the module's table from keys to values: `Map new`,
    /// `Map new: capacity` or `Map withAll: aMap`.
    ///
    /// Signals nothing itself; `Map new:` signals an ArgumentError,
    /// 'new: requires a capacity of at least 0, got …', for a negative
    /// capacity; for a Float, 'new: requires an Integer size, got …';
    /// for an Integer whose array size `(capacity + 1) * 2` is past the
    /// SmallInteger range (a capacity from 2^59 - 1 on, or a
    /// LargeInteger) or too large to allocate, 'new: cannot allocate an
    /// Array of … elements'; and a MessageNotUnderstood for `<` for one
    /// that is no number. Both texts show the array size, not the
    /// capacity.
    ///
    /// @answers the `Map` class.
    public Map = (
      ^outer CollectionsFactory Map.
    )

    /// Hands out the module's Map comparing keys with `==`:
    /// `IdentityMap new`, `IdentityMap new: capacity` or
    /// `IdentityMap withAll: aMap`.
    ///
    /// Signals nothing itself; `IdentityMap new:` signals what `Map
    /// new:` signals for a capacity.
    ///
    /// @answers the `IdentityMap` class.
    /// @see `Map`.
    public IdentityMap = (
      ^outer CollectionsFactory IdentityMap.
    )

    /// Hands out the module's collection of distinct elements: `Set new`,
    /// `Set new: capacity` or `Set withAll: collection`.
    ///
    /// Signals nothing itself; `Set new:` signals an ArgumentError,
    /// 'new: requires a capacity of at least 0, got …', for a negative
    /// capacity; for a Float, 'new: requires an Integer size, got …';
    /// for an Integer whose `capacity + 1`, the size of the Set's
    /// `data_`, is past the SmallInteger range (a capacity from 2^60 - 1
    /// on, or a LargeInteger) or too large to allocate, 'new: cannot
    /// allocate an Array of … elements'; and a MessageNotUnderstood for
    /// `<` for one that is no number. Both texts show `capacity + 1`,
    /// not the capacity.
    ///
    /// @answers the `Set` class.
    public Set = (
      ^outer CollectionsFactory Set.
    )

    /// Hands out the abstract superclass of `List`, `Map` and `Set`, for
    /// a program to subclass.
    ///
    /// @answers the kernel's `Collection` class.
    public Collection = (
      ^outer CollectionsFactory Collection.
    )

    /// Hands out the Error a `List`, `Map` or `Set` signals when it is
    /// changed while it is iterated. It carries the collection in
    /// `collection`.
    ///
    /// @answers the `ConcurrentModification` class.
    public ConcurrentModification = (
      ^outer CollectionsFactory ConcurrentModification.
    )

    /// Hands out the kernel's weak array: `WeakArray new: size`.
    ///
    /// Signals nothing itself; `new:` signals an ArgumentError for a size
    /// that is negative or no Integer.
    ///
    /// Handed out here as well as by the kernel facet because a program
    /// asks for it here (`corpus/modules/Brazil.ns`).
    ///
    /// @answers the kernel's `WeakArray` class, the one `platform kernel
    /// WeakArray` answers.
    public WeakArray = (
      ^outer CollectionsFactory WeakArray.
    )

    /// Hands out the kernel's weak map: `WeakMap new`, a map whose
    /// entries last only while their keys do.
    ///
    /// Signals nothing itself.
    ///
    /// Handed out here as well as by the kernel facet because a weak map
    /// is a collection a program looks for among the others.
    ///
    /// @answers the kernel's `WeakMap` class, the one `platform kernel
    /// WeakMap` answers.
    public WeakMap = (
      ^outer CollectionsFactory WeakMap.
    )
  )

  /// An ordered, growable sequence, indexed from 1, that adds and removes
  /// at both ends in amortized constant time: `List new`, `List new: 20`,
  /// `List withAll: {1. 2}`. A Collection: `collect:`, `select:` and
  /// `reject:` answer Lists.
  ///
  /// Changing its elements' number -- adding, removing -- while `do:`,
  /// `keysAndValuesDo:`, `anySatisfy:`, `removeAllSuchThat:` or anything
  /// built on `do:` runs over it signals a ConcurrentModification after
  /// the block that did it, unless that block ends the iteration; inside
  /// the block of `sort:`, once the sort is done. Storing at an existing
  /// index does not.
  ///
  /// The primary factory takes the capacity, so a program may write
  /// `List new: 15` as a superclass clause.
  ///
  /// The elements lie in `data` from `firstIndex` on, so that removing at
  /// either end moves nothing; the representation is private, so that it
  /// can change without a subclass noticing, and `size_` alone is
  /// protected, as a subclass's view of the size.
  ///
  /// @factory makes an empty list with room for `capacity` elements before
  /// it grows; `Array new:` is sent the capacity, and signals what it
  /// signals for one that is no Integer or is negative.
  /// @param capacity an Integer of at least 0: the number of elements
  /// `add:` appends to the new list before it first grows.
  private class List new: capacity = Collection (
    |
      /// The number of elements.
      /// Kept by every addition and removal; `size` answers it.
      protected size_ ::= 0.
      /// The index in `data` of the first element; 1 whenever the list
      /// is empty.
      private firstIndex ::= 1.
      /// The elements, `size_` of them from `firstIndex` on; every
      /// other slot holds nil, so the list keeps nothing alive it no
      /// longer holds.
      private data ::= Array new: capacity.
      /// The number of changes to the number of elements so far; an
      /// iteration compares it after every block that does not end
      /// it, and `sort:` once its copy is sorted.
      private modifications ::= 0.
    |
  ) (
    /// Identifies the receiver as a List, without a class test.
    ///
    /// @answers true.
    public isKindOfList = (
      ^true.
    )

    /// Reports the list's size, in constant time.
    ///
    /// @answers the number of elements, an Integer.
    public size = (
      ^size_.
    )

    /// Tests the list for elements, in constant time.
    ///
    /// The size is at hand; `Collection`'s would send `size`.
    ///
    /// @answers whether the list holds no element, a Boolean.
    public isEmpty = (
      ^0 = size_.
    )

    /// Reads the element at `index`, in constant time.
    ///
    /// The check is written out, since every `at:` pays for it; an
    /// index that is no Integer is out of range too.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the element at `index`.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for any other index, an index
    /// that is no Integer included.
    public at: index = (
      (index isKindOfInteger and: [(1 <= index) and: [index <= size_]]) ifFalse: [
        ^self indexOutOfRange: index.
      ].
      ^data at: firstIndex + index - 1.
    )

    /// Replaces the element at `index` with `value`. Not a change of the
    /// number of elements: an iteration running meanwhile carries on, and
    /// sees `value` if it has not passed `index` yet.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value any object; stored as it is.
    /// @answers `value`.
    /// @signals ArgumentError the one `at:` signals for any other index.
    /// @see `at:`.
    public at: index put: value = (
      (index isKindOfInteger and: [(1 <= index) and: [index <= size_]]) ifFalse: [
        ^self indexOutOfRange: index.
      ].
      data at: firstIndex + index - 1 put: value.
      ^value.
    )

    /// Reads the element at index 1, in constant time.
    ///
    /// @answers the first element.
    /// @signals ArgumentError the one of `at:`, carrying 1, for an empty
    /// list.
    public first = (
      ^self at: 1.
    )

    /// Reads the element at index `size`, in constant time.
    ///
    /// @answers the last element.
    /// @signals ArgumentError the one of `at:`, carrying 0, for an empty
    /// list.
    public last = (
      ^self at: size_.
    )

    /// Appends `element` at the end, in amortized constant time.
    ///
    /// @param element any object.
    /// @answers `element`.
    public add: element = (
      |
        end ::= firstIndex + size_.
      |
      end > data size ifTrue: [end:: makeRoomAtEnd].
      data at: end put: element.
      size_:: size_ + 1.
      modifications:: modifications + 1.
      ^element.
    )

    /// Appends `element` at the end, as `add:` does.
    ///
    /// @param element any object.
    /// @answers `element`.
    /// @see `add:`.
    public addLast: element = (
      ^self add: element.
    )

    /// Inserts `element` before the first, in amortized constant time.
    ///
    /// @param element any object.
    /// @answers `element`.
    public addFirst: element = (
      firstIndex = 1 ifTrue: [makeRoomAtFront].
      firstIndex:: firstIndex - 1.
      data at: firstIndex put: element.
      size_:: size_ + 1.
      modifications:: modifications + 1.
      ^element.
    )

    /// Appends each element of `collection`, in its `do:` order. The list
    /// itself as `collection` appends a copy of its elements:
    /// `list addAll: list` doubles it.
    ///
    /// @param collection a Collection, or anything understanding `do:`.
    /// @answers `collection`.
    public addAll: collection = (
      (collection == self ifTrue: [self asArray] ifFalse: [collection]) do: [:element |
        self add: element.
      ].
      ^collection.
    )

    /// Evaluates `action` with each element in turn, from the first. Each
    /// element is read when the walk reaches it, so one stored meanwhile
    /// by `at:put:` is seen.
    ///
    /// @param action a one-argument block, or anything understanding
    /// `value:`.
    /// @answers the receiver.
    /// @signals ConcurrentModification after the evaluation of `action`
    /// that added or removed an element.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for an `action` that does not
    /// take one argument, when the list is not empty.
    public do: action = (
      |
        expected = modifications.
        end = size_.
        index ::= 0.
      |
      [index < end] whileTrue: [
        action value: (data at: firstIndex + index).
        expected = modifications ifFalse: [^signalModificationOf: self].
        index:: index + 1.
      ].
    )

    /// Evaluates `action` with each index and the element there, from
    /// the first.
    ///
    /// @param action a two-argument block, given the index and the
    /// element.
    /// @answers the receiver.
    /// @signals ConcurrentModification as `do:` does.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for an `action` that does not
    /// take two arguments, when the list is not empty.
    public keysAndValuesDo: action = (
      |
        expected = modifications.
        end = size_.
        index ::= 0.
      |
      [index < end] whileTrue: [
        action value: index + 1 value: (data at: firstIndex + index).
        expected = modifications ifFalse: [^signalModificationOf: self].
        index:: index + 1.
      ].
    )

    /// Tries `predicate` on each element in turn, from the first, until
    /// one answers true.
    ///
    /// Written out rather than inherited: `Collection`'s returns from a
    /// block, and the benchmarks ask it of their work lists.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers whether `predicate` answers true for some element, a
    /// Boolean; false for an empty list.
    /// @signals ConcurrentModification as `do:` does.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the list is not empty.
    public anySatisfy: predicate = (
      |
        expected = modifications.
        end = size_.
        index ::= 0.
      |
      [index < end] whileTrue: [
        (predicate value: (data at: firstIndex + index)) ifTrue: [^true].
        expected = modifications ifFalse: [^signalModificationOf: self].
        index:: index + 1.
      ].
      ^false.
    )

    /// Finds `element` in the list: each element is sent `=` with
    /// `element`, from the first, until one answers true.
    ///
    /// @param element any object; the argument of every `=`.
    /// @answers the index of the first element `=` to `element`, or 0
    /// when there is none.
    public indexOf: element = (
      |
        index ::= 0.
      |
      [index < size_] whileTrue: [
        (data at: firstIndex + index) = element ifTrue: [^index + 1].
        index:: index + 1.
      ].
      ^0.
    )

    /// Removes the first element `=` to `element`.
    ///
    /// @param element any object.
    /// @answers `element`.
    /// @signals NotFound carrying `element`, 'element not found: …' and
    /// its `printString`, when there is none.
    public remove: element = (
      ^self remove: element ifAbsent: [
        (NotFound element: element) signal: 'element not found: ' , element printString.
      ].
    )

    /// Removes the first element `=` to `element`; when there is none,
    /// leaves the list unchanged.
    ///
    /// @param element any object.
    /// @param onAbsent anything understanding `value`.
    /// @answers `element`; when there is none, the value of `onAbsent`.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 0', for an `onAbsent` that declares
    /// any parameter, when there is none.
    public remove: element ifAbsent: onAbsent = (
      |
        position ::= firstIndex.
        end = firstIndex + size_.
      |
      [position < end] whileTrue: [
        (data at: position) = element ifTrue: [
          removeAtDataIndex: position.
          ^element.
        ].
        position:: position + 1.
      ].
      ^onAbsent value.
    )

    /// Removes the first element, in constant time.
    ///
    /// @answers the element removed.
    /// @signals Error 'removeFirst: the List is empty', for an empty
    /// list.
    public removeFirst = (
      |
        element
      |
      0 = size_ ifTrue: [^Error signal: 'removeFirst: the List is empty'].
      element:: data at: firstIndex.
      data at: firstIndex put: nil.
      size_:: size_ - 1.
      0 = size_ ifTrue: [firstIndex:: 1] ifFalse: [firstIndex:: firstIndex + 1].
      modifications:: modifications + 1.
      ^element.
    )

    /// Removes the last element, in constant time.
    ///
    /// @answers the element removed.
    /// @signals Error 'removeLast: the List is empty', for an empty list.
    public removeLast = (
      |
        last
        element
      |
      0 = size_ ifTrue: [^Error signal: 'removeLast: the List is empty'].
      last:: firstIndex + size_ - 1.
      element:: data at: last.
      data at: last put: nil.
      size_:: size_ - 1.
      0 = size_ ifTrue: [firstIndex:: 1].
      modifications:: modifications + 1.
      ^element.
    )

    /// Removes every element; the capacity stays.
    ///
    /// A list emptied is usually filled again to about its old size:
    /// `benchmarks/are-we-fast-yet/Havlak.ns` empties and refills its
    /// lists for every loop search.
    ///
    /// @answers the receiver.
    public removeAll = (
      data:: Array new: data size.
      firstIndex:: 1.
      size_:: 0.
      modifications:: modifications + 1.
    )

    /// Removes every element for which `predicate` answers true, keeping
    /// the order of the rest. `predicate` sees every element once, in
    /// order, before anything is removed.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers the receiver.
    /// @signals ConcurrentModification after the evaluation of
    /// `predicate` that added or removed an element.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the list is not empty; nothing is removed.
    public removeAllSuchThat: predicate = (
      |
        elements = self asArray.
        expected = modifications.
        keep = Array new: elements size.
        count ::= 0.
        position ::= 0.
        kept
        target ::= 0.
      |
      elements do: [:element |
        position:: position + 1.
        (predicate value: element) ifFalse: [
          count:: count + 1.
          keep at: position put: true.
        ].
        expected = modifications ifFalse: [^signalModificationOf: self].
      ].
      count = size_ ifTrue: [^self].
      /// The kept elements are read now, not from the snapshot, so a
      /// store the predicate made at a kept position is kept.
      kept:: Array new: count.
      1 to: size_ do: [:index |
        (keep at: index) == true ifTrue: [
          target:: target + 1.
          kept at: target put: (data at: firstIndex + index - 1).
        ].
      ].
      data:: Array new: data size.
      data replaceFrom: 1 to: count with: kept startingAt: 1.
      firstIndex:: 1.
      size_:: count.
      modifications:: modifications + 1.
    )

    /// Sorts the elements in place, stably. Not a change of the number of
    /// elements: an iteration running meanwhile carries on. The elements
    /// are sorted as a copy and written back once the sort is done. A
    /// store the block makes at an existing index changes no count, so it
    /// is overwritten when the copy is written back: `lessOrEqual`
    /// compares, and changes nothing.
    ///
    /// The copy holds the elements the sort started with, so writing it
    /// back over a list whose block changed it would bring back a
    /// removed element or drop an added one, silently.
    ///
    /// @param lessOrEqual a two-argument block answering whether its
    /// first argument may precede its second.
    /// @answers the receiver.
    /// @signals ConcurrentModification once the copy is sorted, when an
    /// evaluation of `lessOrEqual` added or removed an element; the
    /// sorted copy is then not written back, and the list stays as the
    /// block left it.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for a `lessOrEqual` that does not
    /// take two arguments, when the list holds at least two elements; the
    /// list stays as it was.
    public sort: lessOrEqual = (
      |
        sorted
        expected
      |
      size_ < 2 ifTrue: [^self].
      sorted:: self asArray.
      expected:: modifications.
      sorted sort: lessOrEqual.
      expected = modifications ifFalse: [^signalModificationOf: self].
      data replaceFrom: firstIndex to: firstIndex + size_ - 1 with: sorted startingAt: 1.
    )

    /// Copies the elements out into an Array the list does not share.
    ///
    /// @answers a new Array of the elements, in order.
    public asArray = (
      ^data copyFrom: firstIndex to: firstIndex + size_ - 1.
    )

    /// Concatenates the receiver and `collection` into a new list. The
    /// receiver is unchanged.
    ///
    /// @param collection a Collection, or anything answering `size` and
    /// `do:`.
    /// @answers a new List of the receiver's elements followed by those
    /// of `collection`.
    public , collection = (
      |
        result = List new: size_ + collection size.
      |
      result
          addAll: self;
          addAll: collection.
      ^result.
    )

    /// Copies a run of the elements into a new list. The receiver is
    /// unchanged.
    ///
    /// @param start an Integer, the index of the first element copied.
    /// @param stop an Integer, the index of the last element copied;
    /// `start - 1` for an empty copy.
    /// @answers a new List of the elements from `start` to `stop`; empty
    /// when `stop` is `start - 1`.
    /// @signals ArgumentError the one of `Array>>copyFrom:to:` for a
    /// range the list does not hold.
    public copyFrom: start to: stop = (
      ^List withAll: (self asArray copyFrom: start to: stop).
    )

    /// Makes the empty list that `collect:`, `select:` and `reject:`
    /// fill.
    ///
    /// `List`, not `self class`: a subclass's primary factory may take
    /// no capacity, as DeltaBlue's `Plan` takes none.
    ///
    /// @param capacity an Integer of at least 0, the number of elements
    /// the answer is to have room for.
    /// @answers a new, empty List with room for `capacity` elements.
    protected newForCollectUsingAdd: capacity = (
      ^List new: capacity.
    )

    /// Refuses `index` with the text `Array>>at:` signals, with the
    /// list's size, so a program sees one text from either. It never
    /// returns: an Error is not resumable.
    ///
    /// @param index the index `at:` or `at:put:` refused, any object.
    /// @answers nothing; it never returns.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)'.
    private indexOutOfRange: index = (
      ^(ArgumentError value: index) signal: 'index '
          , index printString
          , ' out of range: valid indices are 1..'
          , size_ printString
          , ' (size '
          , size_ printString
          , ')'.
    )

    /// Removes the element at `position` in `data`, closing the gap from
    /// the shorter side so that removing near either end moves little,
    /// and counts the change.
    ///
    /// @param position an index in `data` of an element: from
    /// `firstIndex` to `firstIndex + size_ - 1`.
    /// @answers the receiver.
    private removeAtDataIndex: position = (
      |
        last = firstIndex + size_ - 1.
      |
      position - firstIndex < (last - position) ifTrue: [
        data replaceFrom: firstIndex + 1 to: position with: data startingAt: firstIndex.
        data at: firstIndex put: nil.
        firstIndex:: firstIndex + 1.
      ] ifFalse: [
        data replaceFrom: position to: last - 1 with: data startingAt: position + 1.
        data at: last put: nil.
      ].
      size_:: size_ - 1.
      0 = size_ ifTrue: [firstIndex:: 1].
      modifications:: modifications + 1.
    )

    /// Makes room after the last element: slides the elements to the
    /// start when at least as many slots lie empty before them as they
    /// fill -- the `removeFirst`s that emptied those slots pay for the
    /// move -- and otherwise copies them into an Array half as large
    /// again, plus four, so that an Array of size 0 grows too.
    ///
    /// @answers the index in `data` where the next element goes.
    private makeRoomAtEnd = (
      |
        grown
      |
      ((firstIndex > 1) and: [firstIndex - 1 >= size_]) ifTrue: [
        data replaceFrom: 1 to: size_ with: data startingAt: firstIndex.
        size_ + 1 to: firstIndex + size_ - 1 do: [:index | data at: index put: nil].
        firstIndex:: 1.
        ^size_ + 1.
      ].
      grown:: Array new: data size + (data size // 2) + 4.
      grown replaceFrom: 1 to: size_ with: data startingAt: firstIndex.
      data:: grown.
      firstIndex:: 1.
      ^size_ + 1.
    )

    /// Makes room before the first element, which lies at index 1 of
    /// `data`. Slides the elements right by half the empty slots after
    /// them, rounded up, when those are at least as many as the
    /// elements -- the removals that emptied them pay for the move --
    /// and otherwise copies the elements into an Array half as large
    /// again, plus four, leaving that room in front. Sliding whenever
    /// any slot is free would move every element for each `addFirst:`
    /// of a list rotated at its full size.
    ///
    /// @answers the receiver.
    private makeRoomAtFront = (
      |
        free = data size - size_.
        shift
        target
      |
      ((free > 0) and: [free >= size_]) ifTrue: [
        shift:: free + 1 // 2.
        target:: data.
      ] ifFalse: [
        shift:: data size // 2 + 4.
        target:: Array new: data size + shift.
      ].
      target replaceFrom: firstIndex + shift
          to: firstIndex + shift + size_ - 1
          with: data
          startingAt: firstIndex.
      target == data ifTrue: [
        firstIndex to: firstIndex + shift - 1 do: [:index | data at: index put: nil].
      ].
      data:: target.
      firstIndex:: firstIndex + shift.
    )
  ) : (
    /// Makes an empty list of the default capacity, `List new: 3`.
    ///
    /// @answers an empty List with room for 3 elements.
    public new = (
      ^self new: 3.
    )

    /// Makes a list of `collection`'s elements, sized to hold them.
    ///
    /// @param collection a Collection, or anything answering `size` and
    /// `do:`.
    /// @answers a new List of `collection`'s elements, in its `do:`
    /// order.
    public withAll: collection = (
      ^(self new: collection size)
          addAll: collection;
          yourself.
    )
  )

  /// The Error a List, Map or Set signals when an iteration over it finds
  /// it changed -- an element added or removed -- by the block it ran.
  /// Carries the collection.
  ///
  /// Iteration means `do:`, `keysAndValuesDo:`, `anySatisfy:`,
  /// `removeAllSuchThat:` and everything built on `do:`, each checked
  /// after every block that does not end it -- a block that ends the
  /// iteration by returning, as the deciding one of `anySatisfy:` or
  /// `detect:` does, leaves before the check -- and a List's `sort:`,
  /// checked once its sort is done. Storing at an existing index or key,
  /// and sorting, are no change.
  ///
  /// Without it a change inside `do:` would visit an element twice, skip
  /// one or end early, silently.
  private class ConcurrentModification = Error (
    |
      /// The collection that was changed while it was iterated.
      /// Public and mutable: the class's `collection:` sets it as the
      /// error is made, and anyone may set it later; nil in one made by
      /// `new` until set.
      public collection ::= nil.
    |
  ) () : (
    /// Makes the error for `modified`, not yet signalled.
    ///
    /// @param modified the collection found changed while it was
    /// iterated.
    /// @answers a new ConcurrentModification carrying `modified`.
    public collection: modified = (
      ^self new collection: modified.
    )
  )

  /// Raises the error for a collection an iteration found changed. The
  /// one place the error is raised, so every collection's text is one.
  ///
  /// @param collection the collection found changed.
  /// @answers nothing: it never answers, since an Error is not
  /// resumable.
  /// @signals ConcurrentModification carrying `collection`, its
  /// messageText 'the collection was modified while it was being
  /// iterated'.
  private signalModificationOf: collection = (
    ^(ConcurrentModification collection: collection) signal: 'the collection was modified while it was being iterated'.
  )

  /// The Error a collection signals when it is asked for an element or
  /// key it does not hold. Carries it in `element`.
  private class NotFound = Error (
    |
      /// The element or key that was not found.
      /// Public and mutable: the class's `element:` sets it as the error
      /// is made, and anyone may set it later; nil in one made by `new`
      /// until set.
      public element ::= nil.
    |
  ) (
    /// Describes the error: the text it was signalled with, else the
    /// missing element or key.
    ///
    /// @answers `messageText`, or, when it is nil, 'NotFound: ' and the
    /// `printString` of the element.
    public description = (
      ^messageText isNil ifTrue: ['NotFound: ' , element printString] ifFalse: [messageText].
    )
  ) : (
    /// Makes the error for `missing`, not yet signalled.
    ///
    /// @param missing the element or key a collection does not hold.
    /// @answers a new NotFound carrying `missing`.
    public element: missing = (
      ^self new element: missing.
    )
  )

  /// A table from keys to values: `Map new`, `Map new: 20`,
  /// `Map withAll: aMap`. A key is found by its `hash` and compared with
  /// `=`; every key's `hash` must agree with its `=`. Keys keep the order
  /// they were first stored in: storing an existing key keeps its place,
  /// a removed key leaves the order, and one stored again after its
  /// removal comes last.
  ///
  /// A Collection whose elements are the values: `do:`, `includes:` and
  /// the rest of Collection's protocol visit them, and `collect:`,
  /// `select:` and `reject:` answer Maps of the same keys.
  ///
  /// Adding or removing a key while `do:`, `keysAndValuesDo:` or anything
  /// built on them runs over the map signals a ConcurrentModification
  /// after the block that did it; storing a value under an existing key
  /// does not.
  ///
  /// The keys and values lie side by side in `data_`, in the order they
  /// were stored, and `hashtable_` is an open-addressing table of their
  /// indices in `data_`, 0 marking an empty bucket. A removal overwrites
  /// the key with `data_` itself, which no lookup can match, so its
  /// bucket stays in the probe chain as a tombstone; growing copies only
  /// the live entries, which compacts both.
  ///
  /// The removed mark is the data array because it costs nothing and no
  /// key can be it: no slot is read and nothing allocated to test for
  /// it, and the public protocol never hands the array out -- `keys` and
  /// `values` answer new Arrays -- so no key is ever it. A subclass
  /// reaches it through the protected `dataForScan` and probes; one that
  /// stores it as a key or hands it on breaks only its own map. Every
  /// test has the mark as the receiver of `==`, so a key's own `==` is
  /// never sent the array; and a rebuild replaces `data_`, dropping
  /// exactly the entries it marked.
  ///
  /// @factory makes an empty map with room for `capacity` keys before it
  /// grows, its table built at once by `createTable:`, which signals for
  /// a capacity that is negative or no Integer.
  /// @param capacity an Integer of at least 0: the number of keys stored,
  /// none removed, before the map first grows.
  private class Map new: capacity = Collection (
    |
      /// The number of keys the map holds.
      /// A removed entry left in `data_` as a tombstone is not counted.
      private size_ ::= 0.
      /// The number of entries `data_` has been given since the table
      /// was last built, removed ones included: the next entry goes at
      /// `used_ * 2 + 1`.
      private used_ ::= 0.
      /// The keys and values, side by side in storing order; a removed
      /// entry's key is `data_` itself and its value nil.
      private data_ ::= nil.
      /// The number of keys added or removed so far; an iteration
      /// compares it after every block that does not end it.
      private modifications ::= 0.
    |
    createTable: capacity.
  ) (
    /// Identifies the receiver as a Map, without a class test.
    ///
    /// @answers true.
    public isKindOfMap = (
      ^true.
    )

    /// The table of the indices in `data_`, rebuilt from `data_` by
    /// `rehash` whenever it is nil.
    private lazy hashtable_ ::= rehash.

    /// Reports the map's size, in constant time.
    ///
    /// @answers the number of keys, an Integer.
    public size = (
      ^size_.
    )

    /// Tests the map for keys, in constant time.
    ///
    /// @answers whether the map holds no key, a Boolean.
    public isEmpty = (
      ^0 = size_.
    )

    /// Looks `key` up by its `hash`, comparing with `=`.
    ///
    /// @param key any object whose `hash` agrees with its `=`.
    /// @answers the value stored under `key`.
    /// @signals NotFound carrying `key`, 'key not found: …' and the key's
    /// `printString`, when the map holds no such key.
    public at: key = (
      |
        keyIndex = scanFor: key in: hashtable_.
      |
      keyIndex < 0 ifTrue: [^(NotFound element: key) signal: 'key not found: ' , key printString].
      ^data_ at: keyIndex + 1.
    )

    /// Looks `key` up, falling back on `onAbsent` when the map holds no
    /// such key.
    ///
    /// @param key any object whose `hash` agrees with its `=`.
    /// @param onAbsent anything understanding `value`; sent it only when
    /// the key is absent.
    /// @answers the value stored under `key`, or the value of `onAbsent`
    /// when the map holds no such key.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 0', for an `onAbsent` that declares
    /// any parameter, when the map holds no such key.
    public at: key ifAbsent: onAbsent = (
      |
        keyIndex = scanFor: key in: hashtable_.
      |
      keyIndex < 0 ifTrue: [^onAbsent value].
      ^data_ at: keyIndex + 1.
    )

    /// Looks `key` up; when the map holds no such key, stores the value
    /// of `generator` under it.
    ///
    /// @param key any object whose `hash` agrees with its `=`.
    /// @param generator anything understanding `value`; sent it only when
    /// the key is absent.
    /// @answers the value stored under `key`, or the value of `generator`
    /// just stored there.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 0', for a `generator` that declares
    /// any parameter, when the map holds no such key; nothing is stored.
    public at: key ifAbsentPut: generator = (
      ^self at: key ifAbsent: [self at: key put: generator value].
    )

    /// Stores `value` under `key`. A new key comes last in the order and
    /// counts as a change for an iteration running meanwhile; an existing
    /// key keeps its place and does not.
    ///
    /// @param key any object whose `hash` agrees with its `=`.
    /// @param value any object.
    /// @answers `value`.
    public at: key put: value = (
      |
        table = hashtable_.
        keyIndex = scanFor: key in: table.
      |
      keyIndex < 0 ifTrue: [^insert: key value: value at: 0 - keyIndex in: table].
      data_ at: keyIndex + 1 put: value.
      ^value.
    )

    /// Looks `key` up without reading its value.
    ///
    /// @param key any object whose `hash` agrees with its `=`.
    /// @answers whether the map holds `key`, a Boolean.
    public includesKey: key = (
      ^(scanFor: key in: hashtable_) > 0.
    )

    /// Removes `key` and its value.
    ///
    /// @param key any object whose `hash` agrees with its `=`.
    /// @answers the value `key` had.
    /// @signals NotFound carrying `key`, 'key not found: …' and the key's
    /// `printString`, when the map holds no such key.
    public removeKey: key = (
      ^self removeKey: key ifAbsent: [
        (NotFound element: key) signal: 'key not found: ' , key printString.
      ].
    )

    /// Removes `key` and its value; when the map holds no such key,
    /// leaves the map unchanged.
    ///
    /// @param key any object whose `hash` agrees with its `=`.
    /// @param onAbsent anything understanding `value`.
    /// @answers the value `key` had; when the map holds no such key, the
    /// value of `onAbsent`.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 0', for an `onAbsent` that declares
    /// any parameter, when the map holds no such key.
    public removeKey: key ifAbsent: onAbsent = (
      |
        keyIndex = scanFor: key in: hashtable_.
        value
      |
      keyIndex < 0 ifTrue: [^onAbsent value].
      value:: data_ at: keyIndex + 1.
      data_ at: keyIndex put: data_.
      data_ at: keyIndex + 1 put: nil.
      size_:: size_ - 1.
      modifications:: modifications + 1.
      ^value.
    )

    /// Removes every key; the capacity stays.
    ///
    /// `benchmarks/are-we-fast-yet/Havlak.ns` empties its map for every
    /// loop search and fills it again with as many nodes.
    ///
    /// @answers the receiver.
    public removeAll = (
      createTable: data_ size // 2 - 1.
      modifications:: modifications + 1.
    )

    /// Stores every key and value of `aMap` in the receiver, in `aMap`'s
    /// order. The receiver itself as `aMap` changes nothing.
    ///
    /// @param aMap a Map, or anything understanding `keysAndValuesDo:`.
    /// @answers `aMap`.
    public addAll: aMap = (
      aMap keysAndValuesDo: [:key :value | self at: key put: value].
      ^aMap.
    )

    /// Evaluates `action` with each value, in the order of the keys.
    ///
    /// @param action a one-argument block, or anything understanding
    /// `value:`.
    /// @answers the receiver.
    /// @signals ConcurrentModification after the evaluation of `action`
    /// that added or removed a key.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for an `action` that does not
    /// take one argument, when the map is not empty.
    public do: action = (
      |
        data = data_.
        end = used_ * 2.
        expected = modifications.
        keyIndex ::= 1.
      |
      [keyIndex < end] whileTrue: [
        data == (data at: keyIndex) ifFalse: [
          action value: (data at: keyIndex + 1).
          expected = modifications ifFalse: [^signalModificationOf: self].
        ].
        keyIndex:: keyIndex + 2.
      ].
    )

    /// Evaluates `action` with each key and its value, in the order of
    /// the keys.
    ///
    /// @param action a two-argument block, given the key and the value.
    /// @answers the receiver.
    /// @signals ConcurrentModification as `do:` does.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for an `action` that does not
    /// take two arguments, when the map is not empty.
    public keysAndValuesDo: action = (
      |
        data = data_.
        end = used_ * 2.
        expected = modifications.
        keyIndex ::= 1.
      |
      [keyIndex < end] whileTrue: [
        data == (data at: keyIndex) ifFalse: [
          action value: (data at: keyIndex) value: (data at: keyIndex + 1).
          expected = modifications ifFalse: [^signalModificationOf: self].
        ].
        keyIndex:: keyIndex + 2.
      ].
    )

    /// Copies the keys out into an Array the map does not share.
    ///
    /// @answers a new Array of the keys, in their order.
    public keys = (
      ^self entriesAt: 0.
    )

    /// Copies the values out into an Array the map does not share.
    ///
    /// @answers a new Array of the values, in the order of the keys.
    public values = (
      ^self entriesAt: 1.
    )

    /// Maps every value through `transform`, keeping the keys, into a new
    /// map from `newForCollectUsingAdd:` -- a Map, an IdentityMap for an
    /// IdentityMap.
    ///
    /// @param transform a one-argument block, given a value.
    /// @answers the new map, holding each key with `transform`'s answer
    /// for its value, in the same order.
    /// @signals ConcurrentModification as `keysAndValuesDo:` does.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `transform` that does not
    /// take one argument, when the map is not empty.
    public collect: transform = (
      |
        result = self newForCollectUsingAdd: size_.
      |
      self keysAndValuesDo: [:key :value | result at: key put: (transform value: value)].
      ^result.
    )

    /// Keeps the entries whose values `predicate` answers true for, in a
    /// new map from `newForCollectUsingAdd:`.
    ///
    /// @param predicate a one-argument block answering a Boolean, given a
    /// value.
    /// @answers the new map, holding the keys whose values `predicate`
    /// answers true for, with their values, in the same order.
    /// @signals ConcurrentModification as `keysAndValuesDo:` does.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the map is not empty.
    public select: predicate = (
      |
        result = self newForCollectUsingAdd: size_.
      |
      self keysAndValuesDo: [:key :value |
        (predicate value: value) ifTrue: [result at: key put: value].
      ].
      ^result.
    )

    /// Drops the entries whose values `predicate` answers true for, in a
    /// new map from `newForCollectUsingAdd:`.
    ///
    /// @param predicate a one-argument block answering a Boolean, given a
    /// value.
    /// @answers the new map, holding the keys whose values `predicate`
    /// answers false for, with their values, in the same order.
    /// @signals ConcurrentModification as `keysAndValuesDo:` does.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the map is not empty.
    public reject: predicate = (
      ^self select: [:value | (predicate value: value) not].
    )

    /// Makes the empty map that `collect:`, `select:` and `reject:`
    /// fill.
    ///
    /// @param capacity an Integer of at least 0, the number of keys the
    /// answer is to have room for.
    /// @answers a new, empty Map with room for `capacity` keys.
    protected newForCollectUsingAdd: capacity = (
      ^Map new: capacity.
    )

    /// Hands the data array to a subclass's own `scanFor:in:`, which
    /// reads it and must neither store into it nor hand it on, since the
    /// array is the removed mark and no key may be it.
    ///
    /// @answers `data_` itself, not a copy: the keys and values side by
    /// side, each removed entry's key the array itself.
    protected dataForScan = (
      ^data_.
    )

    /// Copies the live entries' keys or values out, in storing order.
    ///
    /// @param offset 0 for the keys, 1 for the values.
    /// @answers a new Array of the live entries' keys (`offset` 0) or
    /// values (`offset` 1), in storing order.
    private entriesAt: offset = (
      |
        result = Array new: size_.
        data = data_.
        end = used_ * 2.
        count ::= 0.
        keyIndex ::= 1.
      |
      [keyIndex < end] whileTrue: [
        data == (data at: keyIndex) ifFalse: [
          count:: count + 1.
          result at: count put: (data at: keyIndex + offset).
        ].
        keyIndex:: keyIndex + 2.
      ].
      ^result.
    )

    /// Empties the map with room for `count + 1` entries -- `data_` of
    /// twice that, the table of `(count + 1) * 4 // 3` buckets, never
    /// fewer than the entries `data_` has room for.
    ///
    /// The table has at least as many buckets as `data_` has entries,
    /// and `insert:` rebuilds the map the moment `data_` is full, so no
    /// probe runs on a full table: every one meets an empty bucket,
    /// which is what ends `scanFor:in:` and `emptyBucketFor:in:`.
    ///
    /// The table is filled by `whileTrue:`, which the compiler inlines,
    /// rather than `to:do:`, which is a send: a closure and an activation
    /// per bucket, on every growth and every `removeAll`.
    ///
    /// @param count an Integer of at least 0.
    /// @answers the new table.
    /// @signals ArgumentError carrying `count`, 'new: requires a capacity
    /// of at least 0, got …', for a negative `count`.
    /// @signals ArgumentError the one `Array new:` signals for a size
    /// that is no Integer or too large.
    private createTable: count = (
      |
        table
        index
      |
      count < 0 ifTrue: [
        ^(ArgumentError value: count) signal: 'new: requires a capacity of at least 0, got '
            , count printString.
      ].
      size_:: 0.
      used_:: 0.
      data_:: Array new: count + 1 * 2.
      table:: Array new: count + 1 * 4 // 3.
      index:: table size.
      [index > 0] whileTrue: [
        table at: index put: 0.
        index:: index - 1.
      ].
      hashtable_:: table.
      ^table.
    )

    /// Stores a new entry at the end of `data_`, its index in the empty
    /// bucket `bucketIndex` of `table`, counts it as a change, and grows
    /// the map when `data_` is full.
    ///
    /// @param key the new key, which the map does not hold.
    /// @param value its value, any object.
    /// @param bucketIndex the empty bucket of `table` where `key` belongs:
    /// the negation of what `scanFor:in:` answered for it.
    /// @param table the map's current table.
    /// @answers `value`.
    private insert: key value: value at: bucketIndex in: table = (
      |
        keyIndex = used_ * 2 + 1.
      |
      data_ at: keyIndex put: key.
      data_ at: keyIndex + 1 put: value.
      table at: bucketIndex put: keyIndex.
      used_:: used_ + 1.
      size_:: size_ + 1.
      modifications:: modifications + 1.
      keyIndex + 2 > data_ size ifTrue: [rehash].
      ^value.
    )

    /// Builds a new table, with room for twice the live entries, from
    /// the live entries of `data_` in their order, dropping the removed
    /// ones. Runs when `data_` is full, and when the table slot is nil.
    ///
    /// @answers the new table.
    private rehash = (
      |
        oldData = data_.
        oldEnd = used_ * 2.
        table = createTable: size_ * 2.
        keyIndex ::= 1.
        key
        newIndex
      |
      [keyIndex < oldEnd] whileTrue: [
        key:: oldData at: keyIndex.
        oldData == key ifFalse: [
          newIndex:: used_ * 2 + 1.
          data_ at: newIndex put: key.
          data_ at: newIndex + 1 put: (oldData at: keyIndex + 1).
          table at: (emptyBucketFor: key in: table) put: newIndex.
          used_:: used_ + 1.
          size_:: size_ + 1.
        ].
        keyIndex:: keyIndex + 2.
      ].
      ^table.
    )

    /// Finds `key` in `table`: probes from the bucket of `key`'s `hash`
    /// onwards, passing removed entries without comparing them; `key` is
    /// the receiver of every `=`, and its `hash` and `=` are all it is
    /// sent.
    ///
    /// The probe is written out here and again, with `identityHash` and
    /// `==`, in IdentityMap, rather than sending a protected hook for
    /// the hash and the comparison: a self-send per probe step is a
    /// send and an activation on every lookup.
    ///
    /// @param key any object.
    /// @param table the table of the indices in `data_`, `hashtable_` or
    /// the one `rehash` is building.
    /// @answers the index in `data_` of the key `=` to `key`, or the
    /// negated index of the empty bucket of `table` where `key` belongs.
    /// @signals Error every one `key`'s `hash` and `=` signal. A `hash`
    /// answering no Integer is sent `\\` with the table's size, and
    /// signals what that signals.
    /// @signals MessageNotUnderstood of `\\`, for a `hash` answering an
    /// object that does not define it, a Float among them.
    protected scanFor: key in: table = (
      |
        data = data_.
        tableSize = table size.
        bucketIndex ::= key hash \\ tableSize + 1.
        keyIndex
        stored
      |
      [true] whileTrue: [
        keyIndex:: table at: bucketIndex.
        0 = keyIndex ifTrue: [^0 - bucketIndex].
        stored:: data at: keyIndex.
        (data == stored) ifFalse: [key = stored ifTrue: [^keyIndex]].
        bucketIndex = tableSize ifTrue: [bucketIndex:: 1] ifFalse: [bucketIndex:: bucketIndex + 1].
      ].
    )

    /// Finds where a key not yet in `table` goes, probing from the bucket
    /// of `key`'s `hash` onwards. Sends `key` only `hash`.
    ///
    /// Written out again in IdentityMap, as `scanFor:in:` is.
    ///
    /// @param key any object the table does not hold.
    /// @param table a table of indices in `data_` with an empty bucket.
    /// @answers the index of the first empty bucket of `table` from the
    /// bucket of `key`'s `hash` onwards.
    /// @signals Error every one `key`'s `hash` signals, and for a `hash`
    /// answering no Integer every one `scanFor:in:` signals for one.
    /// @see `scanFor:in:`.
    protected emptyBucketFor: key in: table = (
      |
        tableSize = table size.
        bucketIndex ::= key hash \\ tableSize + 1.
      |
      [0 = (table at: bucketIndex)] whileFalse: [
        bucketIndex = tableSize ifTrue: [bucketIndex:: 1] ifFalse: [bucketIndex:: bucketIndex + 1].
      ].
      ^bucketIndex.
    )
  ) : (
    /// Makes an empty map of the default capacity, `new: 3`.
    ///
    /// @answers an empty map with room for 3 keys.
    public new = (
      ^self new: 3.
    )

    /// Makes a map of `aMap`'s keys and values, sized to hold them.
    ///
    /// @param aMap a Map, or anything answering `size` and understanding
    /// `keysAndValuesDo:`.
    /// @answers a new map of `aMap`'s keys and values, in its order.
    public withAll: aMap = (
      ^(self new: aMap size)
          addAll: aMap;
          yourself.
    )
  )

  /// A Map that compares keys with `==` and finds them by their
  /// `identityHash`: two distinct objects are two keys however `=` they
  /// are, and no key's `=` or `hash` is ever sent. A value as key behaves
  /// as in a Map, since a value's `==` is its `=` and its `identityHash`
  /// its `hash`. Everything else is Map's: the order, removal,
  /// ConcurrentModification.
  ///
  /// @factory makes an empty identity map with room for `capacity` keys
  /// before it grows, as `Map new:` makes a map, and signals what it
  /// signals for a capacity.
  /// @param capacity an Integer of at least 0: the number of keys stored,
  /// none removed, before the map first grows.
  private class IdentityMap new: capacity = Map new: capacity () (
    /// Identifies the receiver as an IdentityMap, without a class test.
    ///
    /// @answers true.
    public isKindOfIdentityMap = (
      ^true.
    )

    /// Finds `key` in `table`: probes from the bucket of `key`'s
    /// `identityHash` onwards, passing removed entries without comparing
    /// them; each stored key on the way is compared by sending `==` to
    /// `key` with it as the argument, so `identityHash` and `==` are all
    /// `key` is sent.
    ///
    /// Map's probe written out with `identityHash` and `==`, for the
    /// reason Map's gives. The removed-mark test has the mark as its
    /// receiver, so `key`'s own `==` is never sent the data array.
    ///
    /// @param key any object.
    /// @param table the table of the indices in the data array, as Map's
    /// `scanFor:in:` takes it.
    /// @answers the index in the map's data array of the key `==` to
    /// `key`, or the negated index of the empty bucket of `table` where
    /// `key` belongs.
    /// @signals Error every one `key`'s `identityHash` and `==` signal.
    protected scanFor: key in: table = (
      |
        data = self dataForScan.
        tableSize = table size.
        bucketIndex ::= key identityHash \\ tableSize + 1.
        keyIndex
        stored
      |
      [true] whileTrue: [
        keyIndex:: table at: bucketIndex.
        0 = keyIndex ifTrue: [^0 - bucketIndex].
        stored:: data at: keyIndex.
        (data == stored) ifFalse: [key == stored ifTrue: [^keyIndex]].
        bucketIndex = tableSize ifTrue: [bucketIndex:: 1] ifFalse: [bucketIndex:: bucketIndex + 1].
      ].
    )

    /// Finds where a key not yet in `table` goes, probing from the bucket
    /// of `key`'s `identityHash` onwards. Sends `key` only
    /// `identityHash`.
    ///
    /// Map's written out with `identityHash`, for the reason Map's
    /// `scanFor:in:` gives.
    ///
    /// @param key any object the table does not hold.
    /// @param table a table of indices in the data array with an empty
    /// bucket.
    /// @answers the index of the first empty bucket of `table` from the
    /// bucket of `key`'s `identityHash` onwards.
    protected emptyBucketFor: key in: table = (
      |
        tableSize = table size.
        bucketIndex ::= key identityHash \\ tableSize + 1.
      |
      [0 = (table at: bucketIndex)] whileFalse: [
        bucketIndex = tableSize ifTrue: [bucketIndex:: 1] ifFalse: [bucketIndex:: bucketIndex + 1].
      ].
      ^bucketIndex.
    )

    /// Makes the empty identity map that `collect:`, `select:` and
    /// `reject:` fill.
    ///
    /// @param capacity an Integer of at least 0, the number of keys the
    /// answer is to have room for.
    /// @answers a new, empty IdentityMap with room for `capacity` keys.
    protected newForCollectUsingAdd: capacity = (
      ^IdentityMap new: capacity.
    )

    /// Stores `value` under `key`, which the map must hold already.
    ///
    /// @param key any object.
    /// @param value any object.
    /// @answers `value`.
    /// @signals NotFound carrying `key`, 'key not found: …' and the key's
    /// `printString`, when the map holds no such key, and stores nothing.
    public at: key putReplace: value = (
      (self includesKey: key) ifFalse: [
        ^(NotFound element: key) signal: 'key not found: ' , key printString.
      ].
      ^self at: key put: value.
    )

    /// Stores `value` under `key` when the map holds no such key; stores
    /// nothing when it does.
    ///
    /// @param key any object.
    /// @param value any object.
    /// @answers true when `value` was stored, false when the map held
    /// `key` already.
    public at: key ifAbsentPutVal: value = (
      (self includesKey: key) ifTrue: [^false].
      self at: key put: value.
      ^true.
    )

    /// Looks `key` up, falling back on `key` itself.
    ///
    /// @param key any object.
    /// @answers the value stored under `key`, or `key` itself when the
    /// map holds no such key.
    public atOrItself: key = (
      ^self at: key ifAbsent: [key].
    )
  ) : (
    /// Makes an empty identity map of the default capacity, `new: 3`.
    ///
    /// A class side is not inherited, so the factories `Map` declares
    /// are declared here again.
    ///
    /// @answers an empty identity map with room for 3 keys.
    public new = (
      ^self new: 3.
    )

    /// Makes an identity map of `aMap`'s keys and values, sized to hold
    /// them.
    ///
    /// @param aMap a Map, or anything answering `size` and understanding
    /// `keysAndValuesDo:`.
    /// @answers a new identity map of `aMap`'s keys and values, in its
    /// order.
    public withAll: aMap = (
      ^(self new: aMap size)
          addAll: aMap;
          yourself.
    )
  )

  /// A collection of distinct elements: `Set new`, `Set new: 20`,
  /// `Set withAll: {1. 2}`. An element is found by its `hash` and
  /// compared with `=`; every element's `hash` must agree with its `=`.
  /// Elements keep the order they were first added in; adding an element
  /// `=` to one the set holds replaces it in place.
  ///
  /// A Collection: `collect:`, `select:` and `reject:` answer Sets, so
  /// equal results of `collect:` merge.
  ///
  /// Adding or removing an element while `do:` or anything built on it
  /// runs over the set signals a ConcurrentModification after the block
  /// that did it; replacing an equal element does not.
  ///
  /// Map's representation with elements instead of key-value pairs: the
  /// elements in `data_` in adding order, `hashtable_` of their indices,
  /// `data_` itself overwriting a removed element as the removed mark, for
  /// Map's reasons.
  ///
  /// @factory makes an empty set with room for `capacity` elements before
  /// it grows, its table built at once by `createTable:`, which signals
  /// for a capacity that is negative or no Integer.
  /// @param capacity an Integer of at least 0: the number of elements
  /// added, none removed, before the set first grows.
  private class Set new: capacity = Collection (
    |
      /// The number of elements the set holds.
      /// A removed element, overwritten in `data_` by the mark, is not
      /// counted.
      private size_ ::= 0.
      /// The number of entries `data_` has been given since the table
      /// was last built, removed ones included: the next goes at
      /// `used_ + 1`.
      private used_ ::= 0.
      /// The elements in adding order; a removed one is `data_`
      /// itself.
      private data_ ::= nil.
      /// The number of elements added or removed so far; an iteration
      /// compares it after every block that does not end it.
      private modifications ::= 0.
    |
    createTable: capacity.
  ) (
    /// Identifies the receiver as a Set, without a class test.
    ///
    /// @answers true.
    public isKindOfSet = (
      ^true.
    )

    /// The table of the indices in `data_`, rebuilt from `data_` by
    /// `rehash` whenever it is nil.
    private lazy hashtable_ ::= rehash.

    /// Reports the set's size, in constant time.
    ///
    /// @answers the number of elements, an Integer.
    public size = (
      ^size_.
    )

    /// Tests the set for elements, in constant time.
    ///
    /// @answers whether the set holds no element, a Boolean.
    public isEmpty = (
      ^0 = size_.
    )

    /// Adds `element` last in the order, or replaces the element `=` to
    /// it that the set holds, which keeps its place. Only adding counts
    /// as a change for an iteration running meanwhile.
    ///
    /// @param element any object whose `hash` agrees with its `=`.
    /// @answers `element`.
    public add: element = (
      |
        table = hashtable_.
        index = scanFor: element in: table.
      |
      index < 0 ifTrue: [^insert: element at: 0 - index in: table].
      data_ at: index put: element.
      ^element.
    )

    /// Adds each element of `collection`, in its `do:` order. The set
    /// itself as `collection` changes nothing.
    ///
    /// @param collection a Collection, or anything understanding `do:`.
    /// @answers `collection`.
    public addAll: collection = (
      (collection == self ifTrue: [self asArray] ifFalse: [collection]) do: [:element |
        self add: element.
      ].
      ^collection.
    )

    /// Looks `element` up by its `hash`, comparing with `=`.
    ///
    /// @param element any object whose `hash` agrees with its `=`.
    /// @answers whether the set holds an element `=` to `element`, a
    /// Boolean.
    public includes: element = (
      ^(scanFor: element in: hashtable_) > 0.
    )

    /// Removes the element `=` to `element`.
    ///
    /// @param element any object whose `hash` agrees with its `=`.
    /// @answers `element`.
    /// @signals NotFound carrying `element`, 'element not found: …' and
    /// its `printString`, when the set holds none.
    public remove: element = (
      ^self remove: element ifAbsent: [
        (NotFound element: element) signal: 'element not found: ' , element printString.
      ].
    )

    /// Removes the element `=` to `element`; when the set holds none,
    /// leaves the set unchanged.
    ///
    /// @param element any object whose `hash` agrees with its `=`.
    /// @param onAbsent anything understanding `value`.
    /// @answers `element`; when the set holds none, the value of
    /// `onAbsent`.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 0', for an `onAbsent` that declares
    /// any parameter, when the set holds none.
    public remove: element ifAbsent: onAbsent = (
      |
        index = scanFor: element in: hashtable_.
      |
      index < 0 ifTrue: [^onAbsent value].
      data_ at: index put: data_.
      size_:: size_ - 1.
      modifications:: modifications + 1.
      ^element.
    )

    /// Removes each element of `collection`, in its `do:` order. The set
    /// itself as `collection` empties it.
    ///
    /// @param collection a Collection, or anything understanding `do:`.
    /// @answers `collection`.
    /// @signals NotFound carrying the first element of `collection` the
    /// set does not hold, as `remove:` does; the elements before it are
    /// removed.
    /// @see `remove:`.
    public removeAll: collection = (
      (collection == self ifTrue: [self asArray] ifFalse: [collection]) do: [:element |
        self remove: element.
      ].
      ^collection.
    )

    /// Removes every element for which `predicate` answers true.
    /// `predicate` sees every element once, in order, before anything is
    /// removed.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers the receiver.
    /// @signals ConcurrentModification after the evaluation of
    /// `predicate` that added or removed an element.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the set is not empty; nothing is removed.
    public removeAllSuchThat: predicate = (
      |
        elements = self asArray.
        expected = modifications.
        doomed = Array new: elements size.
        count ::= 0.
      |
      elements do: [:element |
        (predicate value: element) ifTrue: [
          count:: count + 1.
          doomed at: count put: element.
        ].
        expected = modifications ifFalse: [^signalModificationOf: self].
      ].
      1 to: count do: [:index | self remove: (doomed at: index)].
    )

    /// Removes every element; the capacity stays.
    ///
    /// @answers the receiver.
    public removeAll = (
      createTable: data_ size - 1.
      modifications:: modifications + 1.
    )

    /// Evaluates `action` with each element, in adding order.
    ///
    /// @param action a one-argument block, or anything understanding
    /// `value:`.
    /// @answers the receiver.
    /// @signals ConcurrentModification after the evaluation of `action`
    /// that added or removed an element.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for an `action` that does not
    /// take one argument, when the set is not empty.
    public do: action = (
      |
        data = data_.
        end = used_.
        expected = modifications.
        index ::= 1.
        element
      |
      [index <= end] whileTrue: [
        element:: data at: index.
        data == element ifFalse: [
          action value: element.
          expected = modifications ifFalse: [^signalModificationOf: self].
        ].
        index:: index + 1.
      ].
    )

    /// Copies the elements out into an Array the set does not share.
    ///
    /// @answers a new Array of the elements, in adding order.
    public asArray = (
      |
        result = Array new: size_.
        data = data_.
        count ::= 0.
      |
      1 to: used_ do: [:index |
        data == (data at: index) ifFalse: [
          count:: count + 1.
          result at: count put: (data at: index).
        ].
      ].
      ^result.
    )

    /// Makes the empty set that `collect:`, `select:` and `reject:` fill.
    ///
    /// @param capacity an Integer of at least 0, the number of elements
    /// the answer is to have room for.
    /// @answers a new, empty Set with room for `capacity` elements.
    protected newForCollectUsingAdd: capacity = (
      ^Set new: capacity.
    )

    /// Empties the set with room for `count + 1` elements, the table of
    /// `(count + 1) * 4 // 3` buckets, never fewer than the elements
    /// `data_` has room for.
    ///
    /// As in Map: the table has at least as many buckets as `data_` has
    /// slots, and `insert:` rebuilds the set the moment `data_` is
    /// full, so no probe runs on a full table. Filled by `whileTrue:`
    /// rather than `to:do:`, as Map's table is.
    ///
    /// @param count an Integer of at least 0.
    /// @answers the new table.
    /// @signals ArgumentError carrying `count`, 'new: requires a capacity
    /// of at least 0, got …', for a negative `count`.
    /// @signals ArgumentError the one `Array new:` signals for a size
    /// that is no Integer or too large.
    private createTable: count = (
      |
        table
        index
      |
      count < 0 ifTrue: [
        ^(ArgumentError value: count) signal: 'new: requires a capacity of at least 0, got '
            , count printString.
      ].
      size_:: 0.
      used_:: 0.
      data_:: Array new: count + 1.
      table:: Array new: count + 1 * 4 // 3.
      index:: table size.
      [index > 0] whileTrue: [
        table at: index put: 0.
        index:: index - 1.
      ].
      hashtable_:: table.
      ^table.
    )

    /// Stores `element` at the end of `data_`, its index in the empty
    /// bucket `bucketIndex` of `table`, counts it as a change, and grows
    /// the set when `data_` is full.
    ///
    /// @param element the new element, none `=` to which the set holds.
    /// @param bucketIndex the empty bucket of `table` where `element`
    /// belongs: the negation of what `scanFor:in:` answered for it.
    /// @param table the set's current table.
    /// @answers `element`.
    private insert: element at: bucketIndex in: table = (
      |
        index = used_ + 1.
      |
      data_ at: index put: element.
      table at: bucketIndex put: index.
      used_:: index.
      size_:: size_ + 1.
      modifications:: modifications + 1.
      index + 1 > data_ size ifTrue: [rehash].
      ^element.
    )

    /// Builds a new table, with room for twice the live elements, from
    /// the live elements of `data_` in their order, dropping the
    /// removed ones. Runs when `data_` is full, and when the table slot
    /// is nil.
    ///
    /// A `whileTrue:` loop rather than `to:do:`, for the reason Map's
    /// `createTable:` gives: it runs once per element on every growth.
    ///
    /// @answers the new table.
    private rehash = (
      |
        oldData = data_.
        oldEnd = used_.
        table = createTable: size_ * 2.
        element
        index ::= 1.
      |
      [index <= oldEnd] whileTrue: [
        element:: oldData at: index.
        oldData == element ifFalse: [
          used_:: used_ + 1.
          size_:: size_ + 1.
          data_ at: used_ put: element.
          table at: (emptyBucketFor: element in: table) put: used_.
        ].
        index:: index + 1.
      ].
      ^table.
    )

    /// Finds `element` in `table`: probes from its `hash` bucket onwards,
    /// passing removed elements without comparing them; `element` is the
    /// receiver of every `=`.
    ///
    /// @param element any object.
    /// @param table the table of the indices in `data_`, `hashtable_` or
    /// the one `rehash` is building.
    /// @answers the index in `data_` of the element `=` to `element`, or
    /// the negated index of the empty bucket of `table` where it belongs.
    /// @signals Error every one `element`'s `hash` and `=` signal, and for
    /// a `hash` answering no Integer every one Map's `scanFor:in:` signals
    /// for one.
    private scanFor: element in: table = (
      |
        data = data_.
        tableSize = table size.
        bucketIndex ::= element hash \\ tableSize + 1.
        index
        stored
      |
      [true] whileTrue: [
        index:: table at: bucketIndex.
        0 = index ifTrue: [^0 - bucketIndex].
        stored:: data at: index.
        (data == stored) ifFalse: [element = stored ifTrue: [^index]].
        bucketIndex = tableSize ifTrue: [bucketIndex:: 1] ifFalse: [bucketIndex:: bucketIndex + 1].
      ].
    )

    /// Finds where an element not yet in `table` goes, probing from
    /// `element`'s `hash` bucket onwards.
    ///
    /// @param element any object the table does not hold.
    /// @param table a table of indices in `data_` with an empty bucket.
    /// @answers the index of the first empty bucket of `table` from
    /// `element`'s `hash` bucket onwards.
    private emptyBucketFor: element in: table = (
      |
        tableSize = table size.
        bucketIndex ::= element hash \\ tableSize + 1.
      |
      [0 = (table at: bucketIndex)] whileFalse: [
        bucketIndex = tableSize ifTrue: [bucketIndex:: 1] ifFalse: [bucketIndex:: bucketIndex + 1].
      ].
      ^bucketIndex.
    )
  ) : (
    /// Makes an empty set of the default capacity, `Set new: 3`.
    ///
    /// @answers an empty Set with room for 3 elements.
    public new = (
      ^self new: 3.
    )

    /// Makes a set of `collection`'s elements, sized to hold them all.
    ///
    /// @param collection a Collection, or anything answering `size` and
    /// `do:`.
    /// @answers a new Set of `collection`'s elements, in its `do:` order,
    /// equal ones merged.
    public withAll: collection = (
      ^(self new: collection size)
          addAll: collection;
          yourself.
    )
  )

  /// Builds the collections namespace: the one public member of the
  /// module, named `build` like every shipped factory's.
  ///
  /// @answers a new `Collections` namespace: the facet `platform
  /// collections` answers.
  public build = (
    ^Collections new.
  )
)
