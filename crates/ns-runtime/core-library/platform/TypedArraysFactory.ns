    /// A refused store leaves the element as it was.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value an Integer from 0 to 18446744073709551615.
    /// @answers `value` itself.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at:put: requires an
    /// Integer index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @signals ArgumentError carrying `value`, 'at:put: requires an
    /// Integer from 0 to 18446744073709551615, got …', for a value outside
    /// that range or no Integer.
    /// @see `noByteArray:`.
    public at: index put: value = (
      ^vmMirror byteArray: bytes uint64ElementAt: index put: value ifFail: [
        ^self noByteArray: #at:put:.
      ].
    )

    /// Makes the new instance the sequence protocol builds its answers in:
    /// a Uint64Array of `size` elements, each 0, over a new ByteArray -- a
    /// Uint64Array even for a receiver of a subclass, whose class side,
    /// flat (§3.2), need not answer `new:`.
    ///
    /// @param size an Integer of at least 0.
    /// @answers the new Uint64Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    protected newOfSize: size = (
      ^outer TypedArraysFactory Uint64Array new: size.
    )
  ) : (
    /// Makes a Uint64Array of `size` elements, each 0, over a new ByteArray
    /// of `size` × 8 bytes.
    ///
    /// @param size an Integer, at least 0.
    /// @answers the new Uint64Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    public new: size = (
      ^self on: (outer TypedArraysFactory TypedArray bytesFor: size width: 8).
    )

