/// The typed arrays' module: `TypedArray` and its ten subclasses,
/// `Int8Array` to `Float64Array`, fixed-size sequences of numbers of one
/// kind stored in a ByteArray, reached through `platform typedArrays`.
/// Built once, on first demand, over the VM mirror and the kernel, from
/// which it takes `Collection`, `IndexedCollection` and `ArgumentError`;
/// `ByteArray` it names bare, through `Object`'s accessor.
///
/// The factory pattern `PlatformFactory.ns` is written in: this root holds
/// the VM mirror, which the platform's root hands it, and of the kernel only
/// the three classes it needs, never the kernel instance; nothing hands
/// its instance to a program. The platform's root builds it once, through
/// the mirror, on its first use and keeps it in a private lazy slot,
/// and each platform's `typedArrays` getter sends it `build`, its one
/// public member. What a program gets is the `TypedArrays` facet `build`
/// answers, which hands out this module's classes by class accessors,
/// each exactly `^outer TypedArraysFactory <Name>` -- a lexical send,
/// which reaches the root's private classes (§5.9), and which lets an
/// image name the class by its declaration
/// (`docs/design/image-format.md`, "Shipped names"). Its nested classes
/// are private and reach the mirror lexically, as members of this root,
/// never through a slot of their own. Nothing a program can name answers
/// this root's instance or its class, so no program can build one over
/// something that is not the mirror. Keep it so: no code whose receiver
/// is this root's instance may send it anything it does not understand,
/// since a `MessageNotUnderstood` hands its receiver to whoever catches
/// it.
///
/// The factory's parameters are copied into slots because neither a lazy
/// slot nor a method may name them (§6). A send to `vmMirror` here is a
/// mirror send, as in `Kernel.ns`: this module is resolved with
/// `resolve_kernel`, which only shipped source is.
///
/// A value (§3.1.1), so that every platform shares the one module and its
/// classes -- `platform typedArrays Int16Array` is one class however many
/// platforms a program makes; a typed array keeps its elements in a
/// ByteArray, so it is an object.
///
/// @factory makes the typed arrays module over `mirror` and `kernel`,
/// copying the mirror into `vmMirror` and the kernel's `ArgumentError`,
/// `Collection` and `IndexedCollection` into slots of their own and
/// keeping nothing else of the kernel. The platform's root sends it to the
/// class the mirror answers on the module's first demand, and again on the
/// next demand after an unwind interrupted one, which records nothing; the
/// loader sends it instead when an image names the module.
/// @param mirror the VM mirror, through which a typed array reads and
/// writes the elements in its ByteArray.
/// @param kernel the kernel module instance; its `Collection` is
/// `TypedArray`'s superclass, its `IndexedCollection` the mixin that gives
/// it the sequence protocol, its `ArgumentError` what a typed array
/// signals for a ByteArray it cannot view.
class TypedArraysFactory usingVmMirror: mirror kernel: kernel = Value (
  |
    /// The VM mirror the factory was given: the one object through which
    /// a typed array reads and writes its elements. Never handed out.
    private vmMirror = mirror.
    /// The kernel's `ArgumentError`, which a typed array signals for a
    /// ByteArray it cannot view.
    private ArgumentError = kernel ArgumentError.
    /// The kernel's `Collection`, the superclass of `TypedArray`: what makes
    /// a typed array a Collection, with the members written over `do:` that
    /// neither `IndexedCollection` nor `TypedArray` overrides.
    private Collection = kernel Collection.
    /// The kernel's `IndexedCollection`, the mixin `TypedArray` applies
    /// over `Collection` for the sequence protocol.
    private IndexedCollection = kernel IndexedCollection.
  |
) (
  /// `platform typedArrays`: the namespace of this module's classes,
  /// `TypedArray` and the ten typed arrays, one accessor each; nothing
  /// else. Its own class is not among them, so a program makes no second
  /// namespace.
  private class TypedArrays = Value () (
    /// Hands out the abstract superclass of the ten typed arrays, which a
    /// program tests a typed array against or subclasses; a subclass
    /// defines `bytesPerElement`, `at:`, `at:put:` and the protected
    /// `newOfSize:` its copies are made by.
    ///
    /// @answers this module's class `TypedArray`.
    public TypedArray = (
      ^outer TypedArraysFactory TypedArray.
    )

    /// Hands out the class a program makes Int8Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Int8Array`.
    public Int8Array = (
      ^outer TypedArraysFactory Int8Array.
    )

    /// Hands out the class a program makes Uint8Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Uint8Array`.
    public Uint8Array = (
      ^outer TypedArraysFactory Uint8Array.
    )

    /// Hands out the class a program makes Int16Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Int16Array`.
    public Int16Array = (
      ^outer TypedArraysFactory Int16Array.
    )

    /// Hands out the class a program makes Uint16Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Uint16Array`.
    public Uint16Array = (
      ^outer TypedArraysFactory Uint16Array.
    )

    /// Hands out the class a program makes Int32Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Int32Array`.
    public Int32Array = (
      ^outer TypedArraysFactory Int32Array.
    )

    /// Hands out the class a program makes Uint32Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Uint32Array`.
    public Uint32Array = (
      ^outer TypedArraysFactory Uint32Array.
    )

    /// Hands out the class a program makes Int64Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Int64Array`.
    public Int64Array = (
      ^outer TypedArraysFactory Int64Array.
    )

    /// Hands out the class a program makes Uint64Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Uint64Array`.
    public Uint64Array = (
      ^outer TypedArraysFactory Uint64Array.
    )

    /// Hands out the class a program makes Float32Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Float32Array`.
    public Float32Array = (
      ^outer TypedArraysFactory Float32Array.
    )

    /// Hands out the class a program makes Float64Arrays with: it
    /// instantiates it with `new`, `new:`, `withAll:` or `on:` a ByteArray.
    ///
    /// @answers this module's class `Float64Array`.
    public Float64Array = (
      ^outer TypedArraysFactory Float64Array.
    )
  )

  /// A fixed-size sequence of numbers of one kind -- Integers of one width
  /// and signedness, or Floats -- indexed from 1 and stored little-endian
  /// in a ByteArray, and a Collection: the abstract superclass of the ten
  /// typed arrays, `Int8Array` to `Float64Array`. A typed array is a view:
  /// `bytes` answers the ByteArray it reads and writes, itself and not a
  /// copy, so views over one ByteArray see each other's writes and the
  /// ByteArray's own. The sequence protocol comes from `IndexedCollection`:
  /// its copies are of the receiver's shipped class over a new ByteArray,
  /// a subclass's included, since each typed array's `newOfSize:` names
  /// its own class rather than asking a flat class side (§3.2) for `new:`;
  /// `collect:` answers an Array, and `indexOf:` compares with `=`, so 3
  /// finds 3.0. No value: `=` and `hash` are identity, since a hash of the
  /// elements would change under a Map's key as they are stored.
  ///
  /// Little-endian always, every target's own order, so that an access
  /// costs no swap and a ByteArray reads the same on every target; a
  /// big-endian block is read through `DataView`.
  ///
  /// @factory makes a view over `aByteArray`, which it keeps as `bytes`,
  /// itself and not a copy, once `viewable:` has checked that the view can
  /// hold it.
  /// @param aByteArray a ByteArray whose size is a multiple of the
  /// subclass's `bytesPerElement`.
  /// @signals ArgumentError carrying `aByteArray`, 'on: requires a
  /// ByteArray, got …' and its `printString`, for anything that answers
  /// false to `isKindOfByteArray`, as everything but a ByteArray does
  /// unless its class declares otherwise.
  /// @signals ArgumentError carrying `aByteArray`, 'on: requires a
  /// ByteArray whose size is a multiple of …, got a ByteArray of …', for
  /// one whose size is not.
  /// @signals Error of `subclassResponsibility`, for a ByteArray, when the
  /// class's `bytesPerElement` is still `TypedArray`'s abstract one.
  private class TypedArray on: aByteArray = Collection <: IndexedCollection (
    |
      /// The ByteArray the elements are stored in: the one `on:` was given,
      /// never a copy.
      public bytes = viewable: aByteArray.
    |
  ) (
    /// Identifies the receiver as a typed array, without a class test.
    ///
    /// @answers true.
    public isKindOfTypedArray = (
      ^true.
    )

    /// Says how many bytes of `bytes` an element takes; every typed array
    /// defines it.
    ///
    /// @answers nothing here, where it never returns; a typed array's own
    /// answers the number of bytes an element takes, an Integer from 1 to
    /// 8.
    /// @signals Error of `subclassResponsibility`, here: every typed array
    /// defines it.
    public bytesPerElement = (
      ^self subclassResponsibility.
    )

    /// Counts the elements: the size of `bytes` over `bytesPerElement`,
    /// fixed when the view was made.
    ///
    /// @answers the number of elements.
    /// @signals ArgumentError of `noByteArray:` when `bytes` answers false
    /// to `isKindOfByteArray`.
    /// @see `noByteArray:`.
    public size = (
      bytes isKindOfByteArray ifFalse: [^self noByteArray: #size].
      ^bytes size // self bytesPerElement.
    )

    /// Evaluates `action` with each element in turn, from the first,
    /// reading each element only when it reaches it, so that a store ahead
    /// of the walk is seen.
    ///
    /// @param action a block of one argument, or anything understanding
    /// `value:`; sent `value:` with each element.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a block that does not take
    /// one argument, when the receiver is not empty.
    public do: action = (
      1 to: self size do: [:index | action value: (self at: index)].
    )

    /// Reads the element at `index` out of `bytes`; every typed array
    /// defines it.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers nothing here, where it never returns; a typed array's own
    /// answers the element at `index`.
    /// @signals Error of `subclassResponsibility`, here: every typed array
    /// defines it.
    public at: index = (
      ^self subclassResponsibility.
    )

    /// Stores `value` at `index` in `bytes`; every typed array defines it.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value an element of the kind the typed array holds.
    /// @answers nothing here, where it never returns; a typed array's own
    /// answers `value`.
    /// @signals Error of `subclassResponsibility`, here: every typed array
    /// defines it.
    public at: index put: value = (
      ^self subclassResponsibility.
    )

    /// Makes the new instance the sequence protocol builds its answers in:
    /// a typed array of `size` elements, each 0, over a new ByteArray;
    /// every typed array defines it.
    ///
    /// @param size an Integer of at least 0.
    /// @answers nothing here, where it never returns; a typed array's own
    /// answers the new typed array.
    /// @signals Error of `subclassResponsibility`, here: every typed array
    /// defines it, naming its own class, since a class side is flat (§3.2)
    /// and a subclass's need not answer `new:`.
    protected newOfSize: size = (
      ^self subclassResponsibility.
    )

    /// Refuses an access to a view whose `bytes` answers anything but a
    /// ByteArray: an object that answers true to `isKindOfByteArray`
    /// without being one, which `on:` accepts; whatever a program's
    /// subclass that overrides `bytes` answers; or one only a crafted
    /// image can put there. It never returns: an Error is not resumable.
    ///
    /// Protected rather than private, since each typed array's own
    /// accessors signal it.
    ///
    /// @param selector the Symbol of the message the program sent.
    /// @answers nothing; it never returns.
    /// @signals ArgumentError carrying `bytes`, '<selector> found no
    /// ByteArray under the view, got …' and its `printString`.
    protected noByteArray: selector = (
      ^(outer TypedArraysFactory ArgumentError value: bytes) signal: selector asString
          , ' found no ByteArray under the view, got '
          , bytes printString.
    )

    /// Checks that the receiver can view `aByteArray`: a ByteArray whose
    /// size is a multiple of `bytesPerElement`. `on:` keeps what it answers
    /// as `bytes`.
    ///
    /// @param aByteArray the object `on:` was given, any object.
    /// @answers `aByteArray` itself.
    /// @signals ArgumentError of `on:`, carrying `aByteArray`, for anything
    /// else.
    /// @signals Error of `subclassResponsibility`, for a ByteArray, when the
    /// receiver's `bytesPerElement` is still `TypedArray`'s abstract one.
    /// @see `TypedArray`.
    private viewable: aByteArray = (
      aByteArray isKindOfByteArray ifFalse: [
        ^(outer
            TypedArraysFactory
            ArgumentError value: aByteArray) signal: 'on: requires a ByteArray, got '
            , aByteArray printString.
      ].
      aByteArray size \\ self bytesPerElement = 0 ifFalse: [
        ^(outer
            TypedArraysFactory
            ArgumentError value: aByteArray) signal: 'on: requires a ByteArray whose size is a multiple of '
            , self bytesPerElement printString
            , ', got a ByteArray of '
            , aByteArray size printString.
      ].
      ^aByteArray.
    )
  ) : (
    /// Makes the ByteArray a typed array's `new:` views: `size` × `width`
    /// bytes, each 0. The width is checked before anything about `size`,
    /// and every refusal is signalled before anything is allocated. A
    /// `size` that answers true to `isKindOfInteger` but is no Integer the
    /// VM knows is a size that is no Integer.
    ///
    /// Whether the bytes can be allocated is asked of the VM before
    /// allocating, the same decision `ByteArray new:` makes, so that the
    /// error carries the size the program gave rather than the byte count
    /// and no other error is caught and replaced. The width is checked by
    /// identity first, so that once `isKindOfInteger` has answered true and
    /// `< 0` false, the VM declines to answer only for a byte count that is
    /// no Integer it knows, which `size` alone can have caused: a real
    /// Integer of at least 0 times 1, 2, 4 or 8 is one. The decline is
    /// therefore refused as a size that is no Integer, under `new:`.
    ///
    /// @param size the size given to the typed array's `new:`.
    /// @param width the typed array's `bytesPerElement`: 1, 2, 4 or 8.
    /// @answers a new ByteArray of `size` × `width` bytes, each 0.
    /// @signals ArgumentError carrying `width`, 'bytesFor:width: requires a
    /// width of 1, 2, 4 or 8, got …' and its `printString`, for any other
    /// width, which no typed array gives.
    /// @signals ArgumentError carrying `size`, 'new: requires an Integer
    /// size, got …' and its `printString`, for a size that is no Integer.
    /// @signals ArgumentError carrying `size`, 'new: requires a size of at
    /// least 0, got …' and its `printString`, for a negative one.
    /// @signals ArgumentError carrying `size`, 'new: cannot allocate a
    /// ByteArray of … bytes', counting the bytes, for one too large to
    /// allocate.
    public bytesFor: size width: width = (
      |
        count
      |
      (width == 1 or: [width == 2 or: [width == 4 or: [width == 8]]]) ifFalse: [
        ^(outer
            TypedArraysFactory
            ArgumentError value: width) signal: 'bytesFor:width: requires a width of 1, 2, 4 or 8, got '
            , width printString.
      ].
      size isKindOfInteger ifFalse: [
        ^(outer
            TypedArraysFactory
            ArgumentError value: size) signal: 'new: requires an Integer size, got '
            , size printString.
      ].
      size < 0 ifTrue: [
        ^(outer
            TypedArraysFactory
            ArgumentError value: size) signal: 'new: requires a size of at least 0, got '
            , size printString.
      ].
      count:: size * width.
      (vmMirror byteArrayClass: ByteArray fits: count ifFail: [
        ^(outer
            TypedArraysFactory
            ArgumentError value: size) signal: 'new: requires an Integer size, got '
            , size printString.
      ]) ifFalse: [
        ^(outer
            TypedArraysFactory
            ArgumentError value: size) signal: 'new: cannot allocate a ByteArray of '
            , count printString
            , ' bytes'.
      ].
      ^ByteArray new: count.
    )

    /// Stores `collection`'s elements into `array` from its first index on,
    /// in `collection`'s `do:` order: what a typed array's `withAll:` fills
    /// its new array with. It signals what `array`'s `at:put:` signals for
    /// an element it cannot hold.
    ///
    /// @param array a typed array of at least `collection size` elements.
    /// @param collection anything answering `do:` whose elements `array`'s
    /// `at:put:` takes.
    /// @answers `array`.
    public fill: array from: collection = (
      |
        index ::= 0.
      |
      collection do: [:element |
        index:: index + 1.
        array at: index put: element.
      ].
      ^array.
    )
  )

  /// A typed array of signed bytes, each element an Integer from -128 to
  /// 127 in 1 byte. `TypedArray` describes the rest of the protocol.
  ///
  /// @factory makes an Int8Array viewing `aByteArray`, which it keeps as
  /// `bytes`, itself and not a copy.
  /// @param aByteArray a ByteArray whose size is a multiple of 1.
  /// @signals ArgumentError of `TypedArray`'s `on:`.
  /// @see `TypedArray`.
  private class Int8Array on: aByteArray = TypedArray on: aByteArray () (
    /// Says the width of an element in `bytes`, by which `size` divides
    /// the ByteArray's size.
    ///
    /// @answers 1, the number of bytes an element takes.
    public bytesPerElement = (
      ^1.
    )

    /// Reads the element at `index` from its byte in `bytes`.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the element, an Integer from -128 to 127.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at: requires an Integer
    /// index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @see `noByteArray:`.
    public at: index = (
      ^vmMirror byteArray: bytes int8ElementAt: index ifFail: [^self noByteArray: #at:].
    )

    /// Stores `value` at `index`, in its byte of `bytes`. A refused store
    /// leaves the element as it was.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value an Integer from -128 to 127.
    /// @answers `value` itself.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at:put: requires an
    /// Integer index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @signals ArgumentError carrying `value`, 'at:put: requires an
    /// Integer from -128 to 127, got …', for a value outside that range or
    /// no Integer.
    /// @see `noByteArray:`.
    public at: index put: value = (
      ^vmMirror byteArray: bytes int8ElementAt: index put: value ifFail: [
        ^self noByteArray: #at:put:.
      ].
    )

    /// Makes the new instance the sequence protocol builds its answers in:
    /// an Int8Array of `size` elements, each 0, over a new ByteArray -- an
    /// Int8Array even for a receiver of a subclass, whose class side, flat
    /// (§3.2), need not answer `new:`.
    ///
    /// @param size an Integer of at least 0.
    /// @answers the new Int8Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    protected newOfSize: size = (
      ^outer TypedArraysFactory Int8Array new: size.
    )
  ) : (
    /// Makes an Int8Array of `size` elements, each 0, over a new ByteArray
    /// of `size` × 1 bytes.
    ///
    /// @param size an Integer, at least 0.
    /// @answers the new Int8Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    public new: size = (
      ^self on: (outer TypedArraysFactory TypedArray bytesFor: size width: 1).
    )

    /// Makes an Int8Array of no elements, over an empty ByteArray.
    ///
    /// @answers the new, empty Int8Array.
    public new = (
      ^self new: 0.
    )

    /// Makes an Int8Array of `collection size` elements and stores
    /// `collection`'s elements into it, in its `do:` order. It signals what
    /// `at:put:` signals for the first element it cannot hold.
    ///
    /// @param collection anything answering `size` and `do:` whose elements
    /// are Integers from -128 to 127 -- an Array, a List, a typed array.
    /// @answers the new Int8Array.
    public withAll: collection = (
      ^outer TypedArraysFactory TypedArray fill: (self new: collection size) from: collection.
    )

    /// Says the width of an element without an instance: the number of
    /// bytes per element `new:` allocates.
    ///
    /// @answers 1, the number of bytes an element takes.
    public bytesPerElement = (
      ^1.
    )
  )

  /// A typed array of unsigned bytes, each element an Integer from 0 to 255
  /// in 1 byte. `TypedArray` describes the rest of the protocol.
  ///
  /// @factory makes a Uint8Array viewing `aByteArray`, which it keeps as
  /// `bytes`, itself and not a copy.
  /// @param aByteArray a ByteArray whose size is a multiple of 1.
  /// @signals ArgumentError of `TypedArray`'s `on:`.
  /// @see `TypedArray`.
  private class Uint8Array on: aByteArray = TypedArray on: aByteArray () (
    /// Says the width of an element in `bytes`, by which `size` divides
    /// the ByteArray's size.
    ///
    /// @answers 1, the number of bytes an element takes.
    public bytesPerElement = (
      ^1.
    )

    /// Reads the element at `index`, the byte at that index of `bytes`.
    ///
    /// An element is a byte of `bytes`, so the ByteArray's own `at:`
    /// answers it.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the element, an Integer from 0 to 255.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at: requires an Integer
    /// index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` answers false
    /// to `isKindOfByteArray`.
    /// @see `noByteArray:`.
    public at: index = (
      bytes isKindOfByteArray ifFalse: [^self noByteArray: #at:].
      ^bytes at: index.
    )

    /// Stores `value` at `index`, as the byte at that index of `bytes`. A
    /// refused store leaves the element as it was.
    ///
    /// An element is a byte of `bytes`, so the ByteArray's own `at:put:`
    /// stores it.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value an Integer from 0 to 255.
    /// @answers `value` itself.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at:put: requires an
    /// Integer index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` answers false
    /// to `isKindOfByteArray`.
    /// @signals ArgumentError carrying `value`, 'at:put: requires an
    /// Integer from 0 to 255, got …', for a value outside that range or no
    /// Integer.
    /// @see `noByteArray:`.
    public at: index put: value = (
      bytes isKindOfByteArray ifFalse: [^self noByteArray: #at:put:].
      ^bytes at: index put: value.
    )

    /// Makes the new instance the sequence protocol builds its answers in:
    /// a Uint8Array of `size` elements, each 0, over a new ByteArray -- a
    /// Uint8Array even for a receiver of a subclass, whose class side, flat
    /// (§3.2), need not answer `new:`.
    ///
    /// @param size an Integer of at least 0.
    /// @answers the new Uint8Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    protected newOfSize: size = (
      ^outer TypedArraysFactory Uint8Array new: size.
    )
  ) : (
    /// Makes a Uint8Array of `size` elements, each 0, over a new ByteArray
    /// of `size` × 1 bytes.
    ///
    /// @param size an Integer, at least 0.
    /// @answers the new Uint8Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    public new: size = (
      ^self on: (outer TypedArraysFactory TypedArray bytesFor: size width: 1).
    )

    /// Makes a Uint8Array of no elements, over an empty ByteArray.
    ///
