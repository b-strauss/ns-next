    /// Says the width of an element without an instance: the number of
    /// bytes per element `new:` allocates.
    ///
    /// @answers 8, the number of bytes an element takes.
    public bytesPerElement = (
      ^8.
    )
  )

  /// A typed array of binary32 floats, each element a Float in 4 bytes,
  /// little-endian. `at:put:` takes any Number, converted as `asFloat`
  /// converts it and then rounded to the nearest binary32, a tie to the one
  /// whose last bit is even, a finite value past binary32's range becoming
  /// an infinity of its sign and a NaN staying a NaN; `at:` answers the
  /// binary32 widened exactly. `TypedArray` describes the rest of the
  /// protocol.
  ///
  /// @factory makes a Float32Array viewing `aByteArray`, which it keeps as
  /// `bytes`, itself and not a copy.
  /// @param aByteArray a ByteArray whose size is a multiple of 4.
  /// @signals ArgumentError of `TypedArray`'s `on:`.
  /// @see `TypedArray`.
  private class Float32Array on: aByteArray = TypedArray on: aByteArray () (
    /// Says the width of an element in `bytes`, by which `size` divides
    /// the ByteArray's size.
    ///
    /// @answers 4, the number of bytes an element takes.
    public bytesPerElement = (
      ^4.
    )

    /// Reads the element at `index` from its 4 bytes in `bytes`,
    /// little-endian, and widens the binary32 exactly.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the element, a Float.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at: requires an Integer
    /// index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @see `noByteArray:`.
    public at: index = (
      ^vmMirror byteArray: bytes float32ElementAt: index ifFail: [^self noByteArray: #at:].
    )

    /// Stores `value` at `index`, converted as `asFloat` converts it and
    /// rounded to binary32, in its 4 bytes of `bytes`, little-endian. A
    /// refused store leaves the element as it was.
    ///
    /// The leaf takes only a Float, so the conversion happens here; a value
    /// that is no Number reaches the leaf as it is, so that the index is
    /// checked first and the refusal names the value given.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value a Number.
    /// @answers `value` itself.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at:put: requires an
    /// Integer index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @signals ArgumentError carrying `value`, 'at:put: requires a Number,
    /// got …', for a value that is no Number.
    /// @see `noByteArray:`.
    public at: index put: value = (
      vmMirror byteArray: bytes
          float32ElementAt: index
          put: (value isKindOfNumber ifTrue: [value asFloat] ifFalse: [value])
          ifFail: [^self noByteArray: #at:put:].
      ^value.
    )

    /// Makes the new instance the sequence protocol builds its answers in:
    /// a Float32Array of `size` elements, each 0, over a new ByteArray -- a
    /// Float32Array even for a receiver of a subclass, whose class side,
    /// flat (§3.2), need not answer `new:`.
    ///
    /// @param size an Integer of at least 0.
    /// @answers the new Float32Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    protected newOfSize: size = (
      ^outer TypedArraysFactory Float32Array new: size.
    )
  ) : (
    /// Makes a Float32Array of `size` elements, each 0, over a new
    /// ByteArray of `size` × 4 bytes.
    ///
    /// @param size an Integer, at least 0.
    /// @answers the new Float32Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    public new: size = (
      ^self on: (outer TypedArraysFactory TypedArray bytesFor: size width: 4).
    )

    /// Makes a Float32Array of no elements, over an empty ByteArray.
    ///
    /// @answers the new, empty Float32Array.
    public new = (
      ^self new: 0.
    )

    /// Makes a Float32Array of `collection size` elements and stores
    /// `collection`'s elements into it, in its `do:` order. It signals what
    /// `at:put:` signals for the first element it cannot hold.
    ///
    /// @param collection anything answering `size` and `do:` whose elements
    /// are Numbers -- an Array, a List, a typed array.
    /// @answers the new Float32Array.
    public withAll: collection = (
      ^outer TypedArraysFactory TypedArray fill: (self new: collection size) from: collection.
    )

    /// Says the width of an element without an instance: the number of
    /// bytes per element `new:` allocates.
    ///
    /// @answers 4, the number of bytes an element takes.
    public bytesPerElement = (
      ^4.
    )
  )

  /// A typed array of binary64 floats, each element a Float in 8 bytes,
  /// little-endian. `at:put:` takes any Number, converted as `asFloat`
  /// converts it. `TypedArray` describes the rest of the protocol.
  ///
  /// @factory makes a Float64Array viewing `aByteArray`, which it keeps as
  /// `bytes`, itself and not a copy.
  /// @param aByteArray a ByteArray whose size is a multiple of 8.
  /// @signals ArgumentError of `TypedArray`'s `on:`.
  /// @see `TypedArray`.
  private class Float64Array on: aByteArray = TypedArray on: aByteArray () (
    /// Says the width of an element in `bytes`, by which `size` divides
    /// the ByteArray's size.
    ///
    /// @answers 8, the number of bytes an element takes.
    public bytesPerElement = (
      ^8.
    )

    /// Reads the element at `index` from its 8 bytes in `bytes`,
    /// little-endian.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the element, a Float.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at: requires an Integer
    /// index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @see `noByteArray:`.
    public at: index = (
      ^vmMirror byteArray: bytes float64ElementAt: index ifFail: [^self noByteArray: #at:].
    )

    /// Stores `value` at `index`, converted as `asFloat` converts it, in
    /// its 8 bytes of `bytes`, little-endian. A refused store leaves the
    /// element as it was.
    ///
    /// The leaf takes only a Float, so the conversion happens here; a value
    /// that is no Number reaches the leaf as it is, so that the index is
    /// checked first and the refusal names the value given.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value a Number.
    /// @answers `value` itself.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at:put: requires an
    /// Integer index, got …', for an index that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @signals ArgumentError carrying `value`, 'at:put: requires a Number,
    /// got …', for a value that is no Number.
    /// @see `noByteArray:`.
    public at: index put: value = (
      vmMirror byteArray: bytes
          float64ElementAt: index
          put: (value isKindOfNumber ifTrue: [value asFloat] ifFalse: [value])
          ifFail: [^self noByteArray: #at:put:].
      ^value.
    )

    /// Makes the new instance the sequence protocol builds its answers in:
    /// a Float64Array of `size` elements, each 0, over a new ByteArray -- a
    /// Float64Array even for a receiver of a subclass, whose class side,
    /// flat (§3.2), need not answer `new:`.
    ///
    /// @param size an Integer of at least 0.
    /// @answers the new Float64Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    protected newOfSize: size = (
      ^outer TypedArraysFactory Float64Array new: size.
    )
  ) : (
    /// Makes a Float64Array of `size` elements, each 0, over a new
    /// ByteArray of `size` × 8 bytes.
    ///
    /// @param size an Integer, at least 0.
    /// @answers the new Float64Array.
    /// @signals ArgumentError of `TypedArray bytesFor:width:` for a `size`
    /// that is negative, no Integer or too large to allocate.
    /// @see `TypedArray bytesFor:width:`.
    public new: size = (
      ^self on: (outer TypedArraysFactory TypedArray bytesFor: size width: 8).
    )

    /// Makes a Float64Array of no elements, over an empty ByteArray.
    ///
    /// @answers the new, empty Float64Array.
    public new = (
      ^self new: 0.
    )

    /// Makes a Float64Array of `collection size` elements and stores
    /// `collection`'s elements into it, in its `do:` order. It signals what
    /// `at:put:` signals for the first element it cannot hold.
    ///
    /// @param collection anything answering `size` and `do:` whose elements
    /// are Numbers -- an Array, a List, a typed array.
    /// @answers the new Float64Array.
    public withAll: collection = (
      ^outer TypedArraysFactory TypedArray fill: (self new: collection size) from: collection.
    )

    /// Says the width of an element without an instance: the number of
    /// bytes per element `new:` allocates.
    ///
    /// @answers 8, the number of bytes an element takes.
    public bytesPerElement = (
      ^8.
    )
  )

  /// Builds the facet `platform typedArrays` answers. It is the module's
  /// one public member, named `build` like every shipped factory's.
  ///
  /// @answers a new `TypedArrays` namespace.
  public build = (
    ^TypedArrays new.
  )
)
