    /// for a `modulus` that is no number or is 0 (the first send to
    /// fail, so `//` never sees it).
    public reciprocalModulo: modulus = (
      |
        remainder ::= modulus.
        nextRemainder ::= self \\ modulus.
        coefficient ::= 0.
        nextCoefficient ::= 1.
      |
      [nextRemainder = 0] whileFalse: [
        |
          quotient = remainder // nextRemainder.
          previousRemainder = remainder.
          previousCoefficient
        |
        remainder:: nextRemainder.
        nextRemainder:: previousRemainder - (quotient * nextRemainder).
        previousCoefficient:: coefficient.
        coefficient:: nextCoefficient.
        nextCoefficient:: previousCoefficient - (quotient * nextCoefficient).
      ].
      remainder = 1 ifFalse: [
        ^(outer Kernel ArgumentError value: modulus) signal: 'reciprocalModulo: '
            , self printString
            , ' has no inverse modulo '
            , modulus printString.
      ].
      ^coefficient \\ modulus.
    )

    /// Answers the bitwise complement, `-1 - self`.
    public bitInvert = (
      ^-1 - self.
    )

    /// Evaluates `action` as many times as the receiver says, none for
    /// a receiver below 1; answers nil.
    ///
    /// action: a block of no argument, or anything understanding
    /// `value`; sent `value` each time.
    ///
    /// Signals an ArgumentError carrying the block, 'wrong number of
    /// block arguments: block takes …, got 0', for a block that
    /// declares any parameter, when the receiver is at least 1.
    ///
    /// The compiler does not inline it; it is sent.
    public timesRepeat: action = (
      1 to: self do: [:ignored | action value].
      ^nil.
    )

    /// Answers whether the receiver is less than `other` by their exact
    /// values, a Boolean: false whenever `other` is a NaN. A Float or a
    /// Fraction `other` is compared by exact value, so 2^53 + 1 is
    /// greater than the Float 2^53.
    ///
    /// other: a number.
    ///
    /// Signals an ArgumentError carrying `other`, '< requires a numeric
    /// argument, got …', for any other argument.
    public < other = (
      ^vmMirror integer: self lessThan: other ifFail: [^super < other].
    )

    /// As `<`, whether the receiver is greater; its error text names
    /// '>'.
    public > other = (
      ^vmMirror integer: self greaterThan: other ifFail: [^super > other].
    )

    /// As `<`, whether the receiver is less or equal; its error text
    /// names '<='.
    public <= other = (
      ^vmMirror integer: self lessOrEqual: other ifFail: [^super <= other].
    )

    /// As `<`, whether the receiver is greater or equal; its error text
    /// names '>='.
    public >= other = (
      ^vmMirror integer: self greaterOrEqual: other ifFail: [^super >= other].
    )

    /// Answers whether `other` is a number of the same exact value:
    /// `3 = 3.0` is true.
    ///
    /// other: any object; never signals. Anything that is no number is
    /// unequal.
    public = other = (
      ^vmMirror integer: self equals: other ifFail: [^super = other].
    )

    /// Answers the receiver itself, the hash every number of its value
    /// answers.
    public hash = (
      ^self.
    )

    /// Answers `0 - self`, an integer.
    public negated = (
      ^vmMirror integerNegated: self ifFail: [^super negated].
    )

    /// Answers the receiver without its sign, an integer.
    public abs = (
      ^vmMirror integerAbsolute: self ifFail: [^super abs].
    )

    /// Answers the nearest Float, a tie rounded to the even one.
    public asFloat = (
      ^vmMirror integerAsFloat: self ifFail: [^super asFloat].
    )

    /// Answers a new String of the decimal digits, after a '-' for a
    /// negative receiver.
    public printString = (
      ^vmMirror integerPrintString: self ifFail: [^super printString].
    )

    /// Answers what `printString` answers.
    public asString = (
      ^vmMirror integerAsString: self ifFail: [^super asString].
    )
  ) : (
    /// Answers the Integer `text` writes in decimal: `parse:radix:`
    /// with radix 10, and its ArgumentErrors.
    public parse: text = (
      ^self parse: text radix: 10.
    )

    /// Answers the Integer `text` writes in `radix`: an optional '-'
    /// and at least one digit, '0' to '9' then 'A' to 'Z' in either
    /// case, each below `radix`; a LargeInteger beyond -2^60 to
    /// 2^60 - 1.
    ///
    /// text: a String.
    /// radix: an Integer from 2 to 36.
    ///
    /// Signals an ArgumentError: 'parse:radix: takes a radix from 2 to
    /// 36, got …' carrying `radix` for one outside them, 'parse:radix:
    /// requires a String, got …' carrying `text` for one that is no
    /// String, and 'parse:radix: requires the digits of an Integer in
    /// radix …, got …' carrying `text` for a String that writes no
    /// integer, an empty one or a lone '-' included.
    ///
    /// The leaf answers only for `Integer` itself; any other receiver
    /// falls to `super`.
    public parse: text radix: radix = (
      ^vmMirror integerClass: self parse: text radix: radix ifFail: [
        ^super parse: text radix: radix.
      ].
    )
  )

  /// An integer outside -2^60 to 2^60 - 1. It answers `Integer`'s
  /// protocol with the same answers and errors; any result within that
  /// range again is an `Integer`. It inherits `Integer`'s `gcd:`, `>>`,
  /// `digitAt:`, `digitLength`, `asStringRadix:` and the methods written
  /// in Newspeak, which take either representation.
  ///
  /// §5.1.1: "integers are not limited in size". An `Integer` whose value
  /// does not fit a `SmallInteger`; every leaf answers an `Integer` when
  /// the result fits again, so each integer has one representation.
  /// `3 class` stays `Integer` -- the section asks only for its protocol.
  public class LargeInteger = Integer () (
    /// As `Integer>>+`: the sum, an integer for an integer `other`,
    /// exact for a Fraction one and a Float for a Float one, with the
    /// same ArgumentError.
    public + other = (
      ^vmMirror largeInteger: self add: other ifFail: [^super + other].
    )

    /// As `Integer>>-`, with the same ArgumentError.
    public - other = (
      ^vmMirror largeInteger: self subtract: other ifFail: [^super - other].
    )

    /// As `Integer>>*`, with the same ArgumentError.
    public * other = (
      ^vmMirror largeInteger: self multiply: other ifFail: [^super * other].
    )

    /// As `Integer>>//`: the quotient rounded toward negative infinity,
    /// an integer for an integer or a Fraction `other` and a Float for
    /// a Float one, with the same ArgumentErrors.
    public // other = (
      ^vmMirror largeInteger: self floorDivide: other ifFail: [^super // other].
    )

    /// As `Integer>>\\`: the remainder, with the sign of `other`, with
    /// the same ArgumentErrors.
    public \\ other = (
      ^vmMirror largeInteger: self modulo: other ifFail: [^super \\ other].
    )

    /// As `Integer>>bitAnd:`, with the same ArgumentError.
    public bitAnd: other = (
      ^vmMirror largeInteger: self bitAnd: other ifFail: [^super bitAnd: other].
    )

    /// As `Integer>>bitOr:`, with the same ArgumentError.
    public bitOr: other = (
      ^vmMirror largeInteger: self bitOr: other ifFail: [^super bitOr: other].
    )

    /// As `Integer>>bitXor:`, with the same ArgumentError.
    public bitXor: other = (
      ^vmMirror largeInteger: self bitXor: other ifFail: [^super bitXor: other].
    )

    /// As `Integer>><<`: the receiver shifted left by `other` bits,
    /// with the same ArgumentErrors.
    public << other = (
      ^vmMirror largeInteger: self shiftLeft: other ifFail: [^super << other].
    )

    /// As `Integer>><`: a Boolean by the exact values, false whenever
    /// `other` is a NaN, with the same ArgumentError.
    public < other = (
      ^vmMirror largeInteger: self lessThan: other ifFail: [^super < other].
    )

    /// As `Integer>>>`, with the same ArgumentError.
    public > other = (
      ^vmMirror largeInteger: self greaterThan: other ifFail: [^super > other].
    )

    /// As `Integer>><=`, with the same ArgumentError.
    public <= other = (
      ^vmMirror largeInteger: self lessOrEqual: other ifFail: [^super <= other].
    )

    /// As `Integer>>>=`, with the same ArgumentError.
    public >= other = (
      ^vmMirror largeInteger: self greaterOrEqual: other ifFail: [^super >= other].
    )

    /// Answers whether `other` is a number of the same exact value,
    /// whatever its class: a LargeInteger equals the Float or the
    /// LargeInteger of its value, never an Integer within -2^60 to
    /// 2^60 - 1, which is another value.
    ///
    /// other: any object; never signals. Anything that is no number is
    /// unequal.
    public = other = (
      ^vmMirror largeInteger: self equals: other ifFail: [^super = other].
    )

    /// Answers a hash of the value, alike for every number `=` makes
    /// equal.
    public hash = (
      ^vmMirror largeIntegerHash: self ifFail: [^super hash].
    )

    /// Answers `0 - self`, an integer.
    public negated = (
      ^vmMirror largeIntegerNegated: self ifFail: [^super negated].
    )

    /// Answers the receiver without its sign, an integer.
    public abs = (
      ^vmMirror largeIntegerAbsolute: self ifFail: [^super abs].
    )

    /// Answers the nearest Float, a tie rounded to the even one; an
    /// infinity beyond the largest Float.
    public asFloat = (
      ^vmMirror largeIntegerAsFloat: self ifFail: [^super asFloat].
    )

    /// Answers a new String of the decimal digits, after a '-' for a
    /// negative receiver.
    public printString = (
      ^vmMirror largeIntegerPrintString: self ifFail: [^super printString].
    )

    /// Answers what `printString` answers.
    public asString = (
      ^vmMirror largeIntegerAsString: self ifFail: [^super asString].
    )
  )

  /// The 64-bit IEEE 754 floating-point numbers: a literal such as `1.5`
  /// is one.
  public class Float = Number () (
    /// Answers true: the receiver is a Float.
    public isKindOfFloat = (
      ^true.
    )

    /// Answers the sum of the receiver and `other` as IEEE 754 computes
    /// it, a Float.
    ///
    /// other: a number: a Float, or an Integer, a LargeInteger or a
    /// Fraction, converted to the nearest Float first in one rounding.
    ///
    /// Signals an ArgumentError carrying `other`, '+ requires a numeric
    /// argument, got …', for any other argument.
    public + other = (
      ^vmMirror float: self add: other ifFail: [^super + other].
    )

    /// As `+`, the difference; its error text names '-'.
    public - other = (
      ^vmMirror float: self subtract: other ifFail: [^super - other].
    )

    /// As `+`, the product; its error text names '*'.
    public * other = (
      ^vmMirror float: self multiply: other ifFail: [^super * other].
    )

    /// As `+`, the quotient: dividing by zero answers an infinity or a
    /// NaN, never an error; its error text names '/'.
    public / other = (
      ^vmMirror float: self divide: other ifFail: [^super / other].
    )

    /// Answers whether the receiver is less than `other` by their exact
    /// values, a Boolean: false whenever either side is a NaN. An
    /// integer or a Fraction `other` is not rounded to a Float first,
    /// so the Float 2^53 is less than the integer 2^53 + 1.
    ///
    /// other: a number.
    ///
    /// Signals an ArgumentError carrying `other`, '< requires a numeric
    /// argument, got …', for any other argument.
    public < other = (
      ^vmMirror float: self lessThan: other ifFail: [^super < other].
    )

    /// As `<`, whether the receiver is greater; its error text names
    /// '>'.
    public > other = (
      ^vmMirror float: self greaterThan: other ifFail: [^super > other].
    )

    /// As `<`, whether the receiver is less or equal; its error text
    /// names '<='.
    public <= other = (
      ^vmMirror float: self lessOrEqual: other ifFail: [^super <= other].
    )

    /// As `<`, whether the receiver is greater or equal; its error text
    /// names '>='.
    public >= other = (
      ^vmMirror float: self greaterOrEqual: other ifFail: [^super >= other].
    )

    /// Answers whether `other` is a number of the same exact value,
    /// whatever its class: `0.0` equals `-0.0` and `0`, every NaN every
    /// other NaN, `0.5` the Fraction 1/2.
    ///
    /// other: any object; never signals. Anything that is no number is
    /// unequal.
    public = other = (
      ^vmMirror float: self equals: other ifFail: [^super = other].
    )

    /// Answers a hash of the exact value, alike for every number `=`
    /// makes equal, whatever its class: an integral Float's is the
    /// integer it is.
    public hash = (
      ^vmMirror floatHash: self ifFail: [^super hash].
    )

    /// Answers the square root, a Float; a NaN for a negative
    /// receiver.
    public sqrt = (
      ^vmMirror floatSquareRoot: self ifFail: [^super sqrt].
    )

    /// Answers the sine of the receiver, in radians, a Float.
    public sin = (
      ^vmMirror floatSine: self ifFail: [^super sin].
    )

    /// Answers the cosine of the receiver, in radians, a Float.
    public cos = (
      ^vmMirror floatCosine: self ifFail: [^super cos].
    )

    /// Answers the tangent of the receiver, in radians, a Float.
    public tan = (
      ^vmMirror floatTangent: self ifFail: [^super tan].
    )

    /// Answers the arc sine of the receiver, in radians from -π/2 to
    /// π/2, a Float; a NaN outside -1 to 1.
    public asin = (
      ^vmMirror floatArcSine: self ifFail: [^super asin].
    )

    /// Answers the arc cosine of the receiver, in radians from 0 to π, a
    /// Float; a NaN outside -1 to 1.
    public acos = (
      ^vmMirror floatArcCosine: self ifFail: [^super acos].
    )

    /// Answers the arc tangent of the receiver, in radians from -π/2 to
    /// π/2, a Float.
    public atan = (
      ^vmMirror floatArcTangent: self ifFail: [^super atan].
    )

    /// Answers the angle, in radians from -π to π, of the point whose
    /// abscissa is `x` and whose ordinate is the receiver, a Float.
    ///
    /// x: a number, converted to the nearest Float first.
    ///
    /// Signals an ArgumentError carrying `x`, 'atan: requires a numeric
    /// argument, got …', for any other argument.
    public atan: x = (
      ^vmMirror float: self arcTangent: x ifFail: [^super atan: x].
    )

    /// Answers e raised to the receiver, a Float.
    public exp = (
      ^vmMirror floatExponential: self ifFail: [^super exp].
    )

    /// Answers the natural logarithm of the receiver, a Float: minus
    /// infinity for zero, a NaN below zero.
    public ln = (
      ^vmMirror floatNaturalLogarithm: self ifFail: [^super ln].
    )

    /// Answers the logarithm of the receiver to base 10, a Float: minus
    /// infinity for zero, a NaN below zero.
    public log = (
      ^vmMirror floatLogarithm: self ifFail: [^super log].
    )

    /// Answers the receiver raised to `exponent` as IEEE 754's `pow`
    /// computes it, a Float.
    ///
    /// exponent: a number, converted to the nearest Float first.
    ///
    /// Signals an ArgumentError carrying `exponent`, 'raisedTo:
    /// requires a numeric argument, got …', for any other argument.
    public raisedTo: exponent = (
      ^vmMirror float: self raisedTo: exponent ifFail: [^super raisedTo: exponent].
    )

    /// Answers the greatest integral value not above the receiver, a
    /// Float; an infinity or a NaN is answered as it is.
    public floor = (
      ^vmMirror floatFloor: self ifFail: [^super floor].
    )

    /// Answers the least integral value not below the receiver, a
    /// Float; an infinity or a NaN is answered as it is.
    public ceiling = (
      ^vmMirror floatCeiling: self ifFail: [^super ceiling].
    )

    /// Answers the integral value nearest the receiver, a half rounded
    /// away from zero, a Float that keeps the receiver's sign; an
    /// infinity or a NaN is answered as it is.
    public rounded = (
      ^vmMirror floatRounded: self ifFail: [^super rounded].
    )

    /// Answers the receiver without its fraction, toward zero, a Float
    /// that keeps the receiver's sign; an infinity or a NaN is answered
    /// as it is.
    public truncated = (
      ^vmMirror floatTruncated: self ifFail: [^super truncated].
    )

    /// Answers the receiver with its sign changed, a Float: `0.0
    /// negated` is -0.0.
    public negated = (
      ^vmMirror floatNegated: self ifFail: [^super negated].
    )

    /// Answers the receiver without its sign, a Float: -0.0 answers
    /// 0.0.
    public abs = (
      ^vmMirror floatAbsolute: self ifFail: [^super abs].
    )

    /// Answers the receiver itself.
    public asFloat = (
      ^self.
    )

    /// Answers whether the receiver is a NaN.
    public isNaN = (
      ^vmMirror floatIsNaN: self ifFail: [^super isNaN].
    )

    /// Answers whether the receiver is neither an infinity nor a NaN.
    public isFinite = (
      ^vmMirror floatIsFinite: self ifFail: [^super isFinite].
    )

    /// Answers whether the receiver is an infinity, of either sign.
    public isInfinite = (
      ^vmMirror floatIsInfinite: self ifFail: [^super isInfinite].
    )

    /// Answers the receiver truncated toward zero, an integer of any
    /// size.
    ///
    /// Signals an ArgumentError carrying the receiver, 'asInteger
    /// requires a finite Float, got …', for a NaN or an infinity.
    public asInteger = (
      ^vmMirror floatAsInteger: self ifFail: [^super asInteger].
    )

    /// Answers a new String of the receiver with `fractionDigits`
    /// digits after the point, rounded half away from zero on its exact
    /// binary value, keeping its sign even when every digit is zero;
    /// `printString`'s text when it is not within ±1e21, a NaN or an
    /// infinity included.
    ///
    /// fractionDigits: an Integer from 0 to 20.
    ///
    /// Signals an ArgumentError carrying `fractionDigits`:
    /// 'asStringFixed: takes 0 to 20 fraction digits, got …' for an
    /// Integer outside 0 to 20, a LargeInteger included, and
    /// 'asStringFixed: requires a numeric argument, got …' for one that
    /// is no Integer.
    public asStringFixed: fractionDigits = (
      ^vmMirror float: self asStringFixed: fractionDigits ifFail: [
        ^super asStringFixed: fractionDigits.
      ].
    )

    /// Answers a new String of the receiver in exponent form: one digit,
    /// a point and `fractionDigits` digits when there are any, rounded
    /// half away from zero on its exact binary value, then 'e', the
    /// exponent's sign and the exponent -- '3.0e+0', '6.67e+1',
    /// '-0e+0'; 'NaN', 'Infinity' or '-Infinity' for those values.
    ///
    /// fractionDigits: an Integer from 0 to 20.
    ///
    /// Signals an ArgumentError carrying `fractionDigits`:
    /// 'asStringExponential: takes 0 to 20 fraction digits, got …' for
    /// an Integer outside 0 to 20, a LargeInteger included, and
    /// 'asStringExponential: requires an integer argument, got …' for
    /// one that is no Integer.
    public asStringExponential: fractionDigits = (
      ^vmMirror float: self asStringExponential: fractionDigits ifFail: [
        ^super asStringExponential: fractionDigits.
      ].
    )

    /// Answers a new String of the receiver with `digits` significant
    /// digits, rounded half away from zero on its exact binary value:
    /// in decimal ('66.7', '0.0000010'), or in `asStringExponential:`'s
    /// form ('7e+1', '1.0e-7') when the value needs more than six zeros
    /// after the point or its digits end before the point; 'NaN',
    /// 'Infinity' or '-Infinity' for those values.
    ///
    /// digits: an Integer from 1 to 21.
    ///
    /// Signals an ArgumentError carrying `digits`: 'asStringPrecision:
    /// takes 1 to 21 digits, got …' for an Integer outside 1 to 21, a
    /// LargeInteger included, and 'asStringPrecision: requires an
    /// integer argument, got …' for one that is no Integer.
    public asStringPrecision: digits = (
      ^vmMirror float: self asStringPrecision: digits ifFail: [^super asStringPrecision: digits].
    )

    /// Answers a new String of the shortest decimal text that reads
    /// back as the receiver: in decimal when its first digit's power of
    /// ten lies from -6 to 20, with '.0' after an integral value
    /// ('3.0', '0.000001', '100000000000000000000.0'), and in exponent
    /// form beyond ('1e+21', '1e-7'); 'NaN', 'Infinity' and
    /// '-Infinity' for those values. A negative value, -0.0 included,
    /// begins with '-'.
    public printString = (
      ^vmMirror floatPrintString: self ifFail: [^super printString].
    )

    /// Answers what `printString` answers.
    public asString = (
      ^vmMirror floatAsString: self ifFail: [^super asString].
    )
  ) : (
    /// Answers the Float `text` names: an optional '-' or '+', then
    /// 'Infinity', 'NaN', or decimal digits with an optional point and
    /// an optional exponent ('e' or 'E', an optional sign, digits),
    /// with at least one digit before the exponent -- every text
    /// `printString` writes. The nearest Float to the decimal value;
    /// an infinity beyond the largest.
    ///
    /// text: a String.
    ///
    /// Signals an ArgumentError carrying `text`: 'parse: requires the
    /// text of a Float, got …' for a String that is no such text, a
    /// lower-case 'nan' or 'inf', a space or an empty String included,
    /// and 'parse: requires a String, got …' for anything else.
    ///
    /// The leaf answers only for `Float` itself; any other receiver
    /// falls to `super`.
    public parse: text = (
      ^vmMirror floatClass: self parse: text ifFail: [^super parse: text].
    )
  )

  /// The exact quotient of two integers, in normal form: its
  /// denominator above 1, no factor common to both parts, its sign on
  /// the numerator. `Fraction numerator:denominator:` makes one, and so
  /// does dividing integers that do not divide; a fraction is never
  /// equal to an integer, which a quotient that divides is instead.
  ///
  /// Made only by the runtime, so a fraction is always in normal form
  /// and `=` and `hash` can compare its parts. Its parts are two hidden
  /// fields, not slots: no program writes them.
  public class Fraction = Number () (
    /// Answers true: the receiver is a Fraction.
    public isKindOfFraction = (
      ^true.
    )

    /// Answers the numerator, an integer of either sign. A receiver
    /// holding no value (`Fraction new`) makes the leaf decline, and
    /// the send ends in doesNotUnderstand: (MessageNotUnderstood).
    public numerator = (
      ^vmMirror fractionNumerator: self ifFail: [^super numerator].
    )

    /// Answers the denominator, an integer above 1. A receiver holding
    /// no value (`Fraction new`) makes the leaf decline, and the send
    /// ends in doesNotUnderstand: (MessageNotUnderstood).
    public denominator = (
      ^vmMirror fractionDenominator: self ifFail: [^super denominator].
    )

    /// Answers the greatest integer not above the receiver.
    public floor = (
      ^self numerator // self denominator.
    )

    /// Answers the least integer not below the receiver.
    public ceiling = (
      ^(self numerator negated // self denominator) negated.
    )

    /// Answers the receiver without its fraction, an integer toward
    /// zero.
    public truncated = (
      ^self numerator quo: self denominator.
    )

    /// Answers `truncated`.
    public asInteger = (
      ^self truncated.
    )

    /// Answers the integer nearest the receiver, a half rounded away
    /// from zero.
    public rounded = (
      |
        nearest = (self numerator abs * 2 + self denominator) // (self denominator * 2).
      |
      ^self numerator < 0 ifTrue: [nearest negated] ifFalse: [nearest].
    )

    /// Answers a new String of the numerator and the denominator
    /// between parentheses and separated by '/': '(3/4)', '(-1/2)'.
    public printString = (
      ^'(' , self numerator printString , '/' , self denominator printString , ')'.
    )

    /// Answers what `printString` answers.
    public asString = (
      ^self printString.
    )
  ) : (
    /// Answers `numerator` divided by `denominator`, exactly: an
    /// Integer when `denominator` divides `numerator`, otherwise a
    /// Fraction in normal form, its sign on the numerator.
    ///
    /// numerator: an integer.
    /// denominator: an integer other than 0.
    ///
    /// Signals an ArgumentError: 'numerator:denominator: requires a
    /// non-zero denominator' carrying `denominator` for 0, and
    /// 'numerator:denominator: requires integers, got …' carrying the
    /// first argument that is no integer.
    ///
    /// The leaf answers only for `Fraction` itself; any other receiver
    /// falls to `super`.
    public numerator: numerator denominator: denominator = (
      ^vmMirror fractionClass: self numerator: numerator denominator: denominator ifFail: [
        ^super numerator: numerator denominator: denominator.
      ].
    )

    /// Answers the Fraction `numerator`/`denominator`, a pair the
    /// caller has put in normal form already: no factor common to both,
    /// `denominator` above 1. Nothing is reduced.
    ///
    /// numerator: an integer.
    /// denominator: an integer above 1 with no factor common to
    /// `numerator`.
    ///
    /// Signals an ArgumentError carrying `denominator`,
    /// 'reducedNumerator:denominator: requires a fraction in normal
    /// form, got …/…', for a pair not in normal form, and one carrying
    /// the argument, 'reducedNumerator:denominator: requires integers,
    /// got …', for an argument that is no integer.
    ///
    /// The leaf answers only for `Fraction` itself; any other receiver
    /// falls to `super`.
    public reducedNumerator: numerator denominator: denominator = (
      ^vmMirror fractionClass: self reducedNumerator: numerator denominator: denominator ifFail: [
        ^super reducedNumerator: numerator denominator: denominator.
      ].
    )
  )

  /// An immutable sequence of Unicode code points: a literal such as
  /// `'abc'` is one.
  public class String = Value () (
    /// Answers true: the receiver is a String.
    public isKindOfString = (
      ^true.
    )

    /// Answers the number of code points.
    public size = (
      ^vmMirror stringSize: self ifFail: [^super size].
    )

    /// Answers the code point at `index` as an Integer.
    ///
    /// index: an Integer from 1 to `size`.
    ///
    /// Signals an ArgumentError carrying `index`: 'index … out of
    /// range: valid indices are 1..size (size …)' for an Integer outside
    /// 1 to `size`, a LargeInteger included, and 'at: requires an
    /// Integer index, got …' for an index that is no Integer.
    ///
    /// Over code points, not UTF-8 bytes: `at:` answers the code point,
    /// which is the byte only for ASCII.
    public at: index = (
      ^vmMirror string: self at: index ifFail: [^super at: index].
    )

    /// Answers a new String of the code points from `start` to `stop`,
    /// both included; the receiver is unchanged. A `stop` of `start - 1`
    /// answers an empty String.
    ///
    /// start: an Integer from 1 to `size + 1`.
    /// stop: an Integer from `start - 1` to `size`.
    ///
    /// Signals an ArgumentError: 'copyFrom: … to: … out of range: valid
    /// ranges lie within 1..size, an empty range ends just before it
    /// starts (size …)' for bounds outside that, carrying `start`
    /// unless it is in range and `stop` otherwise; and 'copyFrom:to:
    /// requires an Integer index, got …', carrying the first bound
    /// that is no Integer.
    public copyFrom: start to: stop = (
      ^vmMirror string: self copyFrom: start to: stop ifFail: [^super copyFrom: start to: stop].
    )

    /// Answers a new String of the receiver's code points followed by
    /// those of `other`; neither is changed.
    ///
    /// other: a String or a Symbol.
    ///
    /// Signals an ArgumentError carrying `other`, 'String concatenation
    /// (,) requires a String argument, got …', for any other
    /// argument.
    public , other = (
      ^vmMirror string: self concatenate: other ifFail: [^super , other].
    )

    /// Answers whether `other` is a String of the same code points.
    ///
    /// other: any object; never signals. A Symbol never is equal.
    public = other = (
      ^vmMirror string: self equals: other ifFail: [^super = other].
    )

    /// Answers a hash of the code points, alike for equal Strings.
    public hash = (
      ^vmMirror stringHash: self ifFail: [^super hash].
    )

    /// Answers the Symbol of the same text, the one object of it.
    public asSymbol = (
      ^vmMirror stringAsSymbol: self ifFail: [^super asSymbol].
    )

    /// Answers a new String of the receiver as a literal writes it:
    /// between single quotes, each quote inside doubled.
    public printString = (
      ^vmMirror stringPrintString: self ifFail: [^super printString].
    )

    /// Answers the receiver itself.
    public asString = (
      ^self.
    )

    /// Answers a new ByteArray of the receiver's code points encoded as
    /// UTF-8, in order: one byte for a code point below 128, up to four
    /// for one past 65535. `String fromUtf8:` decodes it back to an equal
    /// String. The receiver is unchanged, and each send answers a new
    /// ByteArray.
    ///
    /// Signals an ArgumentError carrying the receiver, 'asUtf8 cannot
    /// allocate a ByteArray of … bytes', only for a String whose bytes
    /// the heap cannot hold.
    public asUtf8 = (
      ^vmMirror stringAsUtf8: self ifFail: [^super asUtf8].
    )

    /// Answers the number of bytes the receiver takes as UTF-8, the size
    /// of `asUtf8`'s answer, counted without making it; never signals.
    ///
    /// `StringBuilder` asks it before it appends a String.
    public utf8Size = (
      ^vmMirror stringUtf8Size: self ifFail: [^super utf8Size].
    )

    /// Evaluates `action` with each code point, an Integer, from the
    /// first. Answers the receiver.
    ///
    /// action: a one-argument block, or anything understanding
    ///     `value:`.
    public do: action = (
      1 to: self size do: [:index | action value: (self at: index)].
    )

    /// Answers whether the String has no code point.
    public isEmpty = (
      ^self size = 0.
    )

    /// Answers the first code point, an Integer.
    ///
    /// Signals the ArgumentError of `at:`, carrying 1, for an empty
    /// String.
    public first = (
      ^self at: 1.
    )

    /// Answers the last code point, an Integer.
    ///
    /// Signals the ArgumentError of `at:`, carrying 0, for an empty
    /// String.
    public last = (
      ^self at: self size.
    )

    /// Answers a new String of the one code point at `index`; for a
    /// Symbol too.
    ///
    /// index: an Integer from 1 to `size`.
    ///
    /// Signals the ArgumentError of `at:` for any other index.
    public stringAt: index = (
      self at: index.
      ^self copyFrom: index to: index.
    )

    /// Answers what `copyFrom: start to: stop` answers: a new String of
    /// the code points from `start` to `stop`.
    ///
    /// Signals what `copyFrom:to:` signals.
    public copyStringFrom: start to: stop = (
      ^self copyFrom: start to: stop.
    )

    /// Answers the index of the first occurrence of `substring`, or 0;
    /// `indexOf: substring startingAt: 1`.
    public indexOf: substring = (
      ^self indexOf: substring startingAt: 1.
    )

    /// Answers the code-point index at which the first occurrence of
    /// `substring` that starts at or after `start` begins, or 0 when
    /// there is none. An empty `substring` is found at `start`.
    ///
    /// substring: a String or a Symbol.
    /// start: an Integer from 1 to `size + 1`.
    ///
    /// Signals an ArgumentError carrying `substring`,
    /// 'indexOf:startingAt: requires a String argument, got …', for a
    /// `substring` that is no String, and one carrying `start`,
    /// 'indexOf:startingAt: … out of range: valid starts are 1..…
    /// (size …)', for a `start` outside 1 to `size + 1`, or
    /// 'indexOf:startingAt: requires an Integer index, got …'.
    public indexOf: substring startingAt: start = (
      ^vmMirror string: self indexOf: substring startingAt: start ifFail: [
        ^super indexOf: substring startingAt: start.
      ].
    )

    /// Answers the index of the last occurrence of `substring`, or 0;
    /// `lastIndexOf: substring startingAt: size + 1`.
    public lastIndexOf: substring = (
      ^self lastIndexOf: substring startingAt: self size + 1.
    )

    /// Answers the code-point index at which the last occurrence of
    /// `substring` that starts at or before `start` begins, or 0 when
    /// there is none. An empty `substring` is found at `start`.
    ///
    /// substring: a String or a Symbol.
    /// start: an Integer from 1 to `size + 1`.
    ///
    /// Signals the ArgumentErrors `indexOf:startingAt:` signals, their
    /// texts naming 'lastIndexOf:startingAt:'.
    public lastIndexOf: substring startingAt: start = (
      ^vmMirror string: self lastIndexOf: substring startingAt: start ifFail: [
        ^super lastIndexOf: substring startingAt: start.
      ].
    )

    /// Answers whether the receiver begins with `prefix`; true for an
    /// empty `prefix`.
    ///
    /// prefix: a String or a Symbol.
    ///
    /// Signals an ArgumentError carrying `prefix`, 'startsWith:
    /// requires a String argument, got …' and its `printString`, for a
    /// `prefix` that is no String.
    ///
    /// Looks for an occurrence starting at 1 at the latest, so only the
    /// first position is compared, whatever the receiver's length; the
    /// search leaf still reads the whole receiver before it compares.
    public startsWith: prefix = (
      prefix isKindOfString ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: prefix) signal: 'startsWith: requires a String argument, got '
            , prefix printString.
      ].
      ^(self lastIndexOf: prefix startingAt: 1) = 1.
    )

    /// Answers whether the receiver ends with `suffix`; true for an
    /// empty `suffix`.
    ///
    /// suffix: a String or a Symbol.
    ///
    /// Signals an ArgumentError carrying `suffix`, 'endsWith: requires
    /// a String argument, got …' and its `printString`, for a `suffix`
    /// that is no String.
    ///
    /// The last occurrence is the one at the end when there is one
    /// there.
    public endsWith: suffix = (
      |
        position
      |
      suffix isKindOfString ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: suffix) signal: 'endsWith: requires a String argument, got '
            , suffix printString.
      ].
      position:: self lastIndexOf: suffix startingAt: self size + 1.
      ^(position > 0) and: [position = (self size - suffix size + 1)].
    )
  ) : (
    /// Answers a new String of one code point, `code`.
    ///
    /// code: an Integer from 0 to 1114111 outside 55296 to 57343.
    ///
    /// Signals an ArgumentError carrying `code`, 'with: requires a
    /// Unicode code point, an Integer from 0 to 1114111 outside 55296 to
    /// 57343, got …', for any other argument.
    ///
    /// It takes a code point, not a byte. The leaf declines only a
    /// subject that is not `String` itself, which a flat class side
    /// cannot be sent from.
    public with: code = (
      ^vmMirror stringClass: self with: code ifFail: [nil].
    )

    /// Answers a new String of the code points of `codePoints`, in its
    /// `do:` order, or a new String of the same code points when
    /// `codePoints` is a String.
    ///
    /// codePoints: a String, or a Collection of Integers, each a
    ///     Unicode code point: from 0 to 1114111 and outside 55296 to
    ///     57343. Anything else answering `size` and `do:` is gathered
    ///     into an Array first.
    ///
    /// Signals an ArgumentError carrying the first element that is no
    /// code point, 'withAll: requires Unicode code points, Integers
    /// from 0 to 1114111 outside 55296 to 57343, got …', and the
    /// MessageNotUnderstood of `size` or `do:` for an argument that
    /// lacks it. Sent to a subclass, answers nil, as `with:` does, and
    /// so it does for an argument that answers `isKindOfArray` or
    /// `isKindOfString` true without being an Array or a String.
    public withAll: codePoints = (
      ^vmMirror stringClass: self withAll: codePoints ifFail: [
        (codePoints isKindOfArray or: [codePoints isKindOfString]) ifTrue: [
          nil.
        ] ifFalse: [
          self withAll: (outer Kernel Array withAll: codePoints).
        ].
      ].
    )

    /// Answers a new String of the code points the UTF-8 bytes of `bytes`
    /// encode: `fromUtf8: bytes from: 1 to: bytes size`.
    ///
    /// bytes: a ByteArray.
    ///
    /// Signals an ArgumentError carrying `bytes`, 'fromUtf8: requires a
    /// ByteArray, got …' and its `printString`, for any other argument,
    /// and the one `fromUtf8:from:to:` signals for bytes that are no
    /// UTF-8.
    ///
    /// The argument is checked first, since `bytes size` of anything else
    /// could answer anything, or nothing.
    public fromUtf8: bytes = (
      bytes isKindOfByteArray ifFalse: [
        ^(outer Kernel ArgumentError value: bytes) signal: 'fromUtf8: requires a ByteArray, got '
            , bytes printString.
      ].
      ^self fromUtf8: bytes from: 1 to: bytes size.
    )

    /// Answers a new String of the code points the UTF-8 bytes of `bytes`
    /// from `start` to `stop`, both included, encode; `bytes` is
    /// unchanged. A `stop` of `start - 1` answers an empty String.
    ///
    /// bytes: a ByteArray.
    /// start: an Integer from 1 to `bytes size + 1`.
    /// stop: an Integer from `start - 1` to `bytes size`.
    ///
    /// Decodes strictly: a truncated sequence, a range that ends inside a
    /// character among them, a stray continuation byte, an overlong
    /// encoding, a surrogate and a code point past 1114111 are an
    /// ArgumentError carrying `bytes`, 'fromUtf8: invalid UTF-8 at byte
    /// …', which names the first byte of the bad sequence by its index in
    /// `bytes`, not in the range. A byte-order mark is kept, as the code
    /// point 65279.
    ///
    /// Signals, besides, an ArgumentError carrying `bytes`,
    /// 'fromUtf8:from:to: requires a ByteArray, got …', for a `bytes`
    /// that is no ByteArray; and for a range `bytes` does not hold the
    /// ArgumentError `copyFrom:to:` signals, its text beginning 'from: …
    /// to: …' and the bound that is no Integer named by
    /// 'fromUtf8:from:to:'.
    ///
    /// Strict rather than a replacement character for each bad sequence,
    /// so that nothing is lost silently. The leaf declines only a subject
    /// that is not `String` itself, which a flat class side cannot be sent
    /// from.
    public fromUtf8: bytes from: start to: stop = (
      ^vmMirror stringClass: self fromUtf8: bytes from: start to: stop ifFail: [nil].
    )
  )

  /// A canonical String: one object per text (§5.1.6), made only by a
  /// literal such as `#at:put:` or by `asSymbol`, never by `new`. It
  /// understands what a String does; `,` and `copyFrom:to:` answer a
  /// String.
  public class Symbol = String () (
    /// Answers a new String of the Symbol's text.
    public asString = (
      ^vmMirror symbolAsString: self ifFail: [^super asString].
    )

    /// Answers whether `other` is the same Symbol.
    ///
    /// other: any object; never signals. A String never is equal.
    public = other = (
      ^vmMirror symbol: self equals: other ifFail: [^super = other].
    )

    /// Answers a hash, alike for equal Symbols.
    public hash = (
      ^vmMirror symbolHash: self ifFail: [^super hash].
    )

    /// Answers a new String of the Symbol's text after a '#'.
    public printString = (
      ^vmMirror symbolPrintString: self ifFail: [^super printString].
    )
  )

  /// A growing text, built by appending Strings and code points: it keeps
  /// the UTF-8 bytes of what was appended in a ByteArray that grows by half
  /// again when it is full, so an append costs amortised constant time. Its
  /// `size` counts code points, as a String's does. Equality and `hash` are
  /// identity.
  ///
  /// capacity: an Integer of at least 0, the number of UTF-8 bytes to make
  ///     room for at the start; a hint, since the builder grows as needed.
  ///
  /// Signals the ArgumentError of `ByteArray new:` for a capacity that is
  /// negative, no Integer or too large to allocate.
  public class StringBuilder new: capacity = Object (
    |
      /// The UTF-8 bytes appended so far, then unused room; never handed
      /// out, so the first `byteCount` of them are always valid UTF-8.
      private data ::= outer Kernel ByteArray new: capacity.
      /// How many bytes of `data` are used.
      private byteCount ::= 0.
      /// How many code points those bytes encode.
      private codePointCount ::= 0.
    |
  ) (
    /// Answers true: the receiver is a StringBuilder.
    public isKindOfStringBuilder = (
      ^true.
    )

    /// Appends the code points of `aString` and answers it.
    ///
    /// aString: a String or a Symbol.
    ///
    /// Signals an ArgumentError carrying `aString`, 'add: requires a
    /// String, got …' and its `printString`, for any other argument, a
    /// ByteArray included; the builder is unchanged.
    ///
    /// Signals the ArgumentError of `checkState:` when the receiver's state
    /// is not one its own members leave.
    public add: aString = (
      |
        byteTotal
      |
      self checkState: #add:.
      aString isKindOfString ifFalse: [
        ^(outer Kernel ArgumentError value: aString) signal: 'add: requires a String, got '
            , aString printString.
      ].
      byteTotal:: aString utf8Size.
      self ensureRoom: byteCount + byteTotal.
      data replaceFrom: byteCount + 1 to: byteCount + byteTotal with: aString startingAt: 1.
      byteCount:: byteCount + byteTotal.
      codePointCount:: codePointCount + aString size.
      ^aString.
    )

    /// Appends one code point and answers it.
    ///
    /// codePoint: an Integer from 0 to 1114111 outside 55296 to 57343.
    ///
    /// Signals an ArgumentError carrying `codePoint`, 'addCodePoint:
    /// requires a Unicode scalar value, got …' and its `printString`, for
    /// any other argument; nothing is appended.
    ///
    /// Signals the ArgumentError of `checkState:` when the receiver's state
    /// is not one its own members leave.
    ///
    /// The value is checked here, before the write, so that the error
    /// names `addCodePoint:` rather than the ByteArray store behind it.
    public addCodePoint: codePoint = (
      self checkState: #addCodePoint:.
      (codePoint isKindOfInteger and: [
        codePoint >= 0 and: [
          codePoint <= 1114111 and: [(codePoint >= 55296 and: [codePoint <= 57343]) not].
        ].
      ]) ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: codePoint) signal: 'addCodePoint: requires a Unicode scalar value, got '
            , codePoint printString.
      ].
      self ensureRoom: byteCount + 4.
      byteCount:: byteCount + (data at: byteCount + 1 putCodePoint: codePoint).
      codePointCount:: codePointCount + 1.
      ^codePoint.
    )

    /// Appends the code points of `aString` and then a newline, code point
    /// 10, and answers the receiver.
    ///
    /// aString: a String or a Symbol.
    ///
    /// Signals the ArgumentErrors of `add:`; the builder is unchanged.
    public writeln: aString = (
      self add: aString.
      self addCodePoint: 10.
      ^self.
    )

    /// Answers how many code points have been appended.
    ///
    /// Signals the ArgumentError of `checkState:` when the receiver's state
    /// is not one its own members leave.
    public size = (
      self checkState: #size.
      ^codePointCount.
    )

    /// Answers whether nothing has been appended.
    ///
    /// Signals the ArgumentError of `checkState:` when the receiver's state
    /// is not one its own members leave.
    public isEmpty = (
      self checkState: #isEmpty.
      ^codePointCount = 0.
    )

    /// Answers a new String of everything appended, in order; a new one
    /// on every send, so the receiver's later appends do not reach it.
    ///
    /// Signals the ArgumentError of `checkState:` when the receiver's state
    /// is not one its own members leave.
    public asString = (
      self checkState: #asString.
      ^outer Kernel String fromUtf8: data from: 1 to: byteCount.
    )

    /// Answers a new ByteArray of the UTF-8 bytes of everything appended,
    /// a copy: changing it leaves the receiver unchanged.
    ///
    /// Signals the ArgumentError of `checkState:` when the receiver's state
    /// is not one its own members leave.
    public asUtf8 = (
      self checkState: #asUtf8.
      ^data copyFrom: 1 to: byteCount.
    )

    /// Answers the receiver when its slots hold what its own members leave
    /// in them: `data` a ByteArray, `byteCount` an Integer from 0 to
    /// `data size`, and `codePointCount` an Integer from 0 to `byteCount`.
    ///
    /// selector: the Symbol of the message the program sent.
    ///
    /// Signals an ArgumentError carrying the receiver, '<selector> found a
    /// StringBuilder whose state is not its own', for any other state,
    /// which only a crafted image can make; nothing is changed.
    ///
    /// Every member that reads the slots sends it first, so that a crafted
    /// builder is refused under the selector the program sent, rather than
    /// by whatever send first meets the wrong object, or by none when the
    /// counts are wrong but still Integers.
    private checkState: selector = (
      (data isKindOfByteArray and: [
        byteCount isKindOfInteger and: [
          codePointCount isKindOfInteger and: [
            byteCount >= 0 and: [
              byteCount <= data size and: [codePointCount >= 0 and: [codePointCount <= byteCount]].
            ].
          ].
        ].
      ]) ifFalse: [
        ^(outer Kernel ArgumentError value: self) signal: selector asString
            , ' found a StringBuilder whose state is not its own'.
      ].
    )

    /// Makes `data` hold at least `byteTotal` bytes, replacing it with a
    /// ByteArray of that size or of one and a half times its current size,
    /// whichever is more, that begins with the used bytes.
    ///
    /// byteTotal: an Integer of at least `byteCount`.
    ///
    /// Growing by a fraction of the size rather than a fixed step is what
    /// keeps the cost of an append amortised constant.
    private ensureRoom: byteTotal = (
      |
        grown
      |
      byteTotal > data size ifFalse: [^self].
      grown:: outer Kernel ByteArray new: (byteTotal max: data size * 3 // 2).
      grown replaceFrom: 1 to: byteCount with: data startingAt: 1.
      data:: grown.
    )
  ) : (
    /// Answers a new, empty StringBuilder with room for 16 bytes.
    public new = (
      ^self new: 16.
    )
  )

  /// A group of elements that can be visited one by one: the abstract
  /// superclass of `Array` and of the collections module's `List`, `Map`
  /// and `Set`. A subclass defines `do:`, and inherits every other public
  /// member here, each written over `do:`; to `collect:`, `select:` or
  /// `reject:` it also defines `newForCollectUsingAdd:`. A subclass
  /// overrides any member it can answer faster.
  public class Collection = Object () (
    /// Answers true: the receiver is a Collection.
    public isKindOfCollection = (
      ^true.
    )

    /// Evaluates `action` with each element in turn.
    ///
    /// action: a one-argument block, or anything understanding
    ///     `value:`.
    ///
    /// Here, signals the Error of `subclassResponsibility`,
    /// 'Collection>>do: is abstract: … must implement it': every
    /// subclass defines it.
    public do: action = (
      ^self subclassResponsibility.
    )

    /// Answers a new, empty collection that `collect:`, `select:` and
    /// `reject:` fill by sending it `add:` once per element they keep.
    ///
    /// capacity: an Integer of at least 0, the receiver's size: room
    ///     enough for every element.
    ///
    /// Here, signals the Error of `subclassResponsibility`,
    /// 'Collection>>newForCollectUsingAdd: is abstract: … must
    /// implement it'.
    ///
    /// The kernel cannot name the collections module's `List`, so a
    /// collection says itself what its `collect:` answers.
    protected newForCollectUsingAdd: capacity = (
      ^self subclassResponsibility.
    )

    /// Answers whether `predicate` answers true for every element; true
    /// for an empty collection. Stops at the first element for which it
    /// answers false.
    ///
    /// predicate: a one-argument block answering a Boolean.
    public allSatisfy: predicate = (
      self do: [:element | (predicate value: element) ifFalse: [^false]].
      ^true.
    )

    /// Answers whether `predicate` answers true for some element; false
    /// for an empty collection. Stops at the first element for which it
    /// answers true.
    ///
    /// predicate: a one-argument block answering a Boolean.
    public anySatisfy: predicate = (
      self do: [:element | (predicate value: element) ifTrue: [^true]].
      ^false.
    )

    /// Answers whether `predicate` answers false for every element; true
    /// for an empty collection. Stops at the first element for which it
    /// answers true.
    ///
    /// predicate: a one-argument block answering a Boolean.
    public noneSatisfy: predicate = (
      self do: [:element | (predicate value: element) ifTrue: [^false]].
      ^true.
    )

    /// Answers the first element, in `do:` order, for which `predicate`
    /// answers true.
    ///
    /// predicate: a one-argument block answering a Boolean.
    ///
    /// Signals an Error, 'No matching element detected', when it answers
    /// true for none.
    public detect: predicate = (
      ^self detect: predicate ifNone: [
        (outer Kernel Error new) signal: 'No matching element detected'.
      ].
    )

    /// Answers the first element, in `do:` order, for which `predicate`
    /// answers true, or the value of `onNone` when it answers true for
    /// none.
    ///
    /// predicate: a one-argument block answering a Boolean.
    /// onNone: anything understanding `value`; sent it only when no
    ///     element matches.
    public detect: predicate ifNone: onNone = (
      self do: [:element | (predicate value: element) ifTrue: [^element]].
      ^onNone value.
    )

    /// Evaluates `action` with each element in `do:` order, and
    /// `between` between every two of them: not before the first, not
    /// after the last. Answers the receiver.
    ///
    /// action: a one-argument block, or anything understanding `value:`.
    /// between: anything understanding `value`.
    public do: action separatedBy: between = (
      |
        first ::= true.
      |
      self do: [:element |
        first ifTrue: [first:: false] ifFalse: [between value].
        action value: element.
      ].
    )

    /// Answers whether some element is `=` to `object`; each element is
    /// sent `=` with `object` as its argument, in `do:` order, until one
    /// answers true.
    public includes: object = (
      self do: [:element | element = object ifTrue: [^true]].
      ^false.
    )

    /// Folds the elements from the left: answers `initial` for an empty
    /// collection, otherwise the last answer of `fold value: accumulated
    /// value: element`, where `accumulated` starts as `initial` and
    /// becomes each answer in turn.
    ///
    /// fold: a two-argument block.
    public inject: initial into: fold = (
      |
        accumulated ::= initial.
      |
      self do: [:element | accumulated:: fold value: accumulated value: element].
      ^accumulated.
    )

    /// Answers whether the collection holds no element.
    public isEmpty = (
      ^self size = 0.
    )

    /// Folds the elements from the left, starting with the first: a
    /// one-element collection answers that element without sending
    /// `merge`; a longer one answers the last answer of `merge value:
    /// accumulated value: element` over the rest.
    ///
    /// merge: a two-argument block.
    ///
    /// Signals an Error, 'Cannot reduce an empty collection', for an
    /// empty collection.
    public reduce: merge = (
      ^self reduce: merge ifEmpty: [
        (outer Kernel Error new) signal: 'Cannot reduce an empty collection'.
      ].
    )

    /// As `reduce:`, but answers the value of `onEmpty` for an empty
    /// collection.
    ///
    /// merge: a two-argument block.
    /// onEmpty: anything understanding `value`; sent it only when the
    ///     collection is empty.
    public reduce: merge ifEmpty: onEmpty = (
      |
        first ::= true.
        accumulated
      |
      self do: [:element |
        first ifTrue: [
          first:: false.
          accumulated:: element.
        ] ifFalse: [
          accumulated:: merge value: accumulated value: element.
        ].
      ].
      first ifTrue: [^onEmpty value].
      ^accumulated.
    )

    /// Answers a new collection, from `newForCollectUsingAdd:`, holding
    /// `transform`'s answer for each element, added in `do:` order. The
    /// receiver is unchanged.
    ///
    /// transform: a one-argument block.
    ///
    /// Signals what `newForCollectUsingAdd:` signals when the subclass
    /// does not define it.
    public collect: transform = (
      |
        result = self newForCollectUsingAdd: self size.
      |
      self do: [:element | result add: (transform value: element)].
      ^result.
    )

    /// Answers a new collection, from `newForCollectUsingAdd:`, holding
    /// the elements for which `predicate` answers true, in `do:` order.
    /// The receiver is unchanged.
    ///
    /// predicate: a one-argument block answering a Boolean.
    ///
    /// Signals what `newForCollectUsingAdd:` signals when the subclass
    /// does not define it.
    public select: predicate = (
      |
        result = self newForCollectUsingAdd: self size.
      |
      self do: [:element | (predicate value: element) ifTrue: [result add: element]].
      ^result.
    )

    /// Answers a new collection, from `newForCollectUsingAdd:`, holding
    /// the elements for which `predicate` answers false, in `do:` order.
    /// The receiver is unchanged.
    ///
    /// predicate: a one-argument block answering a Boolean.
    ///
    /// Signals what `newForCollectUsingAdd:` signals when the subclass
    /// does not define it.
    public reject: predicate = (
      |
        result = self newForCollectUsingAdd: self size.
      |
      self do: [:element | (predicate value: element) ifFalse: [result add: element]].
      ^result.
    )

    /// Answers the number of elements, counted through `do:`.
    public size = (
      |
        count ::= 0.
      |
      self do: [:element | count:: count + 1].
      ^count.
    )
  )

  /// The sequence protocol shared by the classes whose elements are
  /// indexed from 1, a mixin `Array` and `ByteArray` apply over `Collection`
  /// (`Collection <: IndexedCollection`, §6.2): every member here is
  /// written over `at:`, `at:put:`, `size` and `newOfSize:`, which each
  /// class applying it implements, and a class overrides any member it
  /// can answer faster.
  ///
  /// It declares none of `at:`, `at:put:`, `size`, `do:`, `=`, `hash` and
  /// `printString`, so that a failure block's `super` send in the class
  /// applying it passes through to `Collection` and `Object`. Its own
  /// superclass, `Collection`, records that its members build on
  /// `Collection`'s protocol; applying it takes only its own members.
  /// Public so that a shipped module can apply it (`TypedArraysFactory`
  /// applies it over `Collection` to make the typed arrays); no facet
  /// hands it to a program, which meets it only through the classes that
  /// apply it.
  public class IndexedCollection = Collection () (
    /// Answers a new instance of the receiver's kind holding `size`
    /// elements, each the empty element of that kind.
    ///
    /// size: an Integer of at least 0.
    ///
    /// Here, signals the Error of `subclassResponsibility`,
    /// 'IndexedCollection>>newOfSize: is abstract: … must implement it':
    /// every class applying the mixin defines it.
    protected newOfSize: size = (
      ^self subclassResponsibility.
    )

    /// Answers whether the receiver has no element.
    public isEmpty = (
      ^self size = 0.
    )

    /// Answers the first element.
    ///
    /// Signals what `at:` signals for the index 1 when the receiver is
    /// empty: for an Array, an ArgumentError carrying 1.
    public first = (
      ^self at: 1.
    )

    /// Answers the last element.
    ///
    /// Signals what `at:` signals for the index 0 when the receiver is
    /// empty: for an Array, an ArgumentError carrying 0.
    public last = (
      ^self at: self size.
    )

    /// Answers the index of the first element `=` to `element`, or 0
    /// when there is none. Each element is sent `=` with `element`, from
    /// the first, until one answers true.
    public indexOf: element = (
      1 to: self size do: [:index | (self at: index) = element ifTrue: [^index]].
      ^0.
    )

    /// Evaluates `action` with each index and the element there, from
    /// the first, reading each element when it reaches it. Answers the
    /// receiver.
    ///
    /// action: a two-argument block, given the index and the element.
    public keysAndValuesDo: action = (
      1 to: self size do: [:index | action value: index value: (self at: index)].
    )

    /// Answers a new collection of the receiver's kind holding the
    /// elements from `start` to `stop`, in order; empty when `stop` is
    /// `start - 1`. The receiver is unchanged.
    ///
    /// start, stop: Integers with 1 <= start <= stop + 1 and
    ///     stop <= size.
    ///
    /// Signals an Array's ArgumentErrors for the range: carrying the
    /// bound out of range, 'copyFrom: … to: … out of range: valid ranges
    /// lie within 1..size, an empty range ends just before it starts
    /// (size …)', or 'copyFrom:to: requires an Integer index, got …' for
    /// a bound that is no Integer.
    public copyFrom: start to: stop = (
      |
        result
      |
      self checkRangeFrom: start to: stop keyword: 'copyFrom:' ifNoInteger: [
        (outer Kernel Array new: 0) copyFrom: start to: stop.
      ].
      result:: self newOfSize: stop - start + 1.
      1 to: result size do: [:index | result at: index put: (self at: start + index - 1)].
      ^result.
    )

    /// Stores the elements of `source` from `sourceStart` on into the
    /// receiver's positions `start` to `stop`, and answers the
    /// receiver. Correct when `source` is the receiver and the ranges
    /// overlap: every element is read before any is stored.
    ///
    /// start, stop: a range of the receiver, as for `copyFrom:to:`.
    /// source: anything answering `size` and `at:` -- an Array, a List,
    ///     a String, whose elements are its code points.
    /// sourceStart: an Integer with 1 <= sourceStart and
    ///     sourceStart + (stop - start) <= source size.
    ///
    /// Signals, before it reads or stores any element, an Array's
    /// ArgumentErrors: for a range the receiver does not hold, the one
    /// `copyFrom:to:` signals, its text beginning 'replaceFrom: … to: …';
    /// for a bound or a `sourceStart` that is no Integer,
    /// 'replaceFrom:to:with:startingAt: requires an Integer index, got
    /// …'; and for a source too short, one carrying `sourceStart`,
    /// 'startingAt: … out of range: the source holds … elements, the
    /// range needs … from …'. Then signals what `at:put:` signals for an
    /// element the receiver cannot hold.
    ///
    /// The elements the range needs are copied into an Array first, which
    /// is what makes an overlapping range correct.
    public replaceFrom: start to: stop with: source startingAt: sourceStart = (
      |
        count
        elements
      |
      self checkRangeFrom: start to: stop keyword: 'replaceFrom:' ifNoInteger: [
        (outer Kernel Array new: 0) replaceFrom: start
            to: stop
            with: (outer Kernel Array new: 0)
            startingAt: 1.
      ].
      count:: stop - start + 1.
      self checkSourceStart: sourceStart count: count sourceSize: source size.
      elements:: outer Kernel Array new: count.
      1 to: count do: [:index | elements at: index put: (source at: sourceStart + index - 1)].
      1 to: count do: [:index | self at: start + index - 1 put: (elements at: index)].
    )

    /// Answers the receiver when `start` to `stop` is a range it holds --
    /// 1 <= start <= stop + 1 and stop <= size, the empty range included
    /// -- and otherwise signals the ArgumentError an Array's leaf signals
    /// for it: carrying the start unless it is a position the receiver
    /// has, one past the end included, and then the stop, with the text
    /// '<keyword> … to: … out of range: valid ranges lie within 1..size,
    /// an empty range ends just before it starts (size …)'.
    ///
    /// keyword: the String naming the selector's first keyword,
    ///     'copyFrom:' or 'replaceFrom:'.
    /// refuse: a block, evaluated when a bound is no Integer, that
    ///     signals the selector's own 'requires an Integer index' error.
    ///
    /// The texts are an Array leaf's, so that a receiver of any kind fails
    /// as an Array does. A bound that is no Integer is refused by that
    /// leaf on an empty Array, since the description of an arbitrary
    /// object is the leaf's to give; checking the range itself allocates
    /// nothing, whatever the receiver's size.
    private checkRangeFrom: start to: stop keyword: keyword ifNoInteger: refuse = (
      |
        receiverSize
        refused
      |
      (start isKindOfInteger and: [stop isKindOfInteger]) ifFalse: [^refuse value].
      receiverSize:: self size.
      (start >= 1 and: [stop >= (start - 1) and: [stop <= receiverSize]]) ifTrue: [^self].
      refused:: (start >= 1 and: [start - 1 <= receiverSize]) ifTrue: [stop] ifFalse: [start].
      ^(outer Kernel ArgumentError value: refused) signal: keyword
          , ' '
          , start printString
          , ' to: '
          , stop printString
          , ' out of range: valid ranges lie within 1..'
          , receiverSize printString
          , ', an empty range ends just before it starts (size '
          , receiverSize printString
          , ')'.
    )

    /// Answers the receiver when a source of `sourceSize` elements holds
    /// `count` of them from `sourceStart` on, and otherwise signals the
    /// ArgumentError an Array's `replaceFrom:to:with:startingAt:` leaf
    /// signals for it, carrying `sourceStart`: 'startingAt: … out of
    /// range: the source holds … elements, the range needs … from …', or
    /// 'replaceFrom:to:with:startingAt: requires an Integer index, got …'
    /// for a `sourceStart` that is no Integer.
    ///
    /// count, sourceSize: Integers of at least 0.
    ///
    /// The texts are the leaf's, as `checkRangeFrom:to:keyword:ifNoInteger:`'s
    /// are, and so is the refusal of a start that is no Integer.
    private checkSourceStart: sourceStart count: count sourceSize: sourceSize = (
      sourceStart isKindOfInteger ifFalse: [
        ^(outer Kernel Array new: 0) replaceFrom: 1
            to: 0
            with: (outer Kernel Array new: 0)
            startingAt: sourceStart.
      ].
      (sourceStart >= 1 and: [sourceStart - 1 + count <= sourceSize]) ifTrue: [^self].
      ^(outer Kernel ArgumentError value: sourceStart) signal: 'startingAt: '
          , sourceStart printString
          , ' out of range: the source holds '
          , sourceSize printString
          , (sourceSize = 1 ifTrue: [' element'] ifFalse: [' elements'])
          , ', the range needs '
          , count printString
          , ' from '
          , sourceStart printString.
    )

    /// Answers a new collection of the receiver's kind holding the
    /// receiver's elements followed by those of `collection`. The
    /// receiver is unchanged.
    ///
    /// collection: anything answering `size` and `at:` -- an Array, a
    ///     List, a String, whose elements are its code points.
    ///
    /// Signals what `at:put:` signals for an element of `collection` the
    /// receiver's kind cannot hold.
    public , collection = (
      |
        result = self newOfSize: self size + collection size.
      |
      result replaceFrom: 1 to: self size with: self startingAt: 1.
      result replaceFrom: self size + 1 to: result size with: collection startingAt: 1.
      ^result.
    )

    /// Answers a new collection of the receiver's kind one longer than
    /// the receiver, `element` last. The receiver is unchanged.
    ///
    /// Signals what `at:put:` signals for an `element` the receiver's
    /// kind cannot hold.
    public copyWith: element = (
      |
        result = self copyWithSize: self size + 1.
      |
      result at: result size put: element.
      ^result.
    )

    /// Answers a new collection of the receiver's kind of `newSize`
    /// elements: the receiver's first ones, cut off when `newSize` is
    /// smaller than `size`, followed by the empty element of that kind
    /// -- nil for an Array -- when it is larger. The receiver is
    /// unchanged.
    ///
    /// newSize: an Integer of at least 0.
    ///
    /// Signals what `newOfSize:` signals for a `newSize` that is negative
    /// or no Integer: for an Array, the ArgumentError of `Array new:`.
    public copyWithSize: newSize = (
      |
        result = self newOfSize: newSize.
        kept = newSize < self size ifTrue: [newSize] ifFalse: [self size].
      |
      result replaceFrom: 1 to: kept with: self startingAt: 1.
      ^result.
    )

    /// Answers a new Array of `transform`'s answer for each element, in
    /// order: an Array whatever the receiver's kind, since `transform`
    /// may answer anything. The receiver is unchanged.
    ///
    /// transform: a one-argument block.
    public collect: transform = (
      |
        result = outer Kernel Array new: self size.
      |
      1 to: self size do: [:index | result at: index put: (transform value: (self at: index))].
      ^result.
    )

    /// Answers a new collection of the receiver's kind holding the
    /// elements for which `predicate` answers true, in order. The
    /// receiver is unchanged.
    ///
    /// predicate: a one-argument block answering a Boolean.
    public select: predicate = (
      |
        result = self newOfSize: self size.
        count ::= 0.
        element
      |
      1 to: self size do: [:index |
        element:: self at: index.
        (predicate value: element) ifTrue: [
          count:: count + 1.
          result at: count put: element.
        ].
      ].
      ^result copyFrom: 1 to: count.
    )

    /// Answers a new collection of the receiver's kind holding the
    /// elements for which `predicate` answers false, in order. The
    /// receiver is unchanged.
    ///
    /// predicate: a one-argument block answering a Boolean.
    public reject: predicate = (
      ^self select: [:element | (predicate value: element) not].
    )

    /// Sorts the elements in place, stably -- elements that may precede
    /// each other both ways keep their order -- and answers the
    /// receiver.
    ///
    /// lessOrEqual: a two-argument block answering whether its first
    ///     argument may precede its second.
    public sort: lessOrEqual = (
      ^self sortFrom: 1 to: self size by: lessOrEqual.
    )

    /// Sorts the elements from `start` to `stop` in place, stably, as
    /// `sort:` does, and answers the receiver; the rest stay where they
    /// are.
    ///
    /// start, stop: a range of the receiver, as for `copyFrom:to:`.
    /// lessOrEqual: a two-argument block answering whether its first
    ///     argument may precede its second.
    ///
    /// Signals the ArgumentError of `copyFrom:to:` for a range the
    /// receiver does not hold.
    ///
    /// A bottom-up merge sort over a copy of the range and a buffer of
    /// the same size, trading the two each pass: no recursion, so its
    /// depth does not grow with the range, and two collections of the
    /// receiver's kind the size of the range as extra memory. Taking from
    /// the left run while its element may precede the right run's keeps
    /// it stable.
    public sortFrom: start to: stop by: lessOrEqual = (
      |
        source ::= self copyFrom: start to: stop.
        target
        count = source size.
        width ::= 1.
        left
        swap
      |
      count < 2 ifTrue: [^self].
      target:: self newOfSize: count.
      [width < count] whileTrue: [
        left:: 1.
        [left <= count] whileTrue: [
          self merge: source into: target from: left width: width count: count by: lessOrEqual.
          left:: left + width + width.
        ].
        swap:: source.
        source:: target.
        target:: swap.
        width:: width + width.
      ].
      self replaceFrom: start to: stop with: source startingAt: 1.
    )

    /// Merges the sorted runs of `source` that start at `left` -- the
    /// first `width` elements long, the second the next `width`, each
    /// cut off at `count` -- into the same positions of `target`,
    /// taking from the first run while its element may precede the
    /// second's.
    private merge: source into: target from: left width: width count: count by: lessOrEqual = (
      |
        middle ::= left + width - 1.
        right
        leftCursor ::= left.
        rightCursor
        targetCursor ::= left.
      |
      middle > count ifTrue: [middle:: count].
      right:: middle + width.
      right > count ifTrue: [right:: count].
      rightCursor:: middle + 1.
      [targetCursor <= right] whileTrue: [
        ((rightCursor > right) or: [
          (leftCursor <= middle) and: [
            lessOrEqual value: (source at: leftCursor) value: (source at: rightCursor).
          ].
        ]) ifTrue: [
          target at: targetCursor put: (source at: leftCursor).
          leftCursor:: leftCursor + 1.
        ] ifFalse: [
          target at: targetCursor put: (source at: rightCursor).
          rightCursor:: rightCursor + 1.
        ].
        targetCursor:: targetCursor + 1.
      ].
    )

    /// Answers a new Array of the receiver's elements, in order. The
    /// receiver is unchanged, and later changes to either do not reach
    /// the other.
    public asArray = (
      |
        result = outer Kernel Array new: self size.
      |
      1 to: self size do: [:index | result at: index put: (self at: index)].
      ^result.
    )
  )

  /// A fixed-size sequence of objects, indexed from 1, and a Collection:
  /// `Array new: 3`, or a literal such as `{1. 2}`. The sequence protocol
  /// comes from `IndexedCollection`, over the leaves here.
  public class Array = Collection <: IndexedCollection () (
    /// Answers true: the receiver is an Array.
    public isKindOfArray = (
      ^true.
    )

    /// Evaluates `action` with each element in turn, from the first,
    /// reading each element only when it reaches it, so that a store
    /// ahead of the walk is seen; answers the receiver.
    ///
    /// action: a block of one argument, or anything understanding
    /// `value:`; sent `value:` with each element.
    ///
    /// Signals an ArgumentError carrying the block, 'wrong number of
    /// block arguments: block takes …, got 1', for a block that does
    /// not take one argument.
    public do: action = (
      ^vmMirror collection: self do: action ifFail: [^super do: action].
    )

    /// Stores `value` at `index` and answers `value`.
    ///
    /// index: an Integer from 1 to `size`.
    /// value: any object; the Array holds it from now on.
    ///
    /// Signals an ArgumentError carrying `index`: 'index … out of
    /// range: valid indices are 1..size (size …)' for an Integer outside
    /// 1 to `size`, a LargeInteger included, and 'at:put: requires an
    /// Integer index, got …' for an index that is no Integer.
    public at: index put: value = (
      ^vmMirror collection: self at: index put: value ifFail: [^super at: index put: value].
    )

    /// Answers the number of elements, fixed when the Array was
    /// made.
    public size = (
      ^vmMirror collectionSize: self ifFail: [^super size].
    )

    /// Answers the element at `index`.
    ///
    /// index: an Integer from 1 to `size`.
    ///
    /// Signals an ArgumentError carrying `index`: 'index … out of
    /// range: valid indices are 1..size (size …)' for an Integer outside
    /// 1 to `size`, a LargeInteger included, and 'at: requires an
    /// Integer index, got …' for an index that is no Integer.
    public at: index = (
      ^vmMirror collection: self at: index ifFail: [^super at: index].
    )

    /// Answers the receiver itself: an Array is its own Array.
    public asArray = (
      ^self.
    )

    /// Answers a new Array of `size` elements, each nil: the new
    /// instance of the receiver's kind the sequence protocol builds its
    /// answers in.
    ///
    /// size: an Integer of at least 0.
    ///
    /// Signals the ArgumentError of `Array new:` for a `size` that is
    /// negative or no Integer.
    protected newOfSize: size = (
      ^outer Kernel Array new: size.
    )

    /// Answers a new Array of the elements from `start` to `stop`; empty
    /// when `stop` is `start - 1`. The receiver is unchanged.
    ///
    /// start, stop: Integers with 1 <= start <= stop + 1 and
    ///     stop <= size.
    ///
    /// Signals an ArgumentError carrying the bound out of range,
    /// 'copyFrom: … to: … out of range: valid ranges lie within
    /// 1..size, an empty range ends just before it starts (size …)', or
    /// 'copyFrom:to: requires an Integer index, got …' for a bound that
    /// is no Integer.
    public copyFrom: start to: stop = (
      ^vmMirror collection: self copyFrom: start to: stop ifFail: [^super copyFrom: start to: stop].
    )

    /// Stores the elements of `source` from `sourceStart` on into the
    /// receiver's positions `start` to `stop`, and answers the
    /// receiver. Correct when `source` is the receiver and the ranges
    /// overlap: every element is read before any is stored.
    ///
    /// start, stop: a range of the receiver, as for `copyFrom:to:`.
    /// source: an Array, or anything answering `size` and `at:` -- a
    ///     List, a String, whose elements are its code points.
    /// sourceStart: an Integer with 1 <= sourceStart and
    ///     sourceStart + (stop - start) <= source size.
    ///
    /// Signals the ArgumentError `copyFrom:to:` signals, its text
    /// beginning 'replaceFrom: … to: …', for a range the receiver does
    /// not hold, and an ArgumentError carrying `sourceStart`,
    /// 'startingAt: … out of range: the source holds … elements, the
    /// range needs … from …', for a source too short.
    ///
    /// The leaf takes an Array source; any other source falls to
    /// `IndexedCollection`'s, which copies it into an Array first.
    public replaceFrom: start to: stop with: source startingAt: sourceStart = (
      ^vmMirror collection: self
          replaceFrom: start
          to: stop
          with: source
          startingAt: sourceStart
          ifFail: [^super replaceFrom: start to: stop with: source startingAt: sourceStart].
    )
  ) : (
    /// Answers a new Array of `size` elements, each nil.
    ///
    /// size: an Integer, at least 0.
    ///
    /// Signals an ArgumentError carrying `size`: 'new: requires an
    /// Integer size, got …' for a size that is no Integer, 'new:
    /// requires a size of at least 0, got …' for a negative one, and
    /// 'new: cannot allocate an Array of … elements' for one too large
    /// to allocate.
    ///
    /// A sized array of nils, which `List` grows into and the handler
    /// search fills. The leaf declines only a subject that is not `Array`
    /// itself, which a flat class side cannot be sent from.
    public new: size = (
      ^vmMirror arrayClass: self new: size ifFail: [nil].
    )

    /// Answers a new Array of `collection`'s elements, in its `do:`
    /// order.
    ///
    /// collection: a Collection, or anything answering `size` and
    ///     `do:` -- a String, whose elements are its code points.
    public withAll: collection = (
      |
        result = self new: collection size.
        index ::= 0.
      |
      collection do: [:element |
        index:: index + 1.
        result at: index put: element.
      ].
      ^result.
    )
  )

  /// A fixed-size sequence of bytes, each an Integer from 0 to 255,
  /// indexed from 1, and a Collection: `ByteArray new: 4` makes one of
  /// zeros. The sequence protocol comes from `IndexedCollection`, over
  /// the leaves here. No value: `=` and `hash` are identity, since a hash
  /// of the bytes would change under a Map's key as they are stored.
  public class ByteArray = Collection <: IndexedCollection () (
    /// Answers true: the receiver is a ByteArray.
    public isKindOfByteArray = (
      ^true.
    )

    /// Evaluates `action` with each byte in turn, from the first, reading
    /// each byte only when it reaches it, so that a store ahead of the
    /// walk is seen; answers the receiver.
    ///
    /// action: a block of one argument, or anything understanding
    /// `value:`; sent `value:` with each byte.
    ///
    /// Signals what `action`'s `value:` signals.
    ///
    /// The size is read through its leaf rather than `self size`, which
    /// for a receiver holding no bytes -- an instance of a subclass --
    /// would reach Collection's `size`, which counts through `do:` and
    /// would come back here; the declining leaf sends such a receiver on
    /// to Collection's `do:` instead.
    public do: action = (
      |
        count = vmMirror byteArraySize: self ifFail: [^super do: action].
      |
      1 to: count do: [:index | action value: (self at: index)].
    )

    /// Stores `value` at `index` and answers `value`.
    ///
    /// index: an Integer from 1 to `size`.
    /// value: an Integer from 0 to 255.
    ///
    /// Signals an ArgumentError carrying `index`: 'index … out of
    /// range: valid indices are 1..size (size …)' for an Integer outside
    /// 1 to `size`, a LargeInteger included, and 'at:put: requires an
    /// Integer index, got …' for an index that is no Integer; and an
    /// ArgumentError carrying `value`, 'at:put: requires an Integer from
    /// 0 to 255, got …', for a value outside 0 to 255 or no Integer. A
    /// refused store leaves the byte as it was.
    public at: index put: value = (
      ^vmMirror byteArray: self at: index put: value ifFail: [^super at: index put: value].
    )

    /// Answers the number of bytes, fixed when the ByteArray was made.
    public size = (
      ^vmMirror byteArraySize: self ifFail: [^super size].
    )

    /// Answers the byte at `index`, an Integer from 0 to 255.
    ///
    /// index: an Integer from 1 to `size`.
    ///
    /// Signals an ArgumentError carrying `index`: 'index … out of
    /// range: valid indices are 1..size (size …)' for an Integer outside
    /// 1 to `size`, a LargeInteger included, and 'at: requires an
    /// Integer index, got …' for an index that is no Integer.
    public at: index = (
      ^vmMirror byteArray: self at: index ifFail: [^super at: index].
    )

    /// Stores the UTF-8 bytes of the code point `codePoint` from `index`
    /// on, and answers how many it stored, an Integer from 1 to 4.
    ///
    /// index: an Integer from 1 to `size`, with room from it to the end
    ///     for every byte of `codePoint`.
    /// codePoint: an Integer from 0 to 1114111 outside 55296 to 57343.
    ///
    /// Signals an ArgumentError carrying `index`: 'index … out of
    /// range: valid indices are 1..size (size …)' for an index outside 1
    /// to `size`, a LargeInteger included, or one whose last byte would
    /// pass the end, naming that byte's index; and 'at:putCodePoint:
    /// requires an Integer index, got …' for an index that is no
    /// Integer. Signals an ArgumentError carrying `codePoint`,
    /// 'at:putCodePoint: requires a Unicode scalar value, got …', for
    /// any other code point. A refused store leaves every byte as it was.
    ///
    /// `StringBuilder>>addCodePoint:` writes through it.
    public at: index putCodePoint: codePoint = (
      ^vmMirror byteArray: self at: index putCodePoint: codePoint ifFail: [
        ^super at: index putCodePoint: codePoint.
      ].
    )

    /// Answers the receiver itself: a ByteArray is its own ByteArray.
    public asByteArray = (
      ^self.
    )

    /// Answers a new ByteArray of `size` bytes, each 0: the new instance
    /// of the receiver's kind the sequence protocol builds its answers
    /// in.
    ///
    /// size: an Integer of at least 0.
    ///
    /// Signals the ArgumentError of `ByteArray new:` for a `size` that is
    /// negative, no Integer or too large to allocate.
    protected newOfSize: size = (
      ^outer Kernel ByteArray new: size.
    )

    /// Answers a new ByteArray of the bytes from `start` to `stop`; empty
    /// when `stop` is `start - 1`. The receiver is unchanged.
    ///
    /// start, stop: Integers with 1 <= start <= stop + 1 and
    ///     stop <= size.
    ///
    /// Signals an ArgumentError carrying the bound out of range,
    /// 'copyFrom: … to: … out of range: valid ranges lie within
    /// 1..size, an empty range ends just before it starts (size …)', or
    /// 'copyFrom:to: requires an Integer index, got …' for a bound that
    /// is no Integer.
    public copyFrom: start to: stop = (
      ^vmMirror byteArray: self copyFrom: start to: stop ifFail: [^super copyFrom: start to: stop].
    )

    /// Stores the bytes of `source` from `sourceStart` on into the
    /// receiver's positions `start` to `stop`, and answers the receiver.
    /// Correct when `source` is the receiver and the ranges overlap, in
    /// either direction.
    ///
    /// start, stop: a range of the receiver, as for `copyFrom:to:`.
    /// source: a ByteArray; a String, which counts as its UTF-8 bytes, so
    ///     that `sourceStart` counts bytes, not code points; or anything
    ///     answering `size` and `at:` with Integers from 0 to 255.
    /// sourceStart: an Integer with 1 <= sourceStart and
    ///     sourceStart + (stop - start) <= the source's size in bytes.
    ///
    /// Signals, before it stores any byte, the ArgumentError
    /// `copyFrom:to:` signals, its text beginning 'replaceFrom: … to: …',
    /// for a range the receiver does not hold;
    /// 'replaceFrom:to:with:startingAt: requires an Integer index, got
    /// …' for a bound or a `sourceStart` that is no Integer; and an
    /// ArgumentError carrying `sourceStart`, 'startingAt: … out of range:
    /// the source holds … elements, the range needs … from …', for a
    /// source too short. From any other source, signals then what
    /// `at:put:` signals for an element that is no byte.
    ///
    /// The leaf takes a ByteArray or a String source; any other source
    /// falls to `IndexedCollection`'s, which copies it into an Array
    /// first and then stores its elements one by one, so an element
    /// `at:put:` refuses leaves the bytes before it already stored.
    public replaceFrom: start to: stop with: source startingAt: sourceStart = (
      ^vmMirror byteArray: self
          replaceFrom: start
          to: stop
          with: source
          startingAt: sourceStart
          ifFail: [^super replaceFrom: start to: stop with: source startingAt: sourceStart].
    )

    /// Answers a new ByteArray of the receiver's bytes followed by those
    /// of `collection`. The receiver is unchanged.
    ///
    /// collection: a ByteArray; a String, which counts as its UTF-8
    ///     bytes; or anything answering `size` and `at:` with Integers
    ///     from 0 to 255.
    ///
    /// Signals an ArgumentError carrying `collection`, ', cannot
    /// allocate a ByteArray of … bytes', for a result too large to
    /// allocate, and, for any other `collection`, what `at:put:` signals
    /// for an element that is no byte.
    public , collection = (
      ^vmMirror byteArray: self concatenate: collection ifFail: [^super , collection].
    )

    /// Answers the index of the first occurrence of `element`, or 0;
    /// `indexOf: element startingAt: 1`.
    public indexOf: element = (
      ^self indexOf: element startingAt: 1.
    )

    /// Answers the index at which the first occurrence of `element` that
    /// starts at or after `start` begins, or 0 when there is none.
    ///
    /// element: an Integer, looked for as one byte -- one outside 0 to
    ///     255 is never found; a ByteArray, or a String, which counts as
    ///     its UTF-8 bytes, looked for as a run of bytes, an empty one
    ///     found at `start`; or any other object, looked for as an
    ///     element, each byte from `start` on sent `=` with it.
    /// start: an Integer from 1 to `size + 1`.
    ///
    /// Signals an ArgumentError carrying `start`, 'indexOf:startingAt: …
    /// out of range: valid starts are 1..… (size …)', for a `start`
    /// outside 1 to `size + 1`, or 'indexOf:startingAt: requires an
    /// Integer index, got …'.
    public indexOf: element startingAt: start = (
      ^vmMirror byteArray: self indexOf: element startingAt: start ifFail: [
        start to: self size do: [:index | (self at: index) = element ifTrue: [^index]].
        0.
      ].
    )

    /// Answers the index of the last occurrence of `element`, or 0;
    /// `lastIndexOf: element startingAt: size + 1`.
    public lastIndexOf: element = (
      ^self lastIndexOf: element startingAt: self size + 1.
    )

    /// Answers the index at which the last occurrence of `element` that
    /// starts at or before `start` begins, or 0 when there is none.
    ///
    /// element: as for `indexOf:startingAt:`; an empty run of bytes is
    ///     found at `start`.
    /// start: an Integer from 1 to `size + 1`.
    ///
    /// Signals the ArgumentErrors `indexOf:startingAt:` signals, their
    /// texts naming 'lastIndexOf:startingAt:'.
    public lastIndexOf: element startingAt: start = (
      ^vmMirror byteArray: self lastIndexOf: element startingAt: start ifFail: [
        (start min: self size) to: 1 by: -1 do: [:index |
          (self at: index) = element ifTrue: [^index].
        ].
        0.
      ].
    )

    /// Answers whether the receiver begins with `prefix`; true for an
    /// empty ByteArray or String.
    ///
    /// prefix: an Integer, compared with the first byte; or a ByteArray,
    ///     or a String, which counts as its UTF-8 bytes, compared with the
    ///     first bytes.
    ///
    /// Signals an ArgumentError carrying `prefix`, 'startsWith: requires
    /// an Integer, a ByteArray or a String, got …', for any other
    /// `prefix`.
    public startsWith: prefix = (
      ^vmMirror byteArray: self startsWith: prefix ifFail: [^super startsWith: prefix].
    )

    /// Answers whether the receiver ends with `suffix`; true for an
    /// empty ByteArray or String.
    ///
    /// suffix: an Integer, compared with the last byte; or a ByteArray,
    ///     or a String, which counts as its UTF-8 bytes, compared with the
    ///     last bytes.
    ///
    /// Signals an ArgumentError carrying `suffix`, 'endsWith: requires
    /// an Integer, a ByteArray or a String, got …', for any other
    /// `suffix`.
    public endsWith: suffix = (
      ^vmMirror byteArray: self endsWith: suffix ifFail: [^super endsWith: suffix].
    )
  ) : (
    /// Answers a new ByteArray of `size` bytes, each 0.
    ///
    /// size: an Integer, at least 0.
    ///
    /// Signals an ArgumentError carrying `size`: 'new: requires an
    /// Integer size, got …' for a size that is no Integer, 'new:
    /// requires a size of at least 0, got …' for a negative one, and
    /// 'new: cannot allocate a ByteArray of … bytes' for one too large
    /// to allocate.
    ///
    /// The leaf declines only a subject that is not `ByteArray` itself,
    /// which a flat class side cannot be sent from.
    public new: size = (
      ^vmMirror byteArrayClass: self new: size ifFail: [nil].
    )

    /// Answers a new ByteArray of `collection`'s elements: a copy of a
    /// ByteArray, a String's UTF-8 bytes (`asUtf8`), and otherwise the
    /// elements in `collection`'s `do:` order.
    ///
    /// collection: a ByteArray, a String, or anything answering `size`
    ///     and `do:` whose elements are Integers from 0 to 255 -- an
    ///     Array, a List.
    ///
    /// Signals an ArgumentError carrying the first element that is no
    /// byte, 'withAll: requires an Integer from 0 to 255, got …' and its
    /// `printString`.
    ///
    /// Each element is checked before it is stored, so that the error
    /// names the message the program sent rather than `at:put:`.
    public withAll: collection = (
      |
        result
        index ::= 0.
      |
      collection isKindOfByteArray ifTrue: [^collection copyFrom: 1 to: collection size].
      collection isKindOfString ifTrue: [^collection asUtf8].
      result:: self new: collection size.
      collection do: [:element |
        (element isKindOfInteger and: [element >= 0 and: [element <= 255]]) ifFalse: [
          ^(outer
              Kernel
              ArgumentError value: element) signal: 'withAll: requires an Integer from 0 to 255, got '
              , element printString.
        ].
        index:: index + 1.
        result at: index put: element.
      ].
      ^result.
    )
  )

  /// A fixed-size sequence whose slots hold their objects weakly, indexed
  /// from 1, and a Collection: `WeakArray new: 3` makes one of nils. A
  /// slot holds any object, a value included, without keeping it alive:
  /// once nothing but weak slots reaches the object, a collection sets
  /// every slot holding it to nil. An immediate -- an Integer that fits a
  /// SmallInteger, nil, true, false -- is never collected, so a slot
  /// holding one keeps it. No value: `=` and `hash` are identity.
  ///
  /// Make one with the class side's `new:`, never with the factory
  /// `withoutSlots`. `withoutSlots` answers an instance with no slots at
  /// all, not even zero weak ones: every leaf here declines on it, so
  /// every member but `isKindOfArray` and `isKindOfWeakArray` signals --
  /// `at:` and `at:put:` a MessageNotUnderstood, `size` and the members
  /// built on it the Error of Collection's `subclassResponsibility` -- as
  /// for an instance of a subclass, which holds no slots either. The
  /// factory exists only so that the class's factory is not `new`, which
  /// keeps `WeakArray new` not understood: there is no WeakArray without
  /// a size.
  public class WeakArray withoutSlots = Collection () (
    /// Answers true: the receiver is a WeakArray.
    public isKindOfWeakArray = (
      ^true.
    )

    /// Answers true, as an Array does: a WeakArray answers the sequence
    /// protocol -- `at:`, `at:put:`, `size`, `do:` -- that code asking
    /// this sends.
    public isKindOfArray = (
      ^true.
    )

    /// Answers the object in the slot at `index`, or nil when the slot
    /// holds none or the collector has reclaimed its object.
    ///
    /// index: an Integer from 1 to `size`.
    ///
    /// Signals an ArgumentError carrying `index`: 'index … out of
    /// range: valid indices are 1..size (size …)' for an Integer outside
    /// 1 to `size`, a LargeInteger included, and 'at: requires an
    /// Integer index, got …' for an index that is no Integer.
    public at: index = (
      ^vmMirror weakArray: self at: index ifFail: [^super at: index].
    )

    /// Stores `value` in the slot at `index` and answers `value`.
    ///
    /// index: an Integer from 1 to `size`.
    /// value: any object; the slot holds it until a collection finds
    ///     nothing but weak slots reaching it.
    ///
    /// Signals an ArgumentError carrying `index`: 'index … out of
    /// range: valid indices are 1..size (size …)' for an Integer outside
    /// 1 to `size`, a LargeInteger included, and 'at:put: requires an
    /// Integer index, got …' for an index that is no Integer. A refused
    /// store leaves the slot as it was.
    public at: index put: value = (
      ^vmMirror weakArray: self at: index put: value ifFail: [^super at: index put: value].
    )

    /// Answers the number of slots, fixed when the WeakArray was made;
    /// a slot the collector cleared still counts.
    public size = (
      ^vmMirror weakArraySize: self ifFail: [^super size].
    )

    /// Answers whether the receiver has no slot.
    public isEmpty = (
      ^self size = 0.
    )

    /// Evaluates `action` with the object in each slot in turn, from the
    /// first, nil for a slot that holds none, reading each slot only when
    /// it reaches it; answers the receiver.
    ///
    /// action: a block of one argument, or anything understanding
    /// `value:`; sent `value:` with each slot's object.
    ///
    /// Signals what `action`'s `value:` signals.
    ///
    /// The size is read through its leaf rather than `self size`, which
    /// for a receiver holding no slots -- an instance of a subclass --
    /// would reach Collection's `size`, which counts through `do:` and
    /// would come back here; the declining leaf sends such a receiver on
    /// to Collection's `do:` instead.
    public do: action = (
      |
        count = vmMirror weakArraySize: self ifFail: [^super do: action].
      |
      1 to: count do: [:index | action value: (self at: index)].
    )

    /// Evaluates `action` with each index and the object in the slot
    /// there, from the first, nil for a slot that holds none, reading
    /// each slot only when it reaches it; answers the receiver.
    ///
    /// action: a two-argument block, given the index and the object.
    ///
    /// Signals what `action`'s `value:value:` signals.
    public keysAndValuesDo: action = (
      1 to: self size do: [:index | action value: index value: (self at: index)].
    )

    /// Answers a new WeakArray one slot longer than the receiver, holding
    /// the receiver's objects in order and `element` last. The receiver
    /// is unchanged.
    ///
    /// element: any object; the new WeakArray holds it weakly.
    public copyWith: element = (
      |
        result = outer Kernel WeakArray new: self size + 1.
      |
      1 to: self size do: [:index | result at: index put: (self at: index)].
      result at: result size put: element.
      ^result.
    )
  ) : (
    /// Answers a new WeakArray of `size` slots, each nil.
    ///
    /// size: an Integer, at least 0.
    ///
    /// Signals an ArgumentError carrying `size`: 'new: requires an
    /// Integer size, got …' for a size that is no Integer, 'new:
    /// requires a size of at least 0, got …' for a negative one, and
    /// 'new: cannot allocate a WeakArray of … elements' for one too
    /// large to allocate.
    ///
    /// The leaf declines only a subject that is not `WeakArray` itself,
    /// which a flat class side cannot be sent from.
    public new: size = (
      ^vmMirror weakArrayClass: self new: size ifFail: [nil].
    )
  )

  /// A view of a ByteArray that reads and writes numbers of one to eight
  /// bytes in a byte order given when it is made, at any byte position:
  /// `DataView on: bytes byteOrder: #bigEndian` and `DataView new: size
  /// byteOrder: #littleEndian` answer an instance of a subclass fixed to
  /// that order, so that no access branches on it. A program makes one with
  /// those two class-side messages and not with `over:`, whose view has no
  /// byte order to read the wider numbers in. The view holds the ByteArray
  /// itself and not a copy, so views over one ByteArray, typed arrays among
  /// them, see each other's writes.
  ///
  /// The accessors are `int8At:` and `uint8At:` -- a single byte has no
  /// order -- here, and `int16At:`, `uint16At:`, `int32At:`, `uint32At:`,
  /// `int64At:`, `uint64At:`, `float32At:` and `float64At:` in each
  /// subclass, every one with a `put:` form. A position counts from 1, as
  /// `at:` does, and need not be a multiple of the width: `uint32At: 3`
  /// reads the bytes 3 to 6. The values follow the typed arrays' rules: an
  /// Integer is checked against its width's range, a float accessor takes
  /// any Number, and `put:` answers the value given. No value: `=` and
  /// `hash` are identity.
  ///
  /// aByteArray: the ByteArray to view.
  ///
  /// Signals an ArgumentError carrying `aByteArray`: 'over: requires a
  /// ByteArray, got …' and its `printString` for anything that is no
  /// ByteArray.
  public class DataView over: aByteArray = Object (
    |
      /// The ByteArray the view reads and writes: the one it was made over,
      /// never a copy.
      public bytes = viewable: aByteArray.
    |
  ) (
    /// Answers true: the receiver is a DataView.
    public isKindOfDataView = (
      ^true.
    )

    /// Answers the byte order the view reads and writes in, the Symbol
    /// #littleEndian or #bigEndian.
    ///
    /// Here, signals the Error of `subclassResponsibility`: the two
    /// subclasses define it.
    public byteOrder = (
      ^self subclassResponsibility.
    )

    /// Answers the number of bytes of `bytes`.
    ///
    /// Signals the ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    public size = (
      bytes isKindOfByteArray ifFalse: [^self noByteArray: #size].
      ^bytes size.
    )

    /// Answers the Integer from -128 to 127 at byte position `position`.
    ///
    /// position: an Integer from 1 to `size`.
    ///
    /// Signals an ArgumentError carrying `position`: 'int8At: position … out of
    /// range: valid positions are 1..… (size …)' or, when `bytes` is empty,
    /// 'int8At: position … out of range: no position holds 1 byte (size …)',
    /// for an Integer outside 1 to `size`, a LargeInteger included, and
    /// 'int8At: requires an Integer position, got …' for a position that is no
    /// Integer; and the ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    public int8At: position = (
      ^vmMirror byteArray: bytes int8At: position ifFail: [^self noByteArray: #int8At:].
    )

    /// Stores `value` at byte position `position` and answers `value` itself.
    ///
    /// position: an Integer from 1 to `size`.
    /// value: an Integer from -128 to 127.
    ///
    /// Signals an ArgumentError carrying `position`: 'int8At:put: position …
    /// out of range: valid positions are 1..… (size …)' or, when `bytes` is
    /// empty, 'int8At:put: position … out of range: no position holds 1 byte
    /// (size …)', for an Integer outside 1 to `size`, a LargeInteger included,
    /// and 'int8At:put: requires an Integer position, got …' for a position
    /// that is no Integer; the ArgumentError of `noByteArray:` when `bytes`
    /// holds no ByteArray; and an ArgumentError carrying `value`, 'int8At:put:
    /// requires an Integer from -128 to 127, got …', for a value outside that
    /// range or no Integer. A refused store leaves the bytes as they were.
    public int8At: position put: value = (
      ^vmMirror byteArray: bytes int8At: position put: value ifFail: [
        ^self noByteArray: #int8At:put:.
      ].
    )

    /// Answers the Integer from 0 to 255 at byte position `position`.
    ///
    /// position: an Integer from 1 to `size`.
    ///
    /// Signals an ArgumentError carrying `position`: 'uint8At: position … out
    /// of range: valid positions are 1..… (size …)' or, when `bytes` is empty,
    /// 'uint8At: position … out of range: no position holds 1 byte (size …)',
    /// for an Integer outside 1 to `size`, a LargeInteger included, and
    /// 'uint8At: requires an Integer position, got …' for a position that is no
    /// Integer; and the ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    public uint8At: position = (
      ^vmMirror byteArray: bytes uint8At: position ifFail: [^self noByteArray: #uint8At:].
    )

    /// Stores `value` at byte position `position` and answers `value` itself.
    ///
    /// position: an Integer from 1 to `size`.
    /// value: an Integer from 0 to 255.
    ///
    /// Signals an ArgumentError carrying `position`: 'uint8At:put: position …
    /// out of range: valid positions are 1..… (size …)' or, when `bytes` is
    /// empty, 'uint8At:put: position … out of range: no position holds 1 byte
    /// (size …)', for an Integer outside 1 to `size`, a LargeInteger included,
    /// and 'uint8At:put: requires an Integer position, got …' for a position
    /// that is no Integer; the ArgumentError of `noByteArray:` when `bytes`
    /// holds no ByteArray; and an ArgumentError carrying `value`, 'uint8At:put:
    /// requires an Integer from 0 to 255, got …', for a value outside that
    /// range or no Integer. A refused store leaves the bytes as they were.
    public uint8At: position put: value = (
      ^vmMirror byteArray: bytes uint8At: position put: value ifFail: [
        ^self noByteArray: #uint8At:put:.
      ].
    )

    /// Signals an ArgumentError carrying `bytes`, '<selector> found no
    /// ByteArray under the view, got …' and its `printString`: what an
    /// access signals when `bytes` holds anything else, which only a
    /// crafted image can make.
    ///
    /// selector: the Symbol of the message the program sent.
    ///
    /// Protected rather than private, since each subclass's accessors
    /// signal it.
    protected noByteArray: selector = (
      ^(outer Kernel ArgumentError value: bytes) signal: selector asString
          , ' found no ByteArray under the view, got '
          , bytes printString.
    )

    /// Answers `aByteArray` when the view can read it: a ByteArray.
    ///
    /// Signals an ArgumentError carrying `aByteArray`: 'over: requires a
    /// ByteArray, got …' and its `printString` for anything else.
    private viewable: aByteArray = (
      aByteArray isKindOfByteArray ifFalse: [
        ^(outer Kernel ArgumentError value: aByteArray) signal: 'over: requires a ByteArray, got '
            , aByteArray printString.
      ].
      ^aByteArray.
    )
  ) : (
    /// Answers a new view of `bytes` reading and writing in the byte order
    /// `order`: an instance of a subclass fixed to it.
    ///
    /// bytes: a ByteArray, viewed itself and not copied.
    /// order: the Symbol #littleEndian or #bigEndian, decided by identity,
    ///     so that a String of the same letters is refused.
    ///
    /// Signals an ArgumentError carrying `bytes`: 'on:byteOrder: requires
    /// a ByteArray, got …' and its `printString` for anything that is no
    /// ByteArray; and one carrying `order`: 'on:byteOrder: requires
    /// #littleEndian or #bigEndian, got …' and its `printString` for
    /// anything else.
    public on: bytes byteOrder: order = (
      bytes isKindOfByteArray ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: bytes) signal: 'on:byteOrder: requires a ByteArray, got '
            , bytes printString.
      ].
      self checkByteOrder: order selector: #on:byteOrder:.
      order == #littleEndian ifTrue: [^outer Kernel LittleEndianDataView over: bytes].
      ^outer Kernel BigEndianDataView over: bytes.
    )

    /// Answers a new view of a new ByteArray of `size` bytes, each 0, in
    /// the byte order `order`.
    ///
    /// size: an Integer, at least 0.
    /// order: the Symbol #littleEndian or #bigEndian.
    ///
    /// Signals the ArgumentError of `on:byteOrder:` for `order`, with the
    /// selector 'new:byteOrder:', before anything about `size`; then an
    /// ArgumentError carrying `size`: 'new:byteOrder: requires an Integer
    /// size, got …' and its `printString` for a size that is no Integer,
    /// 'new:byteOrder: requires a size of at least 0, got …' and its
    /// `printString` for a negative one, and 'new:byteOrder: cannot
    /// allocate a ByteArray of … bytes' for one too large to allocate.
    /// Each is signalled before anything is allocated. A `size` that
    /// answers true to `isKindOfInteger` but is no Integer the VM knows is
    /// a size that is no Integer.
    public new: size byteOrder: order = (
      self checkByteOrder: order selector: #new:byteOrder:.
      ^self on: (self bytesOfSize: size) byteOrder: order.
    )

    /// Answers a new ByteArray of `size` bytes, each 0: the bytes of the
    /// view `new:byteOrder:` makes.
    ///
    /// size: the size given to `new:byteOrder:`.
    ///
    /// Signals the ArgumentErrors `new:byteOrder:` describes for `size`.
    ///
    /// Whether the bytes can be allocated is asked of the VM before
    /// allocating, the same decision `ByteArray new:` makes, so that a
    /// size too large is refused under the message the program sent and
    /// no other error is caught and replaced. Once `isKindOfInteger` has
    /// answered true and `< 0` false, the VM declines to answer only for a
    /// size that is no Integer it knows -- an object that merely claims to
    /// be one -- so the decline is refused as a size that is no Integer,
    /// under `new:byteOrder:` too.
    private bytesOfSize: size = (
      size isKindOfInteger ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: size) signal: 'new:byteOrder: requires an Integer size, got '
            , size printString.
      ].
      size < 0 ifTrue: [
        ^(outer
            Kernel
            ArgumentError value: size) signal: 'new:byteOrder: requires a size of at least 0, got '
            , size printString.
      ].
      (vmMirror byteArrayClass: outer Kernel ByteArray fits: size ifFail: [
        ^(outer
            Kernel
            ArgumentError value: size) signal: 'new:byteOrder: requires an Integer size, got '
            , size printString.
      ]) ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: size) signal: 'new:byteOrder: cannot allocate a ByteArray of '
            , size printString
            , ' bytes'.
      ].
      ^outer Kernel ByteArray new: size.
    )

    /// Answers the receiver when `order` is #littleEndian or #bigEndian and
    /// signals otherwise: what `on:byteOrder:` and `new:byteOrder:` check
    /// before they make anything.
    ///
    /// order: the argument given as the byte order.
    /// selector: the Symbol of the message the program sent.
    ///
    /// Signals an ArgumentError carrying `order`: '<selector> requires
    /// #littleEndian or #bigEndian, got …' and its `printString`.
    private checkByteOrder: order selector: selector = (
      (order == #littleEndian or: [order == #bigEndian]) ifFalse: [
        ^(outer Kernel ArgumentError value: order) signal: selector asString
            , ' requires #littleEndian or #bigEndian, got '
            , order printString.
      ].
    )
  )

  /// A DataView that reads and writes little-endian: the least significant byte
  /// of a value at the lowest position. `DataView` describes the rest of the
  /// protocol.
  ///
  /// aByteArray: the ByteArray to view; `DataView on:byteOrder:` has checked
  ///     it.
  private class LittleEndianDataView over: aByteArray = DataView over: aByteArray () (
    /// Answers #littleEndian.
    public byteOrder = (
      ^#littleEndian.
    )

    /// Answers the Integer from -32768 to 32767 at byte position `position`,
    /// little-endian.
    ///
    /// position: an Integer from 1 to `size` - 1.
    ///
    /// Signals an ArgumentError carrying `position`: 'int16At: position … out
    /// of range: valid positions are 1..… (size …)' or, when `bytes` holds
    /// fewer than 2 bytes, 'int16At: position … out of range: no position holds
    /// 2 bytes (size …)', for an Integer outside 1 to `size` - 1, a
    /// LargeInteger included, and 'int16At: requires an Integer position, got
    /// …' for a position that is no Integer; and the ArgumentError of
    /// `noByteArray:` when `bytes` holds no ByteArray.
    public int16At: position = (
      ^vmMirror byteArray: bytes littleEndianInt16At: position ifFail: [
        ^self noByteArray: #int16At:.
      ].
    )

    /// Stores `value` at byte position `position`, little-endian and answers
    /// `value` itself.
    ///
    /// position: an Integer from 1 to `size` - 1.
