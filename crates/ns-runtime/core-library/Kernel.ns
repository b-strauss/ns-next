    ) : (
        (* Answers a new NonBooleanReceiver carrying `value`, not yet
           signalled.

           value: the condition's answer, any object. *)
        public receiver: value = ( ^self new receiver: value )
        (* As `Exception class>>signal`: signals a new NonBooleanReceiver,
           which carries nil. *)
        public signal = ( ^self new signal )
        (* As `Exception class>>signal:`: signals a new NonBooleanReceiver
           with `text`, which carries nil. *)
        public signal: text = ( ^self new signal: text )
    )
