    public << other = (
      ^vmMirror largeInteger: self shiftLeft: other ifFail: [^super << other].
    )

    /// As `Integer>><`: by the exact values, with the same
    /// ArgumentError.
    ///
    /// @param other a number.
    /// @answers whether the receiver is less than `other`, a Boolean:
    /// false whenever `other` is a NaN.
    /// @signals ArgumentError carrying `other`, '< requires a numeric
    /// argument, got …', for any other argument.
    /// @see `Integer>><`.
    public < other = (
      ^vmMirror largeInteger: self lessThan: other ifFail: [^super < other].
    )

    /// As `Integer>>>`, with the same ArgumentError.
    ///
    /// @param other a number.
    /// @answers whether the receiver is greater than `other`, a Boolean:
    /// false whenever `other` is a NaN.
    /// @signals ArgumentError carrying `other`, '> requires a numeric
    /// argument, got …', for any other argument.
    /// @see `Integer>>>`.
    public > other = (
      ^vmMirror largeInteger: self greaterThan: other ifFail: [^super > other].
    )

    /// As `Integer>><=`, with the same ArgumentError.
    ///
    /// @param other a number.
    /// @answers whether the receiver is less than or equal to `other`, a
    /// Boolean: false whenever `other` is a NaN.
    /// @signals ArgumentError carrying `other`, '<= requires a numeric
    /// argument, got …', for any other argument.
    /// @see `Integer>><=`.
    public <= other = (
      ^vmMirror largeInteger: self lessOrEqual: other ifFail: [^super <= other].
    )

    /// As `Integer>>>=`, with the same ArgumentError.
    ///
    /// @param other a number.
    /// @answers whether the receiver is greater than or equal to `other`,
    /// a Boolean: false whenever `other` is a NaN.
    /// @signals ArgumentError carrying `other`, '>= requires a numeric
    /// argument, got …', for any other argument.
    /// @see `Integer>>>=`.
    public >= other = (
      ^vmMirror largeInteger: self greaterOrEqual: other ifFail: [^super >= other].
    )

    /// Compares the receiver with `other` by exact value, whatever its
    /// class: a LargeInteger equals the Float or the LargeInteger of its
    /// value, never an Integer within -2^60 to 2^60 - 1, which is
    /// another value. It never signals.
