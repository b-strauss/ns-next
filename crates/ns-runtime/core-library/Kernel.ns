    public \\ other = (
      ^vmMirror largeInteger: self modulo: other ifFail: [^super \\ other].
    )

    /// As `Integer>>bitAnd:`, with the same ArgumentError.
    ///
    /// @param other an Integer or a LargeInteger.
    /// @answers the bitwise and of the receiver and `other`.
    /// @signals ArgumentError carrying `other`, 'bitAnd: requires an
    /// integer argument, got …', for any other argument.
    /// @see `Integer>>bitAnd:`.
    public bitAnd: other = (
      ^vmMirror largeInteger: self bitAnd: other ifFail: [^super bitAnd: other].
    )

    /// As `Integer>>bitOr:`, with the same ArgumentError.
    ///
    /// @param other an Integer or a LargeInteger.
    /// @answers the bitwise or of the receiver and `other`.
    /// @signals ArgumentError carrying `other`, 'bitOr: requires an
    /// integer argument, got …', for any other argument.
    /// @see `Integer>>bitOr:`.
    public bitOr: other = (
      ^vmMirror largeInteger: self bitOr: other ifFail: [^super bitOr: other].
    )

    /// As `Integer>>bitXor:`, with the same ArgumentError.
    ///
    /// @param other an Integer or a LargeInteger.
    /// @answers the bitwise exclusive or of the receiver and `other`.
    /// @signals ArgumentError carrying `other`, 'bitXor: requires an
    /// integer argument, got …', for any other argument.
    /// @see `Integer>>bitXor:`.
    public bitXor: other = (
      ^vmMirror largeInteger: self bitXor: other ifFail: [^super bitXor: other].
    )

    /// As `Integer>><<`: the receiver shifted left by `other` bits,
    /// with the same ArgumentErrors.
    ///
    /// @param other an Integer or a LargeInteger, at least 0.
    /// @answers the receiver times 2 to the power `other`.
    /// @signals ArgumentError carrying `other`, '<< requires an integer
    /// argument, got …', for an argument that is no integer.
    /// @signals ArgumentError carrying `other`, '<< takes a non-negative
    /// shift count, got …', for a negative one.
    /// @signals ArgumentError carrying `other`, '<< cannot allocate the
    /// result of shifting by … bits', for a result too large to
    /// allocate.
