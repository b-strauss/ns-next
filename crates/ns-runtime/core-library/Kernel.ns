        (* As `Object>>halt`, for a send from inside the proxy only. *)
        protected halt = ( ^super halt )
    )
    (* A future: what `Future computing:` answers and what a simultaneous
       slot clause stores in a slot until the clause's end. Every message a
       program sends it forces it -- runs its computation once, the first
       time -- and is then sent on to the value. No program can name the
       class. *)
    (* §6.3.2's pull future: what a simultaneous slot clause stores in a slot
       until the clause's end resolves it (docs/design/object-model.md,
       "Simultaneous slots"), and what `Future computing:` answers. Private,
       as `Activation` is, and no program names it: as a `Proxy`, every
       message a program sends it reaches `doesNotUnderstand:`, which
       forwards it to the forced value -- §5.5's proxy, indistinguishable
       from its target. Forcing is the runtime's (`interpreter/future.rs`),
       which alone reads and writes the two slots after the factory: the
       computation, until it is resolved, and then the value, and the state,
       0 unresolved, 1 resolving, 2 resolved. A simultaneous slot clause
       makes its futures in the runtime, of a block; `Future computing:`
       sends the factory, which stores the computation as it is, so a
       future handed to it is not forced until this one is. The
       initializer tells the runtime a future exists, which is what turns
       on its seeing through futures. *)
    private class FutureImplementation computing: theComputation = Proxy new (
        | (* The computation until the future is resolved, then its value;
             read and written only by the runtime after the factory. *)
          private computation ::= theComputation.
          (* The state, read and written only by the runtime: 0
             unresolved, 1 resolving, 2 resolved. *)
          private state ::= 0. |
        vmMirror futureMade: self ifFail: [nil]
    ) (
        (* Forces the future and sends `message` to its value as a public
           send, answering what that send answers.

           message: the `Message` the future was sent.

           Signals an Error, 'divergent evaluation: a future was forced
           while it was being computed', when forcing reaches the future
           while its own computation runs. *)
        protected doesNotUnderstand: message = (
            ^message sendTo: (vmMirror futureValue: self ifFail: [^nil])
        )
    )
    (* The class whose `computing:` answers a future of a block: an object
       that runs the block on its first message and behaves as the block's
       value from then on. `Future new` signals a `CannotInstantiate`. *)
    (* A class only for its class side: the future it answers is a
       `FutureImplementation`, the one class the runtime forces and sees
       through, which no program can name or subclass, so every future
       keeps the rules of docs/design/object-model.md, "Simultaneous
       slots". Its initializer refuses, so a subclass's instances are
       refused too; a subclass does not inherit `computing:` (§3.2). *)
    public class Future = Object new (
        (outer Kernel CannotInstantiate behavior: self class)
            signal: 'a Future is made by Future computing:'
    ) (
    ) : (
        (* Answers a new future of `computation`'s value, computed when the
           future is first sent a message.

           computation: a block of no argument, which the future then
           runs, or any other object, which it then sends `value`. A
           future handed in is forced only then. *)
        public computing: computation = (
            ^outer Kernel FutureImplementation computing: computation
        )
    )
    (* The superclass of every value class: its instances are deeply
       immutable, and two are equal when their classes are equal and their
       slots are equal. *)
    (* §3.1.1: an object is a value object -- deeply immutable and globally
       unique -- only if "its class inherits from class `Value`", so every
       class whose instances are values hangs below this one.

       Each class below it already declares the `hash` its own `=` demands:
       whenever `x = y` is true, `x hash = y hash` must be too. Since a
       value may be copied across an actor boundary, a copy has to hash
       like its original, so none of them may inherit `Object`'s identity
       hash. `Integer`'s, `True`'s and `False`'s are no forwarders to a
       leaf: the value they answer is already at hand. *)
    public class Value = Object new () (
        (* Answers whether `other` is of a class equal to the receiver's and
           its slots, in declaration order, are equal to the receiver's,
           each compared with `=`.

           other: any object; never signals itself, though a slot's own
           `=` may. *)
        (* §3.1.1: a value object is globally unique, in the sense that no
           other object is equal to it -- so equality is derived from state,
           and a value has no observable identity. The leaf declines when a
           slot's class brings its own `=`, because a leaf may not send;
           `valueEquals:` then sends it. *)
        public = other = ( ^vmMirror value: self sameAs: other ifFail: [^self valueEquals: other] )
        (* Answers what `=` answers: a value has no identity of its own. *)
        (* §3.1.1: where `Value` declares an identity method, "that method
           must return the same results as `Value`'s equality method". A send
           of `=` makes that true by construction, for every subclass. *)
        public == other = ( ^self = other )
        (* Answers an Integer computed from the slots, alike for every two
           values `=` makes equal. *)
        public hash = ( ^vmMirror valueHash: self ifFail: [^self valueHashOfSlots] )
        (* Answers the receiver's `hash`: a value's identity is its
           equality. *)
        public identityHash = ( ^self hash )
        (* The equality `=` leaves to Newspeak: whether `other`'s class is
           `==` the receiver's and each of its slots is `=` the receiver's
           slot at the same position, from the first. *)
        private valueEquals: other = (
            | index count |
            (self class == other class) ifFalse: [^false].
            count:: self valueSlotCountOf: self.
            (count = (self valueSlotCountOf: other)) ifFalse: [^false].
            index:: 1.
            [index <= count] whileTrue: [
                ((self valueSlotOf: self at: index) = (self valueSlotOf: other at: index))
                    ifFalse: [^false].
                index:: index + 1].
            ^true
        )
        (* The hash `hash` leaves to Newspeak: the slot count plus the
           `hash` of every slot. *)
        private valueHashOfSlots = (
            | index count result |
            count:: self valueSlotCountOf: self.
            result:: count.
            index:: 1.
            [index <= count] whileTrue: [
                result:: result + (self valueSlotOf: self at: index) hash.
                index:: index + 1].
            ^result
        )
        (* Answers the number of slots `subject`'s classes declare, 0 for a
           `subject` whose state is no slots.

           subject: the receiver or the object it is compared with. *)
        (* Both name their subject rather than forwarding `self`: §5.9
           reaches a private member only through a lexical send, so
           `other valueSlotCount` would find nothing, and the other side's
           state has to be read through the same leaf as this side's. That
           costs each of them the primitive-method fast path, which only
           the declining path pays. *)
        private valueSlotCountOf: subject = ( ^vmMirror valueSlotCount: subject ifFail: [^0] )
        (* Answers `subject`'s declared slot at `index`, counted from 1 in
           declaration order; nil for a `subject` whose state is no slots.

           subject: as `valueSlotCountOf:`'s.
           index: an Integer from 1 to that slot count.

           Signals an ArgumentError carrying `index`: 'index … out of
           range: valid indices are 1..size (size …)' for an Integer outside
           that range, and 'slotAt: requires an Integer index, got …' for
           one that is no Integer. *)
        private valueSlotOf: subject at: index = (
            ^vmMirror value: subject slotAt: index ifFail: [^nil]
        )
    )
    (* The superclass of `Integer` and `Float`: counting loops and `max:`. *)
    (* §3.1.1 names `Number` among the classes whose instances are values,
       and §5.1.1's numeric literals are its instances. Iteration is here
       so that an `Integer`, a `LargeInteger` and a `Float` receiver share
       one body. The compiler does not inline them; they are sent. *)
    public class Number = Value new () (
        (* Answers true: the receiver is a Number. *)
        public isKindOfNumber = ( ^true )
        (* Answers false: a Number is no Float unless its class says so. *)
        public isKindOfFloat = ( ^false )
        (* Answers false: a Number is no Integer unless its class says
           so. *)
        public isKindOfInteger = ( ^false )
        (* Answers false: no Number is a Fraction. *)
        public isKindOfFraction = ( ^false )
        (* Evaluates `action` with the receiver, then with each number one
           greater, in increasing order, while it is at most `stop`;
           answers nil. Nothing is evaluated for a receiver above `stop`.

           stop: a number; compared with `<=`.
           action: a block of one argument, or anything understanding
           `value:`; sent `value:` with each number.

           Signals the ArgumentError the receiver's `<=` signals for a
           `stop` that is no number, and an ArgumentError carrying the
           block, 'wrong number of block arguments: block takes …, got
           1', for a block that does not take one argument, when the
           receiver is at most `stop`. *)
        public to: stop do: action = (
            | current |
            current:: self.
            [current <= stop] whileTrue: [
                action value: current.
                current:: current + 1].
            ^nil
        )
        (* Evaluates `action` with the receiver, then with each number
           `step` further on, while it is at most `stop` -- at least `stop`
           for a negative `step`; answers nil.

           stop: a number; compared with `<=`, or `>=` for a negative
           `step`.
           step: a number other than zero, sent `<` with 0 first; a zero
           `step` never ends from a receiver at most `stop`.
           action: as `to:do:`'s.

           Signals the ArgumentError the receiver's comparison signals for
           a `stop` that is no number, and `to:do:`'s ArgumentError for a
           block that does not take one argument, when the loop runs a
           step. *)
        public to: stop by: step do: action = (
            | current |
            current:: self.
            step < 0
                ifTrue: [[current >= stop] whileTrue: [
                    action value: current.
                    current:: current + step]]
                ifFalse: [[current <= stop] whileTrue: [
                    action value: current.
                    current:: current + step]].
            ^nil
        )
        (* Answers the greater of the receiver and `other`: the receiver
           when it is `>` `other`, `other` otherwise.

           other: a number.

           Signals the ArgumentError the receiver's `>` signals for an
           `other` that is no number. *)
        public max: other = ( ^self > other ifTrue: [self] ifFalse: [other] )
    )
    (* The superclass of `True` and `False`. *)
    public class Boolean = Value new () (
        (* Answers true: the receiver is a Boolean. *)
        public isKindOfBoolean = ( ^true )
    )
    (* The class of `true`. *)
    (* §5.1.2: `true` is the unique instance of `True` and `false` of
       `False`. Each branch is a method of its own, so no method tests the
       receiver and none reaches the mirror. Every body is `^true`,
       `^false`, `^nil`, `^<parameter>` or `^<parameter> value`: a quick
       method, which runs without an activation, so that the
       reference lowering, which sends a conditional the optimized lowering
       inlines, counts no activation for it either
       (`docs/design/core-library.md`, "`True` and `False` are quick
       methods"). An argument that is no block is sent `value` like any
       other object; `printString` and `hash` alone are ordinary methods. *)
    public class True = Boolean new () (
        (* Answers the value of `trueBlock`; `falseBlock` is not
           evaluated.

           trueBlock: a block of no argument, or anything understanding
           `value`; sent `value`.
           falseBlock: any object. *)
        public ifTrue: trueBlock ifFalse: falseBlock = ( ^trueBlock value )
        (* As `ifTrue:ifFalse:`, its arguments in the other order. *)
        public ifFalse: falseBlock ifTrue: trueBlock = ( ^trueBlock value )
        (* Answers the value of `trueBlock`, sent `value`. *)
