    /// `Number>>=`'s equality. Two LargeIntegers of one value are equal
    /// however each was computed, and so identical (`Value>>==`).
    ///
    /// @param other any object; anything that is no number is unequal.
    /// @answers whether `other` is a number of the same exact value, a
    /// Boolean.
    /// @see `Number>>=`.
    public = other = (
      ^vmMirror largeInteger: self equals: other ifFail: [^super = other].
    )

    /// Hashes the receiver by its value, so that the hash agrees with
    /// `=`.
    ///
    /// `Number>>hash`'s rule: the value modulo 2^61 - 1, folded into the
    /// SmallInteger range, so a Float of the same value hashes alike, and
    /// the hash is a SmallInteger that some unequal SmallInteger shares.
    ///
    /// @answers an Integer, alike for every number `=` makes equal.
    /// @see `Number>>hash`.
    public hash = (
      ^vmMirror largeIntegerHash: self ifFail: [^super hash].
    )

    /// Negates the receiver.
    ///
    /// @answers `0 - self`, an integer.
    public negated = (
      ^vmMirror largeIntegerNegated: self ifFail: [^super negated].
    )

    /// Drops the receiver's sign.
    ///
    /// @answers the receiver without its sign, an integer.
    public abs = (
      ^vmMirror largeIntegerAbsolute: self ifFail: [^super abs].
    )

    /// Converts the receiver to a Float, a tie rounded to the even one.
    ///
    /// @answers the nearest Float; an infinity beyond the largest Float.
    public asFloat = (
      ^vmMirror largeIntegerAsFloat: self ifFail: [^super asFloat].
    )

    /// Prints the receiver in decimal.
    ///
    /// @answers a new String of the decimal digits, after a '-' for a
    /// negative receiver.
    public printString = (
      ^vmMirror largeIntegerPrintString: self ifFail: [^super printString].
    )

    /// Prints the receiver as `printString` does.
    ///
    /// @answers what `printString` answers.
    public asString = (
      ^vmMirror largeIntegerAsString: self ifFail: [^super asString].
    )
  )

  /// The 64-bit IEEE 754 floating-point numbers: a literal such as `1.5`
  /// is one.
  public class Float = Number () (
    /// Identifies the receiver as a Float, without a class test.
    ///
    /// @answers true.
    public isKindOfFloat = (
      ^true.
    )

    /// Adds `other` to the receiver as IEEE 754 computes it.
    ///
    /// @param other a number: a Float, or an Integer, a LargeInteger or
    /// a Fraction, converted to the nearest Float first in one rounding.
    /// @answers the sum of the receiver and `other`, a Float.
    /// @signals ArgumentError carrying `other`, '+ requires a numeric
    /// argument, got …', for any other argument.
    public + other = (
      ^vmMirror float: self add: other ifFail: [^super + other].
    )

    /// As `+`, the difference.
    ///
    /// @param other as `+`'s.
    /// @answers the difference of the receiver and `other`, a Float.
    /// @signals ArgumentError carrying `other`, '- requires a numeric
    /// argument, got …', for any other argument.
    /// @see `+`.
    public - other = (
      ^vmMirror float: self subtract: other ifFail: [^super - other].
    )

    /// As `+`, the product.
    ///
    /// @param other as `+`'s.
    /// @answers the product of the receiver and `other`, a Float.
    /// @signals ArgumentError carrying `other`, '* requires a numeric
    /// argument, got …', for any other argument.
    /// @see `+`.
    public * other = (
      ^vmMirror float: self multiply: other ifFail: [^super * other].
    )

    /// As `+`, the quotient: dividing by zero answers an infinity or a
    /// NaN, never an error.
    ///
    /// @param other as `+`'s.
    /// @answers the quotient of the receiver by `other`, a Float.
    /// @signals ArgumentError carrying `other`, '/ requires a numeric
    /// argument, got …', for any other argument.
    /// @see `+`.
    public / other = (
      ^vmMirror float: self divide: other ifFail: [^super / other].
    )

    /// Compares the receiver with `other` by their exact values: an
    /// integer or a Fraction `other` is not rounded to a Float first,
    /// so the Float 2^53 is less than the integer 2^53 + 1.
