    public class Halt = Exception new () (
    ) : (
        (* As `Exception class>>signal`: signals a new Halt. *)
        public signal = ( ^self new signal )
        (* As `Exception class>>signal:`: signals a new Halt with `text`. *)
        public signal: text = ( ^self new signal: text )
    )
