    /// @param other a number.
    /// @answers the sum of the receiver and `other`, as `Integer>>+`
    /// answers it.
    /// @signals ArgumentError carrying `other`, '+ requires a numeric
    /// argument, got …', for any other argument.
    /// @see `Integer>>+`.
    public + other = (
      ^vmMirror largeInteger: self add: other ifFail: [^super + other].
    )

    /// As `Integer>>-`, with the same ArgumentError.
    ///
    /// @param other a number.
    /// @answers the difference of the receiver and `other`, as
    /// `Integer>>-` answers it.
    /// @signals ArgumentError carrying `other`, '- requires a numeric
    /// argument, got …', for any other argument.
    /// @see `Integer>>-`.
    public - other = (
      ^vmMirror largeInteger: self subtract: other ifFail: [^super - other].
    )

    /// As `Integer>>*`, with the same ArgumentError.
    ///
    /// @param other a number.
    /// @answers the product of the receiver and `other`, as `Integer>>*`
    /// answers it.
    /// @signals ArgumentError carrying `other`, '* requires a numeric
    /// argument, got …', for any other argument.
