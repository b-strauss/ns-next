    private class Activation = Object new () (
    )
    (* An object that answers none of `Object`'s public messages itself:
       each is overridden as protected, so a message from outside reaches
       `doesNotUnderstand:`. A subclass that implements only
       `doesNotUnderstand:` forwards every message it is sent. *)
    (* §5.5's proxy, "Otherwise it would be possible to distinguish
       between an object and a proxy": lookupPublic stops at a protected
       method, and the failing send falls to `doesNotUnderstand:`. Inside
       the proxy, a self send still reaches each of them. A member added to
       `Object` without its override here fails
       `a_proxy_overrides_every_public_member_of_object_as_protected`. *)
    public class Proxy = Object new () (
        (* As `Object>>class`, for a send from inside the proxy only: from
           outside, the message reaches `doesNotUnderstand:`. *)
        protected class = ( ^super class )
        (* As `Object>>==`, for a send from inside the proxy only. *)
        protected == other = ( ^super == other )
        (* As `Object>>=`, for a send from inside the proxy only. *)
        protected = other = ( ^super = other )
        (* As `Object>>hash`, for a send from inside the proxy only. *)
        protected hash = ( ^super hash )
        (* As `Object>>yourself`, for a send from inside the proxy only. *)
        protected yourself = ( ^super yourself )
        (* As `Object>>identityHash`, for a send from inside the proxy
           only. *)
        protected identityHash = ( ^super identityHash )
        (* As `Object>>printString`, for a send from inside the proxy
           only. *)
        protected printString = ( ^super printString )
        (* As `Object>>Object`, for a send from inside the proxy only. *)
        protected Object = ( ^super Object )
        (* As `Object>>Value`, for a send from inside the proxy only. *)
        protected Value = ( ^super Value )
        (* As `Object>>Boolean`, for a send from inside the proxy only. *)
        protected Boolean = ( ^super Boolean )
        (* As `Object>>True`, for a send from inside the proxy only. *)
        protected True = ( ^super True )
        (* As `Object>>False`, for a send from inside the proxy only. *)
        protected False = ( ^super False )
        (* As `Object>>Number`, for a send from inside the proxy only. *)
        protected Number = ( ^super Number )
        (* As `Object>>Integer`, for a send from inside the proxy only. *)
        protected Integer = ( ^super Integer )
        (* As `Object>>Float`, for a send from inside the proxy only. *)
        protected Float = ( ^super Float )
        (* As `Object>>String`, for a send from inside the proxy only. *)
        protected String = ( ^super String )
        (* As `Object>>Symbol`, for a send from inside the proxy only. *)
        protected Symbol = ( ^super Symbol )
        (* As `Object>>UndefinedObject`, for a send from inside the proxy
           only. *)
        protected UndefinedObject = ( ^super UndefinedObject )
        (* As `Object>>Array`, for a send from inside the proxy only. *)
        protected Array = ( ^super Array )
        (* As `Object>>Closure`, for a send from inside the proxy only. *)
        protected Closure = ( ^super Closure )
        (* As `Object>>isNil`, for a send from inside the proxy only. *)
        protected isNil = ( ^super isNil )
        (* As `Object>>notNil`, for a send from inside the proxy only. *)
        protected notNil = ( ^super notNil )
        (* As `Object>>ifNil:`, for a send from inside the proxy only. *)
        protected ifNil: block = ( ^super ifNil: block )
        (* As `Object>>ifNotNil:`, for a send from inside the proxy only. *)
        protected ifNotNil: block = ( ^super ifNotNil: block )
        (* As `Object>>ifNil:ifNotNil:`, for a send from inside the proxy
