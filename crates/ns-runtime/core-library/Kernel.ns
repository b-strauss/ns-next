Newspeak3
'Kernel'
(* The core library (`docs/design/core-library.md`, "The core library as
   Newspeak source over a VM mirror"). One nested class per builtin class;
   the bootstrap fills the builtin class objects from them before it
   instantiates this module, so a nested class here *is* the class a literal
   has. Every method that needs a leaf reaches Rust through `vmMirror`, the
   one object that holds the leaves, and nothing else here does.

   A superclass clause below names a sibling by its bare name and nothing
   else: the bootstrap reads the name and never runs the clause, because the
   classes it names must exist before any clause could run. `Top` declares
   none: it has no superclass.

   Every class here says `public`: §6.3.1 makes an undeclared member
   protected, and a protected class is unreachable from another module, so
   the accessibility has to be written out for a program to name it. `Top`
   is the exception, for the reason its own comment gives.

   The kernel declares itself a value so that every builtin value class,
   nested here, meets §3.1.1's enclosing-object condition, as SOMns's
   `Kernel.ns` does. *)
class Kernel vmMirror: theMirror = Object <: Value (
    | private vmMirror = theMirror. |
) (
    (* §3.2: "A class is either the empty class `Top` or the application of
       a mixin to another class known as its superclass", and "Only the
       class `Object` may have `Top` as its superclass" -- which is why it
       is the one private class here: no other module may name it. It stays
       empty, so that all code, `Object`'s included, resides in a mixin. *)
    private class Top = () (
    )
    public class Object = Top new () (
        public class = ( ^vmMirror objectClass: self ifFail: [^super class] )
        public == other = ( ^vmMirror object: self identicalTo: other ifFail: [^super == other] )
        public = other = ( ^vmMirror object: self equals: other ifFail: [^super = other] )
        public hash = ( ^vmMirror objectHash: self ifFail: [^super hash] )
        public printString = ( ^vmMirror objectPrintString: self ifFail: [^super printString] )
        (* §3.2: Object "provides ... accessors for predefined classes and
           objects, such as the classes of the built-in literals", so a bare
           `String` anywhere is the implicit send `self String` and lands
           here unless something nearer declares the name. Each body names
           the kernel explicitly: inside Object, §5.7's innermost
           declaration of `String` is this very method. `Top`, the VM
           mirror's class and `Platform` have no accessor. *)
        public Object = ( ^outer Kernel Object )
        public Value = ( ^outer Kernel Value )
        public Boolean = ( ^outer Kernel Boolean )
        public True = ( ^outer Kernel True )
        public False = ( ^outer Kernel False )
        public Number = ( ^outer Kernel Number )
        public Integer = ( ^outer Kernel Integer )
        public Float = ( ^outer Kernel Float )
        public String = ( ^outer Kernel String )
        public Symbol = ( ^outer Kernel Symbol )
        public UndefinedObject = ( ^outer Kernel UndefinedObject )
        public Array = ( ^outer Kernel Array )
        public OrderedCollection = ( ^outer Kernel OrderedCollection )
        public Block = ( ^outer Kernel Block )
        (* §5.5: protected, so an explicit-receiver send of it finds nothing
           through lookupPublic and falls to the access-blind "defined for"
           walk that invokes it for the failing send itself. *)
        protected doesNotUnderstand: message = ( ^vmMirror object: self doesNotUnderstand: message ifFail: [^super doesNotUnderstand: message] )
        (* The nil protocol, as SOMns's kernel and Newspeak's own declare it:
           every object but nil is not nil, and `UndefinedObject` answers the
           other way. A block for the not-nil case is culled with the
           receiver, as Squeak's is and as the Newspeak corpus relies on,
           passing `[:x | ...]` and `[...]` alike. Every body is a quick
           method (`docs/design/core-library.md`, "The nil protocol"). *)
        public isNil = ( ^false )
        public notNil = ( ^true )
        public ifNil: block = ( ^self )
        public ifNotNil: block = ( ^block cull: self )
        public ifNil: nilBlock ifNotNil: notNilBlock = ( ^notNilBlock cull: self )
        public ifNotNil: notNilBlock ifNil: nilBlock = ( ^notNilBlock cull: self )
    )
    (* §3.1.1: an object is a value object -- deeply immutable and globally
       unique -- only if "its class inherits from class `Value`", so every
       class whose instances are values hangs below this one.

       Each class below it already declares the `hash` its own `=` demands.
       Primordial Soup states the contract: `hash` "should be overridden if
       the method `=` is overridden ... if `x = y` evaluates to true then
       `x hash = y hash` must evaluate to true." Since a value may be copied
       across an actor boundary, a copy has to hash like its original, so
       none of them may inherit `Object`'s identity hash. `Integer`'s,
       `True`'s and `False`'s are no forwarders to a leaf: the value they
       answer is already at hand. *)
    public class Value = Object new () (
        (* §3.1.1: a value object is globally unique, in the sense that no
           other object is equal to it -- so equality is derived from state,
           and a value has no observable identity. The leaf declines when a
           slot's class brings its own `=`, because a leaf may not send;
           `valueEquals:` then sends it. *)
        public = other = ( ^vmMirror value: self sameAs: other ifFail: [^self valueEquals: other] )
        (* §3.1.1: where `Value` declares an identity method, "that method
           must return the same results as `Value`'s equality method". A send
           of `=` makes that true by construction, for every subclass. *)
        public == other = ( ^self = other )
        public hash = ( ^vmMirror valueHash: self ifFail: [^self valueHashOfSlots] )
        private valueEquals: other = (
            | index count |
            (self class == other class) ifFalse: [^false].
            count:: self valueSlotCountOf: self.
            (count = (self valueSlotCountOf: other)) ifFalse: [^false].
            index:: 1.
            [index <= count] whileTrue: [
                ((self valueSlotOf: self at: index) = (self valueSlotOf: other at: index))
                    ifFalse: [^false].
                index:: index + 1].
            ^true
        )
        private valueHashOfSlots = (
            | index count result |
            count:: self valueSlotCountOf: self.
            result:: count.
            index:: 1.
            [index <= count] whileTrue: [
                result:: result + (self valueSlotOf: self at: index) hash.
                index:: index + 1].
            ^result
        )
        (* Both name their subject rather than forwarding `self`: §5.9
           reaches a private member only through a lexical send, so
           `other valueSlotCount` would find nothing, and the other side's
           state has to be read through the same leaf as this side's. That
           costs each of them the primitive-method fast path, which only
           the declining path pays. *)
        private valueSlotCountOf: subject = ( ^vmMirror valueSlotCount: subject ifFail: [^0] )
        private valueSlotOf: subject at: index = ( ^vmMirror value: subject slotAt: index ifFail: [^nil] )
    )
    (* §3.1.1 names `Number` among the classes whose instances are values,
       and §5.1.1's numeric literals are its instances. It is empty for now,
       like `Value`: what the two share between `Integer` and `Float` moves
       up here once there is a body to move. *)
    public class Number = Value new () (
    )
    public class Boolean = Value new () (
    )
    (* §5.1.2: `true` is the unique instance of `True` and `false` of
       `False`. Each branch is a method of its own, as in every prior-art
       kernel (SOMns's, Primordial Soup's, Newspeak on Squeak's), so no
       method tests the receiver and none reaches the mirror. Every body is
       `^true`, `^false`, `^nil`, `^<parameter>` or `^<parameter> value`: a
       quick method, which runs without an activation, so that the
       reference lowering, which sends a conditional the optimized lowering
       inlines, counts no activation for it either
       (`docs/design/core-library.md`, "`True` and `False` are quick
       methods"). An argument that is no block is sent `value` like any
       other object; `printString` and `hash` alone are ordinary methods. *)
    public class True = Boolean new () (
        public ifTrue: trueBlock ifFalse: falseBlock = ( ^trueBlock value )
        public ifFalse: falseBlock ifTrue: trueBlock = ( ^trueBlock value )
        public ifTrue: trueBlock = ( ^trueBlock value )
        public ifFalse: falseBlock = ( ^nil )
        public not = ( ^false )
        public & other = ( ^other )
        public and: block = ( ^block value )
        public | other = ( ^true )
        public or: block = ( ^true )
        public printString = ( ^'true' )
        public hash = ( ^1 )
    )
    public class False = Boolean new () (
        public ifTrue: trueBlock ifFalse: falseBlock = ( ^falseBlock value )
        public ifFalse: falseBlock ifTrue: trueBlock = ( ^falseBlock value )
        public ifTrue: trueBlock = ( ^nil )
        public ifFalse: falseBlock = ( ^falseBlock value )
        public not = ( ^true )
        public & other = ( ^false )
        public and: block = ( ^false )
        public | other = ( ^other )
        public or: block = ( ^block value )
        public printString = ( ^'false' )
        public hash = ( ^0 )
    )
    public class Integer = Number new () (
        public + other = ( ^vmMirror integer: self add: other ifFail: [^super + other] )
        public - other = ( ^vmMirror integer: self subtract: other ifFail: [^super - other] )
        public * other = ( ^vmMirror integer: self multiply: other ifFail: [^super * other] )
        public // other = ( ^vmMirror integer: self floorDivide: other ifFail: [^super // other] )
        public < other = ( ^vmMirror integer: self lessThan: other ifFail: [^super < other] )
        public > other = ( ^vmMirror integer: self greaterThan: other ifFail: [^super > other] )
        public <= other = ( ^vmMirror integer: self lessOrEqual: other ifFail: [^super <= other] )
        public >= other = ( ^vmMirror integer: self greaterOrEqual: other ifFail: [^super >= other] )
        public = other = ( ^vmMirror integer: self equals: other ifFail: [^super = other] )
        public hash = ( ^self )
        public negated = ( ^vmMirror integerNegated: self ifFail: [^super negated] )
        public abs = ( ^vmMirror integerAbsolute: self ifFail: [^super abs] )
        public printString = ( ^vmMirror integerPrintString: self ifFail: [^super printString] )
        public asString = ( ^vmMirror integerAsString: self ifFail: [^super asString] )
    )
    public class Float = Number new () (
        public + other = ( ^vmMirror float: self add: other ifFail: [^super + other] )
        public - other = ( ^vmMirror float: self subtract: other ifFail: [^super - other] )
        public * other = ( ^vmMirror float: self multiply: other ifFail: [^super * other] )
        public / other = ( ^vmMirror float: self divide: other ifFail: [^super / other] )
        public < other = ( ^vmMirror float: self lessThan: other ifFail: [^super < other] )
        public > other = ( ^vmMirror float: self greaterThan: other ifFail: [^super > other] )
        public = other = ( ^vmMirror float: self equals: other ifFail: [^super = other] )
        public hash = ( ^vmMirror floatHash: self ifFail: [^super hash] )
        public printString = ( ^vmMirror floatPrintString: self ifFail: [^super printString] )
        public asString = ( ^vmMirror floatAsString: self ifFail: [^super asString] )
    )
    public class String = Value new () (
        public size = ( ^vmMirror stringSize: self ifFail: [^super size] )
        public , other = ( ^vmMirror string: self concatenate: other ifFail: [^super , other] )
        public = other = ( ^vmMirror string: self equals: other ifFail: [^super = other] )
        public hash = ( ^vmMirror stringHash: self ifFail: [^super hash] )
        public asSymbol = ( ^vmMirror stringAsSymbol: self ifFail: [^super asSymbol] )
        public printString = ( ^vmMirror stringPrintString: self ifFail: [^super printString] )
        public asString = ( ^self )
    )
    public class Symbol = Value new () (
        public asString = ( ^vmMirror symbolAsString: self ifFail: [^super asString] )
        public = other = ( ^vmMirror symbol: self equals: other ifFail: [^super = other] )
        public hash = ( ^vmMirror symbolHash: self ifFail: [^super hash] )
        public printString = ( ^vmMirror symbolPrintString: self ifFail: [^super printString] )
    )
    public class Array = Object new () (
        public do: action = ( ^vmMirror collection: self do: action ifFail: [^super do: action] )
        public at: index put: value = ( ^vmMirror collection: self at: index put: value ifFail: [^super at: index put: value] )
        public size = ( ^vmMirror collectionSize: self ifFail: [^super size] )
        public at: index = ( ^vmMirror collection: self at: index ifFail: [^super at: index] )
    )
    public class OrderedCollection = Object new () (
        public do: action = ( ^vmMirror collection: self do: action ifFail: [^super do: action] )
        public add: element = ( ^vmMirror collection: self add: element ifFail: [^super add: element] )
        public size = ( ^vmMirror collectionSize: self ifFail: [^super size] )
        public at: index = ( ^vmMirror collection: self at: index ifFail: [^super at: index] )
    )
    (* §5.1.3: `nil` is the unique instance of `UndefinedObject`, which
       answers `isNil` with true. It answers the rest of the nil protocol
       `Object` declares the other way round, each a quick method, and
       prints as `nil`, as Primordial Soup's does. *)
    public class UndefinedObject = Value new () (
        public isNil = ( ^true )
        public notNil = ( ^false )
        public ifNil: block = ( ^block value )
        public ifNotNil: block = ( ^nil )
        public ifNil: nilBlock ifNotNil: notNilBlock = ( ^nilBlock value )
        public ifNotNil: notNilBlock ifNil: nilBlock = ( ^nilBlock value )
        public printString = ( ^'nil' )
    )
    public class Block = Object new () (
        public value = ( ^vmMirror blockValue: self ifFail: [^super value] )
        public value: first = ( ^vmMirror block: self value: first ifFail: [^super value: first] )
        public value: first value: second = ( ^vmMirror block: self value: first value: second ifFail: [^super value: first value: second] )
        public value: first value: second value: third = ( ^vmMirror block: self value: first value: second value: third ifFail: [^super value: first value: second value: third] )
        public numArgs = ( ^vmMirror blockNumArgs: self ifFail: [^super numArgs] )
        (* Squeak's `cull:`: the argument when the block takes one, nothing
           when it takes none. `Object`'s `ifNotNil:` family means exactly
           this, and its quick methods do it without sending it. *)
        public cull: argument = ( ^self numArgs = 0 ifTrue: [self value] ifFalse: [self value: argument] )
        public whileTrue: body = ( ^vmMirror block: self whileTrue: body ifFail: [^super whileTrue: body] )
        public whileFalse: body = ( ^vmMirror block: self whileFalse: body ifFail: [^super whileFalse: body] )
    )
    (* The platform object, its transcript and its collections namespace share
       this class and are told apart by payload shape (`platform.rs`), so a
       leaf declines a platform object that is not the one it serves, and the
       failure block's `super` send ends in Object's doesNotUnderstand:. *)
    public class Platform = Object new () (
        public transcript = ( ^vmMirror platformTranscript: self ifFail: [^super transcript] )
        public collections = ( ^vmMirror platformCollections: self ifFail: [^super collections] )
        public List = ( ^vmMirror platformList: self ifFail: [^super List] )
        public show: text = ( ^vmMirror platform: self show: text ifFail: [^super show: text] )
        public newLine = ( ^vmMirror platformNewLine: self ifFail: [^super newLine] )
    )
) : ()
