    /// @see `Number>>hash`.
    public hash = (
      ^vmMirror floatHash: self ifFail: [^super hash].
    )

    /// Takes the square root of the receiver.
    ///
    /// @answers the square root, a Float; a NaN for a negative receiver.
    public sqrt = (
      ^vmMirror floatSquareRoot: self ifFail: [^super sqrt].
    )

    /// Takes the sine of the receiver, in radians.
    ///
    /// @answers the sine of the receiver, a Float.
    public sin = (
      ^vmMirror floatSine: self ifFail: [^super sin].
    )

    /// Takes the cosine of the receiver, in radians.
    ///
    /// @answers the cosine of the receiver, a Float.
    public cos = (
      ^vmMirror floatCosine: self ifFail: [^super cos].
    )

    /// Takes the tangent of the receiver, in radians.
    ///
    /// @answers the tangent of the receiver, a Float.
    public tan = (
      ^vmMirror floatTangent: self ifFail: [^super tan].
    )

    /// Takes the arc sine of the receiver.
    ///
    /// @answers the arc sine of the receiver, in radians from -π/2 to
    /// π/2, a Float; a NaN outside -1 to 1.
    public asin = (
      ^vmMirror floatArcSine: self ifFail: [^super asin].
    )

    /// Takes the arc cosine of the receiver.
    ///
    /// @answers the arc cosine of the receiver, in radians from 0 to π,
    /// a Float; a NaN outside -1 to 1.
    public acos = (
      ^vmMirror floatArcCosine: self ifFail: [^super acos].
    )

    /// Takes the arc tangent of the receiver.
    ///
    /// @answers the arc tangent of the receiver, in radians from -π/2 to
    /// π/2, a Float.
    public atan = (
      ^vmMirror floatArcTangent: self ifFail: [^super atan].
    )

    /// Measures the angle of the point whose abscissa is `x` and whose
    /// ordinate is the receiver.
    ///
    /// @param x a number, converted to the nearest Float first.
    /// @answers the angle, in radians from -π to π, a Float.
    /// @signals ArgumentError carrying `x`, 'atan: requires a numeric
    /// argument, got …', for any other argument.
    public atan: x = (
      ^vmMirror float: self arcTangent: x ifFail: [^super atan: x].
    )

    /// Raises e to the receiver.
    ///
    /// @answers e raised to the receiver, a Float.
    public exp = (
      ^vmMirror floatExponential: self ifFail: [^super exp].
    )

    /// Takes the natural logarithm of the receiver.
    ///
    /// @answers the natural logarithm of the receiver, a Float: minus
    /// infinity for zero, a NaN below zero.
    public ln = (
      ^vmMirror floatNaturalLogarithm: self ifFail: [^super ln].
    )

    /// Takes the logarithm of the receiver to base 10.
    ///
    /// @answers the logarithm of the receiver to base 10, a Float: minus
    /// infinity for zero, a NaN below zero.
    public log = (
      ^vmMirror floatLogarithm: self ifFail: [^super log].
    )

    /// Raises the receiver to `exponent` as IEEE 754's `pow` computes
    /// it.
    ///
    /// @param exponent a number, converted to the nearest Float first.
    /// @answers the receiver raised to `exponent`, a Float.
    /// @signals ArgumentError carrying `exponent`, 'raisedTo: requires a
    /// numeric argument, got …', for any other argument.
    public raisedTo: exponent = (
      ^vmMirror float: self raisedTo: exponent ifFail: [^super raisedTo: exponent].
    )

    /// Rounds the receiver toward negative infinity; an infinity or a
    /// NaN is answered as it is.
    ///
    /// @answers the greatest integral value not above the receiver, a
    /// Float.
    public floor = (
      ^vmMirror floatFloor: self ifFail: [^super floor].
    )

    /// Rounds the receiver toward positive infinity; an infinity or a
    /// NaN is answered as it is.
    ///
    /// @answers the least integral value not below the receiver, a
    /// Float.
    public ceiling = (
      ^vmMirror floatCeiling: self ifFail: [^super ceiling].
    )

    /// Rounds the receiver to the nearest integral value, a half away
    /// from zero; an infinity or a NaN is answered as it is.
    ///
    /// @answers the integral value nearest the receiver, a Float that
    /// keeps the receiver's sign.
    public rounded = (
      ^vmMirror floatRounded: self ifFail: [^super rounded].
    )

    /// Drops the receiver's fraction, toward zero; an infinity or a NaN
    /// is answered as it is.
    ///
    /// @answers the receiver without its fraction, a Float that keeps
    /// the receiver's sign.
    public truncated = (
      ^vmMirror floatTruncated: self ifFail: [^super truncated].
    )

    /// Changes the receiver's sign: `0.0 negated` is -0.0.
    ///
    /// @answers the receiver with its sign changed, a Float.
    public negated = (
      ^vmMirror floatNegated: self ifFail: [^super negated].
    )

    /// Drops the receiver's sign: -0.0 answers 0.0.
    ///
    /// @answers the receiver without its sign, a Float.
    public abs = (
      ^vmMirror floatAbsolute: self ifFail: [^super abs].
    )

    /// Converts the receiver to a Float, which it already is.
    ///
    /// @answers the receiver.
    public asFloat = (
      ^self.
    )

    /// Tells whether the receiver is a NaN.
    ///
    /// @answers whether the receiver is a NaN, a Boolean.
    public isNaN = (
      ^vmMirror floatIsNaN: self ifFail: [^super isNaN].
    )

    /// Tells whether the receiver is finite.
    ///
    /// @answers whether the receiver is neither an infinity nor a NaN, a
    /// Boolean.
    public isFinite = (
      ^vmMirror floatIsFinite: self ifFail: [^super isFinite].
    )

    /// Tells whether the receiver is infinite.
    ///
    /// @answers whether the receiver is an infinity, of either sign, a
    /// Boolean.
    public isInfinite = (
      ^vmMirror floatIsInfinite: self ifFail: [^super isInfinite].
    )

    /// Truncates the receiver toward zero to an integer.
    ///
    /// @answers the receiver truncated toward zero, an integer of any
    /// size.
    /// @signals ArgumentError carrying the receiver, 'asInteger requires
    /// a finite Float, got …', for a NaN or an infinity.
    public asInteger = (
      ^vmMirror floatAsInteger: self ifFail: [^super asInteger].
    )

    /// Prints the receiver with `fractionDigits` digits after the point,
    /// rounded half away from zero on its exact binary value, keeping
    /// its sign even when every digit is zero.
    ///
    /// @param fractionDigits an Integer from 0 to 20.
    /// @answers a new String of the receiver in that form;
    /// `printString`'s text when it is not within ±1e21, a NaN or an
    /// infinity included.
    /// @signals ArgumentError carrying `fractionDigits`, 'asStringFixed:
    /// takes 0 to 20 fraction digits, got …', for an Integer outside 0
    /// to 20, a LargeInteger included.
    /// @signals ArgumentError carrying `fractionDigits`, 'asStringFixed:
    /// requires a numeric argument, got …', for one that is no Integer.
    public asStringFixed: fractionDigits = (
      ^vmMirror float: self asStringFixed: fractionDigits ifFail: [
        ^super asStringFixed: fractionDigits.
      ].
    )

    /// Prints the receiver in exponent form: one digit, a point and
    /// `fractionDigits` digits when there are any, rounded half away
    /// from zero on its exact binary value, then 'e', the exponent's
    /// sign and the exponent.
    ///
    /// @param fractionDigits an Integer from 0 to 20.
    /// @answers a new String of the receiver in that form -- '3.0e+0',
    /// '6.67e+1', '-0e+0'; 'NaN', 'Infinity' or '-Infinity' for those
    /// values.
    /// @signals ArgumentError carrying `fractionDigits`,
    /// 'asStringExponential: takes 0 to 20 fraction digits, got …', for
    /// an Integer outside 0 to 20, a LargeInteger included.
    /// @signals ArgumentError carrying `fractionDigits`,
    /// 'asStringExponential: requires an integer argument, got …', for
    /// one that is no Integer.
    public asStringExponential: fractionDigits = (
      ^vmMirror float: self asStringExponential: fractionDigits ifFail: [
        ^super asStringExponential: fractionDigits.
      ].
    )

    /// Prints the receiver with `digits` significant digits, rounded
    /// half away from zero on its exact binary value: in decimal, or in
    /// `asStringExponential:`'s form when the value needs more than six
    /// zeros after the point or its digits end before the point.
    ///
    /// @param digits an Integer from 1 to 21.
    /// @answers a new String of the receiver in that form ('66.7',
    /// '0.0000010', '7e+1', '1.0e-7'); 'NaN', 'Infinity' or '-Infinity'
    /// for those values.
    /// @signals ArgumentError carrying `digits`, 'asStringPrecision:
    /// takes 1 to 21 digits, got …', for an Integer outside 1 to 21, a
    /// LargeInteger included.
    /// @signals ArgumentError carrying `digits`, 'asStringPrecision:
    /// requires an integer argument, got …', for one that is no Integer.
    /// @see `asStringExponential:`.
    public asStringPrecision: digits = (
      ^vmMirror float: self asStringPrecision: digits ifFail: [^super asStringPrecision: digits].
    )

    /// Prints the shortest decimal text that reads back as the receiver:
    /// in decimal when its first digit's power of ten lies from -6 to
    /// 20, with '.0' after an integral value, and in exponent form
    /// beyond. A negative value, -0.0 included, begins with '-'.
    ///
    /// @answers a new String of that text ('3.0', '0.000001',
    /// '100000000000000000000.0', '1e+21', '1e-7'); 'NaN', 'Infinity'
    /// and '-Infinity' for those values.
    public printString = (
      ^vmMirror floatPrintString: self ifFail: [^super printString].
    )

    /// Prints the receiver as `printString` does.
    ///
    /// @answers what `printString` answers.
    public asString = (
      ^vmMirror floatAsString: self ifFail: [^super asString].
    )
  ) : (
    /// Reads the Float `text` names: an optional '-' or '+', then
    /// 'Infinity', 'NaN', or decimal digits with an optional point and
    /// an optional exponent ('e' or 'E', an optional sign, digits),
    /// with at least one digit before the exponent -- every text
    /// `printString` writes.
    ///
    /// The leaf answers only for `Float` itself; any other receiver
    /// falls to `super`.
    ///
    /// @param text a String.
    /// @answers the nearest Float to the decimal value; an infinity
    /// beyond the largest.
    /// @signals ArgumentError carrying `text`, 'parse: requires the text
    /// of a Float, got …', for a String that is no such text, a
    /// lower-case 'nan' or 'inf', a space or an empty String included.
    /// @signals ArgumentError carrying `text`, 'parse: requires a
    /// String, got …', for anything else.
    public parse: text = (
      ^vmMirror floatClass: self parse: text ifFail: [^super parse: text].
    )

    /// Answers IEEE 754's quiet NaN, the result of `0.0 / 0.0`: the value
    /// of an operation that has none, which `isNaN` recognizes.
    ///
    /// It lives on `Float` alone, as `infinity` does: no other number
    /// class has a NaN. Every NaN equals every other and hashes alike, so
    /// this one is equal and identical to any NaN a computation makes
    /// (see "A NaN equals a NaN" in docs/design/core-library.md).
    ///
    /// @answers a NaN, a Float.
    /// @see `isNaN`.
    public nan = (
      ^0.0 / 0.0.
    )

    /// Answers IEEE 754's positive infinity, the result of `1.0 / 0.0`:
    /// greater than every other number, finite Floats and integers of any
    /// size included, and equal only to itself.
    ///
    /// It lives on `Float` alone: an integer has no infinity, however
    /// large, and neither has a fraction.
    ///
    /// @answers the positive infinity, a Float.
    /// @see `isInfinite`.
    public infinity = (
      ^1.0 / 0.0.
    )

    /// Answers IEEE 754's negative infinity, the result of `-1.0 / 0.0`:
    /// less than every other number, and equal only to itself.
    ///
    /// @answers the negative infinity, a Float.
    /// @see `infinity`.
    public negativeInfinity = (
      ^-1.0 / 0.0.
    )
  )

  /// The exact quotient of two integers, in normal form: its
  /// denominator above 1, no factor common to both parts, its sign on
  /// the numerator. `Fraction numerator:denominator:` makes one, and so
  /// does dividing integers that do not divide; a fraction is never
  /// equal to an integer, which a quotient that divides is instead.
  ///
  /// Made only by the runtime, so a fraction is always in normal form
  /// and `=` and `hash` can compare its parts. Its parts are two hidden
  /// fields, not slots: no program writes them.
  public class Fraction = Number () (
    /// Identifies the receiver as a Fraction, without a class test.
    ///
    /// @answers true.
    public isKindOfFraction = (
      ^true.
    )

    /// Reads the receiver's numerator. A receiver holding no value
    /// (`Fraction new`) makes the leaf decline, and the send ends in
    /// doesNotUnderstand:.
    ///
    /// @answers the numerator, an integer of either sign.
    /// @signals MessageNotUnderstood for a receiver holding no value.
    public numerator = (
      ^vmMirror fractionNumerator: self ifFail: [^super numerator].
    )

    /// Reads the receiver's denominator. A receiver holding no value
    /// (`Fraction new`) makes the leaf decline, and the send ends in
    /// doesNotUnderstand:.
    ///
    /// @answers the denominator, an integer above 1.
    /// @signals MessageNotUnderstood for a receiver holding no value.
    public denominator = (
      ^vmMirror fractionDenominator: self ifFail: [^super denominator].
    )

    /// Rounds the receiver toward negative infinity.
    ///
    /// @answers the greatest integer not above the receiver.
    public floor = (
      ^self numerator // self denominator.
    )

    /// Rounds the receiver toward positive infinity.
    ///
    /// @answers the least integer not below the receiver.
    public ceiling = (
      ^(self numerator negated // self denominator) negated.
    )

    /// Drops the receiver's fraction, toward zero.
    ///
    /// @answers the receiver without its fraction, an integer.
    public truncated = (
      ^self numerator quo: self denominator.
    )

    /// Converts the receiver to an integer by truncating it.
    ///
    /// @answers `truncated`.
    /// @see `truncated`.
    public asInteger = (
      ^self truncated.
    )

    /// Rounds the receiver to the nearest integer, a half away from
    /// zero.
    ///
    /// @answers the integer nearest the receiver.
    public rounded = (
      |
        nearest = (self numerator abs * 2 + self denominator) // (self denominator * 2).
      |
      ^self numerator < 0 ifTrue: [nearest negated] ifFalse: [nearest].
    )

    /// Prints the numerator and the denominator between parentheses and
    /// separated by '/'.
    ///
    /// @answers a new String such as '(3/4)' or '(-1/2)'.
    public printString = (
      ^'(' , self numerator printString , '/' , self denominator printString , ')'.
    )

    /// Prints the receiver as `printString` does.
    ///
    /// @answers what `printString` answers.
    public asString = (
      ^self printString.
    )
  ) : (
    /// Divides `numerator` by `denominator` exactly.
    ///
    /// The leaf answers only for `Fraction` itself; any other receiver
    /// falls to `super`.
    ///
    /// @param numerator an integer.
    /// @param denominator an integer other than 0.
    /// @answers an Integer when `denominator` divides `numerator`,
    /// otherwise a Fraction in normal form, its sign on the numerator.
    /// @signals ArgumentError carrying `denominator`,
    /// 'numerator:denominator: requires a non-zero denominator', for 0.
    /// @signals ArgumentError carrying the first argument that is no
    /// integer, 'numerator:denominator: requires integers, got …', when
    /// either is none.
    public numerator: numerator denominator: denominator = (
      ^vmMirror fractionClass: self numerator: numerator denominator: denominator ifFail: [
        ^super numerator: numerator denominator: denominator.
      ].
    )

    /// Makes the Fraction `numerator`/`denominator` from a pair the
    /// caller has put in normal form already: no factor common to both,
    /// `denominator` above 1. Nothing is reduced.
    ///
    /// The leaf answers only for `Fraction` itself; any other receiver
    /// falls to `super`.
    ///
    /// @param numerator an integer.
    /// @param denominator an integer above 1 with no factor common to
    /// `numerator`.
    /// @answers the Fraction `numerator`/`denominator`.
    /// @signals ArgumentError carrying `denominator`,
    /// 'reducedNumerator:denominator: requires a fraction in normal
    /// form, got …/…', for a pair not in normal form.
    /// @signals ArgumentError carrying the argument,
    /// 'reducedNumerator:denominator: requires integers, got …', for an
    /// argument that is no integer.
    public reducedNumerator: numerator denominator: denominator = (
      ^vmMirror fractionClass: self reducedNumerator: numerator denominator: denominator ifFail: [
        ^super reducedNumerator: numerator denominator: denominator.
      ].
    )
  )

  /// An immutable sequence of Unicode code points: a literal such as
  /// `'abc'` is one.
  ///
  /// A receiver holding no text -- an instance of a program's subclass
  /// of `String`, which gets no text of its own -- makes every leaf
  /// decline: a send that no other method above the leaf's answers ends
  /// in `doesNotUnderstand:`, a MessageNotUnderstood, as does a method
  /// written in Newspeak whose own sends reach such a leaf. The Errors
  /// and answers each method below names are those of a receiver
  /// holding a text whose class overrides none of them: a subclass's
  /// override decides them for the methods written over it.
  public class String = Value () (
    /// Identifies the receiver as a String, without a class test.
    ///
    /// @answers true.
    public isKindOfString = (
      ^true.
    )

    /// Counts the receiver's code points.
    ///
    /// @answers the number of code points, an Integer of at least 0.
    public size = (
      ^vmMirror stringSize: self ifFail: [^super size].
    )

    /// Reads the code point at `index`.
    ///
    /// Over code points, not UTF-8 bytes: `at:` answers the code point,
    /// which is the byte only for ASCII.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the code point at `index`, an Integer.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at: requires an Integer
    /// index, got …', for an index that is no Integer.
    public at: index = (
      ^vmMirror string: self at: index ifFail: [^super at: index].
    )

    /// Copies the code points from `start` to `stop`, both included; the
    /// receiver is unchanged. A `stop` of `start - 1` answers an empty
    /// String.
    ///
    /// @param start an Integer from 1 to `size + 1`.
    /// @param stop an Integer from `start - 1` to `size`.
    /// @answers a new String of the code points from `start` to `stop`.
    /// @signals ArgumentError 'copyFrom: … to: … out of range: valid
    /// ranges lie within 1..size, an empty range ends just before it
    /// starts (size …)' for bounds outside that, carrying `start` unless
    /// it is in range and `stop` otherwise.
    /// @signals ArgumentError 'copyFrom:to: requires an Integer index,
    /// got …', carrying the first bound that is no Integer.
    public copyFrom: start to: stop = (
      ^vmMirror string: self copyFrom: start to: stop ifFail: [^super copyFrom: start to: stop].
    )

    /// Concatenates the receiver's code points and those of `other`;
    /// neither is changed.
    ///
    /// @param other a String or a Symbol.
    /// @answers a new String of the receiver's code points followed by
    /// those of `other`.
    /// @signals ArgumentError carrying `other`, 'String concatenation (,)
    /// requires a String argument, got …', for any other argument.
    public , other = (
      ^vmMirror string: self concatenate: other ifFail: [^super , other].
    )

    /// Compares the receiver with `other` by their code points. It never
    /// signals. A Symbol never is equal.
    ///
    /// Only a String equals a String: a Symbol of the same text is not,
    /// and `Symbol>>=` answers false the other way round, so `'abc' =
    /// #abc` and `#abc = 'abc'` are both false and the equality stays
    /// symmetric. Each class hashes by its own rule, which a cross-class
    /// equality would break. Two Strings of the same code points are
    /// equal however each was made -- a literal, a copy, a concatenation,
    /// a StringBuilder -- and so identical (`Value>>==`): `'abc' ==
    /// ('abcd' copyFrom: 1 to: 3)` is true. A String never changes, so the
    /// answer never does. An instance of a program's subclass of `String`
    /// holds no text, and is compared by `Value>>=`.
    ///
    /// @param other any object.
    /// @answers whether `other` is a String of the same code points, a
    /// Boolean.
    /// @see `hash`, `Symbol>>=` and `Object>>=`.
    public = other = (
      ^vmMirror string: self equals: other ifFail: [^super = other].
    )

    /// Hashes the receiver by its code points, so that the hash agrees
    /// with `=`.
    ///
    /// It reads the text alone, so a copy hashes like its original, and
    /// its `identityHash` is this hash (`Value>>identityHash`). A Symbol
    /// of the same text hashes differently, which its being unequal
    /// allows.
    ///
    /// @answers a hash of the code points, an Integer alike for equal
    /// Strings.
    /// @see `=` and `Object>>hash`.
    public hash = (
      ^vmMirror stringHash: self ifFail: [^super hash].
    )

    /// Converts the receiver to the canonical Symbol of its text.
    ///
    /// @answers the Symbol of the same text, the one object of it.
    public asSymbol = (
      ^vmMirror stringAsSymbol: self ifFail: [^super asSymbol].
    )

    /// Prints the receiver as a literal writes it: between single
    /// quotes, each quote inside doubled.
    ///
    /// @answers a new String: the receiver's text as its literal.
    public printString = (
      ^vmMirror stringPrintString: self ifFail: [^super printString].
    )

    /// Converts the receiver to a String, which it already is.
    ///
    /// @answers the receiver itself.
    public asString = (
      ^self.
    )

    /// Encodes the receiver's code points as UTF-8, in order: one byte for
    /// a code point below 128, up to four for one past 65535.
    /// `String fromUtf8:` decodes it back to an equal String. The receiver
    /// is unchanged, and each send answers a new ByteArray.
    ///
    /// @answers a new ByteArray of the receiver's UTF-8 bytes.
    /// @signals ArgumentError carrying the receiver, 'asUtf8 cannot
    /// allocate a ByteArray of … bytes', only for a String whose bytes the
    /// heap cannot hold.
    public asUtf8 = (
      ^vmMirror stringAsUtf8: self ifFail: [^super asUtf8].
    )

    /// Counts the bytes the receiver takes as UTF-8 without making them;
    /// never signals.
    ///
    /// `StringBuilder` asks it before it appends a String.
    ///
    /// @answers the number of bytes, an Integer: the size of `asUtf8`'s
    /// answer.
    public utf8Size = (
      ^vmMirror stringUtf8Size: self ifFail: [^super utf8Size].
    )

    /// Evaluates `action` with each code point, an Integer, from the
    /// first.
    ///
    /// @param action a one-argument block, or anything understanding
    /// `value:`.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for an `action` that does not
    /// take one argument, when the receiver is not empty.
    public do: action = (
      1 to: self size do: [:index | action value: (self at: index)].
    )

    /// Tells whether the String has no code point.
    ///
    /// @answers whether `size` is 0, a Boolean.
    public isEmpty = (
      ^self size = 0.
    )

    /// Reads the first code point.
    ///
    /// @answers the first code point, an Integer.
    /// @signals ArgumentError of `at:`, carrying 1, for an empty String.
    public first = (
      ^self at: 1.
    )

    /// Reads the last code point.
    ///
    /// @answers the last code point, an Integer.
    /// @signals ArgumentError of `at:`, carrying 0, for an empty String.
    public last = (
      ^self at: self size.
    )

    /// Copies the one code point at `index` into a String; for a Symbol
    /// too.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers a new String of the one code point at `index`.
    /// @signals ArgumentError of `at:` for any other index.
    public stringAt: index = (
      self at: index.
      ^self copyFrom: index to: index.
    )

    /// Copies the code points from `start` to `stop`, as
    /// `copyFrom: start to: stop` does.
    ///
    /// @param start as `copyFrom:to:`'s.
    /// @param stop as `copyFrom:to:`'s.
    /// @answers what `copyFrom: start to: stop` answers: a new String of
    /// the code points from `start` to `stop`.
    /// @signals ArgumentError `copyFrom:to:` signals, for a range the
    /// receiver does not hold or a bound that is no Integer.
    /// @see `copyFrom:to:`.
    public copyStringFrom: start to: stop = (
      ^self copyFrom: start to: stop.
    )

    /// Finds the first occurrence of `substring`:
    /// `indexOf: substring startingAt: 1`.
    ///
    /// @param substring a String or a Symbol.
    /// @answers the index of the first occurrence of `substring`, or 0.
    /// @signals ArgumentError of `indexOf:startingAt:`, carrying
    /// `substring`, for a `substring` that is no String.
    /// @see `indexOf:startingAt:`.
    public indexOf: substring = (
      ^self indexOf: substring startingAt: 1.
    )

    /// Finds the first occurrence of `substring` that starts at or after
    /// `start`. An empty `substring` is found at `start`.
    ///
    /// @param substring a String or a Symbol.
    /// @param start an Integer from 1 to `size + 1`.
    /// @answers the code-point index at which that occurrence begins, or 0
    /// when there is none.
    /// @signals ArgumentError carrying `substring`, 'indexOf:startingAt:
    /// requires a String argument, got …', for a `substring` that is no
    /// String.
    /// @signals ArgumentError carrying `start`, 'indexOf:startingAt: … out
    /// of range: valid starts are 1..… (size …)', for a `start` outside 1
    /// to `size + 1`, or 'indexOf:startingAt: requires an Integer index,
    /// got …'.
    public indexOf: substring startingAt: start = (
      ^vmMirror string: self indexOf: substring startingAt: start ifFail: [
        ^super indexOf: substring startingAt: start.
      ].
    )

    /// Finds the last occurrence of `substring`:
    /// `lastIndexOf: substring startingAt: size + 1`.
    ///
    /// @param substring a String or a Symbol.
    /// @answers the index of the last occurrence of `substring`, or 0.
    /// @signals ArgumentError of `lastIndexOf:startingAt:`, carrying
    /// `substring`, for a `substring` that is no String.
    /// @see `lastIndexOf:startingAt:`.
    public lastIndexOf: substring = (
      ^self lastIndexOf: substring startingAt: self size + 1.
    )

    /// Finds the last occurrence of `substring` that starts at or before
    /// `start`. An empty `substring` is found at `start`.
    ///
    /// @param substring a String or a Symbol.
    /// @param start an Integer from 1 to `size + 1`.
    /// @answers the code-point index at which that occurrence begins, or 0
    /// when there is none.
    /// @signals ArgumentError `indexOf:startingAt:` signals, for the same
    /// arguments, its text naming 'lastIndexOf:startingAt:'.
    /// @see `indexOf:startingAt:`.
    public lastIndexOf: substring startingAt: start = (
      ^vmMirror string: self lastIndexOf: substring startingAt: start ifFail: [
        ^super lastIndexOf: substring startingAt: start.
      ].
    )

    /// Tells whether the receiver begins with `prefix`; true for an empty
    /// `prefix`.
    ///
    /// Looks for an occurrence starting at 1 at the latest, so only the
    /// first position is compared, whatever the receiver's length; the
    /// search leaf still reads the whole receiver before it compares.
    ///
    /// @param prefix a String or a Symbol.
    /// @answers whether the receiver begins with `prefix`, a Boolean.
    /// @signals ArgumentError carrying `prefix`, 'startsWith: requires a
    /// String argument, got …' and its `printString`, for a `prefix` that
    /// is no String.
    public startsWith: prefix = (
      prefix isKindOfString ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: prefix) signal: 'startsWith: requires a String argument, got '
            , prefix printString.
      ].
      ^(self lastIndexOf: prefix startingAt: 1) = 1.
    )

    /// Tells whether the receiver ends with `suffix`; true for an empty
    /// `suffix`.
    ///
    /// The last occurrence is the one at the end when there is one
    /// there.
    ///
    /// @param suffix a String or a Symbol.
    /// @answers whether the receiver ends with `suffix`, a Boolean.
    /// @signals ArgumentError carrying `suffix`, 'endsWith: requires a
    /// String argument, got …' and its `printString`, for a `suffix` that
    /// is no String.
    public endsWith: suffix = (
      |
        position
      |
      suffix isKindOfString ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: suffix) signal: 'endsWith: requires a String argument, got '
            , suffix printString.
      ].
      position:: self lastIndexOf: suffix startingAt: self size + 1.
      ^(position > 0) and: [position = (self size - suffix size + 1)].
    )
  ) : (
    /// Makes a String of one code point, `code`.
    ///
    /// It takes a code point, not a byte. The leaf answers only for
    /// `String` itself, the only subject a flat class side is sent from;
    /// any other falls to `super`, where nothing understands `with:`, so
    /// the send signals rather than answering nil.
    ///
    /// @param code an Integer from 0 to 1114111 outside 55296 to 57343.
    /// @answers a new String of the one code point `code`.
    /// @signals ArgumentError carrying `code`, 'with: requires a Unicode
    /// code point, an Integer from 0 to 1114111 outside 55296 to 57343,
    /// got …', for any other argument.
    public with: code = (
      ^vmMirror stringClass: self with: code ifFail: [^super with: code].
    )

    /// Makes a String of the code points of `codePoints`, in its `do:`
    /// order.
    ///
    /// The leaf answers only for `String` itself, the only subject a flat
    /// class side is sent from. It declines for an argument that answers
    /// `isKindOfArray` or `isKindOfString` true without being an Array or
    /// a String, and the method then answers nil.
    ///
    /// @param codePoints a String, or a Collection of Integers, each a
    /// Unicode code point: from 0 to 1114111 and outside 55296 to 57343.
    /// Anything else answering `size` and `do:` is gathered into an Array
    /// first.
    /// @answers a new String of the code points of `codePoints`, a new
    /// String of the same code points when `codePoints` is a String; nil
    /// for an argument that answers `isKindOfArray` or `isKindOfString`
    /// true without being an Array or a String.
    /// @signals ArgumentError carrying the first element that is no code
    /// point, 'withAll: requires Unicode code points, Integers from 0 to
    /// 1114111 outside 55296 to 57343, got …'.
    /// @signals MessageNotUnderstood of `size` or `do:` for an argument
    /// that lacks it.
    /// @signals ArgumentError of `Array new:` for an argument gathered
    /// into an Array whose `size` is no Integer of at least 0 or too large
    /// to allocate.
    public withAll: codePoints = (
      ^vmMirror stringClass: self withAll: codePoints ifFail: [
        (codePoints isKindOfArray or: [codePoints isKindOfString]) ifTrue: [
          nil.
        ] ifFalse: [
          self withAll: (outer Kernel Array withAll: codePoints).
        ].
      ].
    )

    /// Decodes the UTF-8 bytes of `bytes`:
    /// `fromUtf8: bytes from: 1 to: bytes size`.
    ///
    /// The argument is checked first, since `bytes size` of anything else
    /// could answer anything, or nothing.
    ///
    /// @param bytes a ByteArray.
    /// @answers a new String of the code points the UTF-8 bytes of `bytes`
    /// encode.
    /// @signals ArgumentError carrying `bytes`, 'fromUtf8: requires a
    /// ByteArray, got …' and its `printString`, for any other argument.
    /// @signals ArgumentError `fromUtf8:from:to:` signals for bytes that
    /// are no UTF-8.
    /// @see `fromUtf8:from:to:`.
    public fromUtf8: bytes = (
      bytes isKindOfByteArray ifFalse: [
        ^(outer Kernel ArgumentError value: bytes) signal: 'fromUtf8: requires a ByteArray, got '
            , bytes printString.
      ].
      ^self fromUtf8: bytes from: 1 to: bytes size.
    )

    /// Decodes the UTF-8 bytes of `bytes` from `start` to `stop`, both
    /// included; `bytes` is unchanged. A `stop` of `start - 1` answers an
    /// empty String.
    ///
    /// Decodes strictly: a truncated sequence, a range that ends inside a
    /// character among them, a stray continuation byte, an overlong
    /// encoding, a surrogate and a code point past 1114111 are an
    /// ArgumentError. A byte-order mark is kept, as the code point 65279.
    ///
    /// Strict rather than a replacement character for each bad sequence,
    /// so that nothing is lost silently. The leaf answers only for
    /// `String` itself, the only subject a flat class side is sent from;
    /// any other falls to `super`, where nothing understands
    /// `fromUtf8:from:to:`, so the send signals rather than answering nil.
    ///
    /// @param bytes a ByteArray.
    /// @param start an Integer from 1 to `bytes size + 1`.
    /// @param stop an Integer from `start - 1` to `bytes size`.
    /// @answers a new String of the code points the bytes from `start` to
    /// `stop` encode.
    /// @signals ArgumentError carrying `bytes`, 'fromUtf8: invalid UTF-8
    /// at byte …', for bytes that are no UTF-8, which names the first byte
    /// of the bad sequence by its index in `bytes`, not in the range.
    /// @signals ArgumentError carrying `bytes`, 'fromUtf8:from:to: requires
    /// a ByteArray, got …', for a `bytes` that is no ByteArray.
    /// @signals ArgumentError `copyFrom:to:` signals for a range `bytes`
    /// does not hold, its text beginning 'from: … to: …' and the bound that
    /// is no Integer named by 'fromUtf8:from:to:'.
    public fromUtf8: bytes from: start to: stop = (
      ^vmMirror stringClass: self fromUtf8: bytes from: start to: stop ifFail: [
        ^super fromUtf8: bytes from: start to: stop.
      ].
    )
  )

  /// A canonical String: one object per text (§5.1.6), made only by a
  /// literal such as `#at:put:` or by `asSymbol`, never by `new`. It
  /// understands what a String does; `,` and `copyFrom:to:` answer a
  /// String.
  public class Symbol = String () (
    /// Copies the Symbol's text into a String, which is not canonical.
    ///
    /// @answers a new String of the Symbol's text.
    public asString = (
      ^vmMirror symbolAsString: self ifFail: [^super asString].
    )

    /// Compares the receiver with `other` by identity, a Symbol being
    /// canonical. It never signals. A String never is equal.
    ///
    /// There is one Symbol per text (§5.1.6), so the same object and the
    /// same text are the same question: `#abc = 'abc' asSymbol` is true.
    /// A String of the same text is not equal, as `String>>=` does not
    /// find a Symbol equal, so the equality stays symmetric across the
    /// two classes.
    ///
    /// @param other any object.
    /// @answers whether `other` is the same Symbol, a Boolean.
    /// @see `String>>=` and `Object>>=`.
    public = other = (
      ^vmMirror symbol: self equals: other ifFail: [^super = other].
    )

    /// Hashes the receiver by its text, so that the hash agrees with `=`.
    ///
    /// By the text rather than by the object, so that the hash is the
    /// same in every run and every process the Symbol reaches; it
    /// differs from the hash of a String of the same text, which is
    /// unequal to it.
    ///
    /// @answers a hash, an Integer alike for equal Symbols.
    /// @see `String>>hash` and `Object>>hash`.
    public hash = (
      ^vmMirror symbolHash: self ifFail: [^super hash].
    )

    /// Prints the Symbol's text after a '#'.
    ///
    /// @answers a new String of the Symbol's text after a '#'.
    public printString = (
      ^vmMirror symbolPrintString: self ifFail: [^super printString].
    )
  )

  /// A growing text, built by appending Strings and code points: it keeps
  /// the UTF-8 bytes of what was appended in a ByteArray that grows by half
  /// again when it is full, so an append costs amortised constant time. Its
  /// `size` counts code points, as a String's does. Equality and `hash` are
  /// identity.
  ///
  /// @factory makes an empty builder whose ByteArray has room for
  /// `capacity` bytes.
  /// @param capacity an Integer of at least 0, the number of UTF-8 bytes
  /// to make room for at the start; a hint, since the builder grows as
  /// needed.
  /// @signals ArgumentError of `ByteArray new:` for a capacity that is
  /// negative, no Integer or too large to allocate.
  public class StringBuilder new: capacity = Object (
    |
      /// The UTF-8 bytes appended so far, then unused room; never handed
      /// out, so the first `byteCount` of them are always valid UTF-8.
      private data ::= outer Kernel ByteArray new: capacity.
      /// How many bytes of `data` are used: an Integer from 0 to
      /// `data size`, to which every append adds the bytes it wrote.
      private byteCount ::= 0.
      /// How many code points those bytes encode: the builder's `size`,
      /// at most `byteCount`, since a code point takes one byte or more.
      private codePointCount ::= 0.
    |
  ) (
    /// Identifies the receiver as a StringBuilder, without a class test.
    ///
    /// @answers true.
    public isKindOfStringBuilder = (
      ^true.
    )

    /// Appends the code points of `aString`.
    ///
    /// @param aString a String or a Symbol.
    /// @answers `aString`.
    /// @signals ArgumentError carrying `aString`, 'add: requires a String,
    /// got …' and its `printString`, for any other argument, a ByteArray
    /// included; the builder is unchanged.
    /// @signals ArgumentError of `checkState:` when the receiver's state is
    /// not one its own members leave.
    /// @signals ArgumentError of `ensureRoom:` when the grown ByteArray is
    /// too large to allocate; the builder is unchanged.
    public add: aString = (
      |
        byteTotal
      |
      self checkState: #add:.
      aString isKindOfString ifFalse: [
        ^(outer Kernel ArgumentError value: aString) signal: 'add: requires a String, got '
            , aString printString.
      ].
      byteTotal:: aString utf8Size.
      self ensureRoom: byteCount + byteTotal.
      data replaceFrom: byteCount + 1 to: byteCount + byteTotal with: aString startingAt: 1.
      byteCount:: byteCount + byteTotal.
      codePointCount:: codePointCount + aString size.
      ^aString.
    )

    /// Appends one code point.
    ///
    /// The value is checked here, before the write, so that the error
    /// names `addCodePoint:` rather than the ByteArray store behind it.
    ///
    /// @param codePoint an Integer from 0 to 1114111 outside 55296 to
    /// 57343.
    /// @answers `codePoint`.
    /// @signals ArgumentError carrying `codePoint`, 'addCodePoint: requires
    /// a Unicode scalar value, got …' and its `printString`, for any other
    /// argument; nothing is appended.
    /// @signals ArgumentError of `checkState:` when the receiver's state is
    /// not one its own members leave.
    /// @signals ArgumentError of `ensureRoom:` when the grown ByteArray is
    /// too large to allocate; nothing is appended.
    public addCodePoint: codePoint = (
      self checkState: #addCodePoint:.
      (codePoint isKindOfInteger and: [
        codePoint >= 0 and: [
          codePoint <= 1114111 and: [(codePoint >= 55296 and: [codePoint <= 57343]) not].
        ].
      ]) ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: codePoint) signal: 'addCodePoint: requires a Unicode scalar value, got '
            , codePoint printString.
      ].
      self ensureRoom: byteCount + 4.
      byteCount:: byteCount + (data at: byteCount + 1 putCodePoint: codePoint).
      codePointCount:: codePointCount + 1.
      ^codePoint.
    )

    /// Appends the code points of `aString` and then a newline, code point
    /// 10.
    ///
    /// @param aString a String or a Symbol.
    /// @answers the receiver.
    /// @signals ArgumentError of `add:`, any of them; the builder is
    /// unchanged.
    /// @signals ArgumentError of `ensureRoom:` when the ByteArray grown for
    /// the newline is too large to allocate; `aString` stays appended.
    public writeln: aString = (
      self add: aString.
      self addCodePoint: 10.
      ^self.
    )

    /// Counts the code points appended so far.
    ///
    /// @answers how many code points have been appended, an Integer of at
    /// least 0.
    /// @signals ArgumentError of `checkState:` when the receiver's state is
    /// not one its own members leave.
    public size = (
      self checkState: #size.
      ^codePointCount.
    )

    /// Tells whether nothing has been appended.
    ///
    /// @answers whether nothing has been appended, a Boolean.
    /// @signals ArgumentError of `checkState:` when the receiver's state is
    /// not one its own members leave.
    public isEmpty = (
      self checkState: #isEmpty.
      ^codePointCount = 0.
    )

    /// Decodes everything appended, in order, into a String; a new one on
    /// every send, so the receiver's later appends do not reach it.
    ///
    /// @answers a new String of everything appended.
    /// @signals ArgumentError of `checkState:` when the receiver's state is
    /// not one its own members leave.
    public asString = (
      self checkState: #asString.
      ^outer Kernel String fromUtf8: data from: 1 to: byteCount.
    )

    /// Copies the UTF-8 bytes of everything appended: changing the copy
    /// leaves the receiver unchanged.
    ///
    /// @answers a new ByteArray of the UTF-8 bytes of everything appended.
    /// @signals ArgumentError of `checkState:` when the receiver's state is
    /// not one its own members leave.
    public asUtf8 = (
      self checkState: #asUtf8.
      ^data copyFrom: 1 to: byteCount.
    )

    /// Checks that the receiver's slots hold what its own members leave
    /// in them: `data` a ByteArray, `byteCount` an Integer from 0 to
    /// `data size`, and `codePointCount` an Integer from 0 to `byteCount`.
    ///
    /// Every member that reads the slots sends it first, so that a crafted
    /// builder is refused under the selector the program sent, rather than
    /// by whatever send first meets the wrong object, or by none when the
    /// counts are wrong but still Integers.
    ///
    /// @param selector the Symbol of the message the program sent.
    /// @answers the receiver, when its slots hold that.
    /// @signals ArgumentError carrying the receiver, '<selector> found a
    /// StringBuilder whose state is not its own', for any other state,
    /// which only a crafted image can make; nothing is changed.
    private checkState: selector = (
      (data isKindOfByteArray and: [
        byteCount isKindOfInteger and: [
          codePointCount isKindOfInteger and: [
            byteCount >= 0 and: [
              byteCount <= data size and: [codePointCount >= 0 and: [codePointCount <= byteCount]].
            ].
          ].
        ].
      ]) ifFalse: [
        ^(outer Kernel ArgumentError value: self) signal: selector asString
            , ' found a StringBuilder whose state is not its own'.
      ].
    )

    /// Makes `data` hold at least `byteTotal` bytes, replacing it with a
    /// ByteArray of that size or of one and a half times its current size,
    /// whichever is more, that begins with the used bytes.
    ///
    /// Growing by a fraction of the size rather than a fixed step is what
    /// keeps the cost of an append amortised constant.
    ///
    /// @param byteTotal an Integer of at least `byteCount`.
    /// @answers the receiver.
    /// @signals ArgumentError of `ByteArray new:` for a size too large to
    /// allocate.
    private ensureRoom: byteTotal = (
      |
        grown
      |
      byteTotal > data size ifFalse: [^self].
      grown:: outer Kernel ByteArray new: (byteTotal max: data size * 3 // 2).
      grown replaceFrom: 1 to: byteCount with: data startingAt: 1.
      data:: grown.
    )
  ) : (
    /// Makes an empty StringBuilder with room for 16 bytes, as
    /// `new: 16` does.
    ///
    /// @answers a new, empty StringBuilder with room for 16 bytes.
    public new = (
      ^self new: 16.
    )
  )

  /// A group of elements that can be visited one by one: the abstract
  /// superclass of `Array` and of the collections module's `List`, `Map`
  /// and `Set`. A subclass defines `do:`, and inherits every other public
  /// member here, each written over `do:`; to `collect:`, `select:` or
  /// `reject:` it also defines `newForCollectUsingAdd:`. A subclass
  /// overrides any member it can answer faster.
  ///
  /// A subclass that does not define `do:` signals `do:`'s Error from
  /// every member written over it. The Errors and answers each member
  /// below names are those of a subclass that defines `do:` and
  /// overrides no other member: an override decides them for the members
  /// written over it.
  public class Collection = Object () (
    /// Identifies the receiver as a Collection, without a class test.
    ///
    /// @answers true.
    public isKindOfCollection = (
      ^true.
    )

    /// Evaluates `action` with each element in turn; every subclass
    /// defines it.
    ///
    /// @param action a one-argument block, or anything understanding
    /// `value:`.
    /// @answers nothing here, where it never returns; a subclass's own
    /// decides its answer, the receiver for every shipped collection.
    /// @signals Error of `subclassResponsibility`, here,
    /// 'Collection>>do: is abstract: … must implement it': every subclass
    /// defines it.
    public do: action = (
      ^self subclassResponsibility.
    )

    /// Makes the new, empty collection that `collect:`, `select:` and
    /// `reject:` fill by sending it `add:` once per element they keep.
    ///
    /// The kernel cannot name the collections module's `List`, so a
    /// collection says itself what its `collect:` answers.
    ///
    /// @param capacity an Integer of at least 0, the receiver's size: room
    /// enough for every element.
    /// @answers nothing here, where it never returns; a subclass's own
    /// answers the new, empty collection.
    /// @signals Error of `subclassResponsibility`, here,
    /// 'Collection>>newForCollectUsingAdd: is abstract: … must implement
    /// it'.
    protected newForCollectUsingAdd: capacity = (
      ^self subclassResponsibility.
    )

    /// Tells whether `predicate` answers true for every element; true for
    /// an empty collection. Stops at the first element for which it
    /// answers false.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers whether `predicate` answers true for every element, a
    /// Boolean.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    public allSatisfy: predicate = (
      self do: [:element | (predicate value: element) ifFalse: [^false]].
      ^true.
    )

    /// Tells whether `predicate` answers true for some element; false for
    /// an empty collection. Stops at the first element for which it
    /// answers true.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers whether `predicate` answers true for some element, a
    /// Boolean.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    public anySatisfy: predicate = (
      self do: [:element | (predicate value: element) ifTrue: [^true]].
      ^false.
    )

    /// Tells whether `predicate` answers false for every element; true for
    /// an empty collection. Stops at the first element for which it
    /// answers true.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers whether `predicate` answers false for every element, a
    /// Boolean.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    public noneSatisfy: predicate = (
      self do: [:element | (predicate value: element) ifTrue: [^false]].
      ^true.
    )

    /// Finds the first element, in `do:` order, for which `predicate`
    /// answers true.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers the first element for which `predicate` answers true.
    /// @signals Error 'No matching element detected' when it answers true
    /// for none.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    /// @see `detect:ifNone:`.
    public detect: predicate = (
      ^self detect: predicate ifNone: [
        (outer Kernel Error new) signal: 'No matching element detected'.
      ].
    )

    /// Finds the first element, in `do:` order, for which `predicate`
    /// answers true, falling back on `onNone` when it answers true for
    /// none.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @param onNone anything understanding `value`; sent it only when no
    /// element matches.
    /// @answers the first element for which `predicate` answers true, or
    /// the value of `onNone` when it answers true for none.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 0', for an `onNone` that declares any
    /// parameter, when no element matches.
    public detect: predicate ifNone: onNone = (
      self do: [:element | (predicate value: element) ifTrue: [^element]].
      ^onNone value.
    )

    /// Evaluates `action` with each element in `do:` order, and `between`
    /// between every two of them: not before the first, not after the
    /// last.
    ///
    /// @param action a one-argument block, or anything understanding
    /// `value:`.
    /// @param between anything understanding `value`.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for an `action` that does not
    /// take one argument, when the receiver is not empty.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 0', for a `between` that declares any
    /// parameter, when the receiver holds at least two elements.
    public do: action separatedBy: between = (
      |
        first ::= true.
      |
      self do: [:element |
        first ifTrue: [first:: false] ifFalse: [between value].
        action value: element.
      ].
    )

    /// Tells whether some element is `=` to `object`; each element is sent
    /// `=` with `object` as its argument, in `do:` order, until one
    /// answers true.
    ///
    /// @param object any object.
    /// @answers whether some element is `=` to `object`, a Boolean.
    public includes: object = (
      self do: [:element | element = object ifTrue: [^true]].
      ^false.
    )

    /// Folds the elements from the left, `accumulated` starting as
    /// `initial` and becoming each answer of
    /// `fold value: accumulated value: element` in turn.
    ///
    /// @param initial any object; the first `accumulated`.
    /// @param fold a two-argument block.
    /// @answers `initial` for an empty collection, otherwise the last
    /// answer of `fold`.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for a `fold` that does not take
    /// two arguments, when the receiver is not empty.
    public inject: initial into: fold = (
      |
        accumulated ::= initial.
      |
      self do: [:element | accumulated:: fold value: accumulated value: element].
      ^accumulated.
    )

    /// Tells whether the collection holds no element.
    ///
    /// @answers whether `size` is 0, a Boolean.
    public isEmpty = (
      ^self size = 0.
    )

    /// Folds the elements from the left, starting with the first: a
    /// one-element collection answers that element without sending
    /// `merge`.
    ///
    /// @param merge a two-argument block.
    /// @answers the only element of a one-element collection; for a longer
    /// one the last answer of `merge value: accumulated value: element`
    /// over the rest.
    /// @signals Error 'Cannot reduce an empty collection' for an empty
    /// collection.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for a `merge` that does not take
    /// two arguments, when the receiver holds at least two elements.
    /// @see `reduce:ifEmpty:`.
    public reduce: merge = (
      ^self reduce: merge ifEmpty: [
        (outer Kernel Error new) signal: 'Cannot reduce an empty collection'.
      ].
    )

    /// As `reduce:`, but answers the value of `onEmpty` for an empty
    /// collection.
    ///
    /// @param merge a two-argument block.
    /// @param onEmpty anything understanding `value`; sent it only when the
    /// collection is empty.
    /// @answers what `reduce:` answers for a collection that is not empty,
    /// the value of `onEmpty` for an empty one.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for a `merge` that does not take
    /// two arguments, when the receiver holds at least two elements.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 0', for an `onEmpty` that declares any
    /// parameter, when the receiver is empty.
    /// @see `reduce:`.
    public reduce: merge ifEmpty: onEmpty = (
      |
        first ::= true.
        accumulated
      |
      self do: [:element |
        first ifTrue: [
          first:: false.
          accumulated:: element.
        ] ifFalse: [
          accumulated:: merge value: accumulated value: element.
        ].
      ].
      first ifTrue: [^onEmpty value].
      ^accumulated.
    )

    /// Transforms each element, in `do:` order, into a new collection.
    /// The receiver is unchanged.
    ///
    /// @param transform a one-argument block.
    /// @answers a new collection, from `newForCollectUsingAdd:`, holding
    /// `transform`'s answer for each element, added in `do:` order.
    /// @signals Error of `subclassResponsibility`, from
    /// `newForCollectUsingAdd:`, when the subclass does not define it.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `transform` that does not
    /// take one argument, when the receiver is not empty.
    public collect: transform = (
      |
        result = self newForCollectUsingAdd: self size.
      |
      self do: [:element | result add: (transform value: element)].
      ^result.
    )

    /// Selects the elements for which `predicate` answers true into a new
    /// collection. The receiver is unchanged.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers a new collection, from `newForCollectUsingAdd:`, holding
    /// the elements for which `predicate` answers true, in `do:` order.
    /// @signals Error of `subclassResponsibility`, from
    /// `newForCollectUsingAdd:`, when the subclass does not define it.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    public select: predicate = (
      |
        result = self newForCollectUsingAdd: self size.
      |
      self do: [:element | (predicate value: element) ifTrue: [result add: element]].
      ^result.
    )

    /// Selects the elements for which `predicate` answers false into a
    /// new collection. The receiver is unchanged.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers a new collection, from `newForCollectUsingAdd:`, holding
    /// the elements for which `predicate` answers false, in `do:` order.
    /// @signals Error of `subclassResponsibility`, from
    /// `newForCollectUsingAdd:`, when the subclass does not define it.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    public reject: predicate = (
      |
        result = self newForCollectUsingAdd: self size.
      |
      self do: [:element | (predicate value: element) ifFalse: [result add: element]].
      ^result.
    )

    /// Counts the elements through `do:`.
    ///
    /// @answers the number of elements, an Integer of at least 0.
    public size = (
      |
        count ::= 0.
      |
      self do: [:element | count:: count + 1].
      ^count.
    )
  )

  /// The sequence protocol shared by the classes whose elements are
  /// indexed from 1, a mixin `Array` and `ByteArray` apply over `Collection`
  /// (`Collection <: IndexedCollection`, §6.2): every member here is
  /// written over `at:`, `at:put:`, `size` and `newOfSize:`, which each
  /// class applying it implements, and a class overrides any member it
  /// can answer faster.
  ///
  /// It declares none of `at:`, `at:put:`, `size`, `do:`, `=`, `hash` and
  /// `printString`, so that a failure block's `super` send in the class
  /// applying it passes through to `Collection` and `Object`. Its own
  /// superclass, `Collection`, records that its members build on
  /// `Collection`'s protocol; applying it takes only its own members.
  /// Public so that a shipped module can apply it (`TypedArraysFactory`
  /// applies it over `Collection` to make the typed arrays); no facet
  /// hands it to a program, which meets it only through the classes that
  /// apply it.
  ///
  /// An instance of a program's subclass of `Array` or `ByteArray` holds
  /// no elements, which only the class itself gets: its leaves decline,
  /// so `at:` ends in `doesNotUnderstand:`, a MessageNotUnderstood, and
  /// `size`, through `Collection`'s, in the Error of `do:`'s
  /// `subclassResponsibility`, as does a member here whose sends reach
  /// them. The Errors and answers each member below names are those of a
  /// receiver that holds its elements -- an instance of a shipped class
  /// applying the mixin, `Array`, `ByteArray` or a typed array -- whose
  /// class overrides none of `at:`, `at:put:`, `size`, `newOfSize:` and
  /// the members here: an override decides them for the members written
  /// over it.
  public class IndexedCollection = Collection () (
    /// Makes the new instance the sequence protocol builds its answers in;
    /// every class applying the mixin defines it.
    ///
    /// @param size an Integer of at least 0.
    /// @answers nothing here, where it never returns; the applying class's
    /// own answers a new instance of the receiver's kind holding `size`
    /// elements, each the empty element of that kind.
    /// @signals Error of `subclassResponsibility`, here,
    /// 'IndexedCollection>>newOfSize: is abstract: … must implement it':
    /// every class applying the mixin defines it.
    protected newOfSize: size = (
      ^self subclassResponsibility.
    )

    /// Tells whether the receiver has no element.
    ///
    /// @answers whether `size` is 0, a Boolean.
    public isEmpty = (
      ^self size = 0.
    )

    /// Reads the first element.
    ///
    /// @answers the first element.
    /// @signals ArgumentError carrying 1, `at:`'s for the index 1, when
    /// the receiver is empty.
    public first = (
      ^self at: 1.
    )

    /// Reads the last element.
    ///
    /// @answers the last element.
    /// @signals ArgumentError carrying 0, `at:`'s for the index 0, when
    /// the receiver is empty.
    public last = (
      ^self at: self size.
    )

    /// Finds the first element `=` to `element`. Each element is sent `=`
    /// with `element`, from the first, until one answers true.
    ///
    /// @param element any object.
    /// @answers the index of the first element `=` to `element`, or 0 when
    /// there is none.
    public indexOf: element = (
      1 to: self size do: [:index | (self at: index) = element ifTrue: [^index]].
      ^0.
    )

    /// Evaluates `action` with each index and the element there, from the
    /// first, reading each element when it reaches it.
    ///
    /// @param action a two-argument block, given the index and the
    /// element.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for an `action` that does not
    /// take two arguments, when the receiver is not empty.
    public keysAndValuesDo: action = (
      1 to: self size do: [:index | action value: index value: (self at: index)].
    )

    /// Copies the elements from `start` to `stop`, in order; empty when
    /// `stop` is `start - 1`. The receiver is unchanged.
    ///
    /// @param start an Integer with 1 <= start <= stop + 1.
    /// @param stop an Integer with start - 1 <= stop <= size.
    /// @answers a new collection of the receiver's kind holding the
    /// elements from `start` to `stop`.
    /// @signals ArgumentError an Array signals for the range, carrying the
    /// bound out of range, 'copyFrom: … to: … out of range: valid ranges
    /// lie within 1..size, an empty range ends just before it starts
    /// (size …)'.
    /// @signals ArgumentError an Array signals, 'copyFrom:to: requires an
    /// Integer index, got …', for a bound that is no Integer.
    public copyFrom: start to: stop = (
      |
        result
      |
      self checkRangeFrom: start to: stop keyword: 'copyFrom:' ifNoInteger: [
        (outer Kernel Array new: 0) copyFrom: start to: stop.
      ].
      result:: self newOfSize: stop - start + 1.
      1 to: result size do: [:index | result at: index put: (self at: start + index - 1)].
      ^result.
    )

    /// Stores the elements of `source` from `sourceStart` on into the
    /// receiver's positions `start` to `stop`. Correct when `source` is
    /// the receiver and the ranges overlap: every element is read before
    /// any is stored.
    ///
    /// The elements the range needs are copied into an Array first, which
    /// is what makes an overlapping range correct.
    ///
    /// @param start a range's first position in the receiver, as for
    /// `copyFrom:to:`.
    /// @param stop a range's last position in the receiver, as for
    /// `copyFrom:to:`.
    /// @param source anything answering `size` and `at:` -- an Array, a
    /// List, a String, whose elements are its code points.
    /// @param sourceStart an Integer with 1 <= sourceStart and
    /// sourceStart + (stop - start) <= source size.
    /// @answers the receiver.
    /// @signals ArgumentError, before it reads or stores any element, an
    /// Array's: for a range the receiver does not hold, the one
    /// `copyFrom:to:` signals, its text beginning 'replaceFrom: … to: …'.
    /// @signals ArgumentError, before it reads or stores any element, an
    /// Array's, 'replaceFrom:to:with:startingAt: requires an Integer
    /// index, got …', for a bound or a `sourceStart` that is no Integer.
    /// @signals ArgumentError, before it reads or stores any element, an
    /// Array's, carrying `sourceStart`, 'startingAt: … out of range: the
    /// source holds … elements, the range needs … from …', for a source
    /// too short.
    /// @signals ArgumentError `at:put:` signals for an element the
    /// receiver cannot hold, after the elements before it are stored.
    public replaceFrom: start to: stop with: source startingAt: sourceStart = (
      |
        count
        elements
      |
      self checkRangeFrom: start to: stop keyword: 'replaceFrom:' ifNoInteger: [
        (outer Kernel Array new: 0) replaceFrom: start
            to: stop
            with: (outer Kernel Array new: 0)
            startingAt: 1.
      ].
      count:: stop - start + 1.
      self checkSourceStart: sourceStart count: count sourceSize: source size.
      elements:: outer Kernel Array new: count.
      1 to: count do: [:index | elements at: index put: (source at: sourceStart + index - 1)].
      1 to: count do: [:index | self at: start + index - 1 put: (elements at: index)].
    )

    /// Checks that `start` to `stop` is a range the receiver holds --
    /// 1 <= start <= stop + 1 and stop <= size, the empty range included.
    ///
    /// The texts are an Array leaf's, so that a receiver of any kind fails
    /// as an Array does. A bound that is no Integer is refused by that
    /// leaf on an empty Array, since the description of an arbitrary
    /// object is the leaf's to give; checking the range itself allocates
    /// nothing, whatever the receiver's size.
    ///
    /// @param start the range's first position, any object; refused
    /// through `refuse` unless it is an Integer.
    /// @param stop the range's last position, any object; refused through
    /// `refuse` unless it is an Integer.
    /// @param keyword the String naming the selector's first keyword,
    /// 'copyFrom:' or 'replaceFrom:'.
    /// @param refuse a block, evaluated when a bound is no Integer, that
    /// signals the selector's own 'requires an Integer index' error.
    /// @answers the receiver, when the range is one it holds.
    /// @signals ArgumentError an Array's leaf signals for a range it does
    /// not hold: carrying the start unless it is a position the receiver
    /// has, one past the end included, and then the stop, with the text
    /// '<keyword> … to: … out of range: valid ranges lie within 1..size,
    /// an empty range ends just before it starts (size …)'.
    /// @signals ArgumentError `refuse` signals, for a bound that is no
    /// Integer.
    private checkRangeFrom: start to: stop keyword: keyword ifNoInteger: refuse = (
      |
        receiverSize
        refused
      |
      (start isKindOfInteger and: [stop isKindOfInteger]) ifFalse: [^refuse value].
      receiverSize:: self size.
      (start >= 1 and: [stop >= (start - 1) and: [stop <= receiverSize]]) ifTrue: [^self].
      refused:: (start >= 1 and: [start - 1 <= receiverSize]) ifTrue: [stop] ifFalse: [start].
      ^(outer Kernel ArgumentError value: refused) signal: keyword
          , ' '
          , start printString
          , ' to: '
          , stop printString
          , ' out of range: valid ranges lie within 1..'
          , receiverSize printString
          , ', an empty range ends just before it starts (size '
          , receiverSize printString
          , ')'.
    )

    /// Checks that a source of `sourceSize` elements holds `count` of them
    /// from `sourceStart` on.
    ///
    /// The texts are the leaf's, as `checkRangeFrom:to:keyword:ifNoInteger:`'s
    /// are, and so is the refusal of a start that is no Integer.
    ///
    /// @param sourceStart the source's position the first element is read
    /// from, any object; refused unless it is an Integer.
    /// @param count an Integer of at least 0, the number of elements read.
    /// @param sourceSize an Integer of at least 0, the source's size.
    /// @answers the receiver, when the source holds them.
    /// @signals ArgumentError an Array's `replaceFrom:to:with:startingAt:`
    /// leaf signals, carrying `sourceStart`, 'startingAt: … out of range:
    /// the source holds … elements, the range needs … from …', for a
    /// source that does not hold them.
    /// @signals ArgumentError the same leaf signals, carrying
    /// `sourceStart`, 'replaceFrom:to:with:startingAt: requires an Integer
    /// index, got …', for a `sourceStart` that is no Integer.
    private checkSourceStart: sourceStart count: count sourceSize: sourceSize = (
      sourceStart isKindOfInteger ifFalse: [
        ^(outer Kernel Array new: 0) replaceFrom: 1
            to: 0
            with: (outer Kernel Array new: 0)
            startingAt: sourceStart.
      ].
      (sourceStart >= 1 and: [sourceStart - 1 + count <= sourceSize]) ifTrue: [^self].
      ^(outer Kernel ArgumentError value: sourceStart) signal: 'startingAt: '
          , sourceStart printString
          , ' out of range: the source holds '
          , sourceSize printString
          , (sourceSize = 1 ifTrue: [' element'] ifFalse: [' elements'])
          , ', the range needs '
          , count printString
          , ' from '
          , sourceStart printString.
    )

    /// Concatenates the receiver's elements and those of `collection`. The
    /// receiver is unchanged.
    ///
    /// @param collection anything answering `size` and `at:` -- an Array,
    /// a List, a String, whose elements are its code points.
    /// @answers a new collection of the receiver's kind holding the
    /// receiver's elements followed by those of `collection`.
    /// @signals ArgumentError `at:put:` signals for an element of
    /// `collection` the receiver's kind cannot hold.
    public , collection = (
      |
        result = self newOfSize: self size + collection size.
      |
      result replaceFrom: 1 to: self size with: self startingAt: 1.
      result replaceFrom: self size + 1 to: result size with: collection startingAt: 1.
      ^result.
    )

    /// Copies the receiver with `element` added last. The receiver is
    /// unchanged.
    ///
    /// @param element an element the receiver's kind can hold.
    /// @answers a new collection of the receiver's kind one longer than
    /// the receiver, `element` last.
    /// @signals ArgumentError `at:put:` signals for an `element` the
    /// receiver's kind cannot hold.
    public copyWith: element = (
      |
        result = self copyWithSize: self size + 1.
      |
      result at: result size put: element.
      ^result.
    )

    /// Copies the receiver's first `newSize` elements, cut off when
    /// `newSize` is smaller than `size`, followed by the empty element of
    /// the receiver's kind -- nil for an Array -- when it is larger. The
    /// receiver is unchanged.
    ///
    /// @param newSize an Integer of at least 0.
    /// @answers a new collection of the receiver's kind of `newSize`
    /// elements.
    /// @signals ArgumentError `newOfSize:` signals for a `newSize` that is
    /// negative, no Integer or too large to allocate: for an Array, that
    /// of `Array new:`.
    public copyWithSize: newSize = (
      |
        result = self newOfSize: newSize.
        kept = newSize < self size ifTrue: [newSize] ifFalse: [self size].
      |
      result replaceFrom: 1 to: kept with: self startingAt: 1.
      ^result.
    )

    /// Transforms each element, in order, into a new Array: an Array
    /// whatever the receiver's kind, since `transform` may answer
    /// anything. The receiver is unchanged.
    ///
    /// @param transform a one-argument block.
    /// @answers a new Array of `transform`'s answer for each element, in
    /// order.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `transform` that does not
    /// take one argument, when the receiver is not empty.
    public collect: transform = (
      |
        result = outer Kernel Array new: self size.
      |
      1 to: self size do: [:index | result at: index put: (transform value: (self at: index))].
      ^result.
    )

    /// Selects the elements for which `predicate` answers true into a new
    /// collection of the receiver's kind. The receiver is unchanged.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers a new collection of the receiver's kind holding the
    /// elements for which `predicate` answers true, in order.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    public select: predicate = (
      |
        result = self newOfSize: self size.
        count ::= 0.
        element
      |
      1 to: self size do: [:index |
        element:: self at: index.
        (predicate value: element) ifTrue: [
          count:: count + 1.
          result at: count put: element.
        ].
      ].
      ^result copyFrom: 1 to: count.
    )

    /// Selects the elements for which `predicate` answers false into a
    /// new collection of the receiver's kind. The receiver is unchanged.
    ///
    /// @param predicate a one-argument block answering a Boolean.
    /// @answers a new collection of the receiver's kind holding the
    /// elements for which `predicate` answers false, in order.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a `predicate` that does not
    /// take one argument, when the receiver is not empty.
    public reject: predicate = (
      ^self select: [:element | (predicate value: element) not].
    )

    /// Sorts the elements in place, stably -- elements that may precede
    /// each other both ways keep their order.
    ///
    /// @param lessOrEqual a two-argument block answering whether its first
    /// argument may precede its second.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for a `lessOrEqual` that does not
    /// take two arguments, when the receiver holds at least two elements.
    /// @see `sortFrom:to:by:`.
    public sort: lessOrEqual = (
      ^self sortFrom: 1 to: self size by: lessOrEqual.
    )

    /// Sorts the elements from `start` to `stop` in place, stably, as
    /// `sort:` does; the rest stay where they are.
    ///
    /// A bottom-up merge sort over a copy of the range and a buffer of
    /// the same size, trading the two each pass: no recursion, so its
    /// depth does not grow with the range, and two collections of the
    /// receiver's kind the size of the range as extra memory. Taking from
    /// the left run while its element may precede the right run's keeps
    /// it stable.
    ///
    /// @param start a range's first position in the receiver, as for
    /// `copyFrom:to:`.
    /// @param stop a range's last position in the receiver, as for
    /// `copyFrom:to:`.
    /// @param lessOrEqual a two-argument block answering whether its first
    /// argument may precede its second.
    /// @answers the receiver.
    /// @signals ArgumentError of `copyFrom:to:` for a range the receiver
    /// does not hold or a bound that is no Integer.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for a `lessOrEqual` that does not
    /// take two arguments, when the range holds at least two elements.
    /// @see `sort:`.
    public sortFrom: start to: stop by: lessOrEqual = (
      |
        source ::= self copyFrom: start to: stop.
        target
        count = source size.
        width ::= 1.
        left
        swap
      |
      count < 2 ifTrue: [^self].
      target:: self newOfSize: count.
      [width < count] whileTrue: [
        left:: 1.
        [left <= count] whileTrue: [
          self merge: source into: target from: left width: width count: count by: lessOrEqual.
          left:: left + width + width.
        ].
        swap:: source.
        source:: target.
        target:: swap.
        width:: width + width.
      ].
      self replaceFrom: start to: stop with: source startingAt: 1.
    )

    /// Merges the sorted runs of `source` that start at `left` -- the
    /// first `width` elements long, the second the next `width`, each
    /// cut off at `count` -- into the same positions of `target`,
    /// taking from the first run while its element may precede the
    /// second's.
    ///
    /// @param source the collection the runs are read from with `at:`.
    /// @param target a collection of at least `count` elements, written
    /// with `at:put:` at the runs' positions only.
    /// @param left the position the first run starts at, an Integer from 1
    /// to `count`.
    /// @param width the length of a run that is not cut off, an Integer of
    /// at least 1.
    /// @param count the number of elements of `source` being sorted, an
    /// Integer; no run reaches past it.
    /// @param lessOrEqual as `sort:`'s.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for a `lessOrEqual` that does not
    /// take two arguments, when the second run is not empty.
    private merge: source into: target from: left width: width count: count by: lessOrEqual = (
      |
        middle ::= left + width - 1.
        right
        leftCursor ::= left.
        rightCursor
        targetCursor ::= left.
      |
      middle > count ifTrue: [middle:: count].
      right:: middle + width.
      right > count ifTrue: [right:: count].
      rightCursor:: middle + 1.
      [targetCursor <= right] whileTrue: [
        ((rightCursor > right) or: [
          (leftCursor <= middle) and: [
            lessOrEqual value: (source at: leftCursor) value: (source at: rightCursor).
          ].
        ]) ifTrue: [
          target at: targetCursor put: (source at: leftCursor).
          leftCursor:: leftCursor + 1.
        ] ifFalse: [
          target at: targetCursor put: (source at: rightCursor).
          rightCursor:: rightCursor + 1.
        ].
        targetCursor:: targetCursor + 1.
      ].
    )

    /// Copies the receiver's elements, in order, into an Array. The
    /// receiver is unchanged, and later changes to either do not reach
    /// the other.
    ///
    /// @answers a new Array of the receiver's elements.
    public asArray = (
      |
        result = outer Kernel Array new: self size.
      |
      1 to: self size do: [:index | result at: index put: (self at: index)].
      ^result.
    )
  )

  /// A fixed-size sequence of objects, indexed from 1, and a Collection:
  /// `Array new: 3`, or a literal such as `{1. 2}`. The sequence protocol
  /// comes from `IndexedCollection`, over the leaves here.
  ///
  /// A receiver holding no elements -- an instance of a program's subclass
  /// of `Array`, which gets no elements of its own -- makes every leaf here
  /// decline: `at:` and `at:put:` end in `doesNotUnderstand:`, a
  /// MessageNotUnderstood, and `do:`, `size` and a member whose sends reach
  /// them in the Error of Collection's `do:`'s `subclassResponsibility`.
  /// The Errors and answers each instance-side member below names are
  /// those of an instance of `Array` itself.
  public class Array = Collection <: IndexedCollection () (
    /// Identifies the receiver as an Array, without a class test.
    ///
    /// @answers true.
    public isKindOfArray = (
      ^true.
    )

    /// Evaluates `action` with each element in turn, from the first,
    /// reading each element only when it reaches it, so that a store
    /// ahead of the walk is seen.
    ///
    /// The size is read through its leaf, as ByteArray's `do:` reads its
    /// own and for the same reason: a receiver holding no elements -- an
    /// instance of a subclass -- goes on to Collection's `do:` rather
    /// than counting through `size`. The walk is a loop here rather than
    /// `to:do:`, which is a send and would put a second activation under
    /// every element.
    ///
    /// @param action a block of one argument, or anything understanding
    /// `value:`; sent `value:` with each element.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a block that does not take
    /// one argument, when the receiver is not empty.
    public do: action = (
      |
        count = vmMirror collectionSize: self ifFail: [^super do: action].
        index ::= 1.
      |
      [index <= count] whileTrue: [
        action value: (self at: index).
        index:: index + 1.
      ].
    )

    /// Stores `value` at `index`. A refused store leaves the element as it
    /// was.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value any object; the Array holds it from now on.
    /// @answers `value`.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at:put: requires an
    /// Integer index, got …', for an index that is no Integer.
    public at: index put: value = (
      ^vmMirror collection: self at: index put: value ifFail: [^super at: index put: value].
    )

    /// Counts the elements, a number fixed when the Array was made.
    ///
    /// @answers the number of elements, an Integer of at least 0.
    public size = (
      ^vmMirror collectionSize: self ifFail: [^super size].
    )

    /// Reads the element at `index`.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the element at `index`.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at: requires an Integer
    /// index, got …', for an index that is no Integer.
    public at: index = (
      ^vmMirror collection: self at: index ifFail: [^super at: index].
    )

    /// Converts the receiver to an Array, which it already is: an Array is
    /// its own Array.
    ///
    /// @answers the receiver itself.
    public asArray = (
      ^self.
    )

    /// Makes the new instance of the receiver's kind the sequence protocol
    /// builds its answers in: an Array.
    ///
    /// @param size an Integer of at least 0.
    /// @answers a new Array of `size` elements, each nil.
    /// @signals ArgumentError of `Array new:` for a `size` that is
    /// negative, no Integer or too large to allocate.
    protected newOfSize: size = (
      ^outer Kernel Array new: size.
    )

    /// Copies the elements from `start` to `stop`; empty when `stop` is
    /// `start - 1`. The receiver is unchanged.
    ///
    /// @param start an Integer with 1 <= start <= stop + 1.
    /// @param stop an Integer with start - 1 <= stop <= size.
    /// @answers a new Array of the elements from `start` to `stop`.
    /// @signals ArgumentError carrying the bound out of range, 'copyFrom: …
    /// to: … out of range: valid ranges lie within 1..size, an empty range
    /// ends just before it starts (size …)'.
    /// @signals ArgumentError carrying the first bound that is no Integer,
    /// 'copyFrom:to: requires an Integer index, got …'.
    public copyFrom: start to: stop = (
      ^vmMirror collection: self copyFrom: start to: stop ifFail: [^super copyFrom: start to: stop].
    )

    /// Stores the elements of `source` from `sourceStart` on into the
    /// receiver's positions `start` to `stop`. Correct when `source` is
    /// the receiver and the ranges overlap: every element is read before
    /// any is stored.
    ///
    /// The leaf takes an Array source; any other source falls to
    /// `IndexedCollection`'s, which copies it into an Array first.
    ///
    /// @param start a range's first position in the receiver, as for
    /// `copyFrom:to:`.
    /// @param stop a range's last position in the receiver, as for
    /// `copyFrom:to:`.
    /// @param source an Array, or anything answering `size` and `at:` -- a
    /// List, a String, whose elements are its code points.
    /// @param sourceStart an Integer with 1 <= sourceStart and
    /// sourceStart + (stop - start) <= source size.
    /// @answers the receiver.
    /// @signals ArgumentError `copyFrom:to:` signals, its text beginning
    /// 'replaceFrom: … to: …', for a range the receiver does not hold.
    /// @signals ArgumentError 'replaceFrom:to:with:startingAt: requires an
    /// Integer index, got …', carrying the first bound that is no Integer,
    /// or, for a range the receiver holds, a `sourceStart` that is none.
    /// @signals ArgumentError carrying `sourceStart`, 'startingAt: … out of
    /// range: the source holds … elements, the range needs … from …', for
    /// a source too short.
    public replaceFrom: start to: stop with: source startingAt: sourceStart = (
      ^vmMirror collection: self
          replaceFrom: start
          to: stop
          with: source
          startingAt: sourceStart
          ifFail: [^super replaceFrom: start to: stop with: source startingAt: sourceStart].
    )
  ) : (
    /// Makes an Array of `size` elements, each nil.
    ///
    /// A sized array of nils, which `List` grows into and the handler
    /// search fills. The leaf answers only for `Array` itself, the only
    /// subject a flat class side is sent from; any other falls to `super`,
    /// where nothing understands `new:`, so the send signals rather than
    /// answering nil.
    ///
    /// @param size an Integer, at least 0.
    /// @answers a new Array of `size` elements, each nil.
    /// @signals ArgumentError carrying `size`, 'new: requires an Integer
    /// size, got …', for a size that is no Integer.
    /// @signals ArgumentError carrying `size`, 'new: requires a size of at
    /// least 0, got …', for a negative one.
    /// @signals ArgumentError carrying `size`, 'new: cannot allocate an
    /// Array of … elements', for one too large to allocate.
    public new: size = (
      ^vmMirror arrayClass: self new: size ifFail: [^super new: size].
    )

    /// Makes an Array of `collection`'s elements, in its `do:` order.
    ///
    /// @param collection a Collection, or anything answering `size` and
    /// `do:` -- a String, whose elements are its code points.
    /// @answers a new Array of `collection`'s elements, in its `do:`
    /// order.
    public withAll: collection = (
      |
        result = self new: collection size.
        index ::= 0.
      |
      collection do: [:element |
        index:: index + 1.
        result at: index put: element.
      ].
      ^result.
    )
  )

  /// A fixed-size sequence of bytes, each an Integer from 0 to 255,
  /// indexed from 1, and a Collection: `ByteArray new: 4` makes one of
  /// zeros. The sequence protocol comes from `IndexedCollection`, over
  /// the leaves here. No value: `=` and `hash` are identity, since a hash
  /// of the bytes would change under a Map's key as they are stored.
  ///
  /// A receiver holding no bytes -- an instance of a program's subclass of
  /// `ByteArray`, which gets no bytes of its own -- makes every leaf here
  /// decline: `at:`, `at:put:`, `at:putCodePoint:`, `startsWith:` and
  /// `endsWith:` end in `doesNotUnderstand:`, a MessageNotUnderstood, and
  /// `do:`, `size` and a member whose sends reach them in the Error of
  /// Collection's `do:`'s `subclassResponsibility`. The Errors and answers
  /// each instance-side member below names are those of an instance of
  /// `ByteArray` itself.
  public class ByteArray = Collection <: IndexedCollection () (
    /// Identifies the receiver as a ByteArray, without a class test.
    ///
    /// @answers true.
    public isKindOfByteArray = (
      ^true.
    )

    /// Evaluates `action` with each byte in turn, from the first, reading
    /// each byte only when it reaches it, so that a store ahead of the
    /// walk is seen.
    ///
    /// The size is read through its leaf rather than `self size`, which
    /// for a receiver holding no bytes -- an instance of a subclass --
    /// would reach Collection's `size`, which counts through `do:` and
    /// would come back here; the declining leaf sends such a receiver on
    /// to Collection's `do:` instead.
    ///
    /// @param action a block of one argument, or anything understanding
    /// `value:`; sent `value:` with each byte.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a block that does not take
    /// one argument, when the receiver is not empty.
    public do: action = (
      |
        count = vmMirror byteArraySize: self ifFail: [^super do: action].
      |
      1 to: count do: [:index | action value: (self at: index)].
    )

    /// Stores `value` at `index`. A refused store leaves the byte as it
    /// was.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value an Integer from 0 to 255.
    /// @answers `value`.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at:put: requires an
    /// Integer index, got …', for an index that is no Integer.
    /// @signals ArgumentError carrying `value`, 'at:put: requires an
    /// Integer from 0 to 255, got …', for a value outside 0 to 255 or no
    /// Integer, at an `index` from 1 to `size`.
    public at: index put: value = (
      ^vmMirror byteArray: self at: index put: value ifFail: [^super at: index put: value].
    )

    /// Counts the bytes, a number fixed when the ByteArray was made.
    ///
    /// @answers the number of bytes, an Integer of at least 0.
    public size = (
      ^vmMirror byteArraySize: self ifFail: [^super size].
    )

    /// Reads the byte at `index`.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the byte at `index`, an Integer from 0 to 255.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at: requires an Integer
    /// index, got …', for an index that is no Integer.
    public at: index = (
      ^vmMirror byteArray: self at: index ifFail: [^super at: index].
    )

    /// Stores the UTF-8 bytes of the code point `codePoint` from `index`
    /// on. A refused store leaves every byte as it was.
    ///
    /// `StringBuilder>>addCodePoint:` writes through it.
    ///
    /// @param index an Integer from 1 to `size`, with room from it to the
    /// end for every byte of `codePoint`.
    /// @param codePoint an Integer from 0 to 1114111 outside 55296 to
    /// 57343.
    /// @answers how many bytes it stored, an Integer from 1 to 4.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an index outside 1 to
    /// `size`, a LargeInteger included, or one whose last byte would pass
    /// the end, naming that byte's index.
    /// @signals ArgumentError carrying `index`, 'at:putCodePoint: requires
    /// an Integer index, got …', for an index that is no Integer.
    /// @signals ArgumentError carrying `codePoint`, 'at:putCodePoint:
    /// requires a Unicode scalar value, got …', for any other code point.
    public at: index putCodePoint: codePoint = (
      ^vmMirror byteArray: self at: index putCodePoint: codePoint ifFail: [
        ^super at: index putCodePoint: codePoint.
      ].
    )

    /// Converts the receiver to a ByteArray, which it already is: a
    /// ByteArray is its own ByteArray.
    ///
    /// @answers the receiver itself.
    public asByteArray = (
      ^self.
    )

    /// Makes the new instance of the receiver's kind the sequence protocol
    /// builds its answers in: a ByteArray.
    ///
    /// @param size an Integer of at least 0.
    /// @answers a new ByteArray of `size` bytes, each 0.
    /// @signals ArgumentError of `ByteArray new:` for a `size` that is
    /// negative, no Integer or too large to allocate.
    protected newOfSize: size = (
      ^outer Kernel ByteArray new: size.
    )

    /// Copies the bytes from `start` to `stop`; empty when `stop` is
    /// `start - 1`. The receiver is unchanged.
    ///
    /// @param start an Integer with 1 <= start <= stop + 1.
    /// @param stop an Integer with start - 1 <= stop <= size.
    /// @answers a new ByteArray of the bytes from `start` to `stop`.
    /// @signals ArgumentError carrying the bound out of range, 'copyFrom: …
    /// to: … out of range: valid ranges lie within 1..size, an empty range
    /// ends just before it starts (size …)'.
    /// @signals ArgumentError carrying the first bound that is no Integer,
    /// 'copyFrom:to: requires an Integer index, got …'.
    public copyFrom: start to: stop = (
      ^vmMirror byteArray: self copyFrom: start to: stop ifFail: [^super copyFrom: start to: stop].
    )

    /// Stores the bytes of `source` from `sourceStart` on into the
    /// receiver's positions `start` to `stop`. Correct when `source` is
    /// the receiver and the ranges overlap, in either direction.
    ///
    /// The leaf takes a ByteArray or a String source; any other source
    /// falls to `IndexedCollection`'s, which copies it into an Array
    /// first and then stores its elements one by one, so an element
    /// `at:put:` refuses leaves the bytes before it already stored.
    ///
    /// @param start a range's first position in the receiver, as for
    /// `copyFrom:to:`.
    /// @param stop a range's last position in the receiver, as for
    /// `copyFrom:to:`.
    /// @param source a ByteArray; a String, which counts as its UTF-8
    /// bytes, so that `sourceStart` counts bytes, not code points; or
    /// anything answering `size` and `at:` with Integers from 0 to 255.
    /// @param sourceStart an Integer with 1 <= sourceStart and
    /// sourceStart + (stop - start) <= the source's size in bytes.
    /// @answers the receiver.
    /// @signals ArgumentError, before it stores any byte, the one
    /// `copyFrom:to:` signals, its text beginning 'replaceFrom: … to: …',
    /// for a range the receiver does not hold.
    /// @signals ArgumentError, before it stores any byte,
    /// 'replaceFrom:to:with:startingAt: requires an Integer index, got …',
    /// carrying the first bound that is no Integer, or, for a range the
    /// receiver holds, a `sourceStart` that is none.
    /// @signals ArgumentError, before it stores any byte, carrying
    /// `sourceStart`, 'startingAt: … out of range: the source holds …
    /// elements, the range needs … from …', for a source too short.
    /// @signals ArgumentError `at:put:` signals for an element that is no
    /// byte, from a source that is neither a ByteArray nor a String, after
    /// those checks.
    public replaceFrom: start to: stop with: source startingAt: sourceStart = (
      ^vmMirror byteArray: self
          replaceFrom: start
          to: stop
          with: source
          startingAt: sourceStart
          ifFail: [^super replaceFrom: start to: stop with: source startingAt: sourceStart].
    )

    /// Concatenates the receiver's bytes and those of `collection`. The
    /// receiver is unchanged.
    ///
    /// @param collection a ByteArray; a String, which counts as its UTF-8
    /// bytes; or anything answering `size` and `at:` with Integers from 0
    /// to 255.
    /// @answers a new ByteArray of the receiver's bytes followed by those
    /// of `collection`.
    /// @signals ArgumentError carrying `collection`, ', cannot allocate a
    /// ByteArray of … bytes', for a result too large to allocate, when
    /// `collection` is a ByteArray or a String.
    /// @signals ArgumentError carrying the size, 'new: cannot allocate a
    /// ByteArray of … bytes', `ByteArray new:`'s, for a result too large
    /// to allocate, for any other `collection`.
    /// @signals ArgumentError `at:put:` signals for an element that is no
    /// byte, for any other `collection`.
    public , collection = (
      ^vmMirror byteArray: self concatenate: collection ifFail: [^super , collection].
    )

    /// Finds the first occurrence of `element`:
    /// `indexOf: element startingAt: 1`.
    ///
    /// @param element as for `indexOf:startingAt:`.
    /// @answers the index of the first occurrence of `element`, or 0.
    /// @see `indexOf:startingAt:`.
    public indexOf: element = (
      ^self indexOf: element startingAt: 1.
    )

    /// Finds the first occurrence of `element` that starts at or after
    /// `start`.
    ///
    /// @param element an Integer, looked for as one byte -- one outside 0
    /// to 255 is never found; a ByteArray, or a String, which counts as
    /// its UTF-8 bytes, looked for as a run of bytes, an empty one found at
    /// `start`; or any other object, looked for as an element, each byte
    /// from `start` on sent `=` with it.
    /// @param start an Integer from 1 to `size + 1`.
    /// @answers the index at which that occurrence begins, or 0 when there
    /// is none.
    /// @signals ArgumentError carrying `start`, 'indexOf:startingAt: … out
    /// of range: valid starts are 1..… (size …)', for a `start` outside 1
    /// to `size + 1`, a LargeInteger included.
    /// @signals ArgumentError carrying `start`, 'indexOf:startingAt:
    /// requires an Integer index, got …', for a `start` that is no
    /// Integer.
    public indexOf: element startingAt: start = (
      ^vmMirror byteArray: self indexOf: element startingAt: start ifFail: [
        start to: self size do: [:index | (self at: index) = element ifTrue: [^index]].
        0.
      ].
    )

    /// Finds the last occurrence of `element`:
    /// `lastIndexOf: element startingAt: size + 1`.
    ///
    /// @param element as for `lastIndexOf:startingAt:`.
    /// @answers the index of the last occurrence of `element`, or 0.
    /// @see `lastIndexOf:startingAt:`.
    public lastIndexOf: element = (
      ^self lastIndexOf: element startingAt: self size + 1.
    )

    /// Finds the last occurrence of `element` that starts at or before
    /// `start`.
    ///
    /// @param element as for `indexOf:startingAt:`; an empty run of bytes
    /// is found at `start`.
    /// @param start an Integer from 1 to `size + 1`.
    /// @answers the index at which that occurrence begins, or 0 when there
    /// is none.
    /// @signals ArgumentError `indexOf:startingAt:` signals, for the same
    /// `start`, its text naming 'lastIndexOf:startingAt:'.
    /// @see `indexOf:startingAt:`.
    public lastIndexOf: element startingAt: start = (
      ^vmMirror byteArray: self lastIndexOf: element startingAt: start ifFail: [
        (start min: self size) to: 1 by: -1 do: [:index |
          (self at: index) = element ifTrue: [^index].
        ].
        0.
      ].
    )

    /// Tells whether the receiver begins with `prefix`; true for an empty
    /// ByteArray or String.
    ///
    /// @param prefix an Integer, compared with the first byte; or a
    /// ByteArray, or a String, which counts as its UTF-8 bytes, compared
    /// with the first bytes.
    /// @answers whether the receiver begins with `prefix`, a Boolean.
    /// @signals ArgumentError carrying `prefix`, 'startsWith: requires an
    /// Integer, a ByteArray or a String, got …', for any other `prefix`.
    public startsWith: prefix = (
      ^vmMirror byteArray: self startsWith: prefix ifFail: [^super startsWith: prefix].
    )

    /// Tells whether the receiver ends with `suffix`; true for an empty
    /// ByteArray or String.
    ///
    /// @param suffix an Integer, compared with the last byte; or a
    /// ByteArray, or a String, which counts as its UTF-8 bytes, compared
    /// with the last bytes.
    /// @answers whether the receiver ends with `suffix`, a Boolean.
    /// @signals ArgumentError carrying `suffix`, 'endsWith: requires an
    /// Integer, a ByteArray or a String, got …', for any other `suffix`.
    public endsWith: suffix = (
      ^vmMirror byteArray: self endsWith: suffix ifFail: [^super endsWith: suffix].
    )
  ) : (
    /// Makes a ByteArray of `size` bytes, each 0.
    ///
    /// The leaf answers only for `ByteArray` itself, the only subject a
    /// flat class side is sent from; any other falls to `super`, where
    /// nothing understands `new:`, so the send signals rather than
    /// answering nil.
    ///
    /// @param size an Integer, at least 0.
    /// @answers a new ByteArray of `size` bytes, each 0.
    /// @signals ArgumentError carrying `size`, 'new: requires an Integer
    /// size, got …', for a size that is no Integer.
    /// @signals ArgumentError carrying `size`, 'new: requires a size of at
    /// least 0, got …', for a negative one.
    /// @signals ArgumentError carrying `size`, 'new: cannot allocate a
    /// ByteArray of … bytes', for one too large to allocate.
    public new: size = (
      ^vmMirror byteArrayClass: self new: size ifFail: [^super new: size].
    )

    /// Makes a ByteArray of `collection`'s elements: a copy of a
    /// ByteArray, a String's UTF-8 bytes (`asUtf8`), and otherwise the
    /// elements in `collection`'s `do:` order.
    ///
    /// Each element is checked before it is stored, so that the error
    /// names the message the program sent rather than `at:put:`.
    ///
    /// @param collection a ByteArray, a String, or anything answering
    /// `size` and `do:` whose elements are Integers from 0 to 255 -- an
    /// Array, a List.
    /// @answers a new ByteArray of `collection`'s elements.
    /// @signals ArgumentError carrying the first element that is no byte,
    /// 'withAll: requires an Integer from 0 to 255, got …' and its
    /// `printString`.
    public withAll: collection = (
      |
        result
        index ::= 0.
      |
      collection isKindOfByteArray ifTrue: [^collection copyFrom: 1 to: collection size].
      collection isKindOfString ifTrue: [^collection asUtf8].
      result:: self new: collection size.
      collection do: [:element |
        (element isKindOfInteger and: [element >= 0 and: [element <= 255]]) ifFalse: [
          ^(outer
              Kernel
              ArgumentError value: element) signal: 'withAll: requires an Integer from 0 to 255, got '
              , element printString.
        ].
        index:: index + 1.
        result at: index put: element.
      ].
      ^result.
    )
  )

  /// A fixed-size sequence whose slots hold their objects weakly, indexed
  /// from 1, and a Collection: `WeakArray new: 3` makes one of nils. A
  /// slot holds any object, a value included, without keeping it alive:
  /// once nothing but weak slots reaches the object, a collection sets
  /// every slot holding it to nil. An immediate -- an Integer that fits a
  /// SmallInteger, nil, true, false -- is never collected, so a slot
  /// holding one keeps it. No value: `=` and `hash` are identity.
  ///
  /// Make one with the class side's `new:`, never with the factory
  /// `withoutSlots`. The factory exists only so that the class's factory
  /// is not `new`, which keeps `WeakArray new` not understood: there is no
  /// WeakArray without a size.
  ///
  /// An instance of a subclass holds no weak slots, and the one
  /// `withoutSlots` makes no slots at all: every leaf here declines on
  /// them, so every member declared here but `isKindOfArray` and
  /// `isKindOfWeakArray` signals -- `at:` and `at:put:` a
  /// MessageNotUnderstood, `size` and the members built on it the Error
  /// of Collection's `subclassResponsibility`. The Errors and answers each
  /// instance-side member below names are those of a WeakArray the class
  /// side's `new:` made.
  ///
  /// @factory makes an instance with no slots at all, not even zero weak
  /// ones, which no member declared here but `isKindOfArray` and
  /// `isKindOfWeakArray` answers for.
  public class WeakArray withoutSlots = Collection () (
    /// Identifies the receiver as a WeakArray, without a class test.
    ///
    /// @answers true.
    public isKindOfWeakArray = (
      ^true.
    )

    /// Identifies the receiver as one answering the sequence protocol of
    /// an Array -- `at:`, `at:put:`, `size`, `do:` -- that code asking
    /// this sends, as an Array does.
    ///
    /// @answers true.
    public isKindOfArray = (
      ^true.
    )

    /// Reads the object in the slot at `index`.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @answers the object in the slot at `index`, or nil when the slot
    /// holds none or the collector has reclaimed its object.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at: requires an Integer
    /// index, got …', for an index that is no Integer.
    public at: index = (
      ^vmMirror weakArray: self at: index ifFail: [^super at: index].
    )

    /// Stores `value` in the slot at `index`. A refused store leaves the
    /// slot as it was.
    ///
    /// @param index an Integer from 1 to `size`.
    /// @param value any object; the slot holds it until a collection finds
    /// nothing but weak slots reaching it.
    /// @answers `value`.
    /// @signals ArgumentError carrying `index`, 'index … out of range:
    /// valid indices are 1..size (size …)', for an Integer outside 1 to
    /// `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `index`, 'at:put: requires an
    /// Integer index, got …', for an index that is no Integer.
    public at: index put: value = (
      ^vmMirror weakArray: self at: index put: value ifFail: [^super at: index put: value].
    )

    /// Counts the slots, a number fixed when the WeakArray was made; a
    /// slot the collector cleared still counts.
    ///
    /// @answers the number of slots, an Integer of at least 0.
    public size = (
      ^vmMirror weakArraySize: self ifFail: [^super size].
    )

    /// Tells whether the receiver has no slot.
    ///
    /// @answers whether `size` is 0, a Boolean.
    public isEmpty = (
      ^self size = 0.
    )

    /// Evaluates `action` with the object in each slot in turn, from the
    /// first, nil for a slot that holds none, reading each slot only when
    /// it reaches it.
    ///
    /// The size is read through its leaf rather than `self size`, which
    /// for a receiver holding no slots -- an instance of a subclass --
    /// would reach Collection's `size`, which counts through `do:` and
    /// would come back here; the declining leaf sends such a receiver on
    /// to Collection's `do:` instead.
    ///
    /// @param action a block of one argument, or anything understanding
    /// `value:`; sent `value:` with each slot's object.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 1', for a block that does not take
    /// one argument, when the receiver is not empty.
    public do: action = (
      |
        count = vmMirror weakArraySize: self ifFail: [^super do: action].
      |
      1 to: count do: [:index | action value: (self at: index)].
    )

    /// Evaluates `action` with each index and the object in the slot
    /// there, from the first, nil for a slot that holds none, reading
    /// each slot only when it reaches it.
    ///
    /// @param action a two-argument block, given the index and the
    /// object.
    /// @answers the receiver.
    /// @signals ArgumentError carrying the block, 'wrong number of block
    /// arguments: block takes …, got 2', for a block that does not take
    /// two arguments, when the receiver is not empty.
    public keysAndValuesDo: action = (
      1 to: self size do: [:index | action value: index value: (self at: index)].
    )

    /// Copies the receiver with `element` added last. The receiver is
    /// unchanged.
    ///
    /// @param element any object; the new WeakArray holds it weakly.
    /// @answers a new WeakArray one slot longer than the receiver, holding
    /// the receiver's objects in order and `element` last.
    public copyWith: element = (
      |
        result = outer Kernel WeakArray new: self size + 1.
      |
      1 to: self size do: [:index | result at: index put: (self at: index)].
      result at: result size put: element.
      ^result.
    )
  ) : (
    /// Makes a WeakArray of `size` slots, each nil.
    ///
    /// The leaf answers only for `WeakArray` itself, which is the only
    /// subject a flat class side is sent from; any other falls to `super`,
    /// where nothing understands `new:`, so the send signals rather than
    /// answering an object that is no WeakArray.
    ///
    /// @param size an Integer, at least 0.
    /// @answers a new WeakArray of `size` slots, each nil.
    /// @signals ArgumentError carrying `size`, 'new: requires an Integer
    /// size, got …', for a size that is no Integer.
    /// @signals ArgumentError carrying `size`, 'new: requires a size of at
    /// least 0, got …', for a negative one.
    /// @signals ArgumentError carrying `size`, 'new: cannot allocate a
    /// WeakArray of … elements', for one too large to allocate.
    public new: size = (
      ^vmMirror weakArrayClass: self new: size ifFail: [^super new: size].
    )
  )

  /// A key, a value and a finalizer, of which only the key is held for
  /// its own sake: while something other than an ephemeron reaches the
  /// key, the value and the finalizer are kept alive through it, and once
  /// nothing but ephemerons reaches the key, a collection sets all three
  /// to nil. `Ephemeron new` makes one whose three are nil. No value: `=`
  /// and `hash` are identity.
  ///
  /// The finalizer is held, never run. A key that is nil, the state an
  /// ephemeron is made in and the one a collected key leaves it in, keeps
  /// the value and the finalizer alive as any slot does.
  ///
  /// A subclass inherits the protocol but not the property: its instance
  /// is an ordinary object whose three slots hold strongly.
  ///
  /// The accessors reach the three through the mirror, which reads the
  /// fields of an Ephemeron's own format and the slots of a subclass's
  /// instance alike. No method names the slots: they only give an
  /// Ephemeron its three fields and lay out a subclass's instance. An
  /// Ephemeron's fields are no instance slots, so that an ordinary
  /// object's slot pays nothing for their format; the slots therefore
  /// have no initializer, which would store into one, and each starts
  /// nil.
  public class Ephemeron = Object (
    |
      /// The key, nil or an object that is not a value; the collectors
      /// read it as the first field, so it is declared first.
      private storedKey.
      /// The value, any object, reached through a live key; the
      /// accessors read it as the second field, so it is declared second.
      private storedValue.
      /// The finalizer, any object, reached through a live key; held,
      /// never run.
      private storedFinalizer.
    |
  ) (
    /// Reads the key.
    ///
    /// @answers the key, or nil when the receiver has none: it was never
    /// given one, was given nil, or a collection found nothing but
    /// ephemerons reaching it.
    public key = (
      ^vmMirror ephemeronKey: self ifFail: [^super key].
    )

    /// Makes `newKey` the key. A refused key leaves the key as it was.
    ///
    /// The value leaf answers a Boolean for any object but two: it
    /// declines for a future it would answer false to, so that the send
    /// asks again of the value the future stands for before the failure
    /// block runs, and it
    /// refuses an instance of a value class still under construction,
    /// since that instance becomes a value once its factory returns. The
    /// refusal of a value is signalled here rather
    /// than by the leaf that stores the key, since its text ends in the
    /// key's printString, which only Newspeak computes.
    ///
    /// @param newKey nil, or an object that is not a value (§3.1.1). A
    /// value has no identity -- an equal one can always be made again --
    /// so whether an entry under it vanished would depend on when the
    /// collector ran.
    /// @answers the receiver.
    /// @signals ArgumentError carrying `newKey`, 'key: requires an object
    /// that is not a value, got …' followed by its printString, for a
    /// value other than nil -- an Integer, a Float, true, false, a String,
    /// an instance of a value class, a future whose value is one.
    /// @signals Error 'cannot tell whether an instance of … is a value: it
    /// is still under construction, and an instance of a value class is a
    /// value only once its factory has returned', naming the class, while
    /// `newKey` is an instance of a value class under construction.
    public key: newKey = (
      newKey isNil ifFalse: [
        (vmMirror objectIsValue: newKey ifFail: [false]) ifTrue: [
          ^(outer
              Kernel
              ArgumentError value: newKey) signal: 'key: requires an object that is not a value, got '
              , newKey printString.
        ].
      ].
      ^vmMirror ephemeron: self key: newKey ifFail: [^super key: newKey].
    )

    /// Reads the value.
    ///
    /// @answers the value, nil until one is given or once a collection has
    /// cleared the receiver.
    public value = (
      ^vmMirror ephemeronValue: self ifFail: [^super value].
    )

    /// Makes `newValue` the value.
    ///
    /// @param newValue any object; kept alive while the key is.
    /// @answers the receiver.
    public value: newValue = (
      ^vmMirror ephemeron: self value: newValue ifFail: [^super value: newValue].
    )

    /// Reads the finalizer.
    ///
    /// @answers the finalizer, nil until one is given or once a collection
    /// has cleared the receiver.
    public finalizer = (
      ^vmMirror ephemeronFinalizer: self ifFail: [^super finalizer].
    )

    /// Makes `newFinalizer` the finalizer. The finalizer is held while the
    /// key lives, and never run.
    ///
    /// @param newFinalizer any object.
    /// @answers the receiver.
    public finalizer: newFinalizer = (
      ^vmMirror ephemeron: self finalizer: newFinalizer ifFail: [^super finalizer: newFinalizer].
    )

    /// Identifies the receiver as an Ephemeron, without a class test.
    ///
    /// @answers true.
    public isKindOfEphemeron = (
      ^true.
    )
  )

  /// A map from keys to values that keeps neither alive for its own sake:
  /// an entry stays while something other than an ephemeron reaches its
  /// key, and once nothing does, a collection removes it, its value with
  /// it. `WeakMap new` makes an empty one. Keys are compared by `==` and
  /// hashed by `identityHash`; a key is an object that is not a value
  /// (§3.1.1). There is no enumeration and no `size`, since what the map
  /// holds changes with every collection. No value: `=` and `hash` are
  /// identity.
  ///
  /// Each entry is an Ephemeron in a table probed linearly from its key's
  /// identity hash. A removed or collected entry stays in the table with
  /// a nil key, so that the chains running through it stay unbroken, until
  /// `at:put:` reuses it or the table is rebuilt.
  public class WeakMap = Object (
    |
      /// The entries: nil where no entry was ever made, otherwise an
      /// Ephemeron, whose key is nil once its entry was removed or
      /// collected. Its size is a power of two, so that a hash is masked
      /// onto it, and it is never full, so that every chain ends at a nil.
      /// It starts large, since a map is expected to serve a whole module.
      private table ::= outer Kernel Array new: 256.
      /// How many slots of `table` hold an Ephemeron, live or dead: once it
      /// passes three quarters of them, `at:put:` rebuilds the table.
      private used ::= 0.
    |
  ) (
    /// Identifies the receiver as a WeakMap, without a class test.
    ///
    /// @answers true.
    public isKindOfWeakMap = (
      ^true.
    )

    /// Looks up the value stored under `key`.
    ///
    /// @param key any object; nil and a value are never found.
    /// @answers the value stored under `key`, or nil when the receiver
    /// holds no entry under it.
    public at: key = (
      |
        entry = self entryAt: key.
      |
      entry isNil ifTrue: [^nil].
      ^entry value.
    )

    /// Tells whether the receiver holds an entry under `key`.
    ///
    /// @param key any object; nil and a value are never found.
    /// @answers whether the receiver holds an entry under `key`, a
    /// Boolean.
    public includesKey: key = (
      ^(self entryAt: key) notNil.
    )

    /// Removes the entry under `key`, when the receiver holds one.
    ///
    /// @param key any object; nil and a value are never found.
    /// @answers the removed entry's value, or nil when the receiver holds
    /// no entry under `key`.
    public removeKey: key = (
      |
        entry = self entryAt: key.
        removed
      |
      entry isNil ifTrue: [^nil].
      removed:: entry value.
      entry
          key: nil;
          value: nil.
      ^removed.
    )

    /// Stores `value` under `key`, replacing the value stored under `key`
    /// before, if any. A refused key leaves the receiver as it was.
    ///
    /// The whole chain is searched for `key` before a dead entry passed on
    /// the way is reused: `key` may sit further along than an entry
    /// removed since it was stored, and reusing that one would leave two
    /// entries under `key`, the older one found first once the newer is
    /// removed.
    ///
    /// @param key an object that is not a value (§3.1.1). A value has no
    /// identity -- an equal one can always be made again -- so whether an
    /// entry under it vanished would depend on when the collector ran.
    /// @param value any object; kept alive while `key` is.
    /// @answers `value`.
    /// @signals ArgumentError carrying `key`, 'at:put: requires a key that
    /// is not a value, got …' followed by its printString, for nil or a
    /// value -- an Integer, a Float, true, false, a String, an instance of
    /// a value class, a future whose value is one.
    /// @signals Error 'cannot tell whether an instance of … is a value: it
    /// is still under construction, and an instance of a value class is a
    /// value only once its factory has returned', naming the class, while
    /// `key` is an instance of a value class under construction.
    public at: key put: value = (
      |
        mask
        index
        entry
        reusable
      |
      (key isNil or: [vmMirror objectIsValue: key ifFail: [false]]) ifTrue: [
        ^(outer
            Kernel
            ArgumentError value: key) signal: 'at:put: requires a key that is not a value, got '
            , key printString.
      ].
      mask:: table size - 1.
      index:: 1 + (key identityHash bitAnd: mask).
      entry:: table at: index.
      [entry isNil] whileFalse: [
        |
          entryKey = entry key.
        |
        entryKey == key ifTrue: [
          entry value: value.
          ^value.
        ].
        (entryKey isNil and: [reusable isNil]) ifTrue: [reusable:: entry].
        index:: 1 + (index bitAnd: mask).
        entry:: table at: index.
      ].
      reusable isNil ifFalse: [
        reusable
            key: key;
            value: value.
        ^value.
      ].
      entry:: outer Kernel Ephemeron new.
      entry
          key: key;
          value: value.
      table at: index put: entry.
      used:: used + 1.
      used > (table size // 4 * 3) ifTrue: [self rehash].
      ^value.
    )

    /// Finds the entry whose key is `key`, walking the chain from the
    /// slot its identity hash names until that entry or a nil slot.
    ///
    /// @param key any object; nil, the key every dead entry has, answers
    /// nil.
    /// @answers the entry whose key is `key`, an Ephemeron, or nil when
    /// there is none.
    private entryAt: key = (
      |
        mask
        index
        entry
      |
      key isNil ifTrue: [^nil].
      mask:: table size - 1.
      index:: 1 + (key identityHash bitAnd: mask).
      entry:: table at: index.
      [entry isNil] whileFalse: [
        entry key == key ifTrue: [^entry].
        index:: 1 + (index bitAnd: mask).
        entry:: table at: index.
      ].
      ^nil.
    )

    /// Rebuilds `table` from its live entries, dropping the dead ones:
    /// twice as large when more than half of it holds live entries, the
    /// same size otherwise, so that a map whose keys keep dying does not
    /// grow without end. Sets `used` to the number of entries moved.
    ///
    /// The entries are counted again as they are moved rather than taken
    /// from the first count, since a collection can kill an entry between
    /// the two passes; each key is read once and held while its entry is
    /// placed, so that one cannot die halfway.
    ///
    /// @answers the receiver.
    private rehash = (
      |
        oldTable = table.
        live ::= 0.
        capacity ::= oldTable size.
        newTable
        mask
        moved ::= 0.
      |
      1 to: oldTable size do: [:oldIndex |
        |
          entry = oldTable at: oldIndex.
        |
        (entry notNil and: [entry key notNil]) ifTrue: [live:: live + 1].
      ].
      live > (capacity // 2) ifTrue: [capacity:: capacity * 2].
      newTable:: outer Kernel Array new: capacity.
      mask:: capacity - 1.
      1 to: oldTable size do: [:oldIndex |
        |
          entry = oldTable at: oldIndex.
          entryKey = entry isNil ifTrue: [nil] ifFalse: [entry key].
          index ::= 0.
        |
        entryKey isNil ifFalse: [
          index:: 1 + (entryKey identityHash bitAnd: mask).
          [(newTable at: index) isNil] whileFalse: [index:: 1 + (index bitAnd: mask)].
          newTable at: index put: entry.
          moved:: moved + 1.
        ].
      ].
      table:: newTable.
      used:: moved.
    )
  )

  /// A view of a ByteArray that reads and writes numbers of one to eight
  /// bytes in a byte order given when it is made, at any byte position:
  /// `DataView on: bytes byteOrder: #bigEndian` and `DataView new: size
  /// byteOrder: #littleEndian` answer an instance of a subclass fixed to
  /// that order, so that no access branches on it. A program makes one with
  /// those two class-side messages and not with `over:`, whose view has no
  /// byte order to read the wider numbers in. The view holds the ByteArray
  /// itself and not a copy, so views over one ByteArray, typed arrays among
  /// them, see each other's writes.
  ///
  /// The accessors are `int8At:` and `uint8At:` -- a single byte has no
  /// order -- here, and `int16At:`, `uint16At:`, `int32At:`, `uint32At:`,
  /// `int64At:`, `uint64At:`, `float32At:` and `float64At:` in each
  /// subclass, every one with a `put:` form. A position counts from 1, as
  /// `at:` does, and need not be a multiple of the width: `uint32At: 3`
  /// reads the bytes 3 to 6. The values follow the typed arrays' rules: an
  /// Integer is checked against its width's range, a float accessor takes
  /// any Number, and `put:` answers the value given. No value: `=` and
  /// `hash` are identity.
  ///
  /// What a view is made over is checked with `isKindOfByteArray`, so an
  /// object that is no ByteArray yet answers true to it -- an instance of a
  /// program's class that declares it, or of a program's subclass of
  /// `ByteArray`, which holds no bytes -- is accepted: every accessor of
  /// such a view then signals the ArgumentError of `noByteArray:`, and
  /// `size` answers, or signals, what the object's own `size` does. The
  /// other answers and Errors each member below names are those of a view
  /// over a ByteArray.
  ///
  /// @factory makes a view over `aByteArray`, which it keeps as `bytes`,
  /// itself and not a copy, once `viewable:` has checked it. The view has
  /// no byte order: only the accessors of single bytes read and write.
  /// @param aByteArray the ByteArray to view.
  /// @signals ArgumentError carrying `aByteArray`, 'over: requires a
  /// ByteArray, got …' and its `printString`, for anything that answers
  /// false to `isKindOfByteArray`, as everything but a ByteArray does unless
  /// its class declares otherwise.
  /// @see `viewable:`.
  public class DataView over: aByteArray = Object (
    |
      /// The ByteArray the view reads and writes: the one it was made over,
      /// never a copy.
      public bytes = viewable: aByteArray.
    |
  ) (
    /// Identifies the receiver as a DataView, without a class test.
    ///
    /// @answers true.
    public isKindOfDataView = (
      ^true.
    )

    /// Says the byte order the view reads and writes in; the two
    /// subclasses define it.
    ///
    /// @answers nothing here, where it never returns; a subclass's own
    /// answers the Symbol #littleEndian or #bigEndian.
    /// @signals Error of `subclassResponsibility`, here,
    /// 'DataView>>byteOrder is abstract: … must implement it', for the view
    /// `over:` makes and an instance of a program's subclass that does not
    /// define it: the two subclasses `on:byteOrder:` makes define it.
    public byteOrder = (
      ^self subclassResponsibility.
    )

    /// Counts the bytes of `bytes`, a number fixed when the ByteArray was
    /// made.
    ///
    /// @answers the number of bytes of `bytes`, an Integer of at least 0.
    /// @signals ArgumentError of `noByteArray:` when `bytes` answers false to
    /// `isKindOfByteArray`.
    /// @see `noByteArray:`.
    public size = (
      bytes isKindOfByteArray ifFalse: [^self noByteArray: #size].
      ^bytes size.
    )

    /// Reads the signed byte at byte position `position`.
    ///
    /// @param position an Integer from 1 to `size`.
    /// @answers the Integer from -128 to 127 there.
    /// @signals ArgumentError carrying `position`, 'int8At: position … out of
    /// range: valid positions are 1..… (size …)' or, when `bytes` is empty,
    /// 'int8At: position … out of range: no position holds 1 byte (size …)',
    /// for an Integer outside 1 to `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `position`, 'int8At: requires an Integer
    /// position, got …', for a position that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @see `noByteArray:`.
    public int8At: position = (
      ^vmMirror byteArray: bytes int8At: position ifFail: [^self noByteArray: #int8At:].
    )

    /// Stores `value` at byte position `position`. A refused store leaves the
    /// bytes as they were.
    ///
    /// @param position an Integer from 1 to `size`.
    /// @param value an Integer from -128 to 127.
    /// @answers `value` itself.
    /// @signals ArgumentError carrying `position`, 'int8At:put: position … out
    /// of range: valid positions are 1..… (size …)' or, when `bytes` is empty,
    /// 'int8At:put: position … out of range: no position holds 1 byte (size
    /// …)', for an Integer outside 1 to `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `position`, 'int8At:put: requires an
    /// Integer position, got …', for a position that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @signals ArgumentError carrying `value`, 'int8At:put: requires an
    /// Integer from -128 to 127, got …', for a value outside that range or no
    /// Integer, at a valid position.
    /// @see `noByteArray:`.
    public int8At: position put: value = (
      ^vmMirror byteArray: bytes int8At: position put: value ifFail: [
        ^self noByteArray: #int8At:put:.
      ].
    )

    /// Reads the unsigned byte at byte position `position`.
    ///
    /// @param position an Integer from 1 to `size`.
    /// @answers the Integer from 0 to 255 there.
    /// @signals ArgumentError carrying `position`, 'uint8At: position … out of
    /// range: valid positions are 1..… (size …)' or, when `bytes` is empty,
    /// 'uint8At: position … out of range: no position holds 1 byte (size …)',
    /// for an Integer outside 1 to `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `position`, 'uint8At: requires an
    /// Integer position, got …', for a position that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @see `noByteArray:`.
    public uint8At: position = (
      ^vmMirror byteArray: bytes uint8At: position ifFail: [^self noByteArray: #uint8At:].
    )

    /// Stores `value` at byte position `position`. A refused store leaves the
    /// bytes as they were.
    ///
    /// @param position an Integer from 1 to `size`.
    /// @param value an Integer from 0 to 255.
    /// @answers `value` itself.
    /// @signals ArgumentError carrying `position`, 'uint8At:put: position … out
    /// of range: valid positions are 1..… (size …)' or, when `bytes` is empty,
    /// 'uint8At:put: position … out of range: no position holds 1 byte (size
    /// …)', for an Integer outside 1 to `size`, a LargeInteger included.
    /// @signals ArgumentError carrying `position`, 'uint8At:put: requires an
    /// Integer position, got …', for a position that is no Integer.
    /// @signals ArgumentError of `noByteArray:` when `bytes` holds no
    /// ByteArray.
    /// @signals ArgumentError carrying `value`, 'uint8At:put: requires an
    /// Integer from 0 to 255, got …', for a value outside that range or no
    /// Integer, at a valid position.
    /// @see `noByteArray:`.
    public uint8At: position put: value = (
      ^vmMirror byteArray: bytes uint8At: position put: value ifFail: [
        ^self noByteArray: #uint8At:put:.
      ].
    )

    /// Refuses an access to a view whose `bytes` answers anything but a
    /// ByteArray: an object that answers true to `isKindOfByteArray`
    /// without being one, which `over:` and `on:byteOrder:` accept;
    /// whatever a program's subclass that overrides `bytes` answers; or
    /// one only a crafted image can put there. It never returns: an Error
    /// is not resumable.
    ///
    /// Protected rather than private, since each subclass's accessors
    /// signal it.
    ///
    /// @param selector the Symbol of the message the program sent.
    /// @answers nothing; it never returns.
    /// @signals ArgumentError carrying `bytes`, '<selector> found no
    /// ByteArray under the view, got …' and its `printString`.
    protected noByteArray: selector = (
      ^(outer Kernel ArgumentError value: bytes) signal: selector asString
          , ' found no ByteArray under the view, got '
          , bytes printString.
    )

    /// Checks that the view can read `aByteArray`: a ByteArray, or anything
    /// that answers true to `isKindOfByteArray`. `over:` keeps what it
    /// answers as `bytes`.
    ///
    /// @param aByteArray the object `over:` was given, any object.
    /// @answers `aByteArray` itself.
    /// @signals ArgumentError carrying `aByteArray`, 'over: requires a
    /// ByteArray, got …' and its `printString`, for anything that answers
    /// false to `isKindOfByteArray`.
    /// @see `DataView`.
    private viewable: aByteArray = (
      aByteArray isKindOfByteArray ifFalse: [
        ^(outer Kernel ArgumentError value: aByteArray) signal: 'over: requires a ByteArray, got '
            , aByteArray printString.
      ].
      ^aByteArray.
    )
  ) : (
    /// Makes a view of `bytes` reading and writing in the byte order
    /// `order`: an instance of a subclass fixed to it. `bytes` is checked
    /// before `order`.
    ///
    /// @param bytes a ByteArray, viewed itself and not copied.
    /// @param order the Symbol #littleEndian or #bigEndian, decided by
    /// identity, so that a String of the same letters is refused.
    /// @answers a new view of `bytes` in the byte order `order`.
    /// @signals ArgumentError carrying `bytes`, 'on:byteOrder: requires a
    /// ByteArray, got …' and its `printString`, for anything that answers
    /// false to `isKindOfByteArray`, as everything but a ByteArray does
    /// unless its class declares otherwise.
    /// @signals ArgumentError carrying `order`, 'on:byteOrder: requires
    /// #littleEndian or #bigEndian, got …' and its `printString`, for
    /// anything else.
    /// @see `checkByteOrder:selector:`.
    public on: bytes byteOrder: order = (
      bytes isKindOfByteArray ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: bytes) signal: 'on:byteOrder: requires a ByteArray, got '
            , bytes printString.
      ].
      self checkByteOrder: order selector: #on:byteOrder:.
      order == #littleEndian ifTrue: [^outer Kernel LittleEndianDataView over: bytes].
      ^outer Kernel BigEndianDataView over: bytes.
    )

    /// Makes a view of a new ByteArray of `size` bytes, each 0, in the byte
    /// order `order`. `order` is checked before anything about `size`, and
    /// every refusal is signalled before anything is allocated. A `size`
    /// that answers true to `isKindOfInteger` but is no Integer the VM
    /// knows is a size that is no Integer.
    ///
    /// @param size an Integer, at least 0.
    /// @param order the Symbol #littleEndian or #bigEndian.
    /// @answers a new view, in the byte order `order`, of a new ByteArray of
    /// `size` bytes, each 0.
    /// @signals ArgumentError of `on:byteOrder:` for `order`, with the
    /// selector 'new:byteOrder:': carrying `order`, 'new:byteOrder:
    /// requires #littleEndian or #bigEndian, got …' and its `printString`.
    /// @signals ArgumentError carrying `size`, 'new:byteOrder: requires an
    /// Integer size, got …' and its `printString`, for a size that is no
    /// Integer.
    /// @signals ArgumentError carrying `size`, 'new:byteOrder: requires a
    /// size of at least 0, got …' and its `printString`, for a negative
    /// one.
    /// @signals ArgumentError carrying `size`, 'new:byteOrder: cannot
    /// allocate a ByteArray of … bytes', for one too large to allocate.
    /// @see `on:byteOrder:`.
    public new: size byteOrder: order = (
      self checkByteOrder: order selector: #new:byteOrder:.
      ^self on: (self bytesOfSize: size) byteOrder: order.
    )

    /// Makes the bytes of the view `new:byteOrder:` makes: a new ByteArray
    /// of `size` bytes, each 0.
    ///
    /// Whether the bytes can be allocated is asked of the VM before
    /// allocating, the same decision `ByteArray new:` makes, so that a
    /// size too large is refused under the message the program sent and
    /// no other error is caught and replaced. Once `isKindOfInteger` has
    /// answered true and `< 0` false, the VM declines to answer only for a
    /// size that is no Integer it knows -- an object that merely claims to
    /// be one -- so the decline is refused as a size that is no Integer,
    /// under `new:byteOrder:` too.
    ///
    /// @param size the size given to `new:byteOrder:`.
    /// @answers a new ByteArray of `size` bytes, each 0.
    /// @signals ArgumentError `new:byteOrder:` describes for `size`, for a
    /// size that is no Integer, negative or too large to allocate.
    /// @see `new:byteOrder:`.
    private bytesOfSize: size = (
      size isKindOfInteger ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: size) signal: 'new:byteOrder: requires an Integer size, got '
            , size printString.
      ].
      size < 0 ifTrue: [
        ^(outer
            Kernel
            ArgumentError value: size) signal: 'new:byteOrder: requires a size of at least 0, got '
            , size printString.
      ].
      (vmMirror byteArrayClass: outer Kernel ByteArray fits: size ifFail: [
        ^(outer
            Kernel
            ArgumentError value: size) signal: 'new:byteOrder: requires an Integer size, got '
            , size printString.
      ]) ifFalse: [
        ^(outer
            Kernel
            ArgumentError value: size) signal: 'new:byteOrder: cannot allocate a ByteArray of '
            , size printString
            , ' bytes'.
      ].
      ^outer Kernel ByteArray new: size.
    )

    /// Checks that `order` is #littleEndian or #bigEndian, by identity:
    /// what `on:byteOrder:` and `new:byteOrder:` check before they make
    /// anything.
    ///
    /// @param order the argument given as the byte order.
    /// @param selector the Symbol of the message the program sent.
    /// @answers the receiver, when `order` is one of the two.
    /// @signals ArgumentError carrying `order`, '<selector> requires
    /// #littleEndian or #bigEndian, got …' and its `printString`, for any
    /// other `order`.
    private checkByteOrder: order selector: selector = (
      (order == #littleEndian or: [order == #bigEndian]) ifFalse: [
        ^(outer Kernel ArgumentError value: order) signal: selector asString
            , ' requires #littleEndian or #bigEndian, got '
            , order printString.
      ].
    )
  )

  /// A DataView that reads and writes little-endian: the least significant byte
