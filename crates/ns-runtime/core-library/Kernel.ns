    public // other = (
      ^vmMirror largeInteger: self floorDivide: other ifFail: [^super // other].
    )

    /// As `Integer>>\\`: the remainder, with the sign of `other`, with
    /// the same ArgumentErrors.
    ///
    /// @param other as `//`'s.
    /// @answers the remainder of `//`, as `Integer>>\\` answers it.
    /// @signals ArgumentError 'division by zero', carrying `other`, for
    /// a zero `other`.
    /// @signals ArgumentError carrying `other`, '\\ requires a numeric
    /// argument, got …', for any other argument.
