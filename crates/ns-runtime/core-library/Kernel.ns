        protected hostReceiver = ( ^message isNil ifTrue: [super hostReceiver] ifFalse: [receiver] )
    ) : (
        (* As `Exception class>>signal`: signals a new MessageNotUnderstood,
           which carries no message. *)
        public signal = ( ^self new signal )
        (* As `Exception class>>signal:`: signals a new
           MessageNotUnderstood with `text`, which carries no message. *)
        public signal: text = ( ^self new signal: text )
    )
    (* What `Object>>halt` signals: a resumable exception which, unhandled,
