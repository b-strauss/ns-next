    /// `noByteArray:` when `bytes` holds no ByteArray.
    public uint64At: position = (
      ^vmMirror byteArray: bytes bigEndianUint64At: position ifFail: [
        ^self noByteArray: #uint64At:.
      ].
    )

    /// Stores `value` at byte position `position`, big-endian and answers
    /// `value` itself.
    ///
    /// position: an Integer from 1 to `size` - 7.
    /// value: an Integer from 0 to 18446744073709551615.
    ///
    /// Signals an ArgumentError carrying `position`: 'uint64At:put: position …
    /// out of range: valid positions are 1..… (size …)' or, when `bytes` holds
    /// fewer than 8 bytes, 'uint64At:put: position … out of range: no position
    /// holds 8 bytes (size …)', for an Integer outside 1 to `size` - 7, a
    /// LargeInteger included, and 'uint64At:put: requires an Integer position,
    /// got …' for a position that is no Integer; the ArgumentError of
    /// `noByteArray:` when `bytes` holds no ByteArray; and an ArgumentError
    /// carrying `value`, 'uint64At:put: requires an Integer from 0 to
    /// 18446744073709551615, got …', for a value outside that range or no
    /// Integer. A refused store leaves the bytes as they were.
    public uint64At: position put: value = (
      ^vmMirror byteArray: bytes bigEndianUint64At: position put: value ifFail: [
        ^self noByteArray: #uint64At:put:.
      ].
    )

    /// Answers the Float at byte position `position`, big-endian, the binary32
    /// there widened exactly.
    ///
    /// position: an Integer from 1 to `size` - 3.
    ///
    /// Signals an ArgumentError carrying `position`: 'float32At: position … out
    /// of range: valid positions are 1..… (size …)' or, when `bytes` holds
    /// fewer than 4 bytes, 'float32At: position … out of range: no position
    /// holds 4 bytes (size …)', for an Integer outside 1 to `size` - 3, a
    /// LargeInteger included, and 'float32At: requires an Integer position, got
    /// …' for a position that is no Integer; and the ArgumentError of
    /// `noByteArray:` when `bytes` holds no ByteArray.
    public float32At: position = (
      ^vmMirror byteArray: bytes bigEndianFloat32At: position ifFail: [
        ^self noByteArray: #float32At:.
      ].
    )

    /// Stores `value` at byte position `position`, big-endian, converted as
    /// `asFloat` converts it and rounded to binary32, and answers `value`
    /// itself.
    ///
    /// position: an Integer from 1 to `size` - 3.
    /// value: a Number.
    ///
    /// Signals an ArgumentError carrying `position`: 'float32At:put: position …
    /// out of range: valid positions are 1..… (size …)' or, when `bytes` holds
    /// fewer than 4 bytes, 'float32At:put: position … out of range: no position
    /// holds 4 bytes (size …)', for an Integer outside 1 to `size` - 3, a
    /// LargeInteger included, and 'float32At:put: requires an Integer position,
    /// got …' for a position that is no Integer; the ArgumentError of
    /// `noByteArray:` when `bytes` holds no ByteArray; and an ArgumentError
    /// carrying `value`, 'float32At:put: requires a Number, got …', for a value
    /// that is no Number. A refused store leaves the bytes as they were.
    ///
    /// The leaf takes only a Float, so the conversion happens here; a value
    /// that is no Number reaches the leaf as it is, so that the position is
    /// checked first and the refusal names the value given.
    public float32At: position put: value = (
      vmMirror byteArray: bytes
          bigEndianFloat32At: position
          put: (value isKindOfNumber ifTrue: [value asFloat] ifFalse: [value])
          ifFail: [^self noByteArray: #float32At:put:].
      ^value.
    )

    /// Answers the Float at byte position `position`, big-endian.
    ///
    /// position: an Integer from 1 to `size` - 7.
    ///
    /// Signals an ArgumentError carrying `position`: 'float64At: position … out
    /// of range: valid positions are 1..… (size …)' or, when `bytes` holds
    /// fewer than 8 bytes, 'float64At: position … out of range: no position
    /// holds 8 bytes (size …)', for an Integer outside 1 to `size` - 7, a
    /// LargeInteger included, and 'float64At: requires an Integer position, got
    /// …' for a position that is no Integer; and the ArgumentError of
    /// `noByteArray:` when `bytes` holds no ByteArray.
    public float64At: position = (
      ^vmMirror byteArray: bytes bigEndianFloat64At: position ifFail: [
        ^self noByteArray: #float64At:.
      ].
    )

    /// Stores `value` at byte position `position`, big-endian, converted as
    /// `asFloat` converts it, and answers `value` itself.
    ///
    /// position: an Integer from 1 to `size` - 7.
    /// value: a Number.
    ///
    /// Signals an ArgumentError carrying `position`: 'float64At:put: position …
    /// out of range: valid positions are 1..… (size …)' or, when `bytes` holds
    /// fewer than 8 bytes, 'float64At:put: position … out of range: no position
    /// holds 8 bytes (size …)', for an Integer outside 1 to `size` - 7, a
    /// LargeInteger included, and 'float64At:put: requires an Integer position,
    /// got …' for a position that is no Integer; the ArgumentError of
    /// `noByteArray:` when `bytes` holds no ByteArray; and an ArgumentError
    /// carrying `value`, 'float64At:put: requires a Number, got …', for a value
    /// that is no Number. A refused store leaves the bytes as they were.
    ///
    /// The leaf takes only a Float, so the conversion happens here; a value
    /// that is no Number reaches the leaf as it is, so that the position is
    /// checked first and the refusal names the value given.
    public float64At: position put: value = (
      vmMirror byteArray: bytes
          bigEndianFloat64At: position
          put: (value isKindOfNumber ifTrue: [value asFloat] ifFalse: [value])
          ifFail: [^self noByteArray: #float64At:put:].
      ^value.
    )
  )

  /// The class of `nil`.
  ///
  /// §5.1.3: `nil` is the unique instance of `UndefinedObject`, which
  /// answers `isNil` with true. It answers the rest of the nil protocol
  /// `Object` declares the other way round, each a quick method, and
  /// prints as `nil`.
  public class UndefinedObject = Value () (
    /// Answers true: the receiver is nil.
    public isNil = (
      ^true.
    )

    /// Answers false: the receiver is nil.
    public notNil = (
      ^false.
    )

    /// Answers the value of `block`.
    ///
    /// block: a block of no argument, or anything understanding
    /// `value`; sent `value`.
    public ifNil: block = (
      ^block value.
    )

    /// Answers nil; `block` is not evaluated.
    public ifNotNil: block = (
      ^nil.
    )

    /// Answers the value of `nilBlock`, sent `value`; `notNilBlock` is
    /// not evaluated.
    public ifNil: nilBlock ifNotNil: notNilBlock = (
      ^nilBlock value.
    )

    /// As `ifNil:ifNotNil:`, its arguments in the other order.
    public ifNotNil: notNilBlock ifNil: nilBlock = (
      ^nilBlock value.
    )

    /// Answers the String 'nil'.
    public printString = (
      ^'nil'.
    )
  )

  /// A closure, `[:argument | …]`: code that runs when it is sent
  /// `value`, in the scope it was written in (§5.1.8).
  public class Closure = Object () (
    /// Answers true: the receiver is a Closure.
    public isKindOfClosure = (
      ^true.
    )

    /// Evaluates the block and answers its value.
    ///
    /// Signals an ArgumentError carrying the block, 'wrong number of
    /// block arguments: block takes …, got 0', when it declares any
    /// parameter.
    public value = (
      ^vmMirror blockValue: self ifFail: [^super value].
    )

    /// As `value`, with `first` as the block's one argument.
    public value: first = (
      ^vmMirror block: self value: first ifFail: [^super value: first].
    )

    /// As `value`, with two arguments, in order.
    public value: first value: second = (
      ^vmMirror block: self value: first value: second ifFail: [^super value: first value: second].
    )

    /// As `value`, with three arguments, in order.
    public value: first value: second value: third = (
      ^vmMirror block: self value: first value: second value: third ifFail: [
        ^super value: first value: second value: third.
      ].
    )

    /// Answers the number of parameters the block declares.
    public numArgs = (
      ^vmMirror blockNumArgs: self ifFail: [^super numArgs].
    )

    /// Evaluates the block with `argument` when it declares parameters,
    /// and with none when it declares none; answers its value.
    ///
    /// argument: any object.
    ///
    /// Signals what `value:` signals for a block of two parameters or
    /// more.
    ///
    /// `Object`'s `ifNotNil:` family means exactly this, and its quick
    /// methods do it without sending it.
    public cull: argument = (
      ^self numArgs = 0 ifTrue: [self value] ifFalse: [self value: argument].
    )

    /// Evaluates the receiver and, while it answers true, `body`, then
    /// the receiver again; answers nil once it answers false.
    ///
    /// body: a block of no argument, or anything understanding `value`;
    /// sent `value`.
    ///
    /// Signals a NonBooleanReceiver carrying the answer, 'a loop's
    /// condition answered …, which is no Boolean', when the receiver
    /// answers anything else, and an ArgumentError, 'wrong number of
    /// block arguments: block takes …, got 0', for a receiver or a
    /// `body` that declares parameters.
    public whileTrue: body = (
      ^vmMirror block: self whileTrue: body ifFail: [^super whileTrue: body].
    )

    /// As `whileTrue:`, evaluating `body` while the receiver answers
    /// false.
    public whileFalse: body = (
      ^vmMirror block: self whileFalse: body ifFail: [^super whileFalse: body].
    )

    /// Evaluates the receiver and answers its value. An exception
    /// signalled meanwhile whose class `exceptionClass handles:` runs
    /// `handler`, given the exception; the handler's value, unless it
    /// resumes, retries or passes the exception, is this send's.
    ///
    /// exceptionClass: an exception class, or anything understanding
    /// `handles:`; sent `handles:` with each exception signalled,
    /// while this `on:do:` is disabled.
    /// handler: a block of no argument or one, or anything
    /// understanding `cull:`; sent `cull:` with the exception.
    ///
    /// ANSI's handler: the marker on this method's code tells `signal`
    /// this activation handles `exceptionClass` with `handler`, while
    /// `handlerActive` is true (docs/design/core-library.md,
    /// "Exceptions"). The body is a tail send that tail-call elimination
    /// must never skip (docs/design/execution.md, "Planned: tail calls").
    public on: exceptionClass do: handler = (
      |
        handlerActive = true.
      |
      ^self value.
    )

    /// Evaluates the receiver, then `onUnwind`, and answers the
    /// receiver's value. `onUnwind` runs exactly once, also when an
    /// unwind abandons the receiver: a `^` out of it, an exception's
    /// `return:`, `retry` or `resume:`, or the end of the run an
    /// unhandled exception brings.
    ///
    /// onUnwind: a block of no argument, or anything understanding
    /// `value`; sent `value`.
    ///
    /// On a normal end the block runs here; on an unwind the unwinder
    /// runs it, having set `complete` first, so it runs exactly once.
    public ensure: onUnwind = (
      |
        complete ::= nil.
        result = self value.
      |
      complete isNil ifTrue: [
        complete:: true.
        onUnwind value.
      ].
      ^result.
    )

    /// Evaluates the receiver and answers its value; runs `onUnwind`
    /// only when an unwind abandons the receiver.
    ///
    /// onUnwind: as `ensure:`'s.
    public ifCurtailed: onUnwind = (
      |
        complete = nil.
      |
      ^self value.
    )

    /// Sends `value` to `onUnwind` and answers what it answers. The
    /// unwinder activates it for an `ensure:` or `ifCurtailed:`
    /// argument that is no block, so that the unwind carries on from
    /// this activation's return.
    ///
    /// onUnwind: any object; sent `value`.
    ///
    /// An ordinary send of `value`, as the normal path's, whatever that
    /// send decides -- a method, an instantiation -- and this
    /// activation's return is where the unwind carries on
    /// (`interpreter::unwind`). A block the unwinder activates
    /// itself.
    private valueOnUnwind: onUnwind = (
      ^onUnwind value.
    )

    /// Sends `value` to `action` and answers what it answers. A native
    /// loop activates it for a loop body that is no block, so that the
    /// loop carries on from this activation's return whatever the send
    /// decides.
    ///
    /// action: any object; sent `value`.
    private valueOf: action = (
      ^action value.
    )

    /// Sends `value:` with `element` to `action` and answers what it
    /// answers. `do:` activates it for an action that is no block, as
    /// `valueOf:` serves a loop body.
    ///
    /// action: any object; sent `value:`.
    /// element: the element of this turn of the walk.
    private valueOf: action with: element = (
      ^action value: element.
    )
  )

  /// Runs a full collection and answers the receiver: every object that
  /// nothing but weak slots reaches is reclaimed, and those slots read
  /// nil from then on. `platform kernel garbageCollect` sends it.
  ///
  /// The leaf asks for the collection, and the run loop serves it at its
  /// next safepoint: the return from the method that sent this one,
  /// before that method's sender runs on. The leaf never declines; its
  /// failure block answers the receiver, as the leaf does, rather than
  /// resending to `super`, so that no MessageNotUnderstood could ever
  /// carry the kernel instance.
  public garbageCollect = (
    ^vmMirror garbageCollect: self ifFail: [self].
  )
)
