<idea-plugin>
    <id>io.github.bstrauss.newspeak</id>
    <name>Newspeak (ns-next)</name>
    <vendor url="https://github.com/b-strauss/ns-next">Benjamin Strauß</vendor>
    <resource-bundle>messages.NewspeakBundle</resource-bundle>

    <description><![CDATA[
    <p>Support for <a href="https://newspeaklanguage.org/">Newspeak</a> <code>.ns</code> modules,
    from the <a href="https://github.com/b-strauss/ns-next">ns-next</a> runtime.</p>
    <ul>
      <li>Syntax highlighting as you type, with brace matching, line and block comments, TODO markers
          and spell checking in comments and strings.</li>
      <li>Typing indents as the formatter does: two spaces, Enter after an opening bracket and before
          a closing one, and the margin at 100 columns.</li>
      <li>Errors as you type: every lexer, parser and resolver error ns-next reports before
          running a module, with ns-next's own message.</li>
      <li>Semantic colouring from ns-next's resolver: parameters, locals, slots, nested classes
          and sends.</li>
      <li>Code folding from ns-next's parser: comments, class bodies and class sides, method
          bodies, closures and slot sections — kept while a file has syntax errors. A method whose
          body is one line shows on one line, as Java's one-line methods do.</li>
      <li>A structure view and breadcrumbs from ns-next's parser: each class with its factory,
          its slots and methods with their access shown as in Java, its class-side methods
          marked static as in Java, and sticky lines — kept while a file has syntax errors.</li>
      <li>Completion and validation in <code>newspeak.json</code>, ns-next's project file, from
          its schema.</li>
      <li>Running and benchmarking a project from its <code>newspeak.json</code>: a play button
          beside <code>main</code> and beside each script opens Run and Benchmark, which create a
          "Newspeak" run configuration starting <code>ns-next run</code> or <code>ns-next bench</code>.</li>
      <li>Running and benchmarking a single module: a play button beside <code>main:args:</code>
          of a module whose root class is created with <code>new</code>, and Run in its context menu.</li>
    </ul>
    <p>The language server, <code>ns-next-analyzer</code>, is bundled for the platform the plugin was
    built on. Where none is bundled, the plugin says so; build it with
    <code>cargo build -p ns-analyzer --release</code> and set its path under
    <em>Settings | Languages &amp; Frameworks | Newspeak</em>.</p>
    <p>The runtime, <code>ns-next</code>, is not bundled. Build it with
    <code>cargo build -p ns-cli --release</code> and set the ns-next path in the same settings;
    a Newspeak run configuration refuses to start without it.</p>
    ]]></description>

    <change-notes><![CDATA[
    <p>0.1.0: highlighting, errors as you type, semantic colouring, code folding, and a
    structure view with breadcrumbs. Completion and validation in <code>newspeak.json</code>
    from the project file's schema. Running and benchmarking a project from its
    <code>newspeak.json</code>, with the ns-next path setting. Running and benchmarking a single
    module from its <code>main:args:</code>.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <!-- Optional: an IDE built without the spellchecker module still loads this
         plugin, with no spell checking in Newspeak comments and strings. -->
    <depends optional="true" config-file="newspeak-spellchecker.xml">com.intellij.modules.spellchecker</depends>
    <!-- Optional: an IDE built without the JSON plugin still loads this plugin,
         with no schema, no play buttons and no context-menu Run for newspeak.json;
         the Newspeak run configuration type stays. -->
    <depends optional="true" config-file="newspeak-json.xml">com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Newspeak"
                  implementationClass="io.github.bstrauss.newspeak.NewspeakFileType"
                  fieldName="INSTANCE"
                  language="Newspeak"
                  extensions="ns"/>
        <lang.parserDefinition language="Newspeak"
                               implementationClass="io.github.bstrauss.newspeak.parser.NewspeakParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Newspeak"
                                       implementationClass="io.github.bstrauss.newspeak.highlighting.NewspeakSyntaxHighlighterFactory"/>
        <annotator language="Newspeak"
                   implementationClass="io.github.bstrauss.newspeak.highlighting.NewspeakDocCommentAnnotator"/>
        <colorSettingsPage implementation="io.github.bstrauss.newspeak.highlighting.NewspeakColorSettingsPage"/>
        <lang.braceMatcher language="Newspeak"
                           implementationClass="io.github.bstrauss.newspeak.editor.NewspeakBraceMatcher"/>
        <lang.commenter language="Newspeak"
                        implementationClass="io.github.bstrauss.newspeak.editor.NewspeakCommenter"/>
        <lang.quoteHandler language="Newspeak"
                           implementationClass="io.github.bstrauss.newspeak.editor.NewspeakQuoteHandler"/>
        <lang.foldingBuilder language="Newspeak"
                             implementationClass="io.github.bstrauss.newspeak.editor.NewspeakOneLineMethodFolding"/>
        <codeFoldingOptionsProvider instance="io.github.bstrauss.newspeak.settings.NewspeakCodeFoldingOptionsProvider"/>
        <indexPatternBuilder implementation="io.github.bstrauss.newspeak.editor.NewspeakIndexPatternBuilder"/>
        <!-- The formatter's style, fixed (NewspeakCodeStyle): first, so that no detected indent or
             .editorconfig answers for a Newspeak file before these. -->
        <fileIndentOptionsProvider order="first"
                                   implementation="io.github.bstrauss.newspeak.editor.NewspeakIndentOptionsProvider"/>
        <codeStyleSettingsModifier order="first"
                                   implementation="io.github.bstrauss.newspeak.editor.NewspeakCodeStyleModifier"/>
        <lineIndentProvider order="first"
                            implementation="io.github.bstrauss.newspeak.editor.NewspeakLineIndentProvider"/>
        <enterBetweenBracesDelegate language="Newspeak"
                                    implementationClass="io.github.bstrauss.newspeak.editor.NewspeakEnterBetweenBracketsDelegate"/>
        <typedHandler implementation="io.github.bstrauss.newspeak.editor.NewspeakClosingBracketTypedHandler"/>
        <enterHandlerDelegate order="first"
                              implementation="io.github.bstrauss.newspeak.editor.NewspeakLineCommentEnter"/>
        <applicationConfigurable parentId="language"
                                 instance="io.github.bstrauss.newspeak.settings.NewspeakSettingsConfigurable"
                                 id="io.github.bstrauss.newspeak.settings"
                                 key="settings.display.name"/>
        <notificationGroup id="Newspeak" displayType="BALLOON" key="notification.group.name"/>
        <configurationType implementation="io.github.bstrauss.newspeak.run.NewspeakConfigurationType"/>
        <!-- Reads the language server's symbols, no JSON PSI, so it is here and not in newspeak-json.xml. -->
        <runLineMarkerContributor language="Newspeak" implementationClass="io.github.bstrauss.newspeak.run.NewspeakModuleRunLineMarkerContributor"/>
        <runConfigurationProducer implementation="io.github.bstrauss.newspeak.run.NewspeakModuleRunConfigurationProducer"/>
        <platform.lsp.integrationProvider implementation="io.github.bstrauss.newspeak.lsp.NewspeakLspIntegrationProvider"/>
        <!-- Asked before the platform's LSP structure view, which is registered for every
             language; that one is also turned off for the Newspeak client
             (NewspeakDocumentSymbols). -->
        <lang.psiStructureViewFactory language="Newspeak"
                                      implementationClass="io.github.bstrauss.newspeak.structure.NewspeakStructureViewFactory"/>
    </extensions>

    <actions>
        <action id="io.github.bstrauss.newspeak.RestartServer"
                class="io.github.bstrauss.newspeak.lsp.RestartServerAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
