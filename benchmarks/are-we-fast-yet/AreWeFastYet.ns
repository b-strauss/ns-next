/// Adapted for ns-next from Primordial Soup's BenchmarkRunner.ns
/// (https://github.com/rmacnak/primordialsoup, commit
/// 338f0bb342a618f5608ab72ab1b1fae9b226e472, newspeak/BenchmarkRunner.ns).
/// Changed for ns-next: the benchmarks are the Are We Fast Yet programs;
/// a run without --timed verifies each benchmark once instead of
/// measuring it, so its output can be pinned; the command line selects a
/// benchmark by name; output goes through the platform's transcript
/// rather than Object>>out; names are written out.
///
/// Copyright 2012 Google Inc.
/// Copyright 2013 Ryan Macnak
///
/// Licensed under the Apache License, Version 2.0 (the ''License''); you
/// may not use this file except in compliance with the License. You may
/// obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0
/// and in THIRD-PARTY-NOTICES.md at the repository root.
///
/// ns-next run benchmarks/are-we-fast-yet --
///     [--timed [--warm-up <milliseconds>] [--measure <milliseconds>]] [Benchmark]:
/// without --timed, runs each benchmark (or the one named) once and prints
/// '<Name>: ok'; with it, measures each for at least --measure
/// milliseconds (20 by default) after --warm-up milliseconds (3 by
/// default) of warm-up and prints its runs per second, as Primordial Soup
/// does. A value is a non-negative decimal integer; a malformed command
/// line signals the usage.
class AreWeFastYet packageUsing: manifest = (
  |
    private benchmarks = {
      manifest Bounce.
      manifest CD.
      manifest DeltaBlue.
      manifest DeltaBlueTon80.
      manifest Havlak.
      manifest Json.
      manifest List.
      manifest Mandelbrot.
      manifest NBody.
      manifest Permute.
      manifest Queens.
      manifest Richards.
      manifest RichardsTon80.
      manifest Sieve.
      manifest Storage.
      manifest Towers.
    }.
  |
) (
  class Benchmarking usingPlatform: platform = (
    |
      private Stopwatch = platform time Stopwatch.
      private ArgumentError = platform kernel ArgumentError.
      private transcript = platform transcript.
      private benchmarkPlatform = platform.
    |
  ) (
    /// Primordial Soup's measure: runs the block until the time is
    /// spent and answers runs per second.
    measure: block forAtLeast: nanoseconds = (
      |
        runs
        stopwatch
        elapsed
      |
      runs:: 0.
      stopwatch:: Stopwatch new start.
      [
        block value.
        runs:: runs + 1.
        elapsed:: stopwatch elapsedNanoseconds.
        elapsed < nanoseconds.
      ] whileTrue: [].
      ^(runs * 1000000000) asFloat / elapsed asFloat.
    )

    /// The line is written only once the benchmark has run, so a
    /// benchmark that raises leaves no half-written line on stdout.
    report: benchmark timed: timed warmUp: warmUpNanoseconds measure: measureNanoseconds = (
      |
        instance
        result
      |
      instance:: benchmark usingPlatform: benchmarkPlatform.
      timed ifTrue: [
        measure: [instance bench] forAtLeast: warmUpNanoseconds.
        result:: (measure: [instance bench] forAtLeast: measureNanoseconds) asStringFixed: 1.
      ] ifFalse: [
        instance bench.
        result:: 'ok'.
      ].
      transcript
          show: benchmark name , ': ' , result;
          newLine.
    )

    public run: name timed: timed warmUp: warmUpNanoseconds measure: measureNanoseconds = (
      |
        found
      |
      found:: false.
      benchmarks do: [:benchmark |
        (name isNil or: [benchmark name = name]) ifTrue: [
          found:: true.
          report: benchmark timed: timed warmUp: warmUpNanoseconds measure: measureNanoseconds.
        ].
      ].
      found ifFalse: [Error signal: 'Unknown benchmark: ' , name].
    )

    /// Answers the Integer a flag's value `text` writes, a non-negative
    /// decimal integer; any other text signals the usage.
    public milliseconds: text = (
      |
        milliseconds
      |
      milliseconds:: [Integer parse: text] on: ArgumentError do: [:error | ^usage].
      milliseconds < 0 ifTrue: [^usage].
      ^milliseconds.
    )

    public usage = (
      Error signal: 'usage: ns-next run benchmarks/are-we-fast-yet -- [--timed [--warm-up <milliseconds>] [--measure <milliseconds>]] [Benchmark]'.
    )
  )

  /// Reads `[--timed [--warm-up <milliseconds>] [--measure
  /// <milliseconds>]] [Benchmark]`: the flags come only after --timed, in
  /// either order, each at most once.
  public main: platform args: arguments = (
    |
      benchmarking = Benchmarking usingPlatform: platform.
      timed
      index
      flag
      milliseconds
      warmUpMilliseconds
      measureMilliseconds
    |
    timed:: arguments size >= 1 and: [(arguments at: 1) = '--timed'].
    index:: timed ifTrue: [2] ifFalse: [1].
    [
      timed and: [
        index <= arguments size and: [
          flag:: arguments at: index.
          flag = '--warm-up' or: [flag = '--measure'].
        ].
      ].
    ] whileTrue: [
      index < arguments size ifFalse: [^benchmarking usage].
      milliseconds:: benchmarking milliseconds: (arguments at: index + 1).
      flag = '--warm-up' ifTrue: [
        warmUpMilliseconds isNil ifFalse: [^benchmarking usage].
        warmUpMilliseconds:: milliseconds.
      ] ifFalse: [
        measureMilliseconds isNil ifFalse: [^benchmarking usage].
        measureMilliseconds:: milliseconds.
      ].
      index:: index + 2.
    ].
    arguments size > index ifTrue: [^benchmarking usage].
    benchmarking run: (arguments size = index ifTrue: [arguments at: index] ifFalse: [nil])
        timed: timed
        warmUp: (warmUpMilliseconds isNil ifTrue: [3] ifFalse: [warmUpMilliseconds]) * 1000000
        measure: (measureMilliseconds isNil ifTrue: [20] ifFalse: [measureMilliseconds]) * 1000000.
  )
)
