[submodule "prior-art/newspeak"]
	path = prior-art/newspeak
	url = https://github.com/newspeaklanguage/newspeak.git
[submodule "prior-art/newspeak-benchmarks"]
	path = prior-art/newspeak-benchmarks
	url = https://github.com/newspeaklanguage/benchmarks.git
[submodule "prior-art/primordialsoup"]
	path = prior-art/primordialsoup
	url = https://github.com/rmacnak/primordialsoup.git
[submodule "prior-art/somns"]
	path = prior-art/somns
	url = https://github.com/smarr/SOMns.git
[submodule "prior-art/nova"]
	path = prior-art/nova
	url = https://github.com/trynova/nova.git
[submodule "prior-art/opensmalltalk-vm"]
	path = prior-art/opensmalltalk-vm
	url = https://github.com/OpenSmalltalk/opensmalltalk-vm.git
[submodule "prior-art/strongtalk"]
	path = prior-art/strongtalk
	url = https://github.com/b-strauss/strongtalk.git
	branch = gcc-linux
[submodule "prior-art/num-bigint"]
	path = prior-art/num-bigint
	url = https://github.com/rust-num/num-bigint.git
[submodule "prior-art/num-integer"]
	path = prior-art/num-integer
	url = https://github.com/rust-num/num-integer.git
[submodule "prior-art/num-rational"]
	path = prior-art/num-rational
	url = https://github.com/rust-num/num-rational.git
[submodule "prior-art/are-we-fast-yet"]
	path = prior-art/are-we-fast-yet
	url = https://github.com/smarr/are-we-fast-yet.git
[submodule "prior-art/v8"]
	path = prior-art/v8
	url = https://github.com/v8/v8.git
	shallow = true
[submodule "prior-art/jdk"]
	path = prior-art/jdk
	url = https://github.com/openjdk/jdk.git
	shallow = true
